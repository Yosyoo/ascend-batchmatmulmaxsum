#include "kernel_operator.h"
using namespace AscendC;
template<class T>
__global__ __aicore__ __cube__ void bmms_cube_scalar32(GM_ADDR a, GM_ADDR b, GM_ADDR y)
{
    constexpr int K=32, P=16;
    const int batch=GetBlockIdx();
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    LocalTensor<T> la(TPosition::A1,0,P*K),lb(TPosition::B1,P*K*2,P*K);
    LocalTensor<T> aa(TPosition::A2,0,P*K),bb(TPosition::B2,0,P*K);
    LocalTensor<float> cc(TPosition::CO1,0,P*P);
    Nd2NzParams p{1,1,K,0,K,P,1,0};
    DataCopy(la,ag[batch*K],p);DataCopy(lb,bg[batch*K],p);
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    LoadData2dParams ap{0,K/16,1,0,0,false,0};
    LoadData(aa,la,ap);LoadData(bb,lb,ap);
    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
    MmadParams mm{P,P,K,0,false,true};Mmad(cc,aa,bb,mm);
    SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
    FixpipeParamsV220 fp;fp.mSize=1;fp.nSize=1;fp.srcStride=P;fp.dstStride=1;
    Fixpipe(yg[batch],cc,fp);
    PipeBarrier<PIPE_ALL>();
}


extern "C" void run_kernel(GM_ADDR x1,const TensorGroupInfo& info_x1,GM_ADDR x2,const TensorGroupInfo& info_x2,GM_ADDR y,const TensorGroupInfo& info_y,int64_t cores,aclrtStream stream,bool ta,bool tb) {
int b=info_x1.tensors[0].shape[0];
if(info_x1.tensors[0].dtype==2)bmms_cube_scalar32<bfloat16_t><<<b,nullptr,stream>>>(x1,x2,y);
else bmms_cube_scalar32<half><<<b,nullptr,stream>>>(x1,x2,y);
}
