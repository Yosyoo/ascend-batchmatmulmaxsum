#include <cstdio>
#include "tiling_api.h"
int main(){
    for(int plan=0;plan<3;++plan){
        matmul_tiling::PlatformInfo p;p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
        p.l1Size=512*1024;p.l0ASize=p.l0BSize=64*1024;p.l0CSize=128*1024;p.ubSize=192*1024;
        matmul_tiling::MatmulApiTiling api(p);
        auto dt=matmul_tiling::DataType::DT_BF16;
        api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,false);
        api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,false);
        api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);api.SetShape(128,256,1152);api.SetOrgShape(4096,1280,1152,1152);
        api.SetFixSplit(128,plan?128:256,plan?128:-1);
        if(plan==2) api.SetDoubleBuffer(true,true,true,false);
        api.SetBufferSpace(p.l1Size,p.l0CSize,0);TCubeTiling t{};int rc=api.GetTiling(t);
        printf("{\"plan\":%d,\"rc\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"dbL0A\":%d,\"dbL0B\":%d,\"dbL0C\":%d,\"stepM\":%d,\"stepN\":%d,\"stepKa\":%d,\"stepKb\":%d,\"depthA1\":%d,\"depthB1\":%d,\"shareL1Size\":%d}\n",
            plan,rc,t.baseM,t.baseN,t.baseK,t.dbL0A,t.dbL0B,t.dbL0C,t.stepM,t.stepN,t.stepKa,t.stepKb,t.depthA1,t.depthB1,t.shareL1Size);
    }
}
