#include <cstdio>
#include "tiling_api.h"

int main()
{
    // Only Host geometry for the user-supplied P12, no tensor values/device work.
    for(int plan=0;plan<5;++plan) {
        matmul_tiling::PlatformInfo p;
        p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
        p.l1Size=512*1024;p.l0ASize=p.l0BSize=64*1024;
        p.l0CSize=128*1024;p.ubSize=192*1024;
        matmul_tiling::MatmulApiTiling api(p);
        api.SetAType(matmul_tiling::TPosition::A1,matmul_tiling::CubeFormat::NZ,matmul_tiling::DataType::DT_BF16,true);
        api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_BF16,false);
        api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);api.SetShape(128,256,768);
        api.SetOrgShape(128,4096,768,1536);
        api.SetFixSplit((plan==0||plan==4)?128:64,plan==4?128:256,plan>=3?128:64);
        if(plan>=2) api.SetDoubleBuffer(true,true,true,false);
        api.SetBufferSpace(p.l1Size,p.l0CSize,0);
        TCubeTiling t{};int rc=api.GetTiling(t);
        std::printf("{\"plan\":%d,\"rc\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"dbL0A\":%d,\"dbL0B\":%d,\"dbL0C\":%d,\"L0C_bytes\":%lld,\"stepM\":%d,\"stepN\":%d,\"stepKb\":%d}\n",
            plan,rc,t.baseM,t.baseN,t.baseK,t.dbL0A,t.dbL0B,t.dbL0C,
            4LL*t.baseM*t.baseN*t.dbL0C,t.stepM,t.stepN,t.stepKb);
    }
}
