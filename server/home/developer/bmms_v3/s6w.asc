#include <algorithm>
#include <vector>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling_api.h"
using namespace AscendC;
using namespace matmul;
constexpr MatmulConfig BMMS_MM_CFG = GetMDLConfig(false, false, 0, false, false, false, true);

__aicore__ inline void bmms_sum(const LocalTensor<float>& dst,
    const LocalTensor<float>& src, const LocalTensor<float>& tmp, int32_t count)
{
    if (count <= 64) { WholeReduceSum(dst, src, count, 1, 1, 1, 8); return; }
    int32_t groups = count / 64;
    WholeReduceSum(tmp, src, 64, groups, 1, 1, 8);
    if (count % 64) WholeReduceSum(tmp[groups], src[groups * 64], count % 64, 1, 1, 1, 8);
    int32_t partials = (count + 63) / 64;
    PipeBarrier<PIPE_V>();
    if (partials > 64) {
        Add(tmp, tmp, tmp[64], partials - 64);
        PipeBarrier<PIPE_V>();
        partials = 64;
    }
    WholeReduceSum(dst, tmp, partials, 1, 1, 1, 8);
}

template<class T, bool TA, bool TB, int M, int N, int K>
__global__ __aicore__ __mix__(1, 1) void bmms_full(GM_ADDR a, GM_ADDR b, GM_ADDR scratch, GM_ADDR y)
{
    const int core = GetBlockIdx();
    const int off = core * 2 * M * N;
    GlobalTensor<float> sg;
    sg.SetGlobalBuffer((__gm__ float*)scratch);
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<T> la(TPosition::A1, 0, M * K), lb(TPosition::B1, M * K * 2, N * K);
        LocalTensor<T> aa(TPosition::A2, 0, M * K), bb(TPosition::B2, 0, N * K);
        LocalTensor<float> cc(TPosition::CO1, 0, M * N);
        Nd2NzParams pa{1, TA ? K : M, TA ? M : K, 0, TA ? M : K, TA ? K : M, 1, 0};
        Nd2NzParams pb{1, TB ? N : K, TB ? K : N, 0, TB ? K : N, TB ? N : K, 1, 0};
        DataCopy(la, ag[core * M * K], pa); DataCopy(lb, bg[core * N * K], pb);
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0); WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        LoadData2dParams ap{0, K / 16, TA ? 1 : M / 16, 0, 0, TA, 0};
        if (TA) {
            ap.repeatTimes = M * K / 256;
            LoadData(aa, la, ap);
        } else {
            #pragma unroll
            for (int i = 0; i < M / 16; ++i) LoadData(aa[i * K * 16], la[i * 256], ap);
        }
        LoadData2dParams bp{0, N / 16, TB ? 1 : K / 16, 0, 0, !TB, 0};
        if (TB) {
            bp.repeatTimes = N * K / 256;
            LoadData(bb, lb, bp);
        } else {
            #pragma unroll
            for (int i = 0; i < K / 16; ++i) LoadData(bb[i * N * 16], lb[i * 256], bp);
        }
        SetFlag<HardEvent::MTE1_M>(EVENT_ID0); WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
        MmadParams mm{M, N, K, 0, false, true};
        Mmad(cc, aa, bb, mm);
        SetFlag<HardEvent::M_FIX>(EVENT_ID0); WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
        FixpipeParamsV220 fp;
        fp.mSize = M; fp.nSize = N; fp.srcStride = M; fp.dstStride = N;
        Fixpipe(sg[off], cc, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
    }
    if ASCEND_IS_AIV {
        LocalTensor<float> vx(TPosition::VECIN, 0, M * N);
        LocalTensor<float> rm(TPosition::VECCALC, M * N * 4, M);
        LocalTensor<float> out(TPosition::VECOUT, M * N * 4 + M * 4, 8);
        GlobalTensor<float> yg; yg.SetGlobalBuffer((__gm__ float*)y);
        CrossCoreWaitFlag(8);
        DataCopy(vx, sg[off], M * N);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if (N == 128) {
            Max(vx, vx, vx[64], 64, M, {1, 1, 1, 16, 16, 16});
            PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(rm, vx, N < 64 ? N : 64, M, 1, 1, N / 8, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(out, rm, M, 1, 1, 1, 8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams cp{1, 4, 0, 0, 0}; DataCopyPad(yg[core], out, cp);
    }
    PipeBarrier<PIPE_ALL>();
}


template<class T, bool TA, bool TB, int TM = 0, int TN = 0, int TK = 0, bool FULL = false>
__global__ __aicore__ __mix__(1, 1) void bmms_small(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns,
    int32_t dynamicM, int32_t dynamicN)
{
    constexpr bool useManual = true;
    const int32_t tileM = TM ? TM : dynamicM;
    const int32_t tileN = TN ? TN : dynamicN;
    if (TK) k = TK;
    if (FULL) { m = TM; n = TN; }
    constexpr int32_t mt = 1;
    constexpr int32_t nt = 1;
    ns = 1;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;

    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        // Hand-rolled cube path (no Matmul-library scheduler) for small problems, where the
        // library's per-task scalar/icache cost dominates the actual MAC time.
        const int32_t mp = tileM, np = tileN;
        int32_t bk = (32768 / (mp > np ? mp : np)) / 16 * 16;
        if (bk > k) bk = k;
        LocalTensor<T> l1a(TPosition::A1, 0, mp * bk);
        LocalTensor<T> l1b(TPosition::B1, mp * bk * 2, np * bk);
        LocalTensor<T> l0a(TPosition::A2, 0, mp * bk);
        LocalTensor<T> l0b(TPosition::B2, 0, np * bk);
        LocalTensor<float> l0c(TPosition::CO1, 0, mp * np);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task;
            constexpr int32_t part = 0;
            constexpr int32_t mi = 0;
            constexpr int32_t begin = 0;
            constexpr int32_t end = 1;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                if (t - begin >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                if (useManual) {
                    const int32_t cm16 = (cm + 15) / 16 * 16;
                    const int32_t cn16 = (cn + 15) / 16 * 16;
                    const int64_t aBase = (int64_t)batch * m * k + (TA ? (int64_t)mi : (int64_t)mi * k);
                    const int64_t bBase = (int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni);
                    for (int32_t k0 = 0; k0 < k; k0 += bk) {
                        int32_t kk = (k0 + bk <= k) ? bk : (k - k0);
                        int32_t kk16 = (kk + 15) / 16 * 16;
                        // Close the pipe hazards left by the previous chunk/tile before rewriting L1/L0.
                        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                        if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                        // ---- GM(ND) -> L1(NZ) ----
                        Nd2NzParams pa;
                        pa.ndNum = 1;
                        pa.dstNzNStride = 1;
                        pa.dstNzMatrixStride = 0;
                        pa.srcNdMatrixStride = 1;
                        int64_t aOff = aBase;
                        if (!TA) {
                            pa.nValue = (uint16_t)cm; pa.dValue = (uint16_t)kk;
                            pa.srcDValue = (uint16_t)k; pa.dstNzC0Stride = (uint16_t)cm16;
                            aOff += k0;
                        } else {
                            pa.nValue = (uint16_t)kk; pa.dValue = (uint16_t)cm;
                            pa.srcDValue = (uint16_t)m; pa.dstNzC0Stride = (uint16_t)kk16;
                            aOff += (int64_t)k0 * m;
                        }
                        Nd2NzParams pb;
                        pb.ndNum = 1;
                        pb.dstNzNStride = 1;
                        pb.dstNzMatrixStride = 0;
                        pb.srcNdMatrixStride = 1;
                        pb.dstNzC0Stride = (uint16_t)(TB ? cn16 : kk16);
                        int64_t bOff = bBase;
                        if (!TB) {
                            pb.nValue = (uint16_t)kk; pb.dValue = (uint16_t)cn;
                            pb.srcDValue = (uint16_t)n;
                            bOff += (int64_t)k0 * n;
                        } else {
                            pb.nValue = (uint16_t)cn; pb.dValue = (uint16_t)kk;
                            pb.srcDValue = (uint16_t)k;
                            bOff += k0;
                        }
                        DataCopy(l1a, ag[aOff], pa);
                        DataCopy(l1b, bg[bOff], pb);
                        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        // ---- L1 -> L0A / L0B ----
                        const int32_t bm = cm16 / 16;
                        const int32_t bn = cn16 / 16;
                        const int32_t bkk = kk16 / 16;
                        LoadData2dParams lp;
                        lp.startIndex = 0;
                        lp.sid = 0;
                        lp.dstGap = 0;
                        if (!TA) {
                            lp.ifTranspose = false;
                            if (bkk == 1) {
                                lp.repeatTimes = (uint8_t)bm;
                                lp.srcStride = 1;
                                LoadData(l0a, l1a, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = (uint8_t)bm;
                                for (int32_t i = 0; i < bm; ++i) {
                                    LoadData(l0a[i * bkk * 256], l1a[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = true;
                            lp.repeatTimes = (uint8_t)(bm * bkk);
                            lp.srcStride = 1;
                            LoadData(l0a, l1a, lp);
                        }
                        if (!TB) {
                            lp.ifTranspose = true;
                            if (bn == 1) {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = 1;
                                LoadData(l0b, l1b, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bn;
                                lp.srcStride = (uint8_t)bkk;
                                for (int32_t i = 0; i < bkk; ++i) {
                                    LoadData(l0b[i * bn * 256], l1b[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = false;
                            lp.repeatTimes = (uint8_t)(bn * bkk);
                            lp.srcStride = 1;
                            LoadData(l0b, l1b, lp);
                        }
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);   // L1 reusable
                        l1Busy = true;
                        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        // ---- Mmad ----
                        MmadParams mmp;
                        mmp.m = (uint16_t)cm16;
                        mmp.n = (uint16_t)cn16;
                        mmp.k = (uint16_t)kk16;
                        mmp.isBias = false;
                        mmp.cmatrixSource = false;
                        mmp.cmatrixInitVal = (k0 == 0);
                        mmp.unitFlag = 0;
                        Mmad(l0c, l0a, l0b, mmp);
                        SetFlag<HardEvent::M_MTE1>(EVENT_ID3);      // L0 reusable
                        l0Busy = true;
                    }
                    SetFlag<HardEvent::M_FIX>(EVENT_ID0);           // L0C ready
                    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                    FixpipeParamsV220 fp;
                    fp.nSize = (uint16_t)cn16;
                    fp.mSize = (uint16_t)cm16;
                    fp.srcStride = (uint16_t)cm16;
                    fp.dstStride = (uint32_t)tileN;
                    fp.reluEn = false;
                    fp.ndNum = 1;
                    fp.srcNdStride = 0;
                    fp.dstNdStride = 0;
                    Fixpipe(sg[coreOffset + (int64_t)slot * tileM * tileN], l0c, fp);
                    SetFlag<HardEvent::FIX_M>(EVENT_ID0);
                    fixBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
            }
            CrossCoreWaitFlag(10);
            if (end - begin > 1) CrossCoreWaitFlag(15);
        }
        if (useManual) {
            if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
            if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }

    }
    if ASCEND_IS_AIV {
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t vrows = (tileM + 7) / 8 * 8;
        const int32_t sumRows = (m + 7) / 8 * 8;
        const int32_t stageBytes = tileM * cN * 4;
        LocalTensor<float> x(TPosition::VECIN, 0, tileM * cN);
        LocalTensor<float> running(TPosition::VECCALC, stageBytes, vrows);
        LocalTensor<float> rbuf(TPosition::VECCALC, stageBytes + vrows * 4, vrows);
        LocalTensor<float> sumTemp(TPosition::VECCALC, stageBytes + vrows * 8, 8192);
        LocalTensor<float> sx(TPosition::VECIN, stageBytes + vrows * 8 + 32768, sumRows);
        LocalTensor<float> acc(TPosition::VECCALC, stageBytes + vrows * 8 + 32768 + sumRows * 4, sumRows);
        bool vectorBusy = false;
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);

        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task;
            constexpr int32_t part = 0;
            constexpr int32_t mi = 0;
            constexpr int32_t begin = 0;
            constexpr int32_t end = 1;
            int32_t cm = m - mi < tileM ? m - mi : tileM;

            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    if (vectorBusy) {
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    if (cN == 128) {
                        Max(x, x, x[64], 64, cm, {1, 1, 1, 16, 16, 16});
                        PipeBarrier<PIPE_V>();
                    }
                    for (int32_t r = 0; r < cm; r += 248) {
                        int32_t rows = cm - r < 248 ? cm - r : 248;
                        WholeReduceMax(rbuf[r], x[r * cN], cN < 64 ? cN : 64,
                            rows, 1, 1, cN / 8, ReduceOrder::ORDER_ONLY_VALUE);
                    }
                    PipeBarrier<PIPE_V>();
                    Max(running, running, rbuf, cm);
                    vectorBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
            }
            if (mt == 1 && ns == 1) {
                if (cm <= 64) WholeReduceSum(rbuf, running, cm, 1, 1, 1, 8);
                else bmms_sum(rbuf, running, sumTemp, cm);
                PipeBarrier<PIPE_V>();
                Adds(running, rbuf, 0.0f, 8);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        if (mt == 1 && ns == 1) { PipeBarrier<PIPE_ALL>(); return; }
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();


        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {

            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sx, mg[((int64_t)batch * ns + part) * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if (ns == 1) bmms_sum(rbuf, sx, sumTemp, m);
                else Max(acc, acc, sx, m);

            }
            auto out = running;
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else bmms_sum(out, acc, sumTemp, m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        PipeBarrier<PIPE_ALL>();
    }
}


template<class T, bool TA, bool TB, int TM = 0, int TN = 0, int TK = 0>
__global__ __aicore__ __mix__(1, 1) void bmms_manual(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns,
    int32_t dynamicM, int32_t dynamicN)
{
    constexpr bool useManual = true;
    const int32_t tileM = TM ? TM : dynamicM;
    const int32_t tileN = TN ? TN : dynamicN;
    if (TK) k = TK;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;

    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        // Hand-rolled cube path (no Matmul-library scheduler) for small problems, where the
        // library's per-task scalar/icache cost dominates the actual MAC time.
        const int32_t mp = tileM, np = tileN;
        int32_t bk = (32768 / (mp > np ? mp : np)) / 16 * 16;
        if (bk > k) bk = k;
        LocalTensor<T> l1a(TPosition::A1, 0, mp * bk);
        LocalTensor<T> l1b(TPosition::B1, mp * bk * 2, np * bk);
        LocalTensor<T> l0a(TPosition::A2, 0, mp * bk);
        LocalTensor<T> l0b(TPosition::B2, 0, np * bk);
        LocalTensor<float> l0c(TPosition::CO1, 0, mp * np);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                if (t - begin >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                if (useManual) {
                    const int32_t cm16 = (cm + 15) / 16 * 16;
                    const int32_t cn16 = (cn + 15) / 16 * 16;
                    const int64_t aBase = (int64_t)batch * m * k + (TA ? (int64_t)mi : (int64_t)mi * k);
                    const int64_t bBase = (int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni);
                    for (int32_t k0 = 0; k0 < k; k0 += bk) {
                        int32_t kk = (k0 + bk <= k) ? bk : (k - k0);
                        int32_t kk16 = (kk + 15) / 16 * 16;
                        // Close the pipe hazards left by the previous chunk/tile before rewriting L1/L0.
                        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                        if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                        // ---- GM(ND) -> L1(NZ) ----
                        Nd2NzParams pa;
                        pa.ndNum = 1;
                        pa.dstNzNStride = 1;
                        pa.dstNzMatrixStride = 0;
                        pa.srcNdMatrixStride = 1;
                        int64_t aOff = aBase;
                        if (!TA) {
                            pa.nValue = (uint16_t)cm; pa.dValue = (uint16_t)kk;
                            pa.srcDValue = (uint16_t)k; pa.dstNzC0Stride = (uint16_t)cm16;
                            aOff += k0;
                        } else {
                            pa.nValue = (uint16_t)kk; pa.dValue = (uint16_t)cm;
                            pa.srcDValue = (uint16_t)m; pa.dstNzC0Stride = (uint16_t)kk16;
                            aOff += (int64_t)k0 * m;
                        }
                        Nd2NzParams pb;
                        pb.ndNum = 1;
                        pb.dstNzNStride = 1;
                        pb.dstNzMatrixStride = 0;
                        pb.srcNdMatrixStride = 1;
                        pb.dstNzC0Stride = (uint16_t)(TB ? cn16 : kk16);
                        int64_t bOff = bBase;
                        if (!TB) {
                            pb.nValue = (uint16_t)kk; pb.dValue = (uint16_t)cn;
                            pb.srcDValue = (uint16_t)n;
                            bOff += (int64_t)k0 * n;
                        } else {
                            pb.nValue = (uint16_t)cn; pb.dValue = (uint16_t)kk;
                            pb.srcDValue = (uint16_t)k;
                            bOff += k0;
                        }
                        DataCopy(l1a, ag[aOff], pa);
                        DataCopy(l1b, bg[bOff], pb);
                        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        // ---- L1 -> L0A / L0B ----
                        const int32_t bm = cm16 / 16;
                        const int32_t bn = cn16 / 16;
                        const int32_t bkk = kk16 / 16;
                        LoadData2dParams lp;
                        lp.startIndex = 0;
                        lp.sid = 0;
                        lp.dstGap = 0;
                        if (!TA) {
                            lp.ifTranspose = false;
                            if (bkk == 1) {
                                lp.repeatTimes = (uint8_t)bm;
                                lp.srcStride = 1;
                                LoadData(l0a, l1a, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = (uint8_t)bm;
                                for (int32_t i = 0; i < bm; ++i) {
                                    LoadData(l0a[i * bkk * 256], l1a[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = true;
                            lp.repeatTimes = (uint8_t)(bm * bkk);
                            lp.srcStride = 1;
                            LoadData(l0a, l1a, lp);
                        }
                        if (!TB) {
                            lp.ifTranspose = true;
                            if (bn == 1) {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = 1;
                                LoadData(l0b, l1b, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bn;
                                lp.srcStride = (uint8_t)bkk;
                                for (int32_t i = 0; i < bkk; ++i) {
                                    LoadData(l0b[i * bn * 256], l1b[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = false;
                            lp.repeatTimes = (uint8_t)(bn * bkk);
                            lp.srcStride = 1;
                            LoadData(l0b, l1b, lp);
                        }
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);   // L1 reusable
                        l1Busy = true;
                        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        // ---- Mmad ----
                        MmadParams mmp;
                        mmp.m = (uint16_t)cm16;
                        mmp.n = (uint16_t)cn16;
                        mmp.k = (uint16_t)kk16;
                        mmp.isBias = false;
                        mmp.cmatrixSource = false;
                        mmp.cmatrixInitVal = (k0 == 0);
                        mmp.unitFlag = 0;
                        Mmad(l0c, l0a, l0b, mmp);
                        SetFlag<HardEvent::M_MTE1>(EVENT_ID3);      // L0 reusable
                        l0Busy = true;
                    }
                    SetFlag<HardEvent::M_FIX>(EVENT_ID0);           // L0C ready
                    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                    FixpipeParamsV220 fp;
                    fp.nSize = (uint16_t)cn16;
                    fp.mSize = (uint16_t)cm16;
                    fp.srcStride = (uint16_t)cm16;
                    fp.dstStride = (uint32_t)tileN;
                    fp.reluEn = false;
                    fp.ndNum = 1;
                    fp.srcNdStride = 0;
                    fp.dstNdStride = 0;
                    Fixpipe(sg[coreOffset + (int64_t)slot * tileM * tileN], l0c, fp);
                    SetFlag<HardEvent::FIX_M>(EVENT_ID0);
                    fixBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
            }
            CrossCoreWaitFlag(10);
            if (end - begin > 1) CrossCoreWaitFlag(15);
        }
        if (useManual) {
            if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
            if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }

    }
    if ASCEND_IS_AIV {
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t vrows = (tileM + 7) / 8 * 8;
        const int32_t sumRows = (m + 7) / 8 * 8;
        const int32_t stageBytes = tileM * cN * 4;
        LocalTensor<float> x(TPosition::VECIN, 0, tileM * cN);
        LocalTensor<float> running(TPosition::VECCALC, stageBytes, vrows);
        LocalTensor<float> rbuf(TPosition::VECCALC, stageBytes + vrows * 4, vrows);
        LocalTensor<float> sumTemp(TPosition::VECCALC, stageBytes + vrows * 8, 8192);
        LocalTensor<float> sx(TPosition::VECIN, stageBytes + vrows * 8 + 32768, sumRows);
        LocalTensor<float> acc(TPosition::VECCALC, stageBytes + vrows * 8 + 32768 + sumRows * 4, sumRows);
        bool vectorBusy = false;
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);

        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;

            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    if (vectorBusy) {
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    if (cN == 128) {
                        Max(x, x, x[64], 64, cm, {1, 1, 1, 16, 16, 16});
                        PipeBarrier<PIPE_V>();
                    }
                    for (int32_t r = 0; r < cm; r += 248) {
                        int32_t rows = cm - r < 248 ? cm - r : 248;
                        WholeReduceMax(rbuf[r], x[r * cN], cN < 64 ? cN : 64,
                            rows, 1, 1, cN / 8, ReduceOrder::ORDER_ONLY_VALUE);
                    }
                    PipeBarrier<PIPE_V>();
                    Max(running, running, rbuf, cm);
                    vectorBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
            }
            if (mt == 1 && ns == 1) {
                if (cm <= 64) WholeReduceSum(rbuf, running, cm, 1, 1, 1, 8);
                else bmms_sum(rbuf, running, sumTemp, cm);
                PipeBarrier<PIPE_V>();
                Adds(running, rbuf, 0.0f, 8);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        if (mt == 1 && ns == 1) { PipeBarrier<PIPE_ALL>(); return; }
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();


        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            if (ns > 1 && m % 8 == 0 && ns * m <= 8192) {
                DataCopyExtParams cp{1, (uint32_t)(ns * m) * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sumTemp, mg[(int64_t)batch * ns * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                Max(acc, sumTemp, sumTemp[m], m);
                for (int part = 2; part < ns; ++part) {
                    PipeBarrier<PIPE_V>();
                    Max(acc, acc, sumTemp[part * m], m);
                }
                PipeBarrier<PIPE_V>();
                bmms_sum(running, acc, sumTemp, m);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], running, op);
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            } else {

            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sx, mg[((int64_t)batch * ns + part) * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if (ns == 1) bmms_sum(rbuf, sx, sumTemp, m);
                else Max(acc, acc, sx, m);

            }
            auto out = running;
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else bmms_sum(out, acc, sumTemp, m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
}


template<class T, bool TA, bool TB>
__global__ __aicore__ __mix__(1, 1) void bmms_fused(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        MatmulImpl<AT, BT, CT, BiasT, BMMS_MM_CFG> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(m, n, k, k, tileN);
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                mm.SetSingleShape(cm, cn, k);
                mm.SetTensorA(ag[(int64_t)batch * m * k + (TA ? mi : (int64_t)mi * k)], TA);
                mm.SetTensorB(bg[(int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni)], TB);
                mm.IterateAll(sg[coreOffset + (int64_t)slot * tileM * tileN]);
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
        }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input, sumInput;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced, rowMax;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        pipe.InitBuffer(input, 1, tileM * cN * 4);
        pipe.InitBuffer(sumInput, 1, (m + 7) / 8 * 32);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        pipe.InitBuffer(rowMax, (m + 7) / 8 * 32);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto acc = rowMax.Get<float>();
            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                auto x = sumInput.AllocTensor<float>();
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(x, mg[((int64_t)batch * ns + part) * m], cp, pad);
                sumInput.EnQue(x); x = sumInput.DeQue<float>();
                if (ns == 1) ReduceSum(rbuf, x, sumTemp, m);
                else Max(acc, acc, x, m);
                sumInput.FreeTensor(x);
            }
            auto out = output.AllocTensor<float>();
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else ReduceSum(out, acc, sumTemp, m);
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
        }
    }
}

template<class T, int KK = 0, bool ONCE = false>
__global__ __aicore__ __vector__ void bmms_dot(GM_ADDR a, GM_ADDR b, GM_ADDR y, int32_t batches, int32_t k)
{
    if (KK) k = KK;
    int32_t ak = (k + 15) / 16 * 16;
    LocalTensor<T> al(TPosition::VECIN, 0, ak), bl(TPosition::VECIN, ak * 2, ak);
    LocalTensor<float> af(TPosition::VECCALC, ak * 4, ak), bf(TPosition::VECCALC, ak * 8, ak);
    LocalTensor<float> tmp(TPosition::VECCALC, ak * 12, 128);
    LocalTensor<float> out(TPosition::VECOUT, ak * 12 + 512, 8);
    GlobalTensor<T> ag, bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b); yg.SetGlobalBuffer((__gm__ float*)y);
    int32_t batch = GetBlockIdx();
    do {
        DataCopyExtParams cp{1, (uint32_t)k * 2, 0, 0, 0};
        DataCopyPadExtParams<T> pad{false, 0, 0, (T)0};
        DataCopyPad(al, ag[(int64_t)batch * k], cp, pad);
        DataCopyPad(bl, bg[(int64_t)batch * k], cp, pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af, al, RoundMode::CAST_NONE, k); Cast(bf, bl, RoundMode::CAST_NONE, k);
        PipeBarrier<PIPE_V>();
        Mul(af, af, bf, k);
        PipeBarrier<PIPE_V>();
        bmms_sum(out, af, tmp, k);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], out, op);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0); WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        batch += GetBlockNum();
    } while (!ONCE && batch < batches);
    PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void bmms_transpose_index(const LocalTensor<int32_t>& ix,
    const LocalTensor<int32_t>& group, const LocalTensor<int32_t>& tmp,
    int32_t count, int32_t logRows, int32_t logCols)
{
    #pragma unroll
    for (int32_t j = 0; j < 8; ++j) ix.SetValue(j, j);
    SetFlag<HardEvent::S_V>(EVENT_ID0); WaitFlag<HardEvent::S_V>(EVENT_ID0);
    for (int32_t len = 8; len < count; len *= 2) {
        Adds(ix[len], ix, len, len);
        PipeBarrier<PIPE_V>();
    }
    PipeBarrier<PIPE_V>();
    ShiftRight(group, ix, logCols, count);
    PipeBarrier<PIPE_V>();
    ShiftLeft(tmp, group, logCols, count);
    PipeBarrier<PIPE_V>();
    Sub(ix, ix, tmp, count);
    PipeBarrier<PIPE_V>();
    ShiftLeft(ix, ix, logRows, count);
    PipeBarrier<PIPE_V>();
    Add(ix, ix, group, count);
    PipeBarrier<PIPE_V>();
    ShiftLeft(ix, ix, int32_t(2), count);
    PipeBarrier<PIPE_V>();
}

template<class T, bool TA, bool TB, int MN, int KK>
__global__ __aicore__ __vector__ void bmms_tiny(GM_ADDR a, GM_ADDR b, GM_ADDR y, int32_t batches)
{
    constexpr int sz = MN * KK;
    constexpr int lm = MN == 8 ? 3 : 4;
    constexpr int lk = KK == 32 ? 5 : 6;
    LocalTensor<T> ar(TPosition::VECIN, 0, sz), br(TPosition::VECIN, sz * 2, sz);
    LocalTensor<float> av(TPosition::VECCALC, sz * 4, sz), bv(TPosition::VECCALC, sz * 8, sz);
    LocalTensor<float> af(TPosition::VECCALC, sz * 12, sz), bf(TPosition::VECCALC, sz * 16, sz);
    LocalTensor<int32_t> ix(TPosition::VECCALC, sz * 20, sz), group(TPosition::VECCALC, sz * 24, sz);
    LocalTensor<int32_t> itmp(TPosition::VECCALC, sz * 28, sz);
    LocalTensor<float> broad(TPosition::VECCALC, sz * 32, sz), prod(TPosition::VECCALC, sz * 36, sz);
    LocalTensor<float> maxima(TPosition::VECOUT, sz * 40, MN * 8);
    GlobalTensor<T> ag, bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b); yg.SetGlobalBuffer((__gm__ float*)y);
    for (int batch = GetBlockIdx(); batch < batches; batch += GetBlockNum()) {
        DataCopy(ar, ag[batch * sz], sz); DataCopy(br, bg[batch * sz], sz);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(av, ar, RoundMode::CAST_NONE, sz); Cast(bv, br, RoundMode::CAST_NONE, sz);
        PipeBarrier<PIPE_V>();
        if (TA) {
            bmms_transpose_index(ix, group, itmp, sz, lm, lk);
            Gather(af, av, ix.ReinterpretCast<uint32_t>(), 0, sz);
        } else af = av;
        if (TB) {
            bmms_transpose_index(ix, group, itmp, sz, lk, lm);
            Gather(bf, bv, ix.ReinterpretCast<uint32_t>(), 0, sz);
        } else bf = bv;
        PipeBarrier<PIPE_V>();
        #pragma unroll
        for (int row = 0; row < MN; ++row) {
            Brcb(broad, af[row * KK], KK / 8, {MN / 8, MN});
            if (MN == 16) Brcb(broad[8], af[row * KK], KK / 8, {2, 16});
            PipeBarrier<PIPE_V>();
            Mul(prod, broad, bf, sz);
            PipeBarrier<PIPE_V>();
            #pragma unroll
            for (int rows = KK / 2; rows > 0; rows /= 2) {
                Add(prod, prod, prod[rows * MN], rows * MN);
                PipeBarrier<PIPE_V>();
            }
            WholeReduceMax(maxima[row * 8], prod, MN, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
        }
        #pragma unroll
        for (int rows = MN / 2; rows > 0; rows /= 2) {
            Add(maxima, maxima, maxima[rows * 8], rows * 8);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], maxima, op);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0); WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}


template<class T, bool TA, bool TB, int KP>
__global__ __aicore__ __vector__ void bmms_micro(GM_ADDR a, GM_ADDR b, GM_ADDR y,
    int32_t batches, int32_t m, int32_t n, int32_t k)
{
    constexpr int elems = 16 * KP, bytes = elems * 4;
    constexpr int lk = KP == 16 ? 4 : KP == 32 ? 5 : KP == 64 ? 6 : 7;
    LocalTensor<T> ar(TPosition::VECIN, 0, elems), br(TPosition::VECIN, bytes / 2, elems);
    LocalTensor<float> af(TPosition::VECCALC, bytes, elems), bf(TPosition::VECCALC, 2 * bytes, elems);
    LocalTensor<float> bp(TPosition::VECCALC, 3 * bytes, elems), prod(TPosition::VECCALC, 4 * bytes, elems);
    LocalTensor<float> broad(TPosition::VECCALC, 5 * bytes, elems);
    LocalTensor<int32_t> ix(TPosition::VECCALC, 6 * bytes, elems), group(TPosition::VECCALC, 7 * bytes, elems);
    LocalTensor<int32_t> tmp(TPosition::VECCALC, 8 * bytes, elems);
    LocalTensor<float> arow(TPosition::VECCALC, 9 * bytes, KP);
    LocalTensor<int32_t> aix(TPosition::VECCALC, 9 * bytes + KP * 4, KP);
    LocalTensor<float> maxima(TPosition::VECOUT, 10 * bytes, 64);
    GlobalTensor<T> ag, bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b); yg.SetGlobalBuffer((__gm__ float*)y);
    if (TA || m > 1) {
        #pragma unroll
        for (int j = 0; j < 8; ++j) aix.SetValue(j, j);
        SetFlag<HardEvent::S_V>(EVENT_ID0); WaitFlag<HardEvent::S_V>(EVENT_ID0);
        #pragma unroll
        for (int len = 8; len < KP; len *= 2) {
            Adds(aix[len], aix, len, len); PipeBarrier<PIPE_V>();
        }
        ShiftLeft(aix, aix, int32_t(6), KP); PipeBarrier<PIPE_V>();
    }
    for (int batch = GetBlockIdx(); batch < batches; batch += GetBlockNum()) {
        Duplicate(ar, (T)0, elems); Duplicate(br, (T)0, elems);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0); WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyExtParams ac{(uint16_t)(TA ? k : m), (uint32_t)(TA ? m : k) * 2,
            0, (uint32_t)(TA ? 0 : (KP - ((k + 15) / 16 * 16)) / 16), 0};
        DataCopyExtParams bc{(uint16_t)(TB ? n : k), (uint32_t)(TB ? k : n) * 2,
            0, (uint32_t)(TB ? (KP - ((k + 15) / 16 * 16)) / 16 : 0), 0};
        DataCopyPadExtParams<T> ap{true, 0, (uint8_t)((16 - (TA ? m : k) % 16) % 16), (T)0};
        DataCopyPadExtParams<T> bpads{true, 0, (uint8_t)((16 - (TB ? k : n) % 16) % 16), (T)0};
        DataCopyPad(ar, ag[(int64_t)batch * m * k], ac, ap);
        DataCopyPad(br, bg[(int64_t)batch * n * k], bc, bpads);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af, ar, RoundMode::CAST_NONE, elems); Cast(bf, br, RoundMode::CAST_NONE, elems);
        PipeBarrier<PIPE_V>();
        if (TB) {
            bmms_transpose_index(ix, group, tmp, elems, lk, 4);
            Gather(bp, bf, ix.ReinterpretCast<uint32_t>(), 0, elems);
            PipeBarrier<PIPE_V>();
        } else bp = bf;
        for (int row = 0; row < m; ++row) {
            if (TA) {
                Gather(arow, af, aix.ReinterpretCast<uint32_t>(), row * 4, KP);
                PipeBarrier<PIPE_V>();
            } else arow = af[row * KP];
            Brcb(broad, arow, KP / 8, {2, 16});
            Brcb(broad[8], arow, KP / 8, {2, 16});
            PipeBarrier<PIPE_V>();
            Mul(prod, broad, bp, elems); PipeBarrier<PIPE_V>();
            #pragma unroll
            for (int half = KP / 2; half > 0; half /= 2) {
                Add(prod, prod, prod[half * 16], half * 16); PipeBarrier<PIPE_V>();
            }
            WholeReduceMax(maxima[row * 8], prod, n, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
        }
        if (m > 1) {
            ShiftRight(ix, aix, int32_t(1), KP); PipeBarrier<PIPE_V>();
            LocalTensor<float> sumInput(TPosition::VECCALC, 9 * bytes, KP);
            Gather(sumInput, maxima, ix.ReinterpretCast<uint32_t>(), 0, m);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(maxima, sumInput, m, 1, 1, 1, 8);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], maxima, op);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

// Short M/N, long K: parallel dot-product segments, then combine matrices before MaxSim.
template<class T, bool TA, bool TB>
__global__ __aicore__ __mix__(1, 1) void bmms_split64(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR partialSums, GM_ADDR y, int32_t batches, int32_t k, int32_t parts)
{
    constexpr int M = 64, N = 64, BK = 512, ROWS = 16, ROW_TILES = M / ROWS;
    const int core = GetBlockIdx();
    GlobalTensor<float> sg, pg, yg;
    sg.SetGlobalBuffer((__gm__ float*)scratch);
    pg.SetGlobalBuffer((__gm__ float*)partialSums);
    yg.SetGlobalBuffer((__gm__ float*)y);
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<T> la(TPosition::A1, 0, M * BK), lb(TPosition::B1, M * BK * 2, N * BK);
        LocalTensor<T> aa(TPosition::A2, 0, M * BK), bb(TPosition::B2, 0, N * BK);
        LocalTensor<float> cc(TPosition::CO1, 0, M * N);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int task = core; task < batches * parts; task += GetBlockNum()) {
            const int batch = task / parts, part = task % parts;
            const int begin = (k / 16 * part / parts) * 16;
            const int end = (k / 16 * (part + 1) / parts) * 16;
            for (int pos = begin; pos < end; pos += BK) {
                const int kk = end - pos < BK ? end - pos : BK;
                if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                Nd2NzParams pa{1, (uint16_t)(TA ? kk : M), (uint16_t)(TA ? M : kk), 0,
                    (uint16_t)(TA ? M : k), (uint16_t)(TA ? kk : M), 1, 0};
                Nd2NzParams pb{1, (uint16_t)(TB ? N : kk), (uint16_t)(TB ? kk : N), 0,
                    (uint16_t)(TB ? k : N), (uint16_t)(TB ? N : kk), 1, 0};
                const int64_t ao = (int64_t)batch * M * k + (TA ? (int64_t)pos * M : pos);
                const int64_t bo = (int64_t)batch * N * k + (TB ? pos : (int64_t)pos * N);
                DataCopy(la, ag[ao], pa); DataCopy(lb, bg[bo], pb);
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0); WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                LoadData2dParams ap{0, (uint8_t)(kk / 16), TA ? 1 : M / 16, 0, 0, TA, 0};
                if (TA) { ap.repeatTimes = M * kk / 256; LoadData(aa, la, ap); }
                else {
                    #pragma unroll
                    for (int i = 0; i < M / 16; ++i) LoadData(aa[i * kk * 16], la[i * 256], ap);
                }
                LoadData2dParams bp{0, N / 16, (uint16_t)(TB ? 1 : kk / 16), 0, 0, !TB, 0};
                if (TB) { bp.repeatTimes = N * kk / 256; LoadData(bb, lb, bp); }
                else {
                    for (int i = 0; i < kk / 16; ++i) LoadData(bb[i * N * 16], lb[i * 256], bp);
                }
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0); l1Busy = true;
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0); WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                MmadParams mm{M, N, (uint16_t)kk, 0, false, pos == begin};
                Mmad(cc, aa, bb, mm);
                SetFlag<HardEvent::M_MTE1>(EVENT_ID3); l0Busy = true;
            }
            SetFlag<HardEvent::M_FIX>(EVENT_ID0); WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
            FixpipeParamsV220 fp;
            fp.mSize = M; fp.nSize = N; fp.srcStride = M; fp.dstStride = N;
            Fixpipe(sg[(int64_t)task * M * N], cc, fp);
            SetFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = true;
        }
        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
        if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
    }
    if ASCEND_IS_AIV {
        // At most 16 parts: 64 KiB staging, 64 B row maxima, 32 B output.
        LocalTensor<float> vx(TPosition::VECIN, 0, 16 * ROWS * N);
        LocalTensor<float> rm(TPosition::VECCALC, 16 * ROWS * N * 4, 32);
        LocalTensor<float> out(TPosition::VECOUT, 16 * ROWS * N * 4 + 128, 32);
        CrossCoreWaitFlag(8);
        SyncAll<true>();
        for (int task = core; task < batches * ROW_TILES; task += GetBlockNum()) {
            const int batch = task / ROW_TILES, row = (task % ROW_TILES) * ROWS;
            DataCopyExtParams cp{(uint16_t)parts, ROWS * N * 4, (M - ROWS) * N * 4, 0, 0};
            DataCopyPadExtParams<float> pad{false, 0, 0, 0};
            DataCopyPad(vx, sg[(int64_t)batch * parts * M * N + row * N], cp, pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            for (int count = parts; count > 1; count = (count + 1) / 2) {
                const int half = (count + 1) / 2;
                Add(vx, vx, vx[half * ROWS * N], (count - half) * ROWS * N);
                PipeBarrier<PIPE_V>();
            }
            WholeReduceMax(rm, vx, N, ROWS, 1, 1, N / 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(out, rm, ROWS, 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(pg[task], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();
        for (int batch = core; batch < batches; batch += GetBlockNum()) {
            DataCopyExtParams cp{1, ROW_TILES * 4, 0, 0, 0};
            DataCopyPadExtParams<float> pad{false, 0, 0, 0};
            DataCopyPad(rm, pg[batch * ROW_TILES], cp, pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WholeReduceSum(out, rm, ROW_TILES, 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

// One Cube/Vector pair per batch for matrices that fit in a single L0 tile.
template<class T, bool TA, bool TB, int MP, int NP, int MC = 0, int NC = 0, int KC = 0>
__global__ __aicore__ __mix__(1, 1) void bmms_direct(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR y, int32_t m, int32_t n, int32_t k)
{
    if (MC) m = MC; if (NC) n = NC; if (KC) k = KC;
    const int core = GetBlockIdx();
    GlobalTensor<float> sg; sg.SetGlobalBuffer((__gm__ float*)scratch);
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<T> la(TPosition::A1, 0, MP * 256), lb(TPosition::B1, MP * 256 * 2, NP * 256);
        LocalTensor<T> aa(TPosition::A2, 0, MP * 256), bb(TPosition::B2, 0, NP * 256);
        LocalTensor<float> cc(TPosition::CO1, 0, MP * NP);
        Nd2NzParams pa{1, (uint16_t)(TA ? k : m), (uint16_t)(TA ? m : k), 0,
            (uint16_t)(TA ? m : k), (uint16_t)(TA ? k : MP), 1, 0};
        Nd2NzParams pb{1, (uint16_t)(TB ? n : k), (uint16_t)(TB ? k : n), 0,
            (uint16_t)(TB ? k : n), (uint16_t)(TB ? NP : k), 1, 0};
        DataCopy(la, ag[(int64_t)core * m * k], pa);
        DataCopy(lb, bg[(int64_t)core * n * k], pb);
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0); WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        LoadData2dParams ap{0, (uint8_t)(k / 16), TA ? 1 : MP / 16, 0, 0, TA, 0};
        if (TA) { ap.repeatTimes = MP * k / 256; LoadData(aa, la, ap); }
        else {
            #pragma unroll
            for (int i = 0; i < MP / 16; ++i) LoadData(aa[i * k * 16], la[i * 256], ap);
        }
        LoadData2dParams bp{0, NP / 16, (uint16_t)(TB ? 1 : k / 16), 0, 0, !TB, 0};
        if (TB) { bp.repeatTimes = NP * k / 256; LoadData(bb, lb, bp); }
        else if (NP / 16 < k / 16) {
            bp.repeatTimes = k / 16; bp.srcStride = 1; bp.dstGap = NP / 16 - 1;
            #pragma unroll
            for (int j = 0; j < NP / 16; ++j) LoadData(bb[j * 256], lb[j * k * 16], bp);
        } else {
            for (int i = 0; i < k / 16; ++i) LoadData(bb[i * NP * 16], lb[i * 256], bp);
        }
        SetFlag<HardEvent::MTE1_M>(EVENT_ID0); WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
        MmadParams mm{MP, NP, (uint16_t)k, 0, false, true}; Mmad(cc, aa, bb, mm);
        SetFlag<HardEvent::M_FIX>(EVENT_ID0); WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
        FixpipeParamsV220 fp;
        fp.mSize = MP; fp.nSize = NP; fp.srcStride = MP; fp.dstStride = NP;
        Fixpipe(sg[(int64_t)core * MP * NP], cc, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
    }
    if ASCEND_IS_AIV {
        LocalTensor<float> vx(TPosition::VECIN, 0, MP * NP);
        LocalTensor<float> rm(TPosition::VECCALC, MP * NP * 4, MP);
        LocalTensor<float> out(TPosition::VECOUT, MP * NP * 4 + MP * 4, 8);
        GlobalTensor<float> yg; yg.SetGlobalBuffer((__gm__ float*)y);
        CrossCoreWaitFlag(8);
        if (n == NP) DataCopy(vx, sg[(int64_t)core * MP * NP], MP * NP);
        else {
            Duplicate(vx, -3.402823466e+38f, MP * NP);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0); WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            DataCopyExtParams cp{(uint16_t)m, (uint32_t)n * 4, (uint32_t)(NP - n) * 4,
                (uint32_t)(NP - (n + 7) / 8 * 8) / 8, 0};
            DataCopyPadExtParams<float> pad{true, 0, (uint8_t)((8 - n % 8) % 8), -3.402823466e+38f};
            DataCopyPad(vx, sg[(int64_t)core * MP * NP], cp, pad);
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if (NP == 128) {
            Max(vx, vx, vx[64], 64, m, {1, 1, 1, 16, 16, 16}); PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(rm, vx, NP < 64 ? NP : 64, m, 1, 1, NP / 8, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(out, rm, m, 1, 1, 1, 8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams cp{1, 4, 0, 0, 0}; DataCopyPad(yg[core], out, cp);
    }
    PipeBarrier<PIPE_ALL>();
}

// Vector dot products with K contiguous: one whole reduction per output column.
template<class T, bool TA, bool TB, int MP, int NP, int KP, int MC = 0, int NC = 0, int KC = 0>
__global__ __aicore__ __vector__ void bmms_vdots(GM_ADDR a, GM_ADDR b, GM_ADDR y,
    int32_t batches, int32_t m, int32_t n, int32_t k)
{
    if (MC) m = MC; if (NC) n = NC; if (KC) k = KC;
    constexpr int AE = MP * KP, BE = NP * KP;
    constexpr int AF = (AE + BE) * 2, BF = AF + AE * 4, AT = BF + BE * 4;
    constexpr int BT = AT + AE * 4, IX = BT + BE * 4, GR = IX + BE * 4;
    constexpr int TMP = GR + BE * 4, PROD = TMP + BE * 4;
    constexpr int DOT = PROD + BE * 4, ROW = DOT + NP * 4, OUT = ROW + MP * 4;
    constexpr int LM = MP == 16 ? 4 : 5, LN = NP == 16 ? 4 : 5;
    constexpr int LK = KP == 64 ? 6 : 7;
    LocalTensor<T> ar(TPosition::VECIN, 0, AE), br(TPosition::VECIN, AE * 2, BE);
    LocalTensor<float> af(TPosition::VECCALC, AF, AE), bf(TPosition::VECCALC, BF, BE);
    LocalTensor<float> at(TPosition::VECCALC, AT, AE), bt(TPosition::VECCALC, BT, BE);
    LocalTensor<int32_t> ix(TPosition::VECCALC, IX, BE), group(TPosition::VECCALC, GR, BE);
    LocalTensor<int32_t> tmp(TPosition::VECCALC, TMP, BE);
    LocalTensor<float> prod(TPosition::VECCALC, PROD, BE), dots(TPosition::VECCALC, DOT, NP);
    LocalTensor<float> maxima(TPosition::VECCALC, ROW, MP), out(TPosition::VECOUT, OUT, 8);
    GlobalTensor<T> ag, bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b); yg.SetGlobalBuffer((__gm__ float*)y);
    for (int batch = GetBlockIdx(); batch < batches; batch += GetBlockNum()) {
        Duplicate(ar, (T)0, AE); Duplicate(br, (T)0, BE);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0); WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyExtParams ac{(uint16_t)(TA ? k : m), (uint32_t)(TA ? m : k) * 2, 0,
            (uint32_t)((TA ? MP - (m + 15) / 16 * 16 : KP - (k + 15) / 16 * 16) / 16), 0};
        DataCopyExtParams bc{(uint16_t)(TB ? n : k), (uint32_t)(TB ? k : n) * 2, 0,
            (uint32_t)((TB ? KP - (k + 15) / 16 * 16 : NP - (n + 15) / 16 * 16) / 16), 0};
        DataCopyPadExtParams<T> ap{true, 0, (uint8_t)((16 - (TA ? m : k) % 16) % 16), (T)0};
        DataCopyPadExtParams<T> bp{true, 0, (uint8_t)((16 - (TB ? k : n) % 16) % 16), (T)0};
        DataCopyPad(ar, ag[(int64_t)batch * m * k], ac, ap);
        DataCopyPad(br, bg[(int64_t)batch * n * k], bc, bp);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af, ar, RoundMode::CAST_NONE, AE); Cast(bf, br, RoundMode::CAST_NONE, BE);
        PipeBarrier<PIPE_V>();
        if (TA) {
            bmms_transpose_index(ix, group, tmp, AE, LM, LK);
            Gather(at, af, ix.ReinterpretCast<uint32_t>(), 0, AE); PipeBarrier<PIPE_V>();
        } else at = af;
        if (!TB) {
            bmms_transpose_index(ix, group, tmp, BE, LN, LK);
            Gather(bt, bf, ix.ReinterpretCast<uint32_t>(), 0, BE); PipeBarrier<PIPE_V>();
        } else bt = bf;
        #pragma unroll
        for (int row = 0; row < m; ++row) {
            Mul(prod, bt, at[row * KP], 64, n, {1, 1, 1, KP / 8, KP / 8, 0});
            if (KP == 128) {
                Mul(prod[64], bt[64], at[row * KP + 64], 64, n, {1, 1, 1, KP / 8, KP / 8, 0});
                PipeBarrier<PIPE_V>();
                Add(prod, prod, prod[64], 64, n, {1, 1, 1, KP / 8, KP / 8, KP / 8});
            }
            PipeBarrier<PIPE_V>();
            WholeReduceSum(dots, prod, 64, n, 1, 1, KP / 8); PipeBarrier<PIPE_V>();
            WholeReduceMax(maxima[row], dots, n, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
        }
        WholeReduceSum(out, maxima, m, 1, 1, 1, 8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], out, op);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    int32_t b = info_x1.tensors[0].shape[0];
    int32_t m = info_x1.tensors[0].shape[transposeX1 ? 2 : 1];
    int32_t k = info_x1.tensors[0].shape[transposeX1 ? 1 : 2];
    int32_t n = info_x2.tensors[0].shape[transposeX2 ? 1 : 2];

    if (m == 64 && n == 64 && k >= 2048 && k % 16 == 0 && b <= 4) {
        int32_t parts = std::min<int32_t>(8, k / 512);
        int32_t cores = std::max<int32_t>(1, std::min<int64_t>(availableCoreNum, b * parts));
        struct SplitSpace { aclrtStream stream; int32_t device; void* ptr; size_t bytes; };
        static thread_local std::vector<SplitSpace> splitSpaces;
        int32_t device = 0; aclrtGetDevice(&device);
        SplitSpace* ws = nullptr;
        for (auto& item : splitSpaces) if (item.stream == stream && item.device == device) ws = &item;
        if (!ws) { splitSpaces.push_back({stream, device, nullptr, 0}); ws = &splitSpaces.back(); }
        size_t matrixBytes = (size_t)b * parts * 64 * 64 * 4;
        size_t bytes = matrixBytes + 512;
        if (bytes > ws->bytes) {
            if (ws->ptr) { aclrtSynchronizeStream(stream); aclrtFree(ws->ptr); ws->ptr = nullptr; ws->bytes = 0; }
            if (aclrtMalloc(&ws->ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
            ws->bytes = bytes;
        }
        auto matrix = (GM_ADDR)ws->ptr;
        auto partial = matrix + matrixBytes;
#define BMMS_SPLIT(T, A, B) bmms_split64<T, A, B><<<cores, nullptr, stream>>>(x1, x2, matrix, partial, y, b, k, parts)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_SPLIT(bfloat16_t, true, true); } else { BMMS_SPLIT(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_SPLIT(bfloat16_t, false, true); } else { BMMS_SPLIT(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_SPLIT(half, true, true); } else { BMMS_SPLIT(half, true, false); } }
            else { if (transposeX2) { BMMS_SPLIT(half, false, true); } else { BMMS_SPLIT(half, false, false); } }
        }
#undef BMMS_SPLIT
        return;
    }

    if (m == 8 && n == 8 && (transposeX1 || !transposeX2) && (k == 32 || k == 64)) {
        int32_t vc = std::max<int32_t>(1, std::min<int64_t>(b, availableCoreNum * 2));
#define BMMS_TINY(T, A, B) do { \
    if (k == 32) bmms_tiny<T, A, B, 8, 32><<<vc, nullptr, stream>>>(x1, x2, y, b); \
    else bmms_tiny<T, A, B, 8, 64><<<vc, nullptr, stream>>>(x1, x2, y, b); \
} while (0)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_TINY(bfloat16_t, true, true); } else { BMMS_TINY(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_TINY(bfloat16_t, false, true); } else { BMMS_TINY(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_TINY(half, true, true); } else { BMMS_TINY(half, true, false); } }
            else { if (transposeX2) { BMMS_TINY(half, false, true); } else { BMMS_TINY(half, false, false); } }
        }
#undef BMMS_TINY
        return;
    }
    if (m == 1 && n == 1) {
        int32_t vc = std::max<int32_t>(1, std::min<int64_t>(b, availableCoreNum * 2));
        if (k == 32 && vc == b) {
            if (info_x1.tensors[0].dtype == 2) bmms_dot<bfloat16_t, 32, true><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
            else bmms_dot<half, 32, true><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
        } else {
            if (info_x1.tensors[0].dtype == 2) bmms_dot<bfloat16_t><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
            else bmms_dot<half><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
        }
        return;
    }

    if (m <= 16 && n <= 32 && k <= 128 && b <= 2 * availableCoreNum) {
        int32_t vc = std::max<int32_t>(1, std::min<int64_t>(b, availableCoreNum * 2));
#define BMMS_VD(T, A, B) do { \
    if (m == 3 && n == 5 && k == 40) bmms_vdots<T, A, B, 16, 16, 64, 3, 5, 40><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (m == 7 && n == 13 && k == 48) bmms_vdots<T, A, B, 16, 16, 64, 7, 13, 48><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (m == 8 && n == 16 && k == 128) bmms_vdots<T, A, B, 16, 16, 128, 8, 16, 128><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (m == 16 && n == 32 && k == 128) bmms_vdots<T, A, B, 16, 32, 128, 16, 32, 128><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (n <= 16 && k <= 64) bmms_vdots<T, A, B, 16, 16, 64><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (n <= 16) bmms_vdots<T, A, B, 16, 16, 128><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (k <= 64) bmms_vdots<T, A, B, 16, 32, 64><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else bmms_vdots<T, A, B, 16, 32, 128><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
} while (0)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_VD(bfloat16_t, true, true); } else { BMMS_VD(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_VD(bfloat16_t, false, true); } else { BMMS_VD(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_VD(half, true, true); } else { BMMS_VD(half, true, false); } }
            else { if (transposeX2) { BMMS_VD(half, false, true); } else { BMMS_VD(half, false, false); } }
        }
#undef BMMS_VD
        return;
    }

    if (m <= 32 && n <= 128 && m * n > 32 && k <= 256 && k % 16 == 0 && b <= availableCoreNum && !(m == 32 && n == 32 && k == 32)) {
        const int32_t mp = m <= 16 ? 16 : 32;
        const int32_t np = n <= 16 ? 16 : n <= 32 ? 32 : 128;
        struct DirectSpace { aclrtStream stream; int32_t device; void* ptr; size_t bytes; };
        static thread_local std::vector<DirectSpace> directSpaces;
        int32_t device = 0; aclrtGetDevice(&device);
        DirectSpace* ws = nullptr;
        for (auto& item : directSpaces) if (item.stream == stream && item.device == device) ws = &item;
        if (!ws) { directSpaces.push_back({stream, device, nullptr, 0}); ws = &directSpaces.back(); }
        size_t bytes = (size_t)b * mp * np * 4;
        if (bytes > ws->bytes) {
            if (ws->ptr) { aclrtSynchronizeStream(stream); aclrtFree(ws->ptr); ws->ptr = nullptr; ws->bytes = 0; }
            if (aclrtMalloc(&ws->ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
            ws->bytes = bytes;
        }
#define BMMS_DN(T, A, B, MP) do { \
    if (np == 16) bmms_direct<T, A, B, MP, 16><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (np == 32) bmms_direct<T, A, B, MP, 32><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else bmms_direct<T, A, B, MP, 128><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
} while (0)
#define BMMS_DIRECT(T, A, B) do { \
    if (m == 7 && n == 13 && k == 48) bmms_direct<T, A, B, 16, 16, 7, 13, 48><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (m == 8 && n == 16 && k == 128) bmms_direct<T, A, B, 16, 16, 8, 16, 128><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (m == 16 && n == 32 && k == 128) bmms_direct<T, A, B, 16, 32, 16, 32, 128><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (m == 23 && n == 73 && k == 192) bmms_direct<T, A, B, 32, 128, 23, 73, 192><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (m == 32 && n == 128 && k == 256) bmms_direct<T, A, B, 32, 128, 32, 128, 256><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (mp == 16) { BMMS_DN(T, A, B, 16); } else { BMMS_DN(T, A, B, 32); } \
} while (0)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_DIRECT(bfloat16_t, true, true); } else { BMMS_DIRECT(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_DIRECT(bfloat16_t, false, true); } else { BMMS_DIRECT(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_DIRECT(half, true, true); } else { BMMS_DIRECT(half, true, false); } }
            else { if (transposeX2) { BMMS_DIRECT(half, false, true); } else { BMMS_DIRECT(half, false, false); } }
        }
#undef BMMS_DIRECT
#undef BMMS_DN
        return;
    }

    if (m <= 8 && n <= 8 && n > 1 && m * n <= 32 && k <= 128) {
        int32_t vc = std::max<int32_t>(1, std::min<int64_t>(b, availableCoreNum * 2));
#define BMMS_MICRO(T, A, B) do { \
    if (k <= 16) bmms_micro<T, A, B, 16><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (k <= 32) bmms_micro<T, A, B, 32><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (k <= 64) bmms_micro<T, A, B, 64><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else bmms_micro<T, A, B, 128><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
} while (0)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_MICRO(bfloat16_t, true, true); } else { BMMS_MICRO(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_MICRO(bfloat16_t, false, true); } else { BMMS_MICRO(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_MICRO(half, true, true); } else { BMMS_MICRO(half, true, false); } }
            else { if (transposeX2) { BMMS_MICRO(half, false, true); } else { BMMS_MICRO(half, false, false); } }
        }
#undef BMMS_MICRO
        return;
    }

    int32_t tileM = m <= 16 ? 16 : (m <= 32 ? 32 : ((n <= 64 && k <= 128 && m >= 256 && (int64_t)b * ((m + 255) / 256) >= availableCoreNum) ? 256 : 64));
    int32_t tileN = n <= 16 ? 16 : (n <= 32 ? 32 : (n <= 64 ? 64 : 128));
    // For narrow, short-K matrices, fewer waves can offset a partially filled wave.
    if (k <= 128 && n <= 32 && m >= 2048) {
        int64_t best = ((b * ((m + tileM - 1) / tileM) + availableCoreNum - 1) / availableCoreNum) * (tileM + 128);
        for (int32_t candidate = 128; candidate * tileN <= 16384; candidate *= 2) {
            int64_t cost = ((b * ((m + candidate - 1) / candidate) + availableCoreNum - 1) / availableCoreNum) * (candidate + 128);
            if (cost < best) { best = cost; tileM = candidate; }
        }
    }
    // Enlarge tiles only when enough independent tasks remain to occupy the device.
    int32_t initialRows = b * ((m + tileM - 1) / tileM);
    if (n > 128 && (k >= 256 || initialRows * 2 < availableCoreNum) && (initialRows * 2 >= availableCoreNum ||
        (int64_t)initialRows * ((n + 255) / 256) >= availableCoreNum)) tileN = 256;

    // Each tile reloads its own A/B slab from GM and pays one Fixpipe + one scheduler pass,
    // so a 128-row M tile is a win whenever enough tiles remain to keep the device busy.
    // ...but never override the tuned narrow-matrix M-tile chosen just above.
    if (m >= 128 && tileN >= 128) {
        int64_t tiles = (int64_t)((m + 127) / 128) * ((n + 127) / 128);
        if (tiles * 2 >= availableCoreNum) tileM = 128;
    }
    if (k <= 256 && (int64_t)b * m * n * k < (1LL << 28) &&
        n > 128 && n <= 1024 && m <= 512) tileN = 128;
    // Keep the AIV UB footprint (tile staging + max/sum reduce buffers) inside the 192 KB
    // budget; an over-large tile overflows UB and faults or hangs the kernel at run time.
    {
        int64_t aux = 32768 + 2 * (int64_t)((m + 7) / 8) * 32 + 2 * (int64_t)tileM * 4;
        int64_t maxStage = (180 * 1024 - aux) / 4;   // elements the chunked AIV staging may hold
        while ((int64_t)tileM * (tileN < 128 ? tileN : 128) > maxStage && (tileM > 16 || tileN > 16)) {
            if (tileN > 128 || (tileN >= tileM && tileN > 16)) tileN >>= 1;
            else if (tileM > 16) tileM >>= 1;
            else break;
        }
    }

    struct Plan { int32_t m, n, k, dtype, tileM, tileN; bool ta, tb; TCubeTiling tiling; };
    static thread_local std::vector<Plan> plans;
    TCubeTiling tiling;
    bool found = false;
    for (const auto& plan : plans) {
        if (plan.m == m && plan.n == n && plan.k == k && plan.dtype == info_x1.tensors[0].dtype &&
            plan.ta == transposeX1 && plan.tb == transposeX2 && plan.tileM == tileM && plan.tileN == tileN) { tiling = plan.tiling; found = true; break; }
    }
    if (!found) {
        matmul_tiling::PlatformInfo platform;
        platform.socVersion = platform_ascendc::SocVersion::ASCEND910B;
        platform.l1Size = 512 * 1024;
        platform.l0ASize = platform.l0BSize = 64 * 1024;
        platform.l0CSize = 128 * 1024;
        platform.ubSize = 192 * 1024;
        matmul_tiling::MatmulApiTiling api(platform);
        auto dtype = info_x1.tensors[0].dtype == 2 ? matmul_tiling::DataType::DT_BF16 : matmul_tiling::DataType::DT_FLOAT16;
        api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX1);
        api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX2);
        api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);
        api.SetShape(tileM, tileN, k);
        api.SetOrgShape(m, n, k);
        if (m >= 512 && n >= 512 && k >= 512 && n % 128 != 0 && k % 16 != 0 && transposeX2)
            api.SetFixSplit(std::min(tileM, 128), std::min(tileN, 128), -1);
        else api.SetFixSplit(std::min(tileM, 256), tileN, -1);
        api.SetBufferSpace(platform.l1Size, platform.l0CSize, 0);
        if (api.GetTiling(tiling) != 0) return;
        tiling.M = m; tiling.N = n; tiling.Ka = k; tiling.Kb = k;
        tiling.singleCoreM = tileM; tiling.singleCoreN = tileN; tiling.singleCoreK = k;
        plans.push_back({m, n, k, info_x1.tensors[0].dtype, tileM, tileN, transposeX1, transposeX2, tiling});
    }
    int32_t rowTasks = b * ((m + tileM - 1) / tileM);
    int32_t nt = (n + tileN - 1) / tileN;
    int32_t ns = 1;
    // Estimate the number of serial tile steps; avoid extra partitions on ties.
    // N-partitioning multiplies the task count and pays the per-task scheduler cost again;
    // only consider it while the B*M row tasks alone leave most of the device idle.
    if (rowTasks < 2 * availableCoreNum) {
        int32_t bestCost = ((rowTasks + availableCoreNum - 1) / availableCoreNum) * nt;
        for (int32_t parts = 2; parts <= nt && parts <= availableCoreNum; ++parts) {
            int32_t cost = ((rowTasks * parts + availableCoreNum - 1) / availableCoreNum) * ((nt + parts - 1) / parts);
            if (cost < bestCost) { bestCost = cost; ns = parts; }
        }
    }
    int32_t tasks = rowTasks * ns;
    int32_t cores = std::max<int32_t>(1, std::min<int64_t>(availableCoreNum, tasks));
    // Successive launches on the same stream reuse its workspace in stream order.
    struct Workspace { aclrtStream stream; int32_t device; void* ptr; size_t bytes; };
    static thread_local std::vector<Workspace> workspaces;
    int32_t device = 0;
    aclrtGetDevice(&device);
    Workspace* ws = nullptr;
    for (auto& item : workspaces) if (item.stream == stream && item.device == device) ws = &item;
    if (!ws) { workspaces.push_back({stream, device, nullptr, 0}); ws = &workspaces.back(); }
    size_t matrixBytes = (size_t)cores * 2 * tileM * tileN * 4;
    size_t bytes = matrixBytes + ((size_t)b * ns * m * 4 + 511) / 512 * 512;
    if (bytes > ws->bytes) {
        if (ws->ptr) { aclrtSynchronizeStream(stream); aclrtFree(ws->ptr); ws->ptr = nullptr; ws->bytes = 0; }
        if (aclrtMalloc(&ws->ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
        ws->bytes = bytes;
    }
    auto matrix = (GM_ADDR)ws->ptr;
    auto maxima = matrix + matrixBytes;
    const bool useManual = ((int64_t)b * m * n * k < (1LL << 28) && k % 16 == 0 &&
                            (int64_t)tileM * tileN <= 32768 && tileM <= 256 &&
                            !(m >= 512 && n >= 8 * m));
#define BMMS_MANUAL(T, A, B) do { \
    if (b <= availableCoreNum && k == 32 && m == 32 && n == 32) bmms_full<T, A, B, 32, 32, 32><<<cores, nullptr, stream>>>(x1, x2, matrix, y); \
    else if (b <= availableCoreNum && k == 64 && m == 64 && n == 64) bmms_full<T, A, B, 64, 64, 64><<<cores, nullptr, stream>>>(x1, x2, matrix, y); \
    else if (b <= availableCoreNum && k == 128 && m == 64 && n == 128) bmms_full<T, A, B, 64, 128, 128><<<cores, nullptr, stream>>>(x1, x2, matrix, y); \
    else if (k == 32 && m == 32 && n == 32) bmms_small<T, A, B, 32, 32, 32, true><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tileM, tileN); \
    else if (k == 64 && m == 64 && n == 64) bmms_small<T, A, B, 64, 64, 64, true><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tileM, tileN); \
    else if (tileM == 64 && tileN == 128 && k == 128) bmms_manual<T, A, B, 64, 128, 128><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tileM, tileN); \
    else bmms_manual<T, A, B><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tileM, tileN); \
} while (0)
#define BMMS_LAUNCH(T, A, B) do { \
    if (useManual) BMMS_MANUAL(T, A, B); \
    else bmms_fused<T, A, B><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tiling); \
} while (0)
    if (info_x1.tensors[0].dtype == 2) {
        if (transposeX1) { if (transposeX2) { BMMS_LAUNCH(bfloat16_t, true, true); } else { BMMS_LAUNCH(bfloat16_t, true, false); } }
        else { if (transposeX2) { BMMS_LAUNCH(bfloat16_t, false, true); } else { BMMS_LAUNCH(bfloat16_t, false, false); } }
    } else {
        if (transposeX1) { if (transposeX2) { BMMS_LAUNCH(half, true, true); } else { BMMS_LAUNCH(half, true, false); } }
        else { if (transposeX2) { BMMS_LAUNCH(half, false, true); } else { BMMS_LAUNCH(half, false, false); } }
    }
#undef BMMS_LAUNCH
#undef BMMS_MANUAL
}
