#include <cstdio>
#include "tiling_api.h"

// Host metadata audit only: reproduces the existing FullA tiling for the
// user-supplied P12. No device initialization, input tensor or kernel launch.
int main()
{
    constexpr int tileM=128, tileN=256, k=1536, storeN=4096;
    matmul_tiling::PlatformInfo p;
    p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
    p.l1Size=512*1024; p.l0ASize=p.l0BSize=64*1024;
    p.l0CSize=128*1024; p.ubSize=192*1024;
    matmul_tiling::MatmulApiTiling api(p);
    api.SetAType(matmul_tiling::TPosition::A1,matmul_tiling::CubeFormat::NZ,matmul_tiling::DataType::DT_BF16,true);
    api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_BF16,false);
    api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
    api.SetBias(false); api.SetShape(tileM,tileN,k/2);
    api.SetOrgShape(tileM,storeN,k/2,k);
    api.SetFixSplit(tileM,tileN,64);
    api.SetBufferSpace(p.l1Size,p.l0CSize,0);
    TCubeTiling t{};
    const int rc=api.GetTiling(t);
    if(rc!=0) {std::fprintf(stderr,"GetTiling failed: %d\n",rc);return 1;}
    const long long aBytes=2LL*tileM*k;
    const long long bDoubleStageBytes=4LL*t.baseN*t.baseK;
    const int steps=(p.l1Size-aBytes)/bDoubleStageBytes;
    std::printf("{\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"residentABytes\":%lld,\"bDoubleStageBytes\":%lld,\"stepKb\":%d,\"totalL1Bytes\":%lld,\"maxAlignedKWithOneBStage\":%lld}\n",
        t.baseM,t.baseN,t.baseK,aBytes,bDoubleStageBytes,steps,
        aBytes+steps*bDoubleStageBytes,(p.l1Size-bDoubleStageBytes)/(2LL*tileM)/32*32);
    return 0;
}
