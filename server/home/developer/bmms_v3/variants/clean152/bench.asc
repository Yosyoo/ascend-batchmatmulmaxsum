// Fast in-process benchmark main for BatchMatmulMaxSum variant comparison.
// Loads inputs once, then times a back-to-back run_kernel loop with ACL events.
// Usage: ./bench B M N K dtype ta tb iters rounds
// Prints one JSON line: {"iters":..,"rounds":[us_per_iter,...],"min":..,"median":..,
//                        "consistent":true,"sum":..}

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <algorithm>
#include <vector>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#include "kernel.asc"

int main(int argc, char** argv)
{
    int B = argc > 1 ? atoi(argv[1]) : 1;
    int M = argc > 2 ? atoi(argv[2]) : 1;
    int N = argc > 3 ? atoi(argv[3]) : 1;
    int K = argc > 4 ? atoi(argv[4]) : 32;
    int dtype = argc > 5 ? atoi(argv[5]) : 1;
    bool ta = argc > 6 ? atoi(argv[6]) != 0 : false;
    bool tb = argc > 7 ? atoi(argv[7]) != 0 : false;
    int iters = argc > 8 ? atoi(argv[8]) : 20;
    int rounds = argc > 9 ? atoi(argv[9]) : 5;

    aclrtStream stream = nullptr;
    aclrtEvent evStart = nullptr, evStop = nullptr;
    int32_t deviceId = 1;
    { const char* dv = getenv("BMMS_DEVICE_ID"); if (dv && *dv) deviceId = atoi(dv); }
    int64_t availableCoreNum = 0;
    if (aclInit(nullptr) != ACL_SUCCESS) return 1;
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) return 1;
    if (aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum) != ACL_SUCCESS) return 1;
    if (availableCoreNum <= 0) return 1;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) return 1;
    if (aclrtCreateEvent(&evStart) != ACL_SUCCESS) return 1;
    if (aclrtCreateEvent(&evStop) != ACL_SUCCESS) return 1;

    int64_t x1_0_shape[] = {B, ta ? K : M, ta ? M : K};
    TensorInfo x1_tensors[] = {{x1_0_shape, 3, dtype}};
    TensorGroupInfo info_x1 = {x1_tensors, 1};
    int64_t x2_0_shape[] = {B, tb ? N : K, tb ? K : N};
    TensorInfo x2_tensors[] = {{x2_0_shape, 3, dtype}};
    TensorGroupInfo info_x2 = {x2_tensors, 1};
    int64_t y_0_shape[] = {B};
    TensorInfo y_tensors[] = {{y_0_shape, 1, 0}};
    TensorGroupInfo info_y = {y_tensors, 1};

    uint8_t *inputHost_x1 = nullptr, *inputDevice_x1 = nullptr;
    uint8_t *inputHost_x2 = nullptr, *inputDevice_x2 = nullptr;
    uint8_t *outputHost_y = nullptr, *outputDevice_y = nullptr;

    if (aclrtMallocHost((void**)&inputHost_x1, (size_t)B * M * K * 2) != ACL_SUCCESS) return 1;
    if (aclrtMalloc((void**)&inputDevice_x1, (size_t)B * M * K * 2, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 1;
    if (!ReadFile("./input/x1.bin", (size_t)B * M * K * 2, inputHost_x1, (size_t)B * M * K * 2)) return 1;
    if (aclrtMemcpy(inputDevice_x1, (size_t)B * M * K * 2, inputHost_x1, (size_t)B * M * K * 2, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return 1;
    if (aclrtMallocHost((void**)&inputHost_x2, (size_t)B * N * K * 2) != ACL_SUCCESS) return 1;
    if (aclrtMalloc((void**)&inputDevice_x2, (size_t)B * N * K * 2, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 1;
    if (!ReadFile("./input/x2.bin", (size_t)B * N * K * 2, inputHost_x2, (size_t)B * N * K * 2)) return 1;
    if (aclrtMemcpy(inputDevice_x2, (size_t)B * N * K * 2, inputHost_x2, (size_t)B * N * K * 2, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return 1;
    if (aclrtMallocHost((void**)&outputHost_y, (size_t)B * 4) != ACL_SUCCESS) return 1;
    if (aclrtMalloc((void**)&outputDevice_y, (size_t)B * 4, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 1;

    // Warmup: also forces host-side tiling/workspace caches to settle.
    for (int i = 0; i < 3; ++i) {
        run_kernel((GM_ADDR)inputDevice_x1, info_x1, (GM_ADDR)inputDevice_x2, info_x2, (GM_ADDR)outputDevice_y,
                   info_y, availableCoreNum, stream, ta, tb);
    }
    if (aclrtSynchronizeStreamWithTimeout(stream, 10000) != ACL_SUCCESS) return 1;
    if (aclrtMemcpy(outputHost_y, (size_t)B * 4, outputDevice_y, (size_t)B * 4, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return 1;
    std::vector<uint8_t> firstOutput((size_t)B * 4);
    memcpy(firstOutput.data(), outputHost_y, (size_t)B * 4);

    std::vector<double> perRound;
    bool consistent = true;
    for (int r = 0; r < rounds; ++r) {
        aclrtRecordEvent(evStart, stream);
        for (int i = 0; i < iters; ++i) {
            run_kernel((GM_ADDR)inputDevice_x1, info_x1, (GM_ADDR)inputDevice_x2, info_x2, (GM_ADDR)outputDevice_y,
                       info_y, availableCoreNum, stream, ta, tb);
        }
        aclrtRecordEvent(evStop, stream);
        if (aclrtSynchronizeStreamWithTimeout(stream, 60000) != ACL_SUCCESS) { fprintf(stderr, "sync timeout\n"); return 1; }
        float ms = 0.0f;
        if (aclrtEventElapsedTime(&ms, evStart, evStop) != ACL_SUCCESS) return 1;
        perRound.push_back((double)ms * 1000.0 / iters);
        if (aclrtMemcpy(outputHost_y, (size_t)B * 4, outputDevice_y, (size_t)B * 4, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) return 1;
        if (memcmp(firstOutput.data(), outputHost_y, (size_t)B * 4) != 0) consistent = false;
    }

    if (!WriteFile("./output/y.bin", outputHost_y, (size_t)B * 4)) return 1;

    std::vector<double> sorted = perRound;
    std::sort(sorted.begin(), sorted.end());
    double sum = 0.0;
    for (double v : perRound) sum += v;
    printf("{\"iters\":%d,\"rounds\":[", iters);
    for (size_t i = 0; i < perRound.size(); ++i) printf("%s%.3f", i ? "," : "", perRound[i]);
    printf("],\"min\":%.3f,\"median\":%.3f,\"mean\":%.3f,\"consistent\":%s}\n",
           sorted.front(), sorted[sorted.size() / 2], sum / perRound.size(), consistent ? "true" : "false");
    fflush(stdout);

    aclrtDestroyEvent(evStart);
    aclrtDestroyEvent(evStop);
    if (inputDevice_x1) aclrtFree(inputDevice_x1);
    if (inputHost_x1) aclrtFreeHost(inputHost_x1);
    if (inputDevice_x2) aclrtFree(inputDevice_x2);
    if (inputHost_x2) aclrtFreeHost(inputHost_x2);
    if (outputDevice_y) aclrtFree(outputDevice_y);
    if (outputHost_y) aclrtFreeHost(outputHost_y);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return consistent ? 0 : 2;
}
