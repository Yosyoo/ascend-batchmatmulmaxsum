#include "kernel_operator.h"
using namespace AscendC;

__global__ __aicore__ void probe_kernel(GM_ADDR y)
{
    LocalTensor<float> src(TPosition::VECIN, 0, 1024);
    LocalTensor<float> dst(TPosition::VECCALC, 4096, 1024);
    for (int i = 0; i < 1024; ++i) src.SetValue(i, (float)(i + 1));
    for (int i = 0; i < 512; ++i) dst.SetValue(i, -7.0f);
    SetFlag<HardEvent::S_V>(EVENT_ID0); WaitFlag<HardEvent::S_V>(EVENT_ID0);
    // A) dstRepStride=1, repeat=4, mask=64 -> where do the 4 results land?
    WholeReduceSum(dst, src, 64, 4, 1, 1, 8);
    PipeBarrier<PIPE_V>();
    // B) same but dstRepStride=8 (datablock interpretation would give same as packed)
    LocalTensor<float> dst2(TPosition::VECCALC, 4096 + 2048, 1024);
    for (int i = 0; i < 512; ++i) dst2.SetValue(i, -7.0f);
    SetFlag<HardEvent::S_V>(EVENT_ID0); WaitFlag<HardEvent::S_V>(EVENT_ID0);
    WholeReduceSum(dst2, src, 64, 4, 8, 1, 8);
    PipeBarrier<PIPE_V>();
    GlobalTensor<float> yg; yg.SetGlobalBuffer((__gm__ float*)y);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    DataCopy(yg[0], dst, 64);
    DataCopy(yg[64], dst2, 64);
    PipeBarrier<PIPE_ALL>();
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    probe_kernel<<<1, nullptr, stream>>>(y);
}
