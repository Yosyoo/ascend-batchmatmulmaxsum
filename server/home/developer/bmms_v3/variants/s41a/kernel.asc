#include <algorithm>
#include <vector>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling_api.h"
using namespace AscendC;
using namespace matmul;
constexpr MatmulConfig BMMS_MM_CFG = GetMDLConfig(false, false, 0, false, false, false, true);

__aicore__ inline void bmms_sum(const LocalTensor<float>& dst,
    const LocalTensor<float>& src, const LocalTensor<float>& tmp, int32_t count)
{
    // At most128 groups need one existing two-level fold; keep that hot path loop-free.
    if(count<=8192) {
        if(count<=64) { WholeReduceSum(dst,src,count,1,1,1,8);return; }
        const int32_t groups=count/64;
        WholeReduceSum(tmp,src,64,groups,1,1,8);
        if(count%64) WholeReduceSum(tmp[groups],src[groups*64],count%64,1,1,1,8);
        int32_t partials=(count+63)/64;
        PipeBarrier<PIPE_V>();
        if(partials>64) {
            Add(tmp,tmp,tmp[64],partials-64);
            PipeBarrier<PIPE_V>();partials=64;
        }
        WholeReduceSum(dst,tmp,partials,1,1,1,8);return;
    }
    // The old two-level fold dropped groups after index127 for count>8192.
    // Pair long aligned row halves before summing, then fold every partial.
    if(count>8192 && count%16==0) {
        Add(src,src,src[count/2],count/2);
        PipeBarrier<PIPE_V>();count/=2;
    }
    if (count <= 64) { WholeReduceSum(dst, src, count, 1, 1, 1, 8); return; }
    int32_t groups = count / 64;
    for(int first=0;first<groups;first+=248) {
        const int reps=groups-first<248?groups-first:248;
        WholeReduceSum(tmp[first],src[first*64],64,reps,1,1,8);
    }
    if (count % 64) WholeReduceSum(tmp[groups], src[groups * 64], count % 64, 1, 1, 1, 8);
    int32_t partials = (count + 63) / 64;
    PipeBarrier<PIPE_V>();
    while (partials > 64) {
        const int half=partials<=128?64:(partials+15)/16*8;
        Add(tmp,tmp,tmp[half],partials-half);
        PipeBarrier<PIPE_V>();partials=half;
    }
    WholeReduceSum(dst, tmp, partials, 1, 1, 1, 8);
}

// Pair the two row halves before the final sum when their UB offsets are aligned.
// This lowers cancellation error without changing the row maxima.
__aicore__ inline void bmms_paired_sum(const LocalTensor<float>& dst,
    const LocalTensor<float>& src, const LocalTensor<float>& tmp, int32_t count)
{
    int32_t h = count / 2;
    if (h > 0 && h % 8 == 0) {
        Add(src, src, src[h], h);
        PipeBarrier<PIPE_V>();
        if (count % 2) {
            Add(src, src, src[h * 2], 1);
            PipeBarrier<PIPE_V>();
        }
        ReduceSum(dst, src, tmp, h);
    } else ReduceSum(dst, src, tmp, count);
}

template<class T, bool TA, bool TB, int M, int N, int K>
__global__ __aicore__ __mix__(1, 1) void bmms_full(GM_ADDR a, GM_ADDR b, GM_ADDR scratch, GM_ADDR y)
{
    const int core = GetBlockIdx();
    const int off = core * 2 * M * N;
    GlobalTensor<float> sg;
    sg.SetGlobalBuffer((__gm__ float*)scratch);
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<T> la(TPosition::A1, 0, M * K), lb(TPosition::B1, M * K * 2, N * K);
        LocalTensor<T> aa(TPosition::A2, 0, M * K), bb(TPosition::B2, 0, N * K);
        LocalTensor<float> cc(TPosition::CO1, 0, M * N);
        Nd2NzParams pa{1, TA ? K : M, TA ? M : K, 0, TA ? M : K, TA ? K : M, 1, 0};
        Nd2NzParams pb{1, TB ? N : K, TB ? K : N, 0, TB ? K : N, TB ? N : K, 1, 0};
        DataCopy(la, ag[core * M * K], pa); DataCopy(lb, bg[core * N * K], pb);
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0); WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        LoadData2dParams ap{0, K / 16, TA ? 1 : M / 16, 0, 0, TA, 0};
        if (TA) {
            ap.repeatTimes = M * K / 256;
            LoadData(aa, la, ap);
        } else {
            #pragma unroll
            for (int i = 0; i < M / 16; ++i) LoadData(aa[i * K * 16], la[i * 256], ap);
        }
        LoadData2dParams bp{0, N / 16, TB ? 1 : K / 16, 0, 0, !TB, 0};
        if (TB) {
            bp.repeatTimes = N * K / 256;
            LoadData(bb, lb, bp);
        } else {
            #pragma unroll
            for (int i = 0; i < K / 16; ++i) LoadData(bb[i * N * 16], lb[i * 256], bp);
        }
        SetFlag<HardEvent::MTE1_M>(EVENT_ID0); WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
        MmadParams mm{M, N, K, 0, false, true};
        Mmad(cc, aa, bb, mm);
        SetFlag<HardEvent::M_FIX>(EVENT_ID0); WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
        FixpipeParamsV220 fp;
        fp.mSize = M; fp.nSize = N; fp.srcStride = M; fp.dstStride = N;
        Fixpipe(sg[off], cc, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
    }
    if ASCEND_IS_AIV {
        LocalTensor<float> vx(TPosition::VECIN, 0, M * N);
        LocalTensor<float> rm(TPosition::VECCALC, M * N * 4, M);
        LocalTensor<float> out(TPosition::VECOUT, M * N * 4 + M * 4, 8);
        GlobalTensor<float> yg; yg.SetGlobalBuffer((__gm__ float*)y);
        CrossCoreWaitFlag(8);
        DataCopy(vx, sg[off], M * N);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if (N == 128) {
            Max(vx, vx, vx[64], 64, M, {1, 1, 1, 16, 16, 16});
            PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(rm, vx, N < 64 ? N : 64, M, 1, 1, N / 8, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(out, rm, M, 1, 1, 1, 8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams cp{1, 4, 0, 0, 0}; DataCopyPad(yg[core], out, cp);
    }
    PipeBarrier<PIPE_ALL>();
}


template<class T, bool TA, bool TB, int TM = 0, int TN = 0, int TK = 0, bool FULL = false>
__global__ __aicore__ __mix__(1, 1) void bmms_small(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns,
    int32_t dynamicM, int32_t dynamicN)
{
    constexpr bool useManual = true;
    const int32_t tileM = TM ? TM : dynamicM;
    const int32_t tileN = TN ? TN : dynamicN;
    if (TK) k = TK;
    if (FULL) { m = TM; n = TN; }
    constexpr int32_t mt = 1;
    constexpr int32_t nt = 1;
    ns = 1;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;

    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        // Hand-rolled cube path (no Matmul-library scheduler) for small problems, where the
        // library's per-task scalar/icache cost dominates the actual MAC time.
        const int32_t mp = tileM, np = tileN;
        int32_t bk = (32768 / (mp > np ? mp : np)) / 16 * 16;
        if (bk > k) bk = k;
        LocalTensor<T> l1a(TPosition::A1, 0, mp * bk);
        LocalTensor<T> l1b(TPosition::B1, mp * bk * 2, np * bk);
        LocalTensor<T> l0a(TPosition::A2, 0, mp * bk);
        LocalTensor<T> l0b(TPosition::B2, 0, np * bk);
        LocalTensor<float> l0c(TPosition::CO1, 0, mp * np);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task;
            constexpr int32_t part = 0;
            constexpr int32_t mi = 0;
            constexpr int32_t begin = 0;
            constexpr int32_t end = 1;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                if (t - begin >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                if (useManual) {
                    const int32_t cm16 = (cm + 15) / 16 * 16;
                    const int32_t cn16 = (cn + 15) / 16 * 16;
                    const int64_t aBase = (int64_t)batch * m * k + (TA ? (int64_t)mi : (int64_t)mi * k);
                    const int64_t bBase = (int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni);
                    for (int32_t k0 = 0; k0 < k; k0 += bk) {
                        int32_t kk = (k0 + bk <= k) ? bk : (k - k0);
                        int32_t kk16 = (kk + 15) / 16 * 16;
                        // Close the pipe hazards left by the previous chunk/tile before rewriting L1/L0.
                        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                        if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                        // ---- GM(ND) -> L1(NZ) ----
                        Nd2NzParams pa;
                        pa.ndNum = 1;
                        pa.dstNzNStride = 1;
                        pa.dstNzMatrixStride = 0;
                        pa.srcNdMatrixStride = 1;
                        int64_t aOff = aBase;
                        if (!TA) {
                            pa.nValue = (uint16_t)cm; pa.dValue = (uint16_t)kk;
                            pa.srcDValue = (uint16_t)k; pa.dstNzC0Stride = (uint16_t)cm16;
                            aOff += k0;
                        } else {
                            pa.nValue = (uint16_t)kk; pa.dValue = (uint16_t)cm;
                            pa.srcDValue = (uint16_t)m; pa.dstNzC0Stride = (uint16_t)kk16;
                            aOff += (int64_t)k0 * m;
                        }
                        Nd2NzParams pb;
                        pb.ndNum = 1;
                        pb.dstNzNStride = 1;
                        pb.dstNzMatrixStride = 0;
                        pb.srcNdMatrixStride = 1;
                        pb.dstNzC0Stride = (uint16_t)(TB ? cn16 : kk16);
                        int64_t bOff = bBase;
                        if (!TB) {
                            pb.nValue = (uint16_t)kk; pb.dValue = (uint16_t)cn;
                            pb.srcDValue = (uint16_t)n;
                            bOff += (int64_t)k0 * n;
                        } else {
                            pb.nValue = (uint16_t)cn; pb.dValue = (uint16_t)kk;
                            pb.srcDValue = (uint16_t)k;
                            bOff += k0;
                        }
                        DataCopy(l1a, ag[aOff], pa);
                        DataCopy(l1b, bg[bOff], pb);
                        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        // ---- L1 -> L0A / L0B ----
                        const int32_t bm = cm16 / 16;
                        const int32_t bn = cn16 / 16;
                        const int32_t bkk = kk16 / 16;
                        LoadData2dParams lp;
                        lp.startIndex = 0;
                        lp.sid = 0;
                        lp.dstGap = 0;
                        if (!TA) {
                            lp.ifTranspose = false;
                            if (bkk == 1) {
                                lp.repeatTimes = (uint8_t)bm;
                                lp.srcStride = 1;
                                LoadData(l0a, l1a, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = (uint8_t)bm;
                                for (int32_t i = 0; i < bm; ++i) {
                                    LoadData(l0a[i * bkk * 256], l1a[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = true;
                            lp.repeatTimes = (uint8_t)(bm * bkk);
                            lp.srcStride = 1;
                            LoadData(l0a, l1a, lp);
                        }
                        if (!TB) {
                            lp.ifTranspose = true;
                            if (bn == 1) {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = 1;
                                LoadData(l0b, l1b, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bn;
                                lp.srcStride = (uint8_t)bkk;
                                for (int32_t i = 0; i < bkk; ++i) {
                                    LoadData(l0b[i * bn * 256], l1b[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = false;
                            lp.repeatTimes = (uint8_t)(bn * bkk);
                            lp.srcStride = 1;
                            LoadData(l0b, l1b, lp);
                        }
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);   // L1 reusable
                        l1Busy = true;
                        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        // ---- Mmad ----
                        MmadParams mmp;
                        mmp.m = (uint16_t)cm16;
                        mmp.n = (uint16_t)cn16;
                        mmp.k = (uint16_t)kk16;
                        mmp.isBias = false;
                        mmp.cmatrixSource = false;
                        mmp.cmatrixInitVal = (k0 == 0);
                        mmp.unitFlag = 0;
                        Mmad(l0c, l0a, l0b, mmp);
                        SetFlag<HardEvent::M_MTE1>(EVENT_ID3);      // L0 reusable
                        l0Busy = true;
                    }
                    SetFlag<HardEvent::M_FIX>(EVENT_ID0);           // L0C ready
                    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                    FixpipeParamsV220 fp;
                    fp.nSize = (uint16_t)cn16;
                    fp.mSize = (uint16_t)cm16;
                    fp.srcStride = (uint16_t)cm16;
                    fp.dstStride = (uint32_t)tileN;
                    fp.reluEn = false;
                    fp.ndNum = 1;
                    fp.srcNdStride = 0;
                    fp.dstNdStride = 0;
                    Fixpipe(sg[coreOffset + (int64_t)slot * tileM * tileN], l0c, fp);
                    SetFlag<HardEvent::FIX_M>(EVENT_ID0);
                    fixBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
            }
            CrossCoreWaitFlag(10);
            if (end - begin > 1) CrossCoreWaitFlag(15);
        }
        if (useManual) {
            if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
            if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }

    }
    if ASCEND_IS_AIV {
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t vrows = (tileM + 7) / 8 * 8;
        const int32_t sumRows = (m + 7) / 8 * 8;
        const int32_t stageBytes = tileM * cN * 4;
        LocalTensor<float> x(TPosition::VECIN, 0, tileM * cN);
        LocalTensor<float> running(TPosition::VECCALC, stageBytes, vrows);
        LocalTensor<float> rbuf(TPosition::VECCALC, stageBytes + vrows * 4, vrows);
        LocalTensor<float> sumTemp(TPosition::VECCALC, stageBytes + vrows * 8, 8192);
        LocalTensor<float> sx(TPosition::VECIN, stageBytes + vrows * 8 + 32768, sumRows);
        LocalTensor<float> acc(TPosition::VECCALC, stageBytes + vrows * 8 + 32768 + sumRows * 4, sumRows);
        bool vectorBusy = false;
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);

        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task;
            constexpr int32_t part = 0;
            constexpr int32_t mi = 0;
            constexpr int32_t begin = 0;
            constexpr int32_t end = 1;
            int32_t cm = m - mi < tileM ? m - mi : tileM;

            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    if (vectorBusy) {
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    if (cN == 128) {
                        Max(x, x, x[64], 64, cm, {1, 1, 1, 16, 16, 16});
                        PipeBarrier<PIPE_V>();
                    }
                    for (int32_t r = 0; r < cm; r += 248) {
                        int32_t rows = cm - r < 248 ? cm - r : 248;
                        WholeReduceMax(rbuf[r], x[r * cN], cN < 64 ? cN : 64,
                            rows, 1, 1, cN / 8, ReduceOrder::ORDER_ONLY_VALUE);
                    }
                    PipeBarrier<PIPE_V>();
                    Max(running, running, rbuf, cm);
                    vectorBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
            }
            if (mt == 1 && ns == 1) {
                if (cm <= 64) WholeReduceSum(rbuf, running, cm, 1, 1, 1, 8);
                else bmms_sum(rbuf, running, sumTemp, cm);
                PipeBarrier<PIPE_V>();
                Adds(running, rbuf, 0.0f, 8);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        if (mt == 1 && ns == 1) { PipeBarrier<PIPE_ALL>(); return; }
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();


        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {

            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sx, mg[((int64_t)batch * ns + part) * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if (ns == 1) bmms_sum(rbuf, sx, sumTemp, m);
                else Max(acc, acc, sx, m);

            }
            auto out = running;
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else bmms_sum(out, acc, sumTemp, m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        PipeBarrier<PIPE_ALL>();
    }
}


template<class T, bool TA, bool TB, int TM = 0, int TN = 0, int TK = 0, bool PAIR = false>
__global__ __aicore__ __mix__(1, 1) void bmms_manual_pad(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns,
    int32_t dynamicM, int32_t dynamicN, int32_t kp)
{
    constexpr bool useManual = true;
    const int32_t tileM = TM ? TM : dynamicM;
    const int32_t tileN = TN ? TN : dynamicN;
    if (TK) k = TK;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;

    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        // Hand-rolled cube path (no Matmul-library scheduler) for small problems, where the
        // library's per-task scalar/icache cost dominates the actual MAC time.
        const int32_t mp = tileM, np = tileN;
        int32_t bk = (32768 / (mp > np ? mp : np)) / 16 * 16;
        if (bk > kp) bk = kp;
        LocalTensor<T> l1a(TPosition::A1, 0, mp * bk);
        LocalTensor<T> l1b(TPosition::B1, mp * bk * 2, np * bk);
        LocalTensor<T> l0a(TPosition::A2, 0, mp * bk);
        LocalTensor<T> l0b(TPosition::B2, 0, np * bk);
        LocalTensor<float> l0c(TPosition::CO1, 0, mp * np);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                if (t - begin >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                if (useManual) {
                  for (int part = 0; part < (PAIR ? 2 : 1); ++part) {
                    const int partStart = PAIR ? part * (k / 2) : 0;
                    const int partK = PAIR ? (part == 0 ? k / 2 : k - k / 2) : k;
                    const int32_t cm16 = (cm + 15) / 16 * 16;
                    const int32_t cn16 = (cn + 15) / 16 * 16;
                    const int64_t aBase = (int64_t)batch * m * k + (TA ? (int64_t)mi : (int64_t)mi * k);
                    const int64_t bBase = (int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni);
                    for (int32_t k0 = 0; k0 < partK; k0 += bk) {
                        int32_t kk = (k0 + bk <= partK) ? bk : (partK - k0);
                        int32_t kk16 = (kk + 15) / 16 * 16;
                        // Close the pipe hazards left by the previous chunk/tile before rewriting L1/L0.
                        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                        if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                        // Initialize B's missing K rows in L1, then load only valid input.
                        InitConstValue(l1b, {1, (uint16_t)(np * bk / 16), 0, (T)0});
                        PipeBarrier<PIPE_MTE2>();
                        // ---- GM(ND) -> L1(NZ) ----
                        Nd2NzParams pa;
                        pa.ndNum = 1;
                        pa.dstNzNStride = 1;
                        pa.dstNzMatrixStride = 0;
                        pa.srcNdMatrixStride = 1;
                        int64_t aOff = aBase;
                        if (!TA) {
                            pa.nValue = (uint16_t)cm; pa.dValue = (uint16_t)(partK - k0 < kk ? partK - k0 : kk);
                            pa.srcDValue = (uint16_t)k; pa.dstNzC0Stride = (uint16_t)cm16;
                            aOff += partStart + k0;
                        } else {
                            pa.nValue = (uint16_t)kk; pa.dValue = (uint16_t)cm;
                            pa.srcDValue = (uint16_t)m; pa.dstNzC0Stride = (uint16_t)kk16;
                            aOff += (int64_t)k0 * m;
                        }
                        Nd2NzParams pb;
                        pb.ndNum = 1;
                        pb.dstNzNStride = 1;
                        pb.dstNzMatrixStride = 0;
                        pb.srcNdMatrixStride = 1;
                        pb.dstNzC0Stride = (uint16_t)(TB ? cn16 : kk16);
                        int64_t bOff = bBase;
                        if (!TB) {
                            pb.nValue = (uint16_t)(partK - k0 < kk ? partK - k0 : kk); pb.dValue = (uint16_t)cn;
                            pb.srcDValue = (uint16_t)n;
                            bOff += (int64_t)(partStart + k0) * n;
                        } else {
                            pb.nValue = (uint16_t)cn; pb.dValue = (uint16_t)kk;
                            pb.srcDValue = (uint16_t)k;
                            bOff += k0;
                        }
                        DataCopy(l1a, ag[aOff], pa);
                        DataCopy(l1b, bg[bOff], pb);
                        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        // ---- L1 -> L0A / L0B ----
                        const int32_t bm = cm16 / 16;
                        const int32_t bn = cn16 / 16;
                        const int32_t bkk = kk16 / 16;
                        LoadData2dParams lp;
                        lp.startIndex = 0;
                        lp.sid = 0;
                        lp.dstGap = 0;
                        if (!TA) {
                            lp.ifTranspose = false;
                            if (bkk == 1) {
                                lp.repeatTimes = (uint8_t)bm;
                                lp.srcStride = 1;
                                LoadData(l0a, l1a, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = (uint8_t)bm;
                                for (int32_t i = 0; i < bm; ++i) {
                                    LoadData(l0a[i * bkk * 256], l1a[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = true;
                            lp.repeatTimes = (uint8_t)(bm * bkk);
                            lp.srcStride = 1;
                            LoadData(l0a, l1a, lp);
                        }
                        if (!TB) {
                            lp.ifTranspose = true;
                            if (bn == 1) {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = 1;
                                LoadData(l0b, l1b, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bn;
                                lp.srcStride = (uint8_t)bkk;
                                for (int32_t i = 0; i < bkk; ++i) {
                                    LoadData(l0b[i * bn * 256], l1b[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = false;
                            lp.repeatTimes = (uint8_t)(bn * bkk);
                            lp.srcStride = 1;
                            LoadData(l0b, l1b, lp);
                        }
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);   // L1 reusable
                        l1Busy = true;
                        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        // ---- Mmad ----
                        MmadParams mmp;
                        mmp.m = (uint16_t)cm16;
                        mmp.n = (uint16_t)cn16;
                        mmp.k = (uint16_t)kk16;
                        mmp.isBias = false;
                        mmp.cmatrixSource = false;
                        mmp.cmatrixInitVal = (k0 == 0);
                        mmp.unitFlag = 0;
                        Mmad(l0c, l0a, l0b, mmp);
                        SetFlag<HardEvent::M_MTE1>(EVENT_ID3);      // L0 reusable
                        l0Busy = true;
                    }
                    SetFlag<HardEvent::M_FIX>(EVENT_ID0);           // L0C ready
                    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                    FixpipeParamsV220 fp;
                    fp.nSize = (uint16_t)cn16;
                    fp.mSize = (uint16_t)cm16;
                    fp.srcStride = (uint16_t)cm16;
                    fp.dstStride = (uint32_t)tileN;
                    fp.reluEn = false;
                    fp.ndNum = 1;
                    fp.srcNdStride = 0;
                    fp.dstNdStride = 0;
                    if constexpr (PAIR) {
                        if (part == 1) SetAtomicAdd<float>(); else DisableDmaAtomic();
                    }
                    Fixpipe(sg[coreOffset + (int64_t)slot * tileM * tileN], l0c, fp);
                    if constexpr (PAIR) DisableDmaAtomic();
                    SetFlag<HardEvent::FIX_M>(EVENT_ID0);
                    fixBusy = true;
                  }
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
            }
            CrossCoreWaitFlag(10);
            if (end - begin > 1) CrossCoreWaitFlag(15);
        }
        if (useManual) {
            if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
            if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }

    }
    if ASCEND_IS_AIV {
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t vrows = (tileM + 7) / 8 * 8;
        const int32_t sumRows = (m + 7) / 8 * 8;
        const int32_t stageBytes = tileM * cN * 4;
        LocalTensor<float> x(TPosition::VECIN, 0, tileM * cN);
        LocalTensor<float> running(TPosition::VECCALC, stageBytes, vrows);
        LocalTensor<float> rbuf(TPosition::VECCALC, stageBytes + vrows * 4, vrows);
        LocalTensor<float> sumTemp(TPosition::VECCALC, stageBytes + vrows * 8, 8192);
        LocalTensor<float> sx(TPosition::VECIN, stageBytes + vrows * 8 + 32768, sumRows);
        LocalTensor<float> acc(TPosition::VECCALC, stageBytes + vrows * 8 + 32768 + sumRows * 4, sumRows);
        bool vectorBusy = false;
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);

        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;

            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    if (vectorBusy) {
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    if (cN == 128) {
                        Max(x, x, x[64], 64, cm, {1, 1, 1, 16, 16, 16});
                        PipeBarrier<PIPE_V>();
                    }
                    for (int32_t r = 0; r < cm; r += 248) {
                        int32_t rows = cm - r < 248 ? cm - r : 248;
                        WholeReduceMax(rbuf[r], x[r * cN], cN < 64 ? cN : 64,
                            rows, 1, 1, cN / 8, ReduceOrder::ORDER_ONLY_VALUE);
                    }
                    PipeBarrier<PIPE_V>();
                    Max(running, running, rbuf, cm);
                    vectorBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
            }
            if (mt == 1 && ns == 1) {
                if (cm <= 64) WholeReduceSum(rbuf, running, cm, 1, 1, 1, 8);
                else bmms_sum(rbuf, running, sumTemp, cm);
                PipeBarrier<PIPE_V>();
                Adds(running, rbuf, 0.0f, 8);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        if (mt == 1 && ns == 1) { PipeBarrier<PIPE_ALL>(); return; }
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();


        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            if (ns > 1 && m % 8 == 0 && ns * m <= 8192) {
                DataCopyExtParams cp{1, (uint32_t)(ns * m) * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sumTemp, mg[(int64_t)batch * ns * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                Max(acc, sumTemp, sumTemp[m], m);
                for (int part = 2; part < ns; ++part) {
                    PipeBarrier<PIPE_V>();
                    Max(acc, acc, sumTemp[part * m], m);
                }
                PipeBarrier<PIPE_V>();
                bmms_sum(running, acc, sumTemp, m);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], running, op);
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            } else {

            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sx, mg[((int64_t)batch * ns + part) * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if (ns == 1) bmms_sum(rbuf, sx, sumTemp, m);
                else Max(acc, acc, sx, m);

            }
            auto out = running;
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else bmms_sum(out, acc, sumTemp, m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
}


template<class T, bool TA, bool TB, int TM = 0, int TN = 0, int TK = 0>
__global__ __aicore__ __mix__(1, 1) void bmms_manual(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns,
    int32_t dynamicM, int32_t dynamicN)
{
    constexpr bool useManual = true;
    const int32_t tileM = TM ? TM : dynamicM;
    const int32_t tileN = TN ? TN : dynamicN;
    if (TK) k = TK;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;

    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        // Hand-rolled cube path (no Matmul-library scheduler) for small problems, where the
        // library's per-task scalar/icache cost dominates the actual MAC time.
        const int32_t mp = tileM, np = tileN;
        int32_t bk = (32768 / (mp > np ? mp : np)) / 16 * 16;
        if (bk > k) bk = k;
        LocalTensor<T> l1a(TPosition::A1, 0, mp * bk);
        LocalTensor<T> l1b(TPosition::B1, mp * bk * 2, np * bk);
        LocalTensor<T> l0a(TPosition::A2, 0, mp * bk);
        LocalTensor<T> l0b(TPosition::B2, 0, np * bk);
        LocalTensor<float> l0c(TPosition::CO1, 0, mp * np);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                if (t - begin >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                if (useManual) {
                    const int32_t cm16 = (cm + 15) / 16 * 16;
                    const int32_t cn16 = (cn + 15) / 16 * 16;
                    const int64_t aBase = (int64_t)batch * m * k + (TA ? (int64_t)mi : (int64_t)mi * k);
                    const int64_t bBase = (int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni);
                    for (int32_t k0 = 0; k0 < k; k0 += bk) {
                        int32_t kk = (k0 + bk <= k) ? bk : (k - k0);
                        int32_t kk16 = (kk + 15) / 16 * 16;
                        // Close the pipe hazards left by the previous chunk/tile before rewriting L1/L0.
                        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                        if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                        // ---- GM(ND) -> L1(NZ) ----
                        Nd2NzParams pa;
                        pa.ndNum = 1;
                        pa.dstNzNStride = 1;
                        pa.dstNzMatrixStride = 0;
                        pa.srcNdMatrixStride = 1;
                        int64_t aOff = aBase;
                        if (!TA) {
                            pa.nValue = (uint16_t)cm; pa.dValue = (uint16_t)kk;
                            pa.srcDValue = (uint16_t)k; pa.dstNzC0Stride = (uint16_t)cm16;
                            aOff += k0;
                        } else {
                            pa.nValue = (uint16_t)kk; pa.dValue = (uint16_t)cm;
                            pa.srcDValue = (uint16_t)m; pa.dstNzC0Stride = (uint16_t)kk16;
                            aOff += (int64_t)k0 * m;
                        }
                        Nd2NzParams pb;
                        pb.ndNum = 1;
                        pb.dstNzNStride = 1;
                        pb.dstNzMatrixStride = 0;
                        pb.srcNdMatrixStride = 1;
                        pb.dstNzC0Stride = (uint16_t)(TB ? cn16 : kk16);
                        int64_t bOff = bBase;
                        if (!TB) {
                            pb.nValue = (uint16_t)kk; pb.dValue = (uint16_t)cn;
                            pb.srcDValue = (uint16_t)n;
                            bOff += (int64_t)k0 * n;
                        } else {
                            pb.nValue = (uint16_t)cn; pb.dValue = (uint16_t)kk;
                            pb.srcDValue = (uint16_t)k;
                            bOff += k0;
                        }
                        DataCopy(l1a, ag[aOff], pa);
                        DataCopy(l1b, bg[bOff], pb);
                        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        // ---- L1 -> L0A / L0B ----
                        const int32_t bm = cm16 / 16;
                        const int32_t bn = cn16 / 16;
                        const int32_t bkk = kk16 / 16;
                        LoadData2dParams lp;
                        lp.startIndex = 0;
                        lp.sid = 0;
                        lp.dstGap = 0;
                        if (!TA) {
                            lp.ifTranspose = false;
                            if (bkk == 1) {
                                lp.repeatTimes = (uint8_t)bm;
                                lp.srcStride = 1;
                                LoadData(l0a, l1a, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = (uint8_t)bm;
                                for (int32_t i = 0; i < bm; ++i) {
                                    LoadData(l0a[i * bkk * 256], l1a[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = true;
                            lp.repeatTimes = (uint8_t)(bm * bkk);
                            lp.srcStride = 1;
                            LoadData(l0a, l1a, lp);
                        }
                        if (!TB) {
                            lp.ifTranspose = true;
                            if (bn == 1) {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = 1;
                                LoadData(l0b, l1b, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bn;
                                lp.srcStride = (uint8_t)bkk;
                                for (int32_t i = 0; i < bkk; ++i) {
                                    LoadData(l0b[i * bn * 256], l1b[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = false;
                            lp.repeatTimes = (uint8_t)(bn * bkk);
                            lp.srcStride = 1;
                            LoadData(l0b, l1b, lp);
                        }
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);   // L1 reusable
                        l1Busy = true;
                        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        // ---- Mmad ----
                        MmadParams mmp;
                        mmp.m = (uint16_t)cm16;
                        mmp.n = (uint16_t)cn16;
                        mmp.k = (uint16_t)kk16;
                        mmp.isBias = false;
                        mmp.cmatrixSource = false;
                        mmp.cmatrixInitVal = (k0 == 0);
                        mmp.unitFlag = 0;
                        Mmad(l0c, l0a, l0b, mmp);
                        SetFlag<HardEvent::M_MTE1>(EVENT_ID3);      // L0 reusable
                        l0Busy = true;
                    }
                    SetFlag<HardEvent::M_FIX>(EVENT_ID0);           // L0C ready
                    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                    FixpipeParamsV220 fp;
                    fp.nSize = (uint16_t)cn16;
                    fp.mSize = (uint16_t)cm16;
                    fp.srcStride = (uint16_t)cm16;
                    fp.dstStride = (uint32_t)tileN;
                    fp.reluEn = false;
                    fp.ndNum = 1;
                    fp.srcNdStride = 0;
                    fp.dstNdStride = 0;
                    Fixpipe(sg[coreOffset + (int64_t)slot * tileM * tileN], l0c, fp);
                    SetFlag<HardEvent::FIX_M>(EVENT_ID0);
                    fixBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
            }
            CrossCoreWaitFlag(10);
            if (end - begin > 1) CrossCoreWaitFlag(15);
        }
        if (useManual) {
            if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
            if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }

    }
    if ASCEND_IS_AIV {
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t vrows = (tileM + 7) / 8 * 8;
        const int32_t sumRows = (m + 7) / 8 * 8;
        const int32_t stageBytes = tileM * cN * 4;
        LocalTensor<float> x(TPosition::VECIN, 0, tileM * cN);
        LocalTensor<float> running(TPosition::VECCALC, stageBytes, vrows);
        LocalTensor<float> rbuf(TPosition::VECCALC, stageBytes + vrows * 4, vrows);
        LocalTensor<float> sumTemp(TPosition::VECCALC, stageBytes + vrows * 8, 8192);
        LocalTensor<float> sx(TPosition::VECIN, stageBytes + vrows * 8 + 32768, sumRows);
        LocalTensor<float> acc(TPosition::VECCALC, stageBytes + vrows * 8 + 32768 + sumRows * 4, sumRows);
        bool vectorBusy = false;
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);

        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;

            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    if (vectorBusy) {
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    if (cN == 128) {
                        Max(x, x, x[64], 64, cm, {1, 1, 1, 16, 16, 16});
                        PipeBarrier<PIPE_V>();
                    }
                    for (int32_t r = 0; r < cm; r += 248) {
                        int32_t rows = cm - r < 248 ? cm - r : 248;
                        WholeReduceMax(rbuf[r], x[r * cN], cN < 64 ? cN : 64,
                            rows, 1, 1, cN / 8, ReduceOrder::ORDER_ONLY_VALUE);
                    }
                    PipeBarrier<PIPE_V>();
                    Max(running, running, rbuf, cm);
                    vectorBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
            }
            if (mt == 1 && ns == 1) {
                if (cm <= 64) WholeReduceSum(rbuf, running, cm, 1, 1, 1, 8);
                else bmms_sum(rbuf, running, sumTemp, cm);
                PipeBarrier<PIPE_V>();
                Adds(running, rbuf, 0.0f, 8);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        if (mt == 1 && ns == 1) { PipeBarrier<PIPE_ALL>(); return; }
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();


        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            if (ns > 1 && m % 8 == 0 && ns * m <= 8192) {
                DataCopyExtParams cp{1, (uint32_t)(ns * m) * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sumTemp, mg[(int64_t)batch * ns * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                Max(acc, sumTemp, sumTemp[m], m);
                for (int part = 2; part < ns; ++part) {
                    PipeBarrier<PIPE_V>();
                    Max(acc, acc, sumTemp[part * m], m);
                }
                PipeBarrier<PIPE_V>();
                bmms_sum(running, acc, sumTemp, m);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], running, op);
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            } else {

            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sx, mg[((int64_t)batch * ns + part) * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if (ns == 1) bmms_sum(rbuf, sx, sumTemp, m);
                else Max(acc, acc, sx, m);

            }
            auto out = running;
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else bmms_sum(out, acc, sumTemp, m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
}



template<class T, bool TA, bool TB, int TM = 0, int TN = 0, int TK = 0>
__global__ __aicore__ __mix__(1, 1) void bmms_manual_narrow(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns,
    int32_t dynamicM, int32_t dynamicN)
{
    constexpr bool useManual = true;
    const int32_t tileM = TM ? TM : dynamicM;
    const int32_t tileN = TN ? TN : dynamicN;
    if (TK) k = TK;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;

    // The host gate gives a single N tile and M >= 1024.
    ns = 1;
    constexpr bool partial = true;
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        // Hand-rolled cube path (no Matmul-library scheduler) for small problems, where the
        // library's per-task scalar/icache cost dominates the actual MAC time.
        const int32_t mp = tileM, np = tileN;
        int32_t bk = (32768 / (mp > np ? mp : np)) / 16 * 16;
        if (bk > k) bk = k;
        LocalTensor<T> l1a(TPosition::A1, 0, mp * bk);
        LocalTensor<T> l1b(TPosition::B1, mp * bk * 2, np * bk);
        LocalTensor<T> l0a(TPosition::A2, 0, mp * bk);
        LocalTensor<T> l0b(TPosition::B2, 0, np * bk);
        LocalTensor<float> l0c(TPosition::CO1, 0, mp * np);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                if (t - begin >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                if (useManual) {
                    const int32_t cm16 = (cm + 15) / 16 * 16;
                    const int32_t cn16 = (cn + 15) / 16 * 16;
                    const int64_t aBase = (int64_t)batch * m * k + (TA ? (int64_t)mi : (int64_t)mi * k);
                    const int64_t bBase = (int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni);
                    for (int32_t k0 = 0; k0 < k; k0 += bk) {
                        int32_t kk = (k0 + bk <= k) ? bk : (k - k0);
                        int32_t kk16 = (kk + 15) / 16 * 16;
                        // Close the pipe hazards left by the previous chunk/tile before rewriting L1/L0.
                        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                        if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                        // ---- GM(ND) -> L1(NZ) ----
                        Nd2NzParams pa;
                        pa.ndNum = 1;
                        pa.dstNzNStride = 1;
                        pa.dstNzMatrixStride = 0;
                        pa.srcNdMatrixStride = 1;
                        int64_t aOff = aBase;
                        if (!TA) {
                            pa.nValue = (uint16_t)cm; pa.dValue = (uint16_t)kk;
                            pa.srcDValue = (uint16_t)k; pa.dstNzC0Stride = (uint16_t)cm16;
                            aOff += k0;
                        } else {
                            pa.nValue = (uint16_t)kk; pa.dValue = (uint16_t)cm;
                            pa.srcDValue = (uint16_t)m; pa.dstNzC0Stride = (uint16_t)kk16;
                            aOff += (int64_t)k0 * m;
                        }
                        Nd2NzParams pb;
                        pb.ndNum = 1;
                        pb.dstNzNStride = 1;
                        pb.dstNzMatrixStride = 0;
                        pb.srcNdMatrixStride = 1;
                        pb.dstNzC0Stride = (uint16_t)(TB ? cn16 : kk16);
                        int64_t bOff = bBase;
                        if (!TB) {
                            pb.nValue = (uint16_t)kk; pb.dValue = (uint16_t)cn;
                            pb.srcDValue = (uint16_t)n;
                            bOff += (int64_t)k0 * n;
                        } else {
                            pb.nValue = (uint16_t)cn; pb.dValue = (uint16_t)kk;
                            pb.srcDValue = (uint16_t)k;
                            bOff += k0;
                        }
                        DataCopy(l1a, ag[aOff], pa);
                        DataCopy(l1b, bg[bOff], pb);
                        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        // ---- L1 -> L0A / L0B ----
                        const int32_t bm = cm16 / 16;
                        const int32_t bn = cn16 / 16;
                        const int32_t bkk = kk16 / 16;
                        LoadData2dParams lp;
                        lp.startIndex = 0;
                        lp.sid = 0;
                        lp.dstGap = 0;
                        if (!TA) {
                            lp.ifTranspose = false;
                            if (bkk == 1) {
                                lp.repeatTimes = (uint8_t)bm;
                                lp.srcStride = 1;
                                LoadData(l0a, l1a, lp);
                            } else if (bm > bkk) {
                                lp.repeatTimes = (uint8_t)bm;
                                lp.srcStride = 1; lp.dstGap = bkk - 1;
                                for (int32_t j = 0; j < bkk; ++j)
                                    LoadData(l0a[j * 256], l1a[j * bm * 256], lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = (uint8_t)bm;
                                for (int32_t i = 0; i < bm; ++i) {
                                    LoadData(l0a[i * bkk * 256], l1a[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = true;
                            lp.repeatTimes = (uint8_t)(bm * bkk);
                            lp.srcStride = 1;
                            LoadData(l0a, l1a, lp);
                        }
                        lp.dstGap = 0;
                        if (!TB) {
                            lp.ifTranspose = true;
                            if (bn == 1) {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = 1;
                                LoadData(l0b, l1b, lp);
                            } else if (bn < bkk) {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = 1; lp.dstGap = bn - 1;
                                for (int32_t j = 0; j < bn; ++j)
                                    LoadData(l0b[j * 256], l1b[j * bkk * 256], lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bn;
                                lp.srcStride = (uint8_t)bkk;
                                for (int32_t i = 0; i < bkk; ++i) {
                                    LoadData(l0b[i * bn * 256], l1b[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = false;
                            lp.repeatTimes = (uint8_t)(bn * bkk);
                            lp.srcStride = 1;
                            LoadData(l0b, l1b, lp);
                        }
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);   // L1 reusable
                        l1Busy = true;
                        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        // ---- Mmad ----
                        MmadParams mmp;
                        mmp.m = (uint16_t)cm16;
                        mmp.n = (uint16_t)cn16;
                        mmp.k = (uint16_t)kk16;
                        mmp.isBias = false;
                        mmp.cmatrixSource = false;
                        mmp.cmatrixInitVal = (k0 == 0);
                        mmp.unitFlag = 0;
                        Mmad(l0c, l0a, l0b, mmp);
                        SetFlag<HardEvent::M_MTE1>(EVENT_ID3);      // L0 reusable
                        l0Busy = true;
                    }
                    SetFlag<HardEvent::M_FIX>(EVENT_ID0);           // L0C ready
                    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                    FixpipeParamsV220 fp;
                    fp.nSize = (uint16_t)cn16;
                    fp.mSize = (uint16_t)cm16;
                    fp.srcStride = (uint16_t)cm16;
                    fp.dstStride = (uint32_t)tileN;
                    fp.reluEn = false;
                    fp.ndNum = 1;
                    fp.srcNdStride = 0;
                    fp.dstNdStride = 0;
                    Fixpipe(sg[coreOffset + (int64_t)slot * tileM * tileN], l0c, fp);
                    SetFlag<HardEvent::FIX_M>(EVENT_ID0);
                    fixBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
            }
            CrossCoreWaitFlag(10);
            if (end - begin > 1) CrossCoreWaitFlag(15);
        }
        if (useManual) {
            if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
            if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }

    }
    if ASCEND_IS_AIV {
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t vrows = (tileM + 7) / 8 * 8;
        const int32_t sumRows = (m + 7) / 8 * 8;
        const int32_t stageBytes = tileM * cN * 4;
        LocalTensor<float> x(TPosition::VECIN, 0, tileM * cN);
        LocalTensor<float> running(TPosition::VECCALC, stageBytes, vrows);
        LocalTensor<float> rbuf(TPosition::VECCALC, stageBytes + vrows * 4, vrows);
        LocalTensor<float> sumTemp(TPosition::VECCALC, stageBytes + vrows * 8, 8192);
        LocalTensor<float> sx(TPosition::VECIN, stageBytes + vrows * 8 + 32768, sumRows);
        LocalTensor<float> acc(TPosition::VECCALC, stageBytes + vrows * 8 + 32768 + sumRows * 4, sumRows);
        bool vectorBusy = false;
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);

        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;

            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    if (vectorBusy) {
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    if (cN == 128) {
                        Max(x, x, x[64], 64, cm, {1, 1, 1, 16, 16, 16});
                        PipeBarrier<PIPE_V>();
                    }
                    for (int32_t r = 0; r < cm; r += 248) {
                        int32_t rows = cm - r < 248 ? cm - r : 248;
                        WholeReduceMax(rbuf[r], x[r * cN], cN < 64 ? cN : 64,
                            rows, 1, 1, cN / 8, ReduceOrder::ORDER_ONLY_VALUE);
                    }
                    PipeBarrier<PIPE_V>();
                    Max(running, running, rbuf, cm);
                    vectorBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
            }
            if (mt == 1 && ns == 1) {
                if (cm <= 64) WholeReduceSum(rbuf, running, cm, 1, 1, 1, 8);
                else bmms_sum(rbuf, running, sumTemp, cm);
                PipeBarrier<PIPE_V>();
                Adds(running, rbuf, 0.0f, 8);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                if (partial) {
                    bmms_sum(rbuf, running, sumTemp, cm);
                    SetFlag<HardEvent::V_MTE3>(EVENT_ID1); WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
                    DataCopyExtParams cp{1, 4, 0, 0, 0};
                    DataCopyPad(mg[(int64_t)batch * mt + mi / tileM], rbuf, cp);
                } else {
                    DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                    DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
                }
            }
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        if (mt == 1 && ns == 1) { PipeBarrier<PIPE_ALL>(); return; }
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();


        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            if (partial) {
                DataCopyExtParams cp{1, (uint32_t)mt * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sx, mg[(int64_t)batch * mt], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID1); WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
                bmms_sum(running, sx, sumTemp, mt);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID1); WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
                DataCopyExtParams op{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, op);
                SetFlag<HardEvent::MTE3_V>(EVENT_ID1); WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
                continue;
            }
            if (ns > 1 && m % 8 == 0 && ns * m <= 8192) {
                DataCopyExtParams cp{1, (uint32_t)(ns * m) * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sumTemp, mg[(int64_t)batch * ns * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                Max(acc, sumTemp, sumTemp[m], m);
                for (int part = 2; part < ns; ++part) {
                    PipeBarrier<PIPE_V>();
                    Max(acc, acc, sumTemp[part * m], m);
                }
                PipeBarrier<PIPE_V>();
                bmms_sum(running, acc, sumTemp, m);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], running, op);
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            } else {

            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sx, mg[((int64_t)batch * ns + part) * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if (ns == 1) bmms_sum(rbuf, sx, sumTemp, m);
                else Max(acc, acc, sx, m);

            }
            auto out = running;
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else bmms_sum(out, acc, sumTemp, m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
}


// Only base shape is constant; runtime tiling still owns L1 depths and full shapes.
template<int BM, int BN, int BK>
__aicore__ constexpr MatmulConfig bmms_static_mdl_config()
{
    MatmulConfig cfg = BMMS_MM_CFG;
    cfg.basicM = BM; cfg.basicN = BN; cfg.basicK = BK;
    return cfg;
}

template<class T, bool TA, bool TB, int BM, int BN, int BK>
__global__ __aicore__ __mix__(1, 1) void bmms_fused_static(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        constexpr static MatmulConfig shapeConfig = bmms_static_mdl_config<BM, BN, BK>();
        constexpr static auto staticTiling = GetMatmulApiTiling<AT, BT, CT, BiasT>(shapeConfig);
        MatmulImpl<AT, BT, CT, BiasT, staticTiling> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(m, n, k, k, tileN);
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                mm.SetSingleShape(cm, cn, k);
                mm.SetTensorA(ag[(int64_t)batch * m * k + (TA ? mi : (int64_t)mi * k)], TA);
                mm.SetTensorB(bg[(int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni)], TB);
                mm.IterateAll(sg[coreOffset + (int64_t)slot * tileM * tileN]);
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
        }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input, sumInput;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced, rowMax;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        pipe.InitBuffer(input, 1, tileM * cN * 4);
        pipe.InitBuffer(sumInput, 1, (m + 7) / 8 * 32);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        pipe.InitBuffer(rowMax, (m + 7) / 8 * 32);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto acc = rowMax.Get<float>();
            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                auto x = sumInput.AllocTensor<float>();
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(x, mg[((int64_t)batch * ns + part) * m], cp, pad);
                sumInput.EnQue(x); x = sumInput.DeQue<float>();
                if (ns == 1) ReduceSum(rbuf, x, sumTemp, m);
                else Max(acc, acc, x, m);
                sumInput.FreeTensor(x);
            }
            auto out = output.AllocTensor<float>();
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else ReduceSum(out, acc, sumTemp, m);
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
        }
    }
}

template<class T, bool TA, bool TB, int BM, int BN, int BK>
__global__ __aicore__ __mix__(1, 1) void bmms_batch_owned(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        constexpr static MatmulConfig shapeConfig = bmms_static_mdl_config<BM, BN, BK>();
        constexpr static auto staticTiling = GetMatmulApiTiling<AT, BT, CT, BiasT>(shapeConfig);
        MatmulImpl<AT, BT, CT, BiasT, staticTiling> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(m, n, k, k, tileN);
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t batch = core; batch < batches; batch += GetBlockNum())
        for (int32_t mi = 0; mi < m; mi += tileM) {
            const int32_t begin = 0, end = nt;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                mm.SetSingleShape(cm, cn, k);
                mm.SetTensorA(ag[(int64_t)batch * m * k + (TA ? mi : (int64_t)mi * k)], TA);
                mm.SetTensorB(bg[(int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni)], TB);
                mm.IterateAll(sg[coreOffset + (int64_t)slot * tileM * tileN]);
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
        }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced, rowMax, runningBuf;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        pipe.InitBuffer(input, 1, tileM * cN * 4);
        pipe.InitBuffer(output, 1, 32);
        pipe.InitBuffer(runningBuf, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        pipe.InitBuffer(rowMax, (m + 7) / 8 * 32);
        GlobalTensor<float> sg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t batch = core; batch < batches; batch += GetBlockNum())
        for (int32_t mi = 0; mi < m; mi += tileM) {
            const int32_t begin = 0, end = nt;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = runningBuf.Get<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            auto acc = rowMax.Get<float>();
            PipeBarrier<PIPE_V>();
            Adds(acc[mi], running, 0.0f, cm);
            PipeBarrier<PIPE_V>();
            if (mi + cm == m) {
                ReduceSum(rbuf, acc, temp.Get<float>(), m);
                auto out = output.AllocTensor<float>();
                Adds(out, rbuf, 0.0f, 8);
                output.EnQue(out); out = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], out, cp);
                output.FreeTensor(out);
            }
        }
    }
}

template<class T, bool TA, bool TB>
__global__ __aicore__ __mix__(1, 1) void bmms_fused(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        MatmulImpl<AT, BT, CT, BiasT, BMMS_MM_CFG> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(m, n, k, k, tileN);
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                mm.SetSingleShape(cm, cn, k);
                mm.SetTensorA(ag[(int64_t)batch * m * k + (TA ? mi : (int64_t)mi * k)], TA);
                mm.SetTensorB(bg[(int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni)], TB);
                mm.IterateAll(sg[coreOffset + (int64_t)slot * tileM * tileN]);
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
        }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input, sumInput;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced, rowMax;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        pipe.InitBuffer(input, 1, tileM * cN * 4);
        pipe.InitBuffer(sumInput, 1, (m + 7) / 8 * 32);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        pipe.InitBuffer(rowMax, (m + 7) / 8 * 32);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto acc = rowMax.Get<float>();
            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                auto x = sumInput.AllocTensor<float>();
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(x, mg[((int64_t)batch * ns + part) * m], cp, pad);
                sumInput.EnQue(x); x = sumInput.DeQue<float>();
                if (ns == 1) ReduceSum(rbuf, x, sumTemp, m);
                else Max(acc, acc, x, m);
                sumInput.FreeTensor(x);
            }
            auto out = output.AllocTensor<float>();
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else ReduceSum(out, acc, sumTemp, m);
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
        }
    }
}

template<class T, bool TA, bool TB, int BM, int BN, int BK>
__global__ __aicore__ __mix__(1, 1) void bmms_pair_static(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    constexpr bool PAIR = true, FULLA = false;
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<(FULLA ? TPosition::A1 : TPosition::GM), (FULLA ? CubeFormat::NZ : CubeFormat::ND), T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        constexpr static MatmulConfig shapeConfig = bmms_static_mdl_config<BM, BN, BK>();
        constexpr static auto staticTiling = GetMatmulApiTiling<AT, BT, CT, BiasT>(shapeConfig);
        MatmulImpl<AT, BT, CT, BiasT, staticTiling> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        TBuf<TPosition::A1> fullA;
        LocalTensor<T> residentA;
        if constexpr(FULLA) {
            pipe.InitBuffer(fullA, tileM*k*2);
            residentA=fullA.template Get<T>();
        }
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(FULLA ? tileM : m, n, FULLA ? k/2 : k, k, tileN);
        decltype(pipe.FetchEventID(HardEvent::MTE2_MTE1)) aReady{},aReleased{};
        if constexpr(FULLA) {
            aReady=pipe.FetchEventID(HardEvent::MTE2_MTE1);
            aReleased=pipe.FetchEventID(HardEvent::MTE1_MTE2);
        }
        bool aBusy=false;
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            if constexpr(FULLA) {
                if(aBusy) WaitFlag<HardEvent::MTE1_MTE2>(aReleased);
                const int32_t halfK=k/2;
                Nd2NzParams pa{1, (uint16_t)(TA ? halfK : tileM), (uint16_t)(TA ? tileM : halfK), 0,
                    (uint16_t)(TA ? m : k), (uint16_t)(TA ? halfK : tileM), 1, 0};
                for(int32_t q=0;q<2;++q) {
                    const int64_t offset=(int64_t)batch*m*k+(TA ? (int64_t)q*halfK*m+mi : (int64_t)mi*k+q*halfK);
                    DataCopy(residentA[q*tileM*halfK],ag[offset],pa);
                }
                SetFlag<HardEvent::MTE2_MTE1>(aReady);
                WaitFlag<HardEvent::MTE2_MTE1>(aReady);
            }
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int halfK = PAIR ? k/2 : k;
                for(int q=0;q<(PAIR ? 2 : 1);++q) {
                    const int pos=q*halfK;
                    mm.SetSingleShape(cm,cn,halfK);
                    if constexpr(FULLA) mm.SetTensorA(residentA[pos*tileM],TA);
                    else mm.SetTensorA(ag[(int64_t)batch*m*k+(TA ? (int64_t)pos*m+mi : (int64_t)mi*k+pos)],TA);
                    mm.SetTensorB(bg[(int64_t)batch*n*k+(TB ? (int64_t)ni*k+pos : (int64_t)pos*n+ni)],TB);
                    mm.IterateAll(sg[coreOffset+(int64_t)slot*tileM*tileN],uint8_t(q));
                    // SDK unitFlag coordinates L0C reuse with the FIX pipeline.
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
            if constexpr(FULLA) { SetFlag<HardEvent::MTE1_MTE2>(aReleased); aBusy=true; }
        }
        if constexpr(FULLA) { if(aBusy) WaitFlag<HardEvent::MTE1_MTE2>(aReleased); }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input, sumInput;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced, rowMax;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        pipe.InitBuffer(input, 1, tileM * cN * 4);
        pipe.InitBuffer(sumInput, 1, (m + 7) / 8 * 32);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        pipe.InitBuffer(rowMax, (m + 7) / 8 * 32);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto acc = rowMax.Get<float>();
            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                auto x = sumInput.AllocTensor<float>();
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(x, mg[((int64_t)batch * ns + part) * m], cp, pad);
                sumInput.EnQue(x); x = sumInput.DeQue<float>();
                if (ns == 1) ReduceSum(rbuf, x, sumTemp, m);
                else Max(acc, acc, x, m);
                sumInput.FreeTensor(x);
            }
            auto out = output.AllocTensor<float>();
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else ReduceSum(out, acc, sumTemp, m);
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
        }
    }
}

template<class T, bool TA, bool TB, bool PAIR=false, bool FULLA=false>
__global__ __aicore__ __mix__(1, 1) void bmms_resident(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<(FULLA ? TPosition::A1 : TPosition::GM), (FULLA ? CubeFormat::NZ : CubeFormat::ND), T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        MatmulImpl<AT, BT, CT, BiasT, BMMS_MM_CFG> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        TBuf<TPosition::A1> fullA;
        LocalTensor<T> residentA;
        if constexpr(FULLA) {
            pipe.InitBuffer(fullA, tileM*k*2);
            residentA=fullA.template Get<T>();
        }
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(FULLA ? tileM : m, n, FULLA ? k/2 : k, k, tileN);
        decltype(pipe.FetchEventID(HardEvent::MTE2_MTE1)) aReady{},aReleased{};
        if constexpr(FULLA) {
            aReady=pipe.FetchEventID(HardEvent::MTE2_MTE1);
            aReleased=pipe.FetchEventID(HardEvent::MTE1_MTE2);
        }
        bool aBusy=false;
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            if constexpr(FULLA) {
                if(aBusy) WaitFlag<HardEvent::MTE1_MTE2>(aReleased);
                const int32_t halfK=k/2;
                Nd2NzParams pa{1, (uint16_t)(TA ? halfK : tileM), (uint16_t)(TA ? tileM : halfK), 0,
                    (uint16_t)(TA ? m : k), (uint16_t)(TA ? halfK : tileM), 1, 0};
                for(int32_t q=0;q<2;++q) {
                    const int64_t offset=(int64_t)batch*m*k+(TA ? (int64_t)q*halfK*m+mi : (int64_t)mi*k+q*halfK);
                    DataCopy(residentA[q*tileM*halfK],ag[offset],pa);
                }
                SetFlag<HardEvent::MTE2_MTE1>(aReady);
                WaitFlag<HardEvent::MTE2_MTE1>(aReady);
            }
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int halfK = PAIR ? k/2 : k;
                for(int q=0;q<(PAIR ? 2 : 1);++q) {
                    const int pos=q*halfK;
                    mm.SetSingleShape(cm,cn,(PAIR && q == 1) ? k - halfK : halfK);
                    if constexpr(FULLA) mm.SetTensorA(residentA[pos*tileM],TA);
                    else mm.SetTensorA(ag[(int64_t)batch*m*k+(TA ? (int64_t)pos*m+mi : (int64_t)mi*k+pos)],TA);
                    mm.SetTensorB(bg[(int64_t)batch*n*k+(TB ? (int64_t)ni*k+pos : (int64_t)pos*n+ni)],TB);
                    mm.IterateAll(sg[coreOffset+(int64_t)slot*tileM*tileN],uint8_t(q));
                    // SDK unitFlag coordinates L0C reuse with the FIX pipeline.
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
            if constexpr(FULLA) { SetFlag<HardEvent::MTE1_MTE2>(aReleased); aBusy=true; }
        }
        if constexpr(FULLA) { if(aBusy) WaitFlag<HardEvent::MTE1_MTE2>(aReleased); }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input, sumInput;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced, rowMax;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        pipe.InitBuffer(input, 1, tileM * cN * 4);
        pipe.InitBuffer(sumInput, 1, (m + 7) / 8 * 32);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        pipe.InitBuffer(rowMax, (m + 7) / 8 * 32);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto acc = rowMax.Get<float>();
            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                auto x = sumInput.AllocTensor<float>();
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(x, mg[((int64_t)batch * ns + part) * m], cp, pad);
                sumInput.EnQue(x); x = sumInput.DeQue<float>();
                if (ns == 1) ReduceSum(rbuf, x, sumTemp, m);
                else Max(acc, acc, x, m);
                sumInput.FreeTensor(x);
            }
            auto out = output.AllocTensor<float>();
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else ReduceSum(out, acc, sumTemp, m);
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
        }
    }
}

// Store the two inputs as GM NZ tensors. The original values are copied bitwise.
// UB = two 64 KiB buffers, reused after the prepack phase completes.
// The helper runs inside the mixed compute kernel; it never launches a second kernel.
template<class T, bool TA, bool TB>
__aicore__ inline void bmms_pack_nz(GM_ADDR a, GM_ADDR b,
    GM_ADDR pa, GM_ADDR pb, int batches, int m, int n, int k, int kp, int mp, int np)
{
    LocalTensor<T> x(TPosition::VECIN,0,32768), z(TPosition::VECOUT,65536,32768);
    GlobalTensor<T> src,dst;
    const int ar=TA?kp:mp, ac=TA?mp:kp;
    const int br=TB?np:kp, bc=TB?kp:np;
    const int at=batches*((ar+127)/128)*((ac+255)/256);
    const int bt=batches*((br+127)/128)*((bc+255)/256);
    // Flatten the operand grids so each Vector peer receives the same number of tiles.
    for(int work=GetBlockIdx();work<at+bt;work+=GetBlockNum()) {
        const int operand=work>=at;
        const int task=operand?work-at:work;
        src.SetGlobalBuffer((__gm__ T*)(operand?b:a));dst.SetGlobalBuffer((__gm__ T*)(operand?pb:pa));
        const int sr=operand?(TB?n:k):(TA?k:m), sc=operand?(TB?k:n):(TA?m:k);
        const int dr=operand?br:ar, dc=operand?bc:ac;
        const int rt=(dr+127)/128,ct=(dc+255)/256;
            const int batch=task/(rt*ct),ri=(task/ct)%rt*128,ci=task%ct*256;
            const int rows=dr-ri<128?dr-ri:128,cols=dc-ci<256?dc-ci:256;
            const int vr=ri>=sr?0:(sr-ri<rows?sr-ri:rows),vc=ci>=sc?0:(sc-ci<cols?sc-ci:cols);
            Duplicate(x,(T)0,rows*256);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            if(vr&&vc) {
                DataCopyExtParams cp{(uint16_t)vr,(uint32_t)vc*2,(uint32_t)(sc-vc)*2,
                    (uint32_t)(256-(vc+15)/16*16)/16,0};
                DataCopyPadExtParams<T> pad{true,0,(uint8_t)((16-vc%16)%16),(T)0};
                DataCopyPad(x,src[(int64_t)batch*sr*sc+(int64_t)ri*sc+ci],cp,pad);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            for(int c=0;c<cols/16;++c)
                Copy(z[c*rows*16].template ReinterpretCast<uint32_t>(),
                    x[c*16].template ReinterpretCast<uint32_t>(),8,rows,{1,1,1,16});
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{(uint16_t)(cols/16),(uint32_t)rows*16*2,0,(uint32_t)(dr-rows)*16*2,0};
            DataCopyPad(dst[(int64_t)batch*dr*dc+(int64_t)ci*dr+ri*16],z,op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

template<class T, bool TA, bool TB, bool NZ=false>
__global__ __aicore__ __mix__(1, 1) void bmms_fused_nz(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling, int32_t storeM, int32_t storeN, GM_ADDR packedA, GM_ADDR packedB, int32_t originalK)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIV {
        bmms_pack_nz<T, TA, TB>(a, b, packedA, packedB, batches, m, n, originalK, k, storeM, storeN);
        // Every operand tile must be visible before any Cube starts reading NZ inputs.
        SyncAll<true>();
        CrossCoreSetFlag<2, PIPE_MTE3>(7);
    }
    if ASCEND_IS_AIC {
        CrossCoreWaitFlag(7);
        using AT = MatmulType<TPosition::GM, NZ?CubeFormat::NZ:CubeFormat::ND, T, TA>;
        using BT = MatmulType<TPosition::GM, NZ?CubeFormat::NZ:CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        MatmulImpl<AT, BT, CT, BiasT, BMMS_MM_CFG> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)packedA); bg.SetGlobalBuffer((__gm__ T*)packedB);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(storeM, storeN, k, k, tileN);
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                mm.SetSingleShape(storeM==m ? cm : tileM, storeN==n ? cn : tileN, k);
                mm.SetTensorA(ag[(int64_t)batch * storeM * k + (NZ ? (TA ? (int64_t)mi*k : (int64_t)mi*16) : (TA ? (int64_t)mi : (int64_t)mi*k))], TA);
                mm.SetTensorB(bg[(int64_t)batch * storeN * k + (NZ ? (TB ? (int64_t)ni*16 : (int64_t)ni*k) : (TB ? (int64_t)ni*k : (int64_t)ni))], TB);
                mm.IterateAll(sg[coreOffset + (int64_t)slot * tileM * tileN]);
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
        }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input, sumInput;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced, rowMax;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        pipe.InitBuffer(input, 1, tileM * cN * 4);
        pipe.InitBuffer(sumInput, 1, (m + 7) / 8 * 32);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        pipe.InitBuffer(rowMax, (m + 7) / 8 * 32);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto acc = rowMax.Get<float>();
            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                auto x = sumInput.AllocTensor<float>();
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(x, mg[((int64_t)batch * ns + part) * m], cp, pad);
                sumInput.EnQue(x); x = sumInput.DeQue<float>();
                if (ns == 1) {
                    if (NZ) bmms_paired_sum(rbuf, x, sumTemp, m);
                    else ReduceSum(rbuf, x, sumTemp, m);
                }
                else Max(acc, acc, x, m);
                sumInput.FreeTensor(x);
            }
            auto out = output.AllocTensor<float>();
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else {
                if (NZ) bmms_paired_sum(out, acc, sumTemp, m);
                else ReduceSum(out, acc, sumTemp, m);
            }
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
        }
    }
}


// Short contiguous K rows: Vector scales better beyond one Cube batch wave.
template<class T>
__global__ __aicore__ __vector__ void bmms_vector_short_nt(
    GM_ADDR a,GM_ADDR b,GM_ADDR y,int32_t batches,int32_t m,int32_t n,int32_t k)
{
    constexpr int MP=8,NP=16,KP=64;
    constexpr int AR=0,BR=1024,AF=3072,BF=5120,PROD=9216,DOTS=13312,MAXIMA=13824,OUT=13856;
    constexpr int UB_BYTES=OUT+32;
    static_assert(UB_BYTES==13888 && UB_BYTES<=180*1024,"short NT UB budget");
    LocalTensor<T> ar(TPosition::VECIN,AR,MP*KP),br(TPosition::VECIN,BR,NP*KP);
    LocalTensor<float> af(TPosition::VECCALC,AF,MP*KP),bf(TPosition::VECCALC,BF,NP*KP);
    LocalTensor<float> prod(TPosition::VECCALC,PROD,NP*KP),dots(TPosition::VECCALC,DOTS,MP*NP);
    LocalTensor<float> maxima(TPosition::VECCALC,MAXIMA,8),out(TPosition::VECOUT,OUT,8);
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    for(int batch=GetBlockIdx();batch<batches;batch+=GetBlockNum()) {
        DataCopyExtParams ac{1,(uint32_t)(m*k*2),0,0,0},bc{1,(uint32_t)(n*k*2),0,0,0};
        DataCopyPadExtParams<T> ap{true,0,(uint8_t)((16-m*k%16)%16),(T)0};
        DataCopyPadExtParams<T> bp{true,0,(uint8_t)((16-n*k%16)%16),(T)0};
        DataCopyPad(ar,ag[(int64_t)batch*m*k],ac,ap);
        DataCopyPad(br,bg[(int64_t)batch*n*k],bc,bp);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af,ar,RoundMode::CAST_NONE,m*k);Cast(bf,br,RoundMode::CAST_NONE,n*k);
        PipeBarrier<PIPE_V>();
        for(int row=0;row<m;++row) {
            Mul(prod,af[row*k],bf,k,n,{1,1,1,(uint8_t)(k/8),0,(uint8_t)(k/8)});
            PipeBarrier<PIPE_V>();
            WholeReduceSum(dots[row*NP],prod,k,n,1,1,k/8);
            PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(maxima,dots,n,m,1,1,NP/8,ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(out,maxima,m,1,1,1,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);
        if(batch+GetBlockNum()<batches) {
            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

template<class T, int KK = 0, bool ONCE = false>
__global__ __aicore__ __vector__ void bmms_dot(GM_ADDR a, GM_ADDR b, GM_ADDR y, int32_t batches, int32_t k)
{
    if (KK) k = KK;
    int32_t ak = (k + 15) / 16 * 16;
    LocalTensor<T> al(TPosition::VECIN, 0, ak), bl(TPosition::VECIN, ak * 2, ak);
    LocalTensor<float> af(TPosition::VECCALC, ak * 4, ak), bf(TPosition::VECCALC, ak * 8, ak);
    LocalTensor<float> tmp(TPosition::VECCALC, ak * 12, 128);
    LocalTensor<float> out(TPosition::VECOUT, ak * 12 + 512, 8);
    GlobalTensor<T> ag, bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b); yg.SetGlobalBuffer((__gm__ float*)y);
    int32_t batch = GetBlockIdx();
    do {
        DataCopyExtParams cp{1, (uint32_t)k * 2, 0, 0, 0};
        DataCopyPadExtParams<T> pad{false, 0, 0, (T)0};
        DataCopyPad(al, ag[(int64_t)batch * k], cp, pad);
        DataCopyPad(bl, bg[(int64_t)batch * k], cp, pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af, al, RoundMode::CAST_NONE, k); Cast(bf, bl, RoundMode::CAST_NONE, k);
        PipeBarrier<PIPE_V>();
        Mul(af, af, bf, k);
        PipeBarrier<PIPE_V>();
        bmms_sum(out, af, tmp, k);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], out, op);
        if (!ONCE) {
            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0); WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
        batch += GetBlockNum();
    } while (!ONCE && batch < batches);
    PipeBarrier<PIPE_ALL>();
}

__aicore__ inline void bmms_transpose_index(const LocalTensor<int32_t>& ix,
    const LocalTensor<int32_t>& group, const LocalTensor<int32_t>& tmp,
    int32_t count, int32_t logRows, int32_t logCols)
{
    #pragma unroll
    for (int32_t j = 0; j < 8; ++j) ix.SetValue(j, j);
    SetFlag<HardEvent::S_V>(EVENT_ID0); WaitFlag<HardEvent::S_V>(EVENT_ID0);
    for (int32_t len = 8; len < count; len *= 2) {
        Adds(ix[len], ix, len, len);
        PipeBarrier<PIPE_V>();
    }
    PipeBarrier<PIPE_V>();
    ShiftRight(group, ix, logCols, count);
    PipeBarrier<PIPE_V>();
    ShiftLeft(tmp, group, logCols, count);
    PipeBarrier<PIPE_V>();
    Sub(ix, ix, tmp, count);
    PipeBarrier<PIPE_V>();
    ShiftLeft(ix, ix, logRows, count);
    PipeBarrier<PIPE_V>();
    Add(ix, ix, group, count);
    PipeBarrier<PIPE_V>();
    ShiftLeft(ix, ix, int32_t(2), count);
    PipeBarrier<PIPE_V>();
}

template<class T, bool TA, bool TB, int MN, int KK>
__global__ __aicore__ __vector__ void bmms_tiny(GM_ADDR a, GM_ADDR b, GM_ADDR y, int32_t batches)
{
    constexpr int sz = MN * KK;
    constexpr int lm = MN == 8 ? 3 : 4;
    constexpr int lk = KK == 32 ? 5 : 6;
    LocalTensor<T> ar(TPosition::VECIN, 0, sz), br(TPosition::VECIN, sz * 2, sz);
    LocalTensor<float> av(TPosition::VECCALC, sz * 4, sz), bv(TPosition::VECCALC, sz * 8, sz);
    LocalTensor<float> af(TPosition::VECCALC, sz * 12, sz), bf(TPosition::VECCALC, sz * 16, sz);
    LocalTensor<int32_t> ix(TPosition::VECCALC, sz * 20, sz), group(TPosition::VECCALC, sz * 24, sz);
    LocalTensor<int32_t> itmp(TPosition::VECCALC, sz * 28, sz);
    LocalTensor<float> broad(TPosition::VECCALC, sz * 32, sz), prod(TPosition::VECCALC, sz * 36, sz);
    LocalTensor<float> maxima(TPosition::VECOUT, sz * 40, MN * 8);
    GlobalTensor<T> ag, bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b); yg.SetGlobalBuffer((__gm__ float*)y);
    for (int batch = GetBlockIdx(); batch < batches; batch += GetBlockNum()) {
        DataCopy(ar, ag[batch * sz], sz); DataCopy(br, bg[batch * sz], sz);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(av, ar, RoundMode::CAST_NONE, sz); Cast(bv, br, RoundMode::CAST_NONE, sz);
        PipeBarrier<PIPE_V>();
        if (TA) {
            bmms_transpose_index(ix, group, itmp, sz, lm, lk);
            Gather(af, av, ix.ReinterpretCast<uint32_t>(), 0, sz);
        } else af = av;
        if (TB) {
            bmms_transpose_index(ix, group, itmp, sz, lk, lm);
            Gather(bf, bv, ix.ReinterpretCast<uint32_t>(), 0, sz);
        } else bf = bv;
        PipeBarrier<PIPE_V>();
        #pragma unroll
        for (int row = 0; row < MN; ++row) {
            Brcb(broad, af[row * KK], KK / 8, {MN / 8, MN});
            if (MN == 16) Brcb(broad[8], af[row * KK], KK / 8, {2, 16});
            PipeBarrier<PIPE_V>();
            Mul(prod, broad, bf, sz);
            PipeBarrier<PIPE_V>();
            #pragma unroll
            for (int rows = KK / 2; rows > 0; rows /= 2) {
                Add(prod, prod, prod[rows * MN], rows * MN);
                PipeBarrier<PIPE_V>();
            }
            WholeReduceMax(maxima[row * 8], prod, MN, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
        }
        #pragma unroll
        for (int rows = MN / 2; rows > 0; rows /= 2) {
            Add(maxima, maxima, maxima[rows * 8], rows * 8);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], maxima, op);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0); WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}


template<class T, bool TA, bool TB, int KP>
__global__ __aicore__ __vector__ void bmms_micro(GM_ADDR a, GM_ADDR b, GM_ADDR y,
    int32_t batches, int32_t m, int32_t n, int32_t k)
{
    constexpr int elems = 16 * KP, bytes = elems * 4;
    constexpr int lk = KP == 16 ? 4 : KP == 32 ? 5 : KP == 64 ? 6 : 7;
    LocalTensor<T> ar(TPosition::VECIN, 0, elems), br(TPosition::VECIN, bytes / 2, elems);
    LocalTensor<float> af(TPosition::VECCALC, bytes, elems), bf(TPosition::VECCALC, 2 * bytes, elems);
    LocalTensor<float> bp(TPosition::VECCALC, 3 * bytes, elems), prod(TPosition::VECCALC, 4 * bytes, elems);
    LocalTensor<float> broad(TPosition::VECCALC, 5 * bytes, elems);
    LocalTensor<int32_t> ix(TPosition::VECCALC, 6 * bytes, elems), group(TPosition::VECCALC, 7 * bytes, elems);
    LocalTensor<int32_t> tmp(TPosition::VECCALC, 8 * bytes, elems);
    LocalTensor<float> arow(TPosition::VECCALC, 9 * bytes, KP);
    LocalTensor<int32_t> aix(TPosition::VECCALC, 9 * bytes + KP * 4, KP);
    LocalTensor<float> maxima(TPosition::VECOUT, 10 * bytes, 64);
    GlobalTensor<T> ag, bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b); yg.SetGlobalBuffer((__gm__ float*)y);
    if (TA || m > 1) {
        #pragma unroll
        for (int j = 0; j < 8; ++j) aix.SetValue(j, j);
        SetFlag<HardEvent::S_V>(EVENT_ID0); WaitFlag<HardEvent::S_V>(EVENT_ID0);
        #pragma unroll
        for (int len = 8; len < KP; len *= 2) {
            Adds(aix[len], aix, len, len); PipeBarrier<PIPE_V>();
        }
        ShiftLeft(aix, aix, int32_t(6), KP); PipeBarrier<PIPE_V>();
    }
    for (int batch = GetBlockIdx(); batch < batches; batch += GetBlockNum()) {
        Duplicate(ar, (T)0, elems); Duplicate(br, (T)0, elems);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0); WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyExtParams ac{(uint16_t)(TA ? k : m), (uint32_t)(TA ? m : k) * 2,
            0, (uint32_t)(TA ? 0 : (KP - ((k + 15) / 16 * 16)) / 16), 0};
        DataCopyExtParams bc{(uint16_t)(TB ? n : k), (uint32_t)(TB ? k : n) * 2,
            0, (uint32_t)(TB ? (KP - ((k + 15) / 16 * 16)) / 16 : 0), 0};
        DataCopyPadExtParams<T> ap{true, 0, (uint8_t)((16 - (TA ? m : k) % 16) % 16), (T)0};
        DataCopyPadExtParams<T> bpads{true, 0, (uint8_t)((16 - (TB ? k : n) % 16) % 16), (T)0};
        DataCopyPad(ar, ag[(int64_t)batch * m * k], ac, ap);
        DataCopyPad(br, bg[(int64_t)batch * n * k], bc, bpads);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af, ar, RoundMode::CAST_NONE, elems); Cast(bf, br, RoundMode::CAST_NONE, elems);
        PipeBarrier<PIPE_V>();
        if (TB) {
            bmms_transpose_index(ix, group, tmp, elems, lk, 4);
            Gather(bp, bf, ix.ReinterpretCast<uint32_t>(), 0, elems);
            PipeBarrier<PIPE_V>();
        } else bp = bf;
        for (int row = 0; row < m; ++row) {
            if (TA) {
                Gather(arow, af, aix.ReinterpretCast<uint32_t>(), row * 4, KP);
                PipeBarrier<PIPE_V>();
            } else arow = af[row * KP];
            Brcb(broad, arow, KP / 8, {2, 16});
            Brcb(broad[8], arow, KP / 8, {2, 16});
            PipeBarrier<PIPE_V>();
            Mul(prod, broad, bp, elems); PipeBarrier<PIPE_V>();
            #pragma unroll
            for (int half = KP / 2; half > 0; half /= 2) {
                Add(prod, prod, prod[half * 16], half * 16); PipeBarrier<PIPE_V>();
            }
            WholeReduceMax(maxima[row * 8], prod, n, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
        }
        if (m > 1) {
            ShiftRight(ix, aix, int32_t(1), KP); PipeBarrier<PIPE_V>();
            LocalTensor<float> sumInput(TPosition::VECCALC, 9 * bytes, KP);
            Gather(sumInput, maxima, ix.ReinterpretCast<uint32_t>(), 0, m);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(maxima, sumInput, m, 1, 1, 1, 8);
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], maxima, op);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

// Short M/N, long K: parallel dot-product segments, then combine matrices before MaxSim.
template<class T, bool TA, bool TB>
__global__ __aicore__ __mix__(1, 1) void bmms_split64(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR partialSums, GM_ADDR y, int32_t batches, int32_t k, int32_t parts)
{
    constexpr int M = 64, N = 64, BK = 512, ROWS = 16, ROW_TILES = M / ROWS;
    const int core = GetBlockIdx();
    GlobalTensor<float> sg, pg, yg;
    sg.SetGlobalBuffer((__gm__ float*)scratch);
    pg.SetGlobalBuffer((__gm__ float*)partialSums);
    yg.SetGlobalBuffer((__gm__ float*)y);
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<T> la(TPosition::A1, 0, M * BK), lb(TPosition::B1, M * BK * 2, N * BK);
        LocalTensor<T> aa(TPosition::A2, 0, M * BK), bb(TPosition::B2, 0, N * BK);
        LocalTensor<float> cc(TPosition::CO1, 0, M * N);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int task = core; task < batches * parts; task += GetBlockNum()) {
            const int batch = task / parts, part = task % parts;
            const int begin = (k / 16 * part / parts) * 16;
            const int end = (k / 16 * (part + 1) / parts) * 16;
            for (int pos = begin; pos < end; pos += BK) {
                const int kk = end - pos < BK ? end - pos : BK;
                if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                Nd2NzParams pa{1, (uint16_t)(TA ? kk : M), (uint16_t)(TA ? M : kk), 0,
                    (uint16_t)(TA ? M : k), (uint16_t)(TA ? kk : M), 1, 0};
                Nd2NzParams pb{1, (uint16_t)(TB ? N : kk), (uint16_t)(TB ? kk : N), 0,
                    (uint16_t)(TB ? k : N), (uint16_t)(TB ? N : kk), 1, 0};
                const int64_t ao = (int64_t)batch * M * k + (TA ? (int64_t)pos * M : pos);
                const int64_t bo = (int64_t)batch * N * k + (TB ? pos : (int64_t)pos * N);
                DataCopy(la, ag[ao], pa); DataCopy(lb, bg[bo], pb);
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0); WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                LoadData2dParams ap{0, (uint8_t)(kk / 16), TA ? 1 : M / 16, 0, 0, TA, 0};
                if (TA) { ap.repeatTimes = M * kk / 256; LoadData(aa, la, ap); }
                else {
                    #pragma unroll
                    for (int i = 0; i < M / 16; ++i) LoadData(aa[i * kk * 16], la[i * 256], ap);
                }
                LoadData2dParams bp{0, N / 16, (uint16_t)(TB ? 1 : kk / 16), 0, 0, !TB, 0};
                if (TB) { bp.repeatTimes = N * kk / 256; LoadData(bb, lb, bp); }
                else {
                    for (int i = 0; i < kk / 16; ++i) LoadData(bb[i * N * 16], lb[i * 256], bp);
                }
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0); l1Busy = true;
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0); WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                MmadParams mm{M, N, (uint16_t)kk, 0, false, pos == begin};
                Mmad(cc, aa, bb, mm);
                SetFlag<HardEvent::M_MTE1>(EVENT_ID3); l0Busy = true;
            }
            SetFlag<HardEvent::M_FIX>(EVENT_ID0); WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
            FixpipeParamsV220 fp;
            fp.mSize = M; fp.nSize = N; fp.srcStride = M; fp.dstStride = N;
            Fixpipe(sg[(int64_t)task * M * N], cc, fp);
            SetFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = true;
        }
        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
        if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
    }
    if ASCEND_IS_AIV {
        // At most 16 parts: 64 KiB staging, 64 B row maxima, 32 B output.
        LocalTensor<float> vx(TPosition::VECIN, 0, 16 * ROWS * N);
        LocalTensor<float> rm(TPosition::VECCALC, 16 * ROWS * N * 4, 32);
        LocalTensor<float> out(TPosition::VECOUT, 16 * ROWS * N * 4 + 128, 32);
        CrossCoreWaitFlag(8);
        SyncAll<true>();
        for (int task = core; task < batches * ROW_TILES; task += GetBlockNum()) {
            const int batch = task / ROW_TILES, row = (task % ROW_TILES) * ROWS;
            DataCopyExtParams cp{(uint16_t)parts, ROWS * N * 4, (M - ROWS) * N * 4, 0, 0};
            DataCopyPadExtParams<float> pad{false, 0, 0, 0};
            DataCopyPad(vx, sg[(int64_t)batch * parts * M * N + row * N], cp, pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            for (int count = parts; count > 1; count = (count + 1) / 2) {
                const int half = (count + 1) / 2;
                Add(vx, vx, vx[half * ROWS * N], (count - half) * ROWS * N);
                PipeBarrier<PIPE_V>();
            }
            WholeReduceMax(rm, vx, N, ROWS, 1, 1, N / 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(out, rm, ROWS, 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(pg[task], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();
        for (int batch = core; batch < batches; batch += GetBlockNum()) {
            DataCopyExtParams cp{1, ROW_TILES * 4, 0, 0, 0};
            DataCopyPadExtParams<float> pad{false, 0, 0, 0};
            DataCopyPad(rm, pg[batch * ROW_TILES], cp, pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WholeReduceSum(out, rm, ROW_TILES, 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

// One Cube/Vector pair per batch for matrices that fit in a single L0 tile.
template<class T, bool TA, bool TB, int MP, int NP, int MC = 0, int NC = 0, int KC = 0>
__global__ __aicore__ __mix__(1, 1) void bmms_direct(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR y, int32_t m, int32_t n, int32_t k)
{
    if (MC) m = MC; if (NC) n = NC; if (KC) k = KC;
    const int core = GetBlockIdx();
    GlobalTensor<float> sg; sg.SetGlobalBuffer((__gm__ float*)scratch);
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<T> la(TPosition::A1, 0, MP * 256), lb(TPosition::B1, MP * 256 * 2, NP * 256);
        LocalTensor<T> aa(TPosition::A2, 0, MP * 256), bb(TPosition::B2, 0, NP * 256);
        LocalTensor<float> cc(TPosition::CO1, 0, MP * NP);
        Nd2NzParams pa{1, (uint16_t)(TA ? k : m), (uint16_t)(TA ? m : k), 0,
            (uint16_t)(TA ? m : k), (uint16_t)(TA ? k : MP), 1, 0};
        Nd2NzParams pb{1, (uint16_t)(TB ? n : k), (uint16_t)(TB ? k : n), 0,
            (uint16_t)(TB ? k : n), (uint16_t)(TB ? NP : k), 1, 0};
        // A matrix with exactly one 16-column NZ block is already contiguous NZ.
        // Keep all padding and multi-block layouts on the original conversion path.
        if ((TA && m == MP && MP == 16) || (!TA && k == 16 && m == MP))
            DataCopy(la, ag[(int64_t)core * m * k], m * k);
        else DataCopy(la, ag[(int64_t)core * m * k], pa);
        if ((!TB && n == NP && NP == 16) || (TB && k == 16 && n == NP))
            DataCopy(lb, bg[(int64_t)core * n * k], n * k);
        else DataCopy(lb, bg[(int64_t)core * n * k], pb);
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0); WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        LoadData2dParams ap{0, (uint8_t)(k / 16), TA ? 1 : MP / 16, 0, 0, TA, 0};
        if (TA) { ap.repeatTimes = MP * k / 256; LoadData(aa, la, ap); }
        else {
            #pragma unroll
            for (int i = 0; i < MP / 16; ++i) LoadData(aa[i * k * 16], la[i * 256], ap);
        }
        LoadData2dParams bp{0, NP / 16, (uint16_t)(TB ? 1 : k / 16), 0, 0, !TB, 0};
        if (TB) { bp.repeatTimes = NP * k / 256; LoadData(bb, lb, bp); }
        else if (NP / 16 < k / 16) {
            bp.repeatTimes = k / 16; bp.srcStride = 1; bp.dstGap = NP / 16 - 1;
            #pragma unroll
            for (int j = 0; j < NP / 16; ++j) LoadData(bb[j * 256], lb[j * k * 16], bp);
        } else {
            for (int i = 0; i < k / 16; ++i) LoadData(bb[i * NP * 16], lb[i * 256], bp);
        }
        SetFlag<HardEvent::MTE1_M>(EVENT_ID0); WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
        MmadParams mm{MP, NP, (uint16_t)k, 0, false, true}; Mmad(cc, aa, bb, mm);
        SetFlag<HardEvent::M_FIX>(EVENT_ID0); WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
        FixpipeParamsV220 fp;
        fp.mSize = MP; fp.nSize = NP; fp.srcStride = MP; fp.dstStride = NP;
        Fixpipe(sg[(int64_t)core * MP * NP], cc, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
    }
    if ASCEND_IS_AIV {
        LocalTensor<float> vx(TPosition::VECIN, 0, MP * NP);
        LocalTensor<float> rm(TPosition::VECCALC, MP * NP * 4, MP);
        LocalTensor<float> out(TPosition::VECOUT, MP * NP * 4 + MP * 4, 8);
        GlobalTensor<float> yg; yg.SetGlobalBuffer((__gm__ float*)y);
        CrossCoreWaitFlag(8);
        // Read the already padded Cube result, then mask invalid N lanes in reductions.
        DataCopy(vx, sg[(int64_t)core * MP * NP], MP * NP);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if (NP == 128 && n > 64) {
            Max(vx, vx, vx[64], n - 64, m, {1, 1, 1, 16, 16, 16}); PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(rm, vx, n < 64 ? n : 64, m, 1, 1, NP / 8, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(out, rm, m, 1, 1, 1, 8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams cp{1, 4, 0, 0, 0}; DataCopyPad(yg[core], out, cp);
    }
    PipeBarrier<PIPE_ALL>();
}



// Keep the tiny dot products contiguous instead of expanding K-major operands.
template<class T, bool TA, bool TB>
__global__ __aicore__ __vector__ void bmms_micro_rows(GM_ADDR a, GM_ADDR b, GM_ADDR y, int32_t batches)
{
    constexpr int M=3,N=5,K=40,NP=8,UB_BYTES=7232;
    static_assert(UB_BYTES<=180*1024,"micro rows UB budget");
    LocalTensor<T> ar(TPosition::VECIN,0,256),br(TPosition::VECIN,512,256);
    LocalTensor<float> af(TPosition::VECCALC,1024,256),bf(TPosition::VECCALC,2048,256);
    LocalTensor<float> at(TPosition::VECCALC,3072,M*K),bt(TPosition::VECCALC,3552,N*K);
    LocalTensor<float> prod(TPosition::VECCALC,4352,M*N*K),dots(TPosition::VECCALC,6752,M*NP);
    LocalTensor<float> maxima(TPosition::VECCALC,6848,8),out(TPosition::VECOUT,6880,8);
    LocalTensor<int32_t> ia(TPosition::VECCALC,6912,K),ib(TPosition::VECCALC,7072,K);
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    bool ready=false;
    for(int batch=GetBlockIdx();batch<batches;batch+=GetBlockNum()) {
        if(ready){SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
        DataCopyExtParams ac{1,M*K*2,0,0,0},bc{1,N*K*2,0,0,0};
        DataCopyPadExtParams<T> pad{true,0,8,(T)0};
        DataCopyPad(ar,ag[(int64_t)batch*M*K],ac,pad);
        DataCopyPad(br,bg[(int64_t)batch*N*K],bc,pad);
        if(!ready) {
            #pragma unroll
            for(int i=0;i<8;++i){if(TA)ia.SetValue(i,i*M*4);if(!TB)ib.SetValue(i,i*N*4);}
            SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
            #pragma unroll
            for(int len=8;len<K;len*=2) {
                constexpr int unused=0;
                if(TA)Adds(ia[len],ia,int32_t(len*M*4),len<K-len?len:K-len);
                if(!TB)Adds(ib[len],ib,int32_t(len*N*4),len<K-len?len:K-len);
                PipeBarrier<PIPE_V>();
            }
            ready=true;
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af,ar,RoundMode::CAST_NONE,M*K);Cast(bf,br,RoundMode::CAST_NONE,N*K);PipeBarrier<PIPE_V>();
        if(TA){
            #pragma unroll
            for(int row=0;row<M;++row)Gather(at[row*K],af,ia.ReinterpretCast<uint32_t>(),row*4,K);
        } else at=af;
        if(!TB){
            #pragma unroll
            for(int col=0;col<N;++col)Gather(bt[col*K],bf,ib.ReinterpretCast<uint32_t>(),col*4,K);
        } else bt=bf;
        PipeBarrier<PIPE_V>();
        #pragma unroll
        for(int row=0;row<M;++row)Mul(prod[row*N*K],at[row*K],bt,K,N,{1,1,1,K/8,0,K/8});
        PipeBarrier<PIPE_V>();
        #pragma unroll
        for(int row=0;row<M;++row)WholeReduceSum(dots[row*NP],prod[row*N*K],K,N,1,1,K/8);
        PipeBarrier<PIPE_V>();
        WholeReduceMax(maxima,dots,N,M,1,1,NP/8,ReduceOrder::ORDER_ONLY_VALUE);PipeBarrier<PIPE_V>();
        WholeReduceSum(out,maxima,M,1,1,1,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);
        if(batch+GetBlockNum()<batches){SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);}
    }
    PipeBarrier<PIPE_ALL>();
}

// Tiny GEMM: each K row contains all 3x8 pair products, reduced along K together.
// Indices are generated from 24-lane seed blocks while the input DMA is in flight.
template<class T, bool TA, bool TB, int KP, int KC=0>
__global__ __aicore__ __vector__ void bmms_micro_parallel(GM_ADDR a, GM_ADDR b, GM_ADDR y,
    int32_t batches, int32_t k)
{
    if (KC) k=KC;
    constexpr int M=3,N=5,NP=8,MP=M,LANES=MP*NP,E=LANES*KC,RAW=256;
    constexpr int START=RAW*12;
    static_assert(START+E*16+256<=180*1024,"UB budget");
    LocalTensor<T> ar(TPosition::VECIN,0,RAW),br(TPosition::VECIN,RAW*2,RAW);
    LocalTensor<float> af(TPosition::VECCALC,RAW*4,RAW),bf(TPosition::VECCALC,RAW*8,RAW);
    LocalTensor<int32_t> ai(TPosition::VECCALC,START,E),bi(TPosition::VECCALC,START+E*4,E);
    LocalTensor<float> ap(TPosition::VECCALC,START+E*8,E),bp(TPosition::VECCALC,START+E*12,E);
    LocalTensor<float> maxima(TPosition::VECCALC,START+E*16,32),out(TPosition::VECOUT,START+E*16+128,8);
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    bool ready=false;
    for(int32_t batch=GetBlockIdx();batch<batches;batch+=GetBlockNum()) {
        if(ready) {
            // The next input DMA must wait until the preceding Cast has read the raw inputs.
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        }
        
        // Load the stored tensors contiguously; the gather indices encode their original strides.
        DataCopyExtParams ac{1,(uint32_t)(M*k*2),0,0,0},bc{1,(uint32_t)(N*k*2),0,0,0};
        DataCopyPadExtParams<T> az{true,0,(uint8_t)((16-M*k%16)%16),(T)0};
        DataCopyPadExtParams<T> bz{true,0,(uint8_t)((16-N*k%16)%16),(T)0};
        DataCopyPad(ar,ag[(int64_t)batch*M*k],ac,az);
        DataCopyPad(br,bg[(int64_t)batch*N*k],bc,bz);
        if(!ready) {
            #pragma unroll
            for(int j=0;j<8;++j) bi.SetValue(j,(j<N?j:0)*(TB?k:1)*4);
            SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
            Duplicate(ai,int32_t(0),LANES);
            Duplicate(ai[8],int32_t((TA?1:k)*4),8);
            Duplicate(ai[16],int32_t((TA?2:2*k)*4),8);
            Copy(bi[8],bi,8,2,{1,1,1,0});
            PipeBarrier<PIPE_V>();
            #pragma unroll
            for(int len=LANES;len<E;len*=2) {
                Adds(ai[len],ai,int32_t(len/LANES*(TA?M:1)*4),len<E-len?len:E-len);
                Adds(bi[len],bi,int32_t(len/LANES*(TB?1:N)*4),len<E-len?len:E-len);
                PipeBarrier<PIPE_V>();
            }
            ready=true;
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af,ar,RoundMode::CAST_NONE,(M*k+15)/16*16);
        Cast(bf,br,RoundMode::CAST_NONE,(N*k+15)/16*16);
        PipeBarrier<PIPE_V>();
        Gather(ap,af,ai.ReinterpretCast<uint32_t>(),0,E);
        Gather(bp,bf,bi.ReinterpretCast<uint32_t>(),0,E);
        PipeBarrier<PIPE_V>();
        Mul(ap,ap,bp,E);PipeBarrier<PIPE_V>();
        Add(ap,ap,ap[32*LANES],8*LANES);PipeBarrier<PIPE_V>();
        #pragma unroll
        for(int half=16*LANES;half>=LANES;half/=2) {
            Add(ap,ap,ap[half],half);PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(maxima,ap,N,M,1,1,1,ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(out,maxima,M,1,1,1,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);
        if(batch+GetBlockNum()<batches) {
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

// UB-resident 8x16 dot products. The transposed A input is already K-major.
// All eight rows are processed together; B uses a 16-bit hardware transpose when needed.
// Conservative UB budget: 180480 bytes, including the final maxima and output.
template<class T, bool TA, bool TB>
__global__ __aicore__ __vector__ void bmms_vector_8x16(GM_ADDR a, GM_ADDR b, GM_ADDR y, int32_t batches)
{
    constexpr int M=8,N=16,K=128,R=8,L=R*N,E=L*K,RAW=N*K,START=RAW*12;
    static_assert(START+RAW*8+K*R*8+E*8+256<=180*1024,"vector dot UB budget");
    LocalTensor<T> ar(TPosition::VECIN,0,RAW),br(TPosition::VECIN,RAW*2,RAW);
    LocalTensor<float> af(TPosition::VECCALC,RAW*4,RAW),bf(TPosition::VECCALC,RAW*8,RAW);
    LocalTensor<int32_t> ai(TPosition::VECCALC,START,K*R),bi(TPosition::VECCALC,START+K*R*4,RAW);
    constexpr int AS=START+K*R*4+RAW*4,BS=AS+K*R*4,PS=BS+RAW*4;
    LocalTensor<float> sortedA(TPosition::VECCALC,AS,K*R),sortedB(TPosition::VECCALC,BS,RAW);
    LocalTensor<float> ap(TPosition::VECCALC,PS,E),bp(TPosition::VECCALC,PS+E*4,E);
    LocalTensor<float> maxima(TPosition::VECCALC,PS+E*8,32),out(TPosition::VECOUT,PS+E*8+128,8);
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    bool ready=false;
    for(int batch=GetBlockIdx();batch<batches;batch+=GetBlockNum()) {
        if(ready) {SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
        DataCopy(ar,ag[(int64_t)batch*M*K],M*K);
        DataCopy(br,bg[(int64_t)batch*N*K],N*K);
        if(!ready) {
            if (!TA) {
            #pragma unroll
            for(int i=0;i<8;++i)ai.SetValue(i,((i%R)*(TA?1:K)+(i/R)*(TA?M:1))*4);
            SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
            #pragma unroll
            for(int len=8;len<K*R;len*=2) {
                Adds(ai[len],ai,int32_t(len/R*(TA?M:1)*4),len);PipeBarrier<PIPE_V>();
            }
            }
            ready=true;
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af,ar,RoundMode::CAST_NONE,M*K);if(!TB)Cast(bf,br,RoundMode::CAST_NONE,N*K);
        PipeBarrier<PIPE_V>();
        if(TB) {
            LocalTensor<uint16_t> bt(TPosition::VECCALC,START+K*R*4,RAW);
            uint64_t src[16],dst[16];
            uint64_t sb=(uint64_t)br.GetPhyAddr(),db=(uint64_t)bt.GetPhyAddr();
            #pragma unroll
            for(int j=0;j<16;++j){src[j]=sb+j*K*2;dst[j]=db+j*N*2;}
            TransDataTo5HDParams tp;
            tp.dstHighHalf=false;tp.srcHighHalf=false;tp.repeatTimes=K/16;tp.dstRepStride=16;tp.srcRepStride=1;
            TransDataTo5HD<uint16_t>(dst,src,tp);PipeBarrier<PIPE_V>();
            Cast(sortedB,bt.template ReinterpretCast<T>(),RoundMode::CAST_NONE,RAW);PipeBarrier<PIPE_V>();
        }
        else sortedB=bf;
        #pragma unroll
        for(int row=0;row<R;++row)Copy(bp[row*N],sortedB,N,K,{1,1,L/8,N/8});
        PipeBarrier<PIPE_V>();
        #pragma unroll
        for(int group=0;group<M/R;++group) {
            if (TA) sortedA=af;
            else {
                Gather(sortedA,af,ai.ReinterpretCast<uint32_t>(),group*R*K*4,K*R);
                PipeBarrier<PIPE_V>();
            }
            Brcb(ap,sortedA,K*R/8,{2,16});
            Brcb(ap[8],sortedA,K*R/8,{2,16});
            PipeBarrier<PIPE_V>();
            Mul(ap,ap,bp,E);PipeBarrier<PIPE_V>();
            #pragma unroll
            for(int half=E/2;half>=L;half/=2) {
                Add(ap,ap,ap[half],half);PipeBarrier<PIPE_V>();
            }
            WholeReduceMax(maxima[group*8],ap,N,R,1,1,N/8,ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
        }
        WholeReduceSum(out,maxima,M,1,1,1,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);
        if(batch+GetBlockNum()<batches) {SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);}
    }
    PipeBarrier<PIPE_ALL>();
}


// Keep each dot product contiguous in K. Vector repeat strides broadcast A
// directly against the stored transposed B, avoiding two expanded operands.
template<class T>
__global__ __aicore__ __vector__ void bmms_vector_8x16_rows(
    GM_ADDR a, GM_ADDR b, GM_ADDR y, int32_t batches)
{
    constexpr int M=8, N=16, K=128, RAW=16*K, E=M*N*K;
    constexpr int AT=RAW*4, AF=AT+RAW*2, BF=AF+RAW*4;
    constexpr int PROD=BF+RAW*4, DOTS=PROD+E*4, MAXIMA=DOTS+M*N*4;
    constexpr int OUT=MAXIMA+32, INDEX=OUT+32, UB_BYTES=INDEX+K*4;
    static_assert(UB_BYTES==95296 && UB_BYTES<=180*1024,"row dot UB budget");
    LocalTensor<T> ar(TPosition::VECIN,0,RAW),br(TPosition::VECIN,RAW*2,RAW);
    LocalTensor<float> at(TPosition::VECCALC,AT,M*K);
    LocalTensor<int32_t> ix(TPosition::VECCALC,INDEX,K);
    LocalTensor<float> af(TPosition::VECCALC,AF,RAW),bf(TPosition::VECCALC,BF,RAW);
    LocalTensor<float> prod(TPosition::VECCALC,PROD,E),dots(TPosition::VECCALC,DOTS,M*N);
    LocalTensor<float> maxima(TPosition::VECCALC,MAXIMA,8),out(TPosition::VECOUT,OUT,8);
    GlobalTensor<T> ag,bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
    yg.SetGlobalBuffer((__gm__ float*)y);
    #pragma unroll
    for(int j=0;j<8;++j)ix.SetValue(j,j*M*4);
    SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
    #pragma unroll
    for(int len=8;len<K;len*=2) {
        Adds(ix[len],ix,int32_t(len*M*4),len);PipeBarrier<PIPE_V>();
    }
    for(int batch=GetBlockIdx();batch<batches;batch+=GetBlockNum()) {
        if(batch!=GetBlockIdx()) {
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        }
        DataCopy(ar,ag[(int64_t)batch*M*K],M*K);
        DataCopy(br,bg[(int64_t)batch*N*K],RAW);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af,ar,RoundMode::CAST_NONE,M*K);
        Cast(bf,br,RoundMode::CAST_NONE,RAW);
        PipeBarrier<PIPE_V>();
        #pragma unroll
        for(int row=0;row<M;++row)Gather(at[row*K],af,ix.ReinterpretCast<uint32_t>(),row*4,K);
        PipeBarrier<PIPE_V>();
        #pragma unroll
        for(int row=0;row<M;++row) {
            Mul(prod[row*N*K],at[row*K],bf,64,N,{1,1,1,K/8,0,K/8});
            Mul(prod[row*N*K+64],at[row*K+64],bf[64],64,N,{1,1,1,K/8,0,K/8});
        }
        PipeBarrier<PIPE_V>();
        Add(prod,prod,prod[64],64,M*N,{1,1,1,K/8,K/8,K/8});
        PipeBarrier<PIPE_V>();
        WholeReduceSum(dots,prod,64,M*N,1,1,K/8);
        PipeBarrier<PIPE_V>();
        WholeReduceMax(maxima,dots,N,M,1,1,N/8,ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(out,maxima,M,1,1,1,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);
        if(batch+GetBlockNum()<batches) {
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

constexpr int BMMS_PAIR_MAX_ROWS=416, BMMS_PAIR_CHUNK_ROWS=208;
// Two independent FP32 dot products, followed by an ordered, core-local GM addition.
template<class T,bool TA,bool TB>
__global__ __aicore__ __mix__(1,1) void bmms_narrow_pair(
    GM_ADDR a,GM_ADDR b,GM_ADDR scratch,GM_ADDR partial,GM_ADDR y,
    int batches,int m,int n,int k,int tileM,int np)
{
    const int kh=k/2,kp=(kh+15)/16*16,mt=(m+tileM-1)/tileM;
    const bool whole=k%32==0;
    const int kl1=whole?k:kp,core=GetBlockIdx(),cores=GetBlockNum();
    const int64_t base=(int64_t)core*tileM*np;
    GlobalTensor<T> ag,bg;GlobalTensor<float> sg,pg,yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);
    sg.SetGlobalBuffer((__gm__ float*)scratch);pg.SetGlobalBuffer((__gm__ float*)partial);yg.SetGlobalBuffer((__gm__ float*)y);
    if ASCEND_IS_AIC {
        LocalTensor<T> la(TPosition::A1,0,tileM*kl1),lb(TPosition::B1,tileM*kl1*2,np*kl1);
        LocalTensor<T> aa(TPosition::A2,0,tileM*kp),bb(TPosition::B2,0,np*kp);
        LocalTensor<float> cc(TPosition::CO1,0,tileM*np);
        bool l1Busy=false,l0Busy=false,fixBusy=false,any=false;
        for(int task=core;task<batches*mt;task+=cores) {
            const int batch=task/mt,mi=task%mt*tileM,cm=m-mi<tileM?m-mi:tileM,cm16=(cm+15)/16*16;
            for(int part=0;part<2;++part) {
                if(l1Busy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                if(l0Busy)WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                const int pos=part*kh,ipos=whole?pos:0;
                if(!whole || part==0) {
                    if(!whole && kh!=kp) {
                        InitConstValue(la,InitConstValueParams<T>{1,(uint16_t)(cm16*kp/16),0,T(0)});
                        InitConstValue(lb,InitConstValueParams<T>{1,(uint16_t)(np*kp/16),0,T(0)});
                        PipeBarrier<PIPE_ALL>();
                    }
                    const int readK=whole?k:kh,readPos=whole?0:pos;
                    Nd2NzParams ap{1,(uint16_t)(TA?readK:cm),(uint16_t)(TA?cm:readK),0,
                        (uint16_t)(TA?m:k),(uint16_t)(TA?kl1:cm16),1,0};
                    Nd2NzParams bp{1,(uint16_t)(TB?n:readK),(uint16_t)(TB?readK:n),0,
                        (uint16_t)(TB?k:n),(uint16_t)(TB?np:kl1),1,0};
                    DataCopy(la,ag[(int64_t)batch*m*k+(TA?(int64_t)readPos*m+mi:(int64_t)mi*k+readPos)],ap);
                    DataCopy(lb,bg[(int64_t)batch*n*k+(TB?readPos:(int64_t)readPos*n)],bp);
                    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                }
                if(cm16>kp) {
                    LoadData2dParams aaP{0,(uint8_t)(cm16/16),(uint16_t)(TA?kl1/16:1),0,(uint16_t)(kp/16-1),TA,0};
                    for(int posK=0;posK<kp/16;++posK)
                        LoadData(aa[posK*256],la[TA?(ipos+posK*16)*16:(ipos+posK*16)*cm16],aaP);
                } else {
                    LoadData2dParams aaP{0,(uint8_t)(kp/16),(uint16_t)(TA?1:cm16/16),0,0,TA,0};
                    for(int row=0;row<cm16/16;++row)
                        LoadData(aa[row*kp*16],la[TA?(row*kl1+ipos)*16:ipos*cm16+row*256],aaP);
                }
                LoadData2dParams bbP{0,(uint8_t)(np/16),(uint16_t)(TB?1:kl1/16),0,0,!TB,0};
                if(TB){bbP.repeatTimes=np*kp/256;LoadData(bb,lb[ipos*np],bbP);}
                else for(int posK=0;posK<kp/16;++posK)LoadData(bb[posK*np*16],lb[ipos*16+posK*256],bbP);
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);l1Busy=true;
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                if(fixBusy){WaitFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=false;}
                MmadParams mm{(uint16_t)cm16,(uint16_t)np,(uint16_t)kp,0,false,true};Mmad(cc,aa,bb,mm);
                SetFlag<HardEvent::M_MTE1>(EVENT_ID3);l0Busy=true;
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                if(part==0 && task!=core)CrossCoreWaitFlag(10);
                FixpipeParamsV220 fp;fp.mSize=cm16;fp.nSize=np;fp.srcStride=cm16;fp.dstStride=np;
                if(part==1)SetAtomicAdd<float>();else DisableDmaAtomic();
                Fixpipe(sg[base],cc,fp);
                DisableDmaAtomic();
                if(part==1)CrossCoreSetFlag<2,PIPE_FIX>(8);
                SetFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=true;
            }
            any=true;
        }
        if(l1Busy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        if(l0Busy)WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
        if(fixBusy)WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        if(any)CrossCoreWaitFlag(10);
    }
    if ASCEND_IS_AIV {
        static_assert(110496<180*1024,"paired narrow UB budget");
        const int stage=tileM*np*4,rmo=stage,tmpo=rmo+(tileM+7)/8*32,outo=tmpo+256,sxo=outo+32;
        LocalTensor<float> c(TPosition::VECIN,0,tileM*np);
        LocalTensor<float> rm(TPosition::VECCALC,rmo,(tileM+7)/8*8),tmp(TPosition::VECCALC,tmpo,64);
        LocalTensor<float> out(TPosition::VECOUT,outo,8),sx(TPosition::VECIN,sxo,512);
        bool used=false;
        for(int task=core;task<batches*mt;task+=cores) {
            const int batch=task/mt,mi=task%mt*tileM,cm=m-mi<tileM?m-mi:tileM;
            CrossCoreWaitFlag(8);
            if(used){SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
            DataCopyExtParams cp{1,(uint32_t)cm*np*4,0,0,0};
            DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(c,sg[base],cp,pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            CrossCoreSetFlag<2,PIPE_MTE2>(10);
            for(int first=0;first<cm;first+=BMMS_PAIR_CHUNK_ROWS) {
                const int rows=cm-first<BMMS_PAIR_CHUNK_ROWS?cm-first:BMMS_PAIR_CHUNK_ROWS;
                WholeReduceMax(rm[first],c[first*np],n,rows,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);
            }
            PipeBarrier<PIPE_V>();used=true;
            bmms_sum(out,rm,tmp,cm);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1,4,0,0,0};DataCopyPad(pg[task],out,op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        PipeBarrier<PIPE_ALL>();SyncAll<true>();
        for(int batch=core;batch<batches;batch+=cores) {
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            DataCopyExtParams cp{1,(uint32_t)mt*4,0,0,0};DataCopyPadExtParams<float> pad{false,0,0,0};
            DataCopyPad(sx,pg[(int64_t)batch*mt],cp,pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            bmms_sum(out,sx,tmp,mt);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

template<class T,bool TA,bool TB,int MP,int NP>
__global__ __aicore__ __mix__(1,1) void bmms_whole(
    GM_ADDR a,GM_ADDR b,GM_ADDR scratch,GM_ADDR y,int batches,int m,int n,int k)
{
    static_assert(MP*NP*4<=128*1024,"whole C capacity");
    constexpr int rmoff=MP*NP*4,tmpoff=rmoff+MP*4,outoff=tmpoff+256;
    static_assert(outoff+32<=180*1024,"whole UB capacity");
    const int core=GetBlockIdx(),cores=GetBlockNum();
    GlobalTensor<float> sg;sg.SetGlobalBuffer((__gm__ float*)scratch);
    if ASCEND_IS_AIC {
        const int cap=32768/(MP>NP?MP:NP),bk=k<cap?k:cap;
        GlobalTensor<T> ag,bg;ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<T> la(TPosition::A1,0,MP*bk),lb(TPosition::B1,MP*bk*2,NP*bk);
        LocalTensor<T> aa(TPosition::A2,0,MP*bk),bb(TPosition::B2,0,NP*bk);
        LocalTensor<float> cc(TPosition::CO1,0,MP*NP);
        bool l1Busy=false,l0Busy=false,fixBusy=false;int step=0;
        for(int batch=core;batch<batches;batch+=cores,++step) {
            for(int pos=0;pos<k;pos+=bk) {
                const int kk=k-pos<bk?k-pos:bk;
                if(l1Busy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                if(m!=MP || n!=NP) {
                    InitConstValue(la,InitConstValueParams<T>{1,(uint16_t)(MP*kk/16),0,T(0)});
                    InitConstValue(lb,InitConstValueParams<T>{1,(uint16_t)(NP*kk/16),0,T(0)});
                    PipeBarrier<PIPE_ALL>();
                }
                Nd2NzParams pa{1,(uint16_t)(TA?kk:m),(uint16_t)(TA?m:kk),0,
                    (uint16_t)(TA?m:k),(uint16_t)(TA?kk:MP),1,0};
                Nd2NzParams pb{1,(uint16_t)(TB?n:kk),(uint16_t)(TB?kk:n),0,
                    (uint16_t)(TB?k:n),(uint16_t)(TB?NP:kk),1,0};
                DataCopy(la,ag[(int64_t)batch*m*k+(TA?(int64_t)pos*m:pos)],pa);
                DataCopy(lb,bg[(int64_t)batch*n*k+(TB?pos:(int64_t)pos*n)],pb);
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                if(l0Busy)WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                LoadData2dParams ap{0,(uint8_t)(kk/16),(uint16_t)(TA?1:MP/16),0,0,TA,0};
                if constexpr(TA){ap.repeatTimes=MP*kk/256;LoadData(aa,la,ap);}
                else if(MP>kk) {
                    ap.repeatTimes=MP/16;ap.srcStride=1;ap.dstGap=kk/16-1;
                    for(int j=0;j<kk/16;++j)LoadData(aa[j*256],la[j*MP*16],ap);
                } else for(int i=0;i<MP/16;++i)LoadData(aa[i*kk*16],la[i*256],ap);
                LoadData2dParams bp{0,(uint8_t)(NP/16),(uint16_t)(TB?1:kk/16),0,0,!TB,0};
                if constexpr(TB){bp.repeatTimes=NP*kk/256;LoadData(bb,lb,bp);}
                else if(NP<kk) {
                    bp.repeatTimes=kk/16;bp.srcStride=1;bp.dstGap=NP/16-1;
                    for(int j=0;j<NP/16;++j)LoadData(bb[j*256],lb[j*kk*16],bp);
                } else for(int i=0;i<kk/16;++i)LoadData(bb[i*NP*16],lb[i*256],bp);
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);l1Busy=true;
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                if(pos==0 && fixBusy){WaitFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=false;}
                MmadParams mm{MP,NP,(uint16_t)kk,0,false,pos==0};Mmad(cc,aa,bb,mm);
                SetFlag<HardEvent::M_MTE1>(EVENT_ID3);l0Busy=true;
            }
            SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
            const int slot=step&1;if(step>=2)CrossCoreWaitFlag(slot?15:10);
            FixpipeParamsV220 fp;fp.mSize=MP;fp.nSize=NP;fp.srcStride=MP;fp.dstStride=NP;
            Fixpipe(sg[(int64_t)core*2*MP*NP+slot*MP*NP],cc,fp);
            SetFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=true;
            CrossCoreSetFlag<2,PIPE_FIX>(slot?9:8);
        }
        if(l1Busy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        if(l0Busy)WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
        if(fixBusy)WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        if(step)CrossCoreWaitFlag(10);if(step>1)CrossCoreWaitFlag(15);
    }
    if ASCEND_IS_AIV {
        LocalTensor<float> x(TPosition::VECIN,0,MP*NP),rm(TPosition::VECCALC,rmoff,MP);
        LocalTensor<float> tmp(TPosition::VECCALC,tmpoff,64),out(TPosition::VECOUT,outoff,8);
        GlobalTensor<float> yg;yg.SetGlobalBuffer((__gm__ float*)y);int step=0;
        for(int batch=core;batch<batches;batch+=cores,++step) {
            const int slot=step&1;CrossCoreWaitFlag(slot?9:8);
            if(step){SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);}
            DataCopy(x,sg[(int64_t)core*2*MP*NP+slot*MP*NP],MP*NP);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            CrossCoreSetFlag<2,PIPE_MTE2>(slot?15:10);
            for(int row=0;row<m;row+=248) {
                const int rows=m-row<248?m-row:248;
                for(int col=64;col<n;col+=64) {
                    const int cols=n-col<64?n-col:64;
                    Max(x[row*NP],x[row*NP],x[row*NP+col],cols,rows,{1,1,1,NP/8,NP/8,NP/8});
                    PipeBarrier<PIPE_V>();
                }
                WholeReduceMax(rm[row],x[row*NP],n<64?n:64,rows,1,1,NP/8,ReduceOrder::ORDER_ONLY_VALUE);
            }
            PipeBarrier<PIPE_V>();bmms_sum(out,rm,tmp,m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],out,cp);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

// Pure bitwise input reordering, executed anew inside every mixed kernel invocation.
template<class T,bool TA,bool TB>
__aicore__ inline void bmms_pack_interleave(GM_ADDR a,GM_ADDR b,GM_ADDR pa,GM_ADDR pb,
    int batches,int m,int n,int k)
{
    constexpr int R=64,E=R*128;
    LocalTensor<T> x(TPosition::VECIN,0,E),z(TPosition::VECOUT,16384,E);
    LocalTensor<int32_t> ix(TPosition::VECCALC,32768,E);
    GlobalTensor<T> src,dst;const int at=TA?0:batches*m/R,bt=TB?batches*n/R:0;
    int lastLayout=-1;
    for(int work=GetBlockIdx();work<at+bt;work+=GetBlockNum()) {
        const bool operand=work>=at,transposed=false;
        const int rows=operand?n:m,task=operand?work-at:work;
        const int batch=task/(rows/R),ri=task%(rows/R)*R;
        if(lastLayout!=(int)transposed) {
            for(int j=0;j<k;++j) {
                const int kj=j/2+(j%2)*(k/2);
                ix.SetValue(j,(transposed?kj*R:kj)*2);
            }
            PipeBarrier<PIPE_ALL>();
            for(int r=1;r<R;++r)Adds(ix[r*k],ix,(int32_t)(transposed?r*2:r*k*2),k);
            PipeBarrier<PIPE_V>();lastLayout=transposed;
        }
        src.SetGlobalBuffer((__gm__ T*)(operand?b:a));
        dst.SetGlobalBuffer((__gm__ T*)(operand?pb:pa));
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        if(transposed) {
            DataCopyExtParams cp{(uint16_t)k,R*2,(uint32_t)(rows-R)*2,0,0};
            DataCopyPadExtParams<T> pad{false,0,0,(T)0};
            DataCopyPad(x,src[(int64_t)batch*rows*k+ri],cp,pad);
        } else DataCopy(x,src[((int64_t)batch*rows+ri)*k],R*k);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Gather(z,x,ix.template ReinterpretCast<uint32_t>(),0,R*k);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopy(dst[((int64_t)batch*rows+ri)*k],z,R*k);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

template<class T,bool TA,bool TB,int TM,int TN>
__global__ __aicore__ __mix__(1,1) void bmms_short_resident(
    GM_ADDR a,GM_ADDR b,GM_ADDR scratch,GM_ADDR maxima,GM_ADDR y,
    int batches,int m,int n,int k,int ns,int dynamicM,int dynamicN,GM_ADDR pa,GM_ADDR pb)
{
    static_assert(TM*TN*4<=128*1024,"resident short L0C capacity");
    static_assert(TM*128*2<=64*1024 && TN*128*2<=64*1024,"resident short L0A/B capacity");
    static_assert((TM+TN)*128*2<=512*1024,"resident short L1 capacity");
    const int tileM=TM,tileN=TN,mt=m/TM,nt=n/TN,core=GetBlockIdx();
    const int64_t coreOffset=(int64_t)core*2*TM*TN;
    if ASCEND_IS_AIV {
        if constexpr(!TA || TB) {
            bmms_pack_interleave<T,TA,TB>(a,b,pa,pb,batches,m,n,k);
            SyncAll<true>();CrossCoreSetFlag<2,PIPE_MTE3>(7);
        }
    }
    if ASCEND_IS_AIC {
        if constexpr(!TA || TB)CrossCoreWaitFlag(7);
        GlobalTensor<T> ag,bg;GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)(TA?a:pa));bg.SetGlobalBuffer((__gm__ T*)(TB?pb:b));
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        LocalTensor<T> la(TPosition::A1,0,TM*k),lb(TPosition::B1,TM*k*2,TN*k);
        LocalTensor<T> aa(TPosition::A2,0,TM*k),bb(TPosition::B2,0,TN*k);
        LocalTensor<float> cc(TPosition::CO1,0,TM*TN);
        bool bBusy=false,mBusy=false,fixBusy=false;int step=0;
        for(int task=core;task<batches*mt*ns;task+=GetBlockNum()) {
            const int batch=task/(mt*ns),part=task%ns,mi=(task/ns)%mt*TM;
            const int begin=nt*part/ns,end=nt*(part+1)/ns;
            if(mBusy){WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);mBusy=false;}
            if(bBusy){WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);bBusy=false;}
            if constexpr(TA) {
                Nd2NzParams ap{1,(uint16_t)(k/2),TM,0,(uint16_t)m,(uint16_t)k,2,0};
                DataCopy(la,ag[(int64_t)batch*m*k+mi],ap);
                DataCopy(la[16],ag[(int64_t)batch*m*k+(int64_t)(k/2)*m+mi],ap);
            } else {
                Nd2NzParams ap{1,TM,(uint16_t)k,0,(uint16_t)k,TM,1,0};
                DataCopy(la,ag[((int64_t)batch*m+mi)*k],ap);
            }
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
            LoadData2dParams ap{0,(uint8_t)(k/16),(uint16_t)(TA?1:TM/16),0,0,TA,0};
            if constexpr(TA){ap.repeatTimes=TM*k/256;LoadData(aa,la,ap);}
            else for(int i=0;i<TM/16;++i)LoadData(aa[i*k*16],la[i*256],ap);
            SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
            for(int t=begin;t<end;++t,++step) {
                const int ni=t*TN,slot=step&1;
                if(bBusy){WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);bBusy=false;}
                if constexpr(TB) {
                    Nd2NzParams bp{1,TN,(uint16_t)k,0,(uint16_t)k,TN,1,0};
                    DataCopy(lb,bg[((int64_t)batch*n+ni)*k],bp);
                } else {
                    Nd2NzParams bp{1,(uint16_t)(k/2),TN,0,(uint16_t)n,(uint16_t)k,2,0};
                    DataCopy(lb,bg[(int64_t)batch*n*k+ni],bp);
                    DataCopy(lb[16],bg[(int64_t)batch*n*k+(int64_t)(k/2)*n+ni],bp);
                }
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                if(mBusy){WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);mBusy=false;}
                LoadData2dParams bp{0,(uint8_t)(TN/16),(uint16_t)(TB?1:k/16),0,0,!TB,0};
                if constexpr(TB){bp.repeatTimes=TN*k/256;LoadData(bb,lb,bp);}
                else {
                    LoadData3DParamsV2<T> rect;
                    rect.l1H=1;rect.l1W=k;rect.channelSize=TN;
                    rect.kExtension=TN;rect.mExtension=k;rect.kStartPt=0;rect.mStartPt=0;
                    LoadData(bb,lb,rect);
                }
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);bBusy=true;
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                if(fixBusy){WaitFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=false;}
                MmadParams mm{TM,TN,(uint16_t)k,0,false,true};Mmad(cc,aa,bb,mm);
                SetFlag<HardEvent::M_MTE1>(EVENT_ID3);mBusy=true;
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                if(step>=2)CrossCoreWaitFlag(slot?15:10);
                FixpipeParamsV220 fp;fp.mSize=TM;fp.nSize=TN;fp.srcStride=TM;fp.dstStride=TN;
                Fixpipe(sg[coreOffset+(int64_t)slot*TM*TN],cc,fp);
                SetFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=true;
                CrossCoreSetFlag<2,PIPE_FIX>(slot?9:8);
            }
        }
        if(bBusy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        if(mBusy)WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
        if(fixBusy)WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        if(step)CrossCoreWaitFlag(10);if(step>1)CrossCoreWaitFlag(15);
    }
    if ASCEND_IS_AIV {
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t vrows = (tileM + 7) / 8 * 8;
        const int32_t sumRows = (m + 7) / 8 * 8;
        const int32_t stageBytes = tileM * cN * 4;
        LocalTensor<float> x(TPosition::VECIN, 0, tileM * cN);
        LocalTensor<float> running(TPosition::VECCALC, stageBytes, vrows);
        LocalTensor<float> rbuf(TPosition::VECCALC, stageBytes + vrows * 4, vrows);
        LocalTensor<float> sumTemp(TPosition::VECCALC, stageBytes + vrows * 8, 8192);
        LocalTensor<float> sx(TPosition::VECIN, stageBytes + vrows * 8 + 32768, sumRows);
        LocalTensor<float> acc(TPosition::VECCALC, stageBytes + vrows * 8 + 32768 + sumRows * 4, sumRows);
        bool vectorBusy = false; int32_t step=0;
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);

        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;

            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (step++) & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    if (vectorBusy) {
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    if(nc+cN>=cn)CrossCoreSetFlag<2,PIPE_MTE2>(slot==0?10:15);
                    uint32_t shape[]={(uint32_t)cm,(uint32_t)cN};
                    ReduceMax<float,Pattern::Reduce::AR,true>(rbuf,x,sumTemp.template ReinterpretCast<uint8_t>(),shape,false);
                    PipeBarrier<PIPE_V>();
                    Max(running, running, rbuf, cm);
                    vectorBusy = true;
                }

            }
            if (mt == 1 && ns == 1) {
                if (cm <= 64) WholeReduceSum(rbuf, running, cm, 1, 1, 1, 8);
                else bmms_sum(rbuf, running, sumTemp, cm);
                PipeBarrier<PIPE_V>();
                Adds(running, rbuf, 0.0f, 8);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        if (mt == 1 && ns == 1) { PipeBarrier<PIPE_ALL>(); return; }
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();


        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            if (ns > 1 && m % 8 == 0 && ns * m <= 8192) {
                DataCopyExtParams cp{1, (uint32_t)(ns * m) * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sumTemp, mg[(int64_t)batch * ns * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                Max(acc, sumTemp, sumTemp[m], m);
                for (int part = 2; part < ns; ++part) {
                    PipeBarrier<PIPE_V>();
                    Max(acc, acc, sumTemp[part * m], m);
                }
                PipeBarrier<PIPE_V>();
                bmms_sum(running, acc, sumTemp, m);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], running, op);
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            } else {

            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sx, mg[((int64_t)batch * ns + part) * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if (ns == 1) bmms_sum(rbuf, sx, sumTemp, m);
                else Max(acc, acc, sx, m);

            }
            auto out = running;
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else bmms_sum(out, acc, sumTemp, m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    int32_t b = info_x1.tensors[0].shape[0];
    int32_t m = info_x1.tensors[0].shape[transposeX1 ? 2 : 1];
    int32_t k = info_x1.tensors[0].shape[transposeX1 ? 1 : 2];
    int32_t n = info_x2.tensors[0].shape[transposeX2 ? 1 : 2];

    if(m>=1024 && m<=8192 && n>8 && n<=64 && k>=32 && k<=128 && k%8==0) {
        const int tm=std::min<int>(BMMS_PAIR_MAX_ROWS,std::max<int>(16,((int64_t)b*m+availableCoreNum-1)/availableCoreNum+15)/16*16);
        const int np=(n+15)/16*16,mt=(m+tm-1)/tm,cores=std::min<int64_t>(availableCoreNum,(int64_t)b*mt);
        struct PairSpace{aclrtStream stream;int32_t device;void* ptr;size_t bytes;};
        static thread_local std::vector<PairSpace> spaces;
        int32_t device=0;aclrtGetDevice(&device);PairSpace* ws=nullptr;
        for(auto& item:spaces)if(item.stream==stream&&item.device==device)ws=&item;
        if(!ws){spaces.push_back({stream,device,nullptr,0});ws=&spaces.back();}
        const size_t matrixBytes=(size_t)cores*tm*np*4,bytes=matrixBytes+((size_t)b*mt*4+511)/512*512;
        if(bytes>ws->bytes){
            if(ws->ptr){aclrtSynchronizeStream(stream);aclrtFree(ws->ptr);ws->ptr=nullptr;ws->bytes=0;}
            if(aclrtMalloc(&ws->ptr,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
            ws->bytes=bytes;
        }
        GM_ADDR matrix=(GM_ADDR)ws->ptr;GM_ADDR partial=matrix+matrixBytes;
#define BMMS_PAIR(T,A,B) bmms_narrow_pair<T,A,B><<<cores,nullptr,stream>>>(x1,x2,matrix,partial,y,b,m,n,k,tm,np)
#define BMMS_PAIR_TYPE(T) if(transposeX1){if(transposeX2){BMMS_PAIR(T,true,true);}else{BMMS_PAIR(T,true,false);}} else{if(transposeX2){BMMS_PAIR(T,false,true);}else{BMMS_PAIR(T,false,false);}}
        if(info_x1.tensors[0].dtype==1){BMMS_PAIR_TYPE(half);}else{BMMS_PAIR_TYPE(bfloat16_t);}
#undef BMMS_PAIR_TYPE
#undef BMMS_PAIR
        return;
    }
    if (m == 64 && n == 64 && k >= 2048 && k % 256 == 0 && b <= 4) {
        int32_t parts = std::min<int32_t>(8, k / 512);
        int32_t cores = std::max<int32_t>(1, std::min<int64_t>(availableCoreNum, b * parts));
        struct SplitSpace { aclrtStream stream; int32_t device; void* ptr; size_t bytes; };
        static thread_local std::vector<SplitSpace> splitSpaces;
        int32_t device = 0; aclrtGetDevice(&device);
        SplitSpace* ws = nullptr;
        for (auto& item : splitSpaces) if (item.stream == stream && item.device == device) ws = &item;
        if (!ws) { splitSpaces.push_back({stream, device, nullptr, 0}); ws = &splitSpaces.back(); }
        size_t matrixBytes = (size_t)b * parts * 64 * 64 * 4;
        size_t bytes = matrixBytes + 512;
        if (bytes > ws->bytes) {
            if (ws->ptr) { aclrtSynchronizeStream(stream); aclrtFree(ws->ptr); ws->ptr = nullptr; ws->bytes = 0; }
            if (aclrtMalloc(&ws->ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
            ws->bytes = bytes;
        }
        auto matrix = (GM_ADDR)ws->ptr;
        auto partial = matrix + matrixBytes;
#define BMMS_SPLIT(T, A, B) bmms_split64<T, A, B><<<cores, nullptr, stream>>>(x1, x2, matrix, partial, y, b, k, parts)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_SPLIT(bfloat16_t, true, true); } else { BMMS_SPLIT(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_SPLIT(bfloat16_t, false, true); } else { BMMS_SPLIT(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_SPLIT(half, true, true); } else { BMMS_SPLIT(half, true, false); } }
            else { if (transposeX2) { BMMS_SPLIT(half, false, true); } else { BMMS_SPLIT(half, false, false); } }
        }
#undef BMMS_SPLIT
        return;
    }

    if(!transposeX1 && transposeX2 && m<=8 && n<=16 && m*n>32 &&
       k<=64 && k%8==0 && b>availableCoreNum) {
        int vc=std::max<int32_t>(1,std::min<int64_t>(b,availableCoreNum*2));
        if(info_x1.tensors[0].dtype==2) bmms_vector_short_nt<bfloat16_t><<<vc,nullptr,stream>>>(x1,x2,y,b,m,n,k);
        else bmms_vector_short_nt<half><<<vc,nullptr,stream>>>(x1,x2,y,b,m,n,k);
        return;
    }
    if(m==8 && n==16 && k==128 && transposeX1) {
        int vc=std::min<int64_t>(b,availableCoreNum*2);
#define BMMS_V816(T,B) bmms_vector_8x16<T,true,B><<<vc,nullptr,stream>>>(x1,x2,y,b)
#define BMMS_V816_ROWS(T) bmms_vector_8x16_rows<T><<<vc,nullptr,stream>>>(x1,x2,y,b)
        if(info_x1.tensors[0].dtype==2) {
            if(transposeX2){BMMS_V816_ROWS(bfloat16_t);}else{BMMS_V816(bfloat16_t,false);}
        } else {
            if(transposeX2){BMMS_V816_ROWS(half);}else{BMMS_V816(half,false);}
        }
#undef BMMS_V816_ROWS
#undef BMMS_V816
        return;
    }
    if (m == 3 && n == 5 && k == 40) {
        int32_t vc=std::min<int64_t>(b,availableCoreNum*2);
#define BMMS_MP(T,A,B) bmms_micro_rows<T,A,B><<<vc,nullptr,stream>>>(x1,x2,y,b)
        if(info_x1.tensors[0].dtype==2) {
            if(transposeX1){if(transposeX2){BMMS_MP(bfloat16_t,true,true);}else{BMMS_MP(bfloat16_t,true,false);}}
            else{if(transposeX2){BMMS_MP(bfloat16_t,false,true);}else{BMMS_MP(bfloat16_t,false,false);}}
        }else{
            if(transposeX1){if(transposeX2){BMMS_MP(half,true,true);}else{BMMS_MP(half,true,false);}}
            else{if(transposeX2){BMMS_MP(half,false,true);}else{BMMS_MP(half,false,false);}}
        }
#undef BMMS_MP
        return;
    }
    if (m == 8 && n == 8 && (transposeX1 || !transposeX2) && (k == 32 || k == 64)) {
        int32_t vc = std::max<int32_t>(1, std::min<int64_t>(b, availableCoreNum * 2));
#define BMMS_TINY(T, A, B) do { \
    if (k == 32) bmms_tiny<T, A, B, 8, 32><<<vc, nullptr, stream>>>(x1, x2, y, b); \
    else bmms_tiny<T, A, B, 8, 64><<<vc, nullptr, stream>>>(x1, x2, y, b); \
} while (0)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_TINY(bfloat16_t, true, true); } else { BMMS_TINY(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_TINY(bfloat16_t, false, true); } else { BMMS_TINY(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_TINY(half, true, true); } else { BMMS_TINY(half, true, false); } }
            else { if (transposeX2) { BMMS_TINY(half, false, true); } else { BMMS_TINY(half, false, false); } }
        }
#undef BMMS_TINY
        return;
    }
    if (m == 1 && n == 1) {
        int32_t vc = std::max<int32_t>(1, std::min<int64_t>(b, availableCoreNum * 2));
        if (k == 32 && vc == b) {
            if (info_x1.tensors[0].dtype == 2) bmms_dot<bfloat16_t, 32, true><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
            else bmms_dot<half, 32, true><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
        } else {
            if (info_x1.tensors[0].dtype == 2) bmms_dot<bfloat16_t><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
            else bmms_dot<half><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
        }
        return;
    }

    if (m <= 32 && n <= 128 && m * n > 32 && k <= 256 && k % 16 == 0 && b <= availableCoreNum && !(m == 32 && n == 32 && k == 32)) {
        const int32_t mp = m <= 16 ? 16 : 32;
        const int32_t np = n <= 16 ? 16 : n <= 32 ? 32 : 128;
        struct DirectSpace { aclrtStream stream; int32_t device; void* ptr; size_t bytes; };
        static thread_local std::vector<DirectSpace> directSpaces;
        int32_t device = 0; aclrtGetDevice(&device);
        DirectSpace* ws = nullptr;
        for (auto& item : directSpaces) if (item.stream == stream && item.device == device) ws = &item;
        if (!ws) { directSpaces.push_back({stream, device, nullptr, 0}); ws = &directSpaces.back(); }
        size_t bytes = (size_t)b * mp * np * 4;
        if (bytes > ws->bytes) {
            if (ws->ptr) { aclrtSynchronizeStream(stream); aclrtFree(ws->ptr); ws->ptr = nullptr; ws->bytes = 0; }
            if (aclrtMalloc(&ws->ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
            ws->bytes = bytes;
        }
#define BMMS_DN(T, A, B, MP) do { \
    if (np == 16) bmms_direct<T, A, B, MP, 16><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (np == 32) bmms_direct<T, A, B, MP, 32><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else bmms_direct<T, A, B, MP, 128><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
} while (0)
#define BMMS_DIRECT(T, A, B) do { \
    if (m == 7 && n == 13 && k == 48) bmms_direct<T, A, B, 16, 16, 7, 13, 48><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (m == 8 && n == 16 && k == 128) bmms_direct<T, A, B, 16, 16, 8, 16, 128><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (m == 16 && n == 32 && k == 128) bmms_direct<T, A, B, 16, 32, 16, 32, 128><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (m == 23 && n == 73 && k == 192) bmms_direct<T, A, B, 32, 128, 23, 73, 192><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (m == 32 && n == 128 && k == 256) bmms_direct<T, A, B, 32, 128, 32, 128, 256><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k); \
    else if (mp == 16) { BMMS_DN(T, A, B, 16); } else { BMMS_DN(T, A, B, 32); } \
} while (0)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_DIRECT(bfloat16_t, true, true); } else { BMMS_DIRECT(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_DIRECT(bfloat16_t, false, true); } else { BMMS_DIRECT(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_DIRECT(half, true, true); } else { BMMS_DIRECT(half, true, false); } }
            else { if (transposeX2) { BMMS_DIRECT(half, false, true); } else { BMMS_DIRECT(half, false, false); } }
        }
#undef BMMS_DIRECT
#undef BMMS_DN
        return;
    }

    if (m <= 8 && n <= 8 && n > 1 && m * n <= 32 && k <= 128) {
        int32_t vc = std::max<int32_t>(1, std::min<int64_t>(b, availableCoreNum * 2));
#define BMMS_MICRO(T, A, B) do { \
    if (k <= 16) bmms_micro<T, A, B, 16><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (k <= 32) bmms_micro<T, A, B, 32><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else if (k <= 64) bmms_micro<T, A, B, 64><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
    else bmms_micro<T, A, B, 128><<<vc, nullptr, stream>>>(x1, x2, y, b, m, n, k); \
} while (0)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_MICRO(bfloat16_t, true, true); } else { BMMS_MICRO(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_MICRO(bfloat16_t, false, true); } else { BMMS_MICRO(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_MICRO(half, true, true); } else { BMMS_MICRO(half, true, false); } }
            else { if (transposeX2) { BMMS_MICRO(half, false, true); } else { BMMS_MICRO(half, false, false); } }
        }
#undef BMMS_MICRO
        return;
    }

    if(((m>32 && m<=64 && n>64 && n<=128 && k>=256 && k<=256) ||
        (m>64 && m<=128 && n>64 && n<=128 && k>=64 && k<=128)) && k%16==0 &&
       !(m==64 && n==64 && k==64) && !(m==64 && n==128 && k==128 && b<=availableCoreNum)) {
        const int mp=m<=64?64:m<=128?128:256,np=n<=64?64:n<=128?128:256;
        if(mp*np<=32768) {
            const int cores=std::min<int64_t>(availableCoreNum,b);
            struct WholeSpace{aclrtStream stream;int device;void* ptr;size_t bytes;};
            static thread_local std::vector<WholeSpace> spaces;
            int device=0;aclrtGetDevice(&device);WholeSpace* ws=nullptr;
            for(auto& item:spaces)if(item.stream==stream&&item.device==device)ws=&item;
            if(!ws){spaces.push_back({stream,device,nullptr,0});ws=&spaces.back();}
            const size_t bytes=(size_t)cores*2*mp*np*4;
            if(bytes>ws->bytes){
                if(ws->ptr){aclrtSynchronizeStream(stream);aclrtFree(ws->ptr);ws->ptr=nullptr;ws->bytes=0;}
                if(aclrtMalloc(&ws->ptr,bytes,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS)return;
                ws->bytes=bytes;
            }
#define BMMS_WHOLE_ONE(T,A,B,MP,NP) bmms_whole<T,A,B,MP,NP><<<cores,nullptr,stream>>>(x1,x2,(GM_ADDR)ws->ptr,y,b,m,n,k)
#define BMMS_WHOLE_DIMS(T,A,B) do { \
    if(mp==64) BMMS_WHOLE_ONE(T,A,B,64,128); \
    else BMMS_WHOLE_ONE(T,A,B,128,128); \
} while(0)
#define BMMS_WHOLE_TYPE(T) if(transposeX1){if(transposeX2){BMMS_WHOLE_DIMS(T,true,true);}else{BMMS_WHOLE_DIMS(T,true,false);}}else{if(transposeX2){BMMS_WHOLE_DIMS(T,false,true);}else{BMMS_WHOLE_DIMS(T,false,false);}}
            if(info_x1.tensors[0].dtype==1){BMMS_WHOLE_TYPE(half);}else{BMMS_WHOLE_TYPE(bfloat16_t);}
#undef BMMS_WHOLE_TYPE
#undef BMMS_WHOLE_DIMS
#undef BMMS_WHOLE_ONE
            return;
        }
    }

    int32_t storeM=m, storeN=n; bool packed=false;
    const int32_t originalK=k; GM_ADDR packedA=nullptr; GM_ADDR packedB=nullptr;
    // Packing and NZ compute share one kernel; reserve padded storage only for substantial tail work.
    if (m >= 512 && n >= 512 && m <= 4096 && n <= 4096 && k >= 512 && k <= 2048 &&
        k % 16 != 0 && (int64_t)m * n * k >= (1LL << 29) && (m % 128 != 0 || n % 256 != 0)) {
        struct PadSpace { aclrtStream stream; int32_t device; void* ptr; size_t bytes; };
        static thread_local std::vector<PadSpace> padSpaces;
        int32_t device = 0; aclrtGetDevice(&device);
        PadSpace* ws = nullptr;
        for (auto& item : padSpaces) if (item.stream == stream && item.device == device) ws = &item;
        if (!ws) { padSpaces.push_back({stream, device, nullptr, 0}); ws = &padSpaces.back(); }
        int32_t kp = (k + 15) / 16 * 16;
        storeM=(m+127)/128*128; storeN=(n+255)/256*256;
        size_t abytes = ((size_t)b * storeM * kp * 2 + 511) / 512 * 512;
        size_t bytes = abytes + (size_t)b * storeN * kp * 2;
        if (bytes > ws->bytes) {
            if (ws->ptr) { aclrtSynchronizeStream(stream); aclrtFree(ws->ptr); ws->ptr = nullptr; ws->bytes = 0; }
            if (aclrtMalloc(&ws->ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
            ws->bytes = bytes;
        }
        packedA = (GM_ADDR)ws->ptr; packedB = packedA + abytes;
        k = kp; packed=true;
    }

    int32_t tileM = m <= 16 ? 16 : (m <= 32 ? 32 : ((n <= 64 && k <= 128 && m >= 256 && (int64_t)b * ((m + 255) / 256) >= availableCoreNum) ? 256 : 64));
    int32_t tileN = n <= 16 ? 16 : (n <= 32 ? 32 : (n <= 64 ? 64 : 128));
    // For narrow, short-K matrices, fewer waves can offset a partially filled wave.
    if (k <= 128 && n <= 32 && m >= 2048) {
        int64_t best = ((b * ((m + tileM - 1) / tileM) + availableCoreNum - 1) / availableCoreNum) * (tileM + 128);
        for (int32_t candidate = 128; candidate * tileN <= 16384; candidate *= 2) {
            int64_t cost = ((b * ((m + candidate - 1) / candidate) + availableCoreNum - 1) / availableCoreNum) * (candidate + 128);
            if (cost < best) { best = cost; tileM = candidate; }
        }
    }
    // Enlarge tiles only when enough independent tasks remain to occupy the device.
    int32_t initialRows = b * ((m + tileM - 1) / tileM);
    if (n > 128 && (k >= 256 || initialRows * 2 < availableCoreNum) && (initialRows * 2 >= availableCoreNum ||
        (int64_t)initialRows * ((n + 255) / 256) >= availableCoreNum)) tileN = 256;

    // Each tile reloads its own A/B slab from GM and pays one Fixpipe + one scheduler pass,
    // so a 128-row M tile is a win whenever enough tiles remain to keep the device busy.
    // ...but never override the tuned narrow-matrix M-tile chosen just above.
    if (m >= 128 && tileN >= 128) {
        int64_t tiles = (int64_t)((m + 127) / 128) * ((n + 127) / 128);
        if (tiles * 2 >= availableCoreNum) tileM = 128;
    }
    if (k <= 256 && (int64_t)b * m * n * k < (1LL << 28) &&
        n > 128 && n <= 1024 && m <= 512) tileN = 128;
    // Keep the AIV UB footprint (tile staging + max/sum reduce buffers) inside the 192 KB
    // budget; an over-large tile overflows UB and faults or hangs the kernel at run time.
    {
        int64_t aux = 32768 + 2 * (int64_t)((m + 7) / 8) * 32 + 2 * (int64_t)tileM * 4;
        int64_t maxStage = (180 * 1024 - aux) / 4;   // elements the chunked AIV staging may hold
        while ((int64_t)tileM * (tileN < 128 ? tileN : 128) > maxStage && (tileM > 16 || tileN > 16)) {
            if (tileN > 128 || (tileN >= tileM && tileN > 16)) tileN >>= 1;
            else if (tileM > 16) tileM >>= 1;
            else break;
        }
    }

    const bool useFullA = !packed && transposeX1 && !transposeX2 && m>=512 && m<=8192 && n>=1024 && n<=8192 &&
        m%128==0 && n%512==0 && k>1024 && k<=1792 && k%32==0 && tileM==128 && tileN==256;
    const bool padPair = !transposeX1 && !transposeX2 && m <= 256 && n <= 256 && k > 128 && k <= 256 && k % 16 != 0;
    const bool pairK = !packed && (padPair || ((k > 1024 || (k > 256 && m <= 128 && n <= 128)) && k % 2 == 0));
    const int32_t pairMaxK = (k + 1) / 2;
    struct Plan { int32_t batch, m, n, k, dtype, tileM, tileN; bool ta, tb, nz, resident; TCubeTiling tiling; };
    static thread_local std::vector<Plan> plans;
    TCubeTiling tiling;
    bool found = false;
    for (const auto& plan : plans) {
        if (plan.batch == b && plan.m == m && plan.n == n && plan.k == k && plan.dtype == info_x1.tensors[0].dtype &&
            plan.ta == transposeX1 && plan.tb == transposeX2 && plan.nz == packed && plan.resident == useFullA && plan.tileM == tileM && plan.tileN == tileN) { tiling = plan.tiling; found = true; break; }
    }
    if (!found) {
        matmul_tiling::PlatformInfo platform;
        platform.socVersion = platform_ascendc::SocVersion::ASCEND910B;
        platform.l1Size = 512 * 1024;
        platform.l0ASize = platform.l0BSize = 64 * 1024;
        platform.l0CSize = 128 * 1024;
        platform.ubSize = 192 * 1024;
        matmul_tiling::MatmulApiTiling api(platform);
        auto dtype = info_x1.tensors[0].dtype == 2 ? matmul_tiling::DataType::DT_BF16 : matmul_tiling::DataType::DT_FLOAT16;
        api.SetAType(useFullA ? matmul_tiling::TPosition::A1 : matmul_tiling::TPosition::GM, ((packed||useFullA)?matmul_tiling::CubeFormat::NZ:matmul_tiling::CubeFormat::ND), dtype, transposeX1);
        api.SetBType(matmul_tiling::TPosition::GM, (packed?matmul_tiling::CubeFormat::NZ:matmul_tiling::CubeFormat::ND), dtype, transposeX2);
        api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);
        api.SetShape(tileM, tileN, (useFullA || (pairK && k%32!=0)) ? pairMaxK : k);
        api.SetOrgShape(useFullA ? tileM : storeM, storeN, useFullA ? k/2 : k, k);
        if (m >= 512 && n >= 512 && k >= 512 && n % 128 != 0 && k % 16 != 0 && transposeX2)
            api.SetFixSplit(std::min(tileM, 128), std::min(tileN, 128), -1);
        else api.SetFixSplit(std::min(tileM, 256), tileN, useFullA ? 64 : -1);
        api.SetBufferSpace(platform.l1Size, platform.l0CSize, 0);
        if (api.GetTiling(tiling) != 0) return;
        if (useFullA) {
            tiling.stepM=1; tiling.stepN=1; tiling.stepKa=1; tiling.depthA1=2;
            tiling.stepKb=(512*1024-tileM*k*2)/(2*tiling.baseN*tiling.baseK*2);
            tiling.depthB1=2*tiling.stepKb;
        }
        // Balanced K slabs reduce small-operand DMA scheduling without increasing
        // L1 capacity. Apply after SDK tiling and before caching the final plan.
        if (!packed && !useFullA && k >= 512 && (int64_t)b*m*n*k >= (1LL << 28) &&
            tiling.stepM == 1 && tiling.stepN == 1 && tiling.baseM > 0 &&
            tiling.baseN > 0 && tiling.baseK > 0 && k % tiling.baseK == 0 &&
            tiling.stepKa > 0 && tiling.stepKb > 0) {
            const int64_t slabBytes = 4LL * tiling.baseK * (tiling.baseM + tiling.baseN);
            const int blocks = k / tiling.baseK;
            const int limit = std::min<int64_t>(blocks, platform.l1Size / slabBytes);
            int q = 1;
            while (q * 2 <= limit && blocks % (q * 2) == 0) q *= 2;
            const int64_t l0a = 2LL*tiling.baseM*tiling.baseK*tiling.dbL0A;
            const int64_t l0b = 2LL*tiling.baseN*tiling.baseK*tiling.dbL0B;
            const int64_t l0c = 4LL*tiling.baseM*tiling.baseN*tiling.dbL0C;
            if (q > std::min(tiling.stepKa, tiling.stepKb) && slabBytes*q <= platform.l1Size &&
                tiling.dbL0A > 0 && tiling.dbL0B > 0 && tiling.dbL0C > 0 &&
                l0a <= platform.l0ASize && l0b <= platform.l0BSize && l0c <= platform.l0CSize) {
                tiling.stepKa = q; tiling.stepKb = q;
                tiling.depthA1 = 2*q; tiling.depthB1 = 2*q;
                tiling.shareL1Size = slabBytes*q;
            }
        }
        tiling.M = useFullA ? tileM : storeM; tiling.N = storeN; tiling.Ka = useFullA ? k/2 : k; tiling.Kb = k;
        tiling.singleCoreM = tileM; tiling.singleCoreN = tileN; tiling.singleCoreK = pairK ? pairMaxK : k;
        plans.push_back({b, m, n, k, info_x1.tensors[0].dtype, tileM, tileN, transposeX1, transposeX2, packed, useFullA, tiling});
    }
    int32_t rowTasks = b * ((m + tileM - 1) / tileM);
    int32_t nt = (n + tileN - 1) / tileN;
    int32_t ns = 1;
    // Estimate the number of serial tile steps; avoid extra partitions on ties.
    // N-partitioning multiplies the task count and pays the per-task scheduler cost again;
    // only consider it while the B*M row tasks alone leave most of the device idle.
    if (rowTasks < 2 * availableCoreNum) {
        int32_t bestCost = ((rowTasks + availableCoreNum - 1) / availableCoreNum) * nt;
        for (int32_t parts = 2; parts <= nt && parts <= availableCoreNum; ++parts) {
            int32_t cost = ((rowTasks * parts + availableCoreNum - 1) / availableCoreNum) * ((nt + parts - 1) / parts);
            if (cost < bestCost) { bestCost = cost; ns = parts; }
        }
    }
    int32_t tasks = rowTasks * ns;
    int32_t cores = std::max<int32_t>(1, std::min<int64_t>(availableCoreNum, tasks));
    // Successive launches on the same stream reuse its workspace in stream order.
    struct Workspace { aclrtStream stream; int32_t device; void* ptr; size_t bytes; };
    static thread_local std::vector<Workspace> workspaces;
    int32_t device = 0;
    aclrtGetDevice(&device);
    Workspace* ws = nullptr;
    for (auto& item : workspaces) if (item.stream == stream && item.device == device) ws = &item;
    if (!ws) { workspaces.push_back({stream, device, nullptr, 0}); ws = &workspaces.back(); }
    const bool shortResident = !pairK && !packed && m>=256 && n>=256 &&
        m<=8192 && n<=8192 && k>=32 && k<=128 && k%32==0 &&
        ((int64_t)b*m*n*k >= (1LL<<28) || n>=8*m) &&
        m%tileM==0 && n%tileN==0 &&
        ((tileM==128 && (tileN==128 || tileN==256)) || (tileM==64 && tileN==256));
    size_t matrixBytes = (size_t)cores * 2 * tileM * tileN * 4;
    const size_t packOffset = matrixBytes + ((size_t)b * ns * m * 4 + 511) / 512 * 512;
    const int32_t kp = (k + 15) / 16 * 16;
    const bool padB = !transposeX1 && !transposeX2 && !pairK && !packed && k % 16 != 0 && k >= 16 && k <= 256 &&
        m <= 256 && n <= 256 && (int64_t)b * m * n * k < (1LL << 28) && (int64_t)b * kp * n <= (1LL << 20) &&
        tileM <= 128 && tileN <= 128 && (int64_t)tileM * tileN <= 16384;
    const size_t packABytes=shortResident && !transposeX1 ? ((size_t)b*m*k*2+511)/512*512 : 0;
    const size_t packBBytes=shortResident && transposeX2 ? (size_t)b*n*k*2 : 0;
    size_t bytes=packOffset+packABytes+packBBytes;
    if (bytes > ws->bytes) {
        if (ws->ptr) { aclrtSynchronizeStream(stream); aclrtFree(ws->ptr); ws->ptr = nullptr; ws->bytes = 0; }
        if (aclrtMalloc(&ws->ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
        ws->bytes = bytes;
    }
    auto matrix = (GM_ADDR)ws->ptr;
    auto maxima = matrix + matrixBytes;
    GM_ADDR interleaveA=matrix+packOffset; GM_ADDR interleaveB=interleaveA+packABytes;
    const bool useManual = (!pairK && !packed && (int64_t)b * m * n * k < (1LL << 28) && k % 16 == 0 &&
                            (int64_t)tileM * tileN <= 32768 && tileM <= 256 &&
                            !(m >= 512 && n >= 8 * m));
#define BMMS_MANUAL(T, A, B) do { \
    if (b <= availableCoreNum && k == 32 && m == 32 && n == 32) bmms_full<T, A, B, 32, 32, 32><<<cores, nullptr, stream>>>(x1, x2, matrix, y); \
    else if (b <= availableCoreNum && k == 64 && m == 64 && n == 64) bmms_full<T, A, B, 64, 64, 64><<<cores, nullptr, stream>>>(x1, x2, matrix, y); \
    else if (b <= availableCoreNum && k == 128 && m == 64 && n == 128) bmms_full<T, A, B, 64, 128, 128><<<cores, nullptr, stream>>>(x1, x2, matrix, y); \
    else if (k == 32 && m == 32 && n == 32) bmms_small<T, A, B, 32, 32, 32, true><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tileM, tileN); \
    else if (k == 64 && m == 64 && n == 64) bmms_small<T, A, B, 64, 64, 64, true><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tileM, tileN); \
    else if (tileM == 64 && tileN == 128 && k == 128) bmms_manual<T, A, B, 64, 128, 128><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tileM, tileN); \
    else if (tileM == 256 && tileN == 64 && n > 32 && m >= 1024 && k <= 128) { \
        if (k == 32) bmms_manual_narrow<T,A,B,256,64,32><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN); \
        else if (k == 64) bmms_manual_narrow<T,A,B,256,64,64><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN); \
        else if (k == 128) bmms_manual_narrow<T,A,B,256,64,128><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN); \
        else bmms_manual_narrow<T,A,B,256,64><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN); \
    } \
    else bmms_manual<T, A, B><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tileM, tileN); \
} while (0)
    const bool staticFullTile = m % tileM == 0 && n % tileN == 0 &&
        tiling.baseK > 0 && k % tiling.baseK == 0;
    const uint32_t staticTilingKey = staticFullTile && tiling.baseM == 128 &&
        tiling.baseN == 256 && tiling.baseK == 64 ? 1 :
        staticFullTile && tiling.baseM == 128 && tiling.baseN == 128 && tiling.baseK == 128 ? 2 : 0;
    const int32_t batchCores = std::min<int64_t>(availableCoreNum,b);
    const int32_t batchMt = (m + tileM - 1) / tileM;
    const uint32_t batchOwnedKey = !packed && !pairK && !useFullA && !shortResident &&
        !useManual && !padB && ns==1 && tileM==128 && m>tileM && m<=8192 &&
        ((b+batchCores-1)/batchCores)*batchMt <= (tasks+cores-1)/cores ? staticTilingKey : 0;
    const bool pairStaticFullTile = pairK && k % 2 == 0 && m % tiling.singleCoreM == 0 &&
        n % tiling.singleCoreN == 0 && tiling.baseK > 0 && (k/2) % tiling.baseK == 0;
    const uint32_t pairStaticKey = pairStaticFullTile && tiling.baseM == 128 &&
        tiling.baseN == 256 && tiling.baseK == 64 ? 1 :
        pairStaticFullTile && tiling.baseM == 128 && tiling.baseN == 128 && tiling.baseK == 128 ? 2 : 0;
#define BMMS_LAUNCH(T, A, B) do { \
    if(shortResident) { \
        if(tileM==64)bmms_short_resident<T,A,B,64,256><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN,interleaveA,interleaveB); \
        else if(tileN==128)bmms_short_resident<T,A,B,128,128><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN,interleaveA,interleaveB); \
        else bmms_short_resident<T,A,B,128,256><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN,interleaveA,interleaveB); \
    } \
    else if (useFullA) bmms_resident<T,A,B,true,true><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else if (pairStaticKey == 1) bmms_pair_static<T,A,B,128,256,64><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else if (pairStaticKey == 2) bmms_pair_static<T,A,B,128,128,128><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else if (padPair && tileM <= 128 && tileN <= 128) bmms_manual_pad<T,false,false,0,0,0,true><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN,(pairMaxK+15)/16*16); \
    else if (pairK) bmms_resident<T,A,B,true><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else if (useManual) BMMS_MANUAL(T, A, B); \
    else if (padB) bmms_manual_pad<T,false,false><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN,kp); \
    else if(packed) bmms_fused_nz<T,A,B,true><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling,storeM,storeN,packedA,packedB,originalK); \
    else if (batchOwnedKey == 1) bmms_batch_owned<T,A,B,128,256,64><<<batchCores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else if (batchOwnedKey == 2) bmms_batch_owned<T,A,B,128,128,128><<<batchCores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else if (staticTilingKey == 1) bmms_fused_static<T,A,B,128,256,64><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else if (staticTilingKey == 2) bmms_fused_static<T,A,B,128,128,128><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else bmms_fused<T,A,B><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
} while (0)
    if (info_x1.tensors[0].dtype == 2) {
        if (transposeX1) { if (transposeX2) { BMMS_LAUNCH(bfloat16_t, true, true); } else { BMMS_LAUNCH(bfloat16_t, true, false); } }
        else { if (transposeX2) { BMMS_LAUNCH(bfloat16_t, false, true); } else { BMMS_LAUNCH(bfloat16_t, false, false); } }
    } else {
        if (transposeX1) { if (transposeX2) { BMMS_LAUNCH(half, true, true); } else { BMMS_LAUNCH(half, true, false); } }
        else { if (transposeX2) { BMMS_LAUNCH(half, false, true); } else { BMMS_LAUNCH(half, false, false); } }
    }
#undef BMMS_LAUNCH
#undef BMMS_MANUAL
}
