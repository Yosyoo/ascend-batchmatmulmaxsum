#include <algorithm>
#include <vector>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling_api.h"
using namespace AscendC;
using namespace matmul;
constexpr MatmulConfig BMMS_MM_CFG = GetMDLConfig(false, false, 0, false, false, false, true);

template<class T, bool TA, bool TB>
__global__ __aicore__ __mix__(1, 1) void bmms_fused(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        MatmulImpl<AT, BT, CT, BiasT, BMMS_MM_CFG> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(m, n, k, k, tileN);
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                if (t - begin >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                mm.SetSingleShape(cm, cn, k);
                mm.SetTensorA(ag[(int64_t)batch * m * k + (TA ? mi : (int64_t)mi * k)], TA);
                mm.SetTensorB(bg[(int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni)], TB);
                mm.IterateAll(sg[coreOffset + (int64_t)slot * tileM * tileN]);
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
            }
            CrossCoreWaitFlag(10);
            if (end - begin > 1) CrossCoreWaitFlag(15);
        }
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input, sumInput;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced, rowMax;
        pipe.InitBuffer(input, 1, tileM * tileN * 4);
        pipe.InitBuffer(sumInput, 1, (m + 7) / 8 * 32);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        pipe.InitBuffer(rowMax, (m + 7) / 8 * 32);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                auto x = input.AllocTensor<float>();
                if (cn != tileN) {
                    Duplicate(x, -3.402823466e+38f, tileM * tileN);
                    SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                }
                DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cn * 4,
                    (uint32_t)(tileN - cn) * 4, (uint32_t)(tileN - (cn + 7) / 8 * 8) / 8, 0};
                DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                DataCopyPad(x, sg[coreOffset + (int64_t)slot * tileM * tileN], cp, pad);
                input.EnQue(x); x = input.DeQue<float>();
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                uint32_t shape[] = {(uint32_t)cm, (uint32_t)tileN};
                ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                Max(running, running, rbuf, cm);
                input.FreeTensor(x);
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto acc = rowMax.Get<float>();
            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                auto x = sumInput.AllocTensor<float>();
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(x, mg[((int64_t)batch * ns + part) * m], cp, pad);
                sumInput.EnQue(x); x = sumInput.DeQue<float>();
                if (ns == 1) ReduceSum(rbuf, x, sumTemp, m);
                else Max(acc, acc, x, m);
                sumInput.FreeTensor(x);
            }
            auto out = output.AllocTensor<float>();
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else ReduceSum(out, acc, sumTemp, m);
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
        }
    }
}

template<class T>
__global__ __aicore__ __vector__ void bmms_dot(GM_ADDR a, GM_ADDR b, GM_ADDR y, int32_t batches, int32_t k)
{
    TPipe pipe;
    int32_t alignK = (k + 15) / 16 * 16;
    TQue<TPosition::VECIN, 1> qa, qb;
    TQue<TPosition::VECOUT, 1> qo;
    TBuf<TPosition::VECCALC> fa, fb, temp;
    pipe.InitBuffer(qa, 1, alignK * 2); pipe.InitBuffer(qb, 1, alignK * 2);
    pipe.InitBuffer(qo, 1, 32);
    pipe.InitBuffer(fa, alignK * 4); pipe.InitBuffer(fb, alignK * 4); pipe.InitBuffer(temp, 32768);
    GlobalTensor<T> ag, bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b); yg.SetGlobalBuffer((__gm__ float*)y);
    auto af = fa.Get<float>(); auto bf = fb.Get<float>(); auto tmp = temp.Get<float>();
    for (int32_t batch = GetBlockIdx(); batch < batches; batch += GetBlockNum()) {
        auto al = qa.AllocTensor<T>(); auto bl = qb.AllocTensor<T>();
        DataCopyExtParams cp{1, (uint32_t)k * 2, 0, 0, 0};
        DataCopyPadExtParams<T> pad{false, 0, 0, (T)0};
        DataCopyPad(al, ag[(int64_t)batch * k], cp, pad); DataCopyPad(bl, bg[(int64_t)batch * k], cp, pad);
        qa.EnQue(al); qb.EnQue(bl); al = qa.DeQue<T>(); bl = qb.DeQue<T>();
        Cast(af, al, RoundMode::CAST_NONE, k); Cast(bf, bl, RoundMode::CAST_NONE, k);
        Mul(af, af, bf, k);
        auto out = qo.AllocTensor<float>(); ReduceSum(out, af, tmp, k);
        qo.EnQue(out); out = qo.DeQue<float>();
        DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], out, op);
        qo.FreeTensor(out); qa.FreeTensor(al); qb.FreeTensor(bl);
    }
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    int32_t b = info_x1.tensors[0].shape[0];
    int32_t m = info_x1.tensors[0].shape[transposeX1 ? 2 : 1];
    int32_t k = info_x1.tensors[0].shape[transposeX1 ? 1 : 2];
    int32_t n = info_x2.tensors[0].shape[transposeX2 ? 1 : 2];
    if (m == 1 && n == 1) {
        int32_t vc = std::max<int32_t>(1, std::min<int64_t>(b, availableCoreNum * 2));
        if (info_x1.tensors[0].dtype == 2) bmms_dot<bfloat16_t><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
        else bmms_dot<half><<<vc, nullptr, stream>>>(x1, x2, y, b, k);
        return;
    }

    int32_t tileM = m <= 16 ? 16 : (m <= 32 ? 32 : ((n <= 64 && k <= 128 && m >= 256 && (int64_t)b * ((m + 255) / 256) >= availableCoreNum) ? 256 : 64));
    int32_t tileN = n <= 16 ? 16 : (n <= 32 ? 32 : (n <= 64 ? 64 : 128));
    // For narrow, short-K matrices, fewer waves can offset a partially filled wave.
    if (k <= 128 && n <= 32 && m >= 2048) {
        int64_t best = ((b * ((m + tileM - 1) / tileM) + availableCoreNum - 1) / availableCoreNum) * (tileM + 128);
        for (int32_t candidate = 128; candidate * tileN <= 16384; candidate *= 2) {
            int64_t cost = ((b * ((m + candidate - 1) / candidate) + availableCoreNum - 1) / availableCoreNum) * (candidate + 128);
            if (cost < best) { best = cost; tileM = candidate; }
        }
    }
    // Enlarge tiles only when enough independent tasks remain to occupy the device.
    int32_t initialRows = b * ((m + tileM - 1) / tileM);
    if (n > 128 && (k >= 256 || initialRows * 2 < availableCoreNum) && (initialRows * 2 >= availableCoreNum ||
        (int64_t)initialRows * ((n + 255) / 256) >= availableCoreNum)) tileN = 256;
    struct Plan { int32_t m, n, k, dtype, tileM, tileN; bool ta, tb; TCubeTiling tiling; };
    static thread_local std::vector<Plan> plans;
    TCubeTiling tiling;
    bool found = false;
    for (const auto& plan : plans) {
        if (plan.m == m && plan.n == n && plan.k == k && plan.dtype == info_x1.tensors[0].dtype &&
            plan.ta == transposeX1 && plan.tb == transposeX2 && plan.tileM == tileM && plan.tileN == tileN) { tiling = plan.tiling; found = true; break; }
    }
    if (!found) {
        matmul_tiling::PlatformInfo platform;
        platform.socVersion = platform_ascendc::SocVersion::ASCEND910B;
        platform.l1Size = 512 * 1024;
        platform.l0ASize = platform.l0BSize = 64 * 1024;
        platform.l0CSize = 128 * 1024;
        platform.ubSize = 192 * 1024;
        matmul_tiling::MatmulApiTiling api(platform);
        auto dtype = info_x1.tensors[0].dtype == 2 ? matmul_tiling::DataType::DT_BF16 : matmul_tiling::DataType::DT_FLOAT16;
        api.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX1);
        api.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, transposeX2);
        api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);
        api.SetShape(tileM, tileN, k);
        api.SetOrgShape(m, n, k);
        api.SetFixSplit(std::min(tileM, 256), tileN, std::min(k, 128));
        api.SetBufferSpace(platform.l1Size, platform.l0CSize, 0);
        if (api.GetTiling(tiling) != 0) return;
        tiling.M = m; tiling.N = n; tiling.Ka = k; tiling.Kb = k;
        tiling.singleCoreM = tileM; tiling.singleCoreN = tileN; tiling.singleCoreK = k;
        plans.push_back({m, n, k, info_x1.tensors[0].dtype, tileM, tileN, transposeX1, transposeX2, tiling});
    }
    int32_t rowTasks = b * ((m + tileM - 1) / tileM);
    int32_t nt = (n + tileN - 1) / tileN;
    int32_t ns = 1;
    // Estimate the number of serial tile steps; avoid extra partitions on ties.
    // N-partitioning multiplies the task count and pays the per-task scheduler cost again;
    // only consider it while the B*M row tasks alone leave most of the device idle.
    if (rowTasks < 2 * availableCoreNum) {
        int32_t bestCost = ((rowTasks + availableCoreNum - 1) / availableCoreNum) * nt;
        for (int32_t parts = 2; parts <= nt && parts <= availableCoreNum; ++parts) {
            int32_t cost = ((rowTasks * parts + availableCoreNum - 1) / availableCoreNum) * ((nt + parts - 1) / parts);
            if (cost < bestCost) { bestCost = cost; ns = parts; }
        }
    }
    int32_t tasks = rowTasks * ns;
    int32_t cores = std::max<int32_t>(1, std::min<int64_t>(availableCoreNum, tasks));
    // Successive launches on the same stream reuse its workspace in stream order.
    struct Workspace { aclrtStream stream; int32_t device; void* ptr; size_t bytes; };
    static thread_local std::vector<Workspace> workspaces;
    int32_t device = 0;
    aclrtGetDevice(&device);
    Workspace* ws = nullptr;
    for (auto& item : workspaces) if (item.stream == stream && item.device == device) ws = &item;
    if (!ws) { workspaces.push_back({stream, device, nullptr, 0}); ws = &workspaces.back(); }
    size_t matrixBytes = (size_t)cores * 2 * tileM * tileN * 4;
    size_t bytes = matrixBytes + ((size_t)b * ns * m * 4 + 511) / 512 * 512;
    if (bytes > ws->bytes) {
        if (ws->ptr) { aclrtSynchronizeStream(stream); aclrtFree(ws->ptr); ws->ptr = nullptr; ws->bytes = 0; }
        if (aclrtMalloc(&ws->ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return;
        ws->bytes = bytes;
    }
    auto matrix = (GM_ADDR)ws->ptr;
    auto maxima = matrix + matrixBytes;
#define BMMS_LAUNCH(T, A, B) bmms_fused<T, A, B><<<cores, nullptr, stream>>>(x1, x2, matrix, maxima, y, b, m, n, k, ns, tiling)
    if (info_x1.tensors[0].dtype == 2) {
        if (transposeX1) { if (transposeX2) { BMMS_LAUNCH(bfloat16_t, true, true); } else { BMMS_LAUNCH(bfloat16_t, true, false); } }
        else { if (transposeX2) { BMMS_LAUNCH(bfloat16_t, false, true); } else { BMMS_LAUNCH(bfloat16_t, false, false); } }
    } else {
        if (transposeX1) { if (transposeX2) { BMMS_LAUNCH(half, true, true); } else { BMMS_LAUNCH(half, true, false); } }
        else { if (transposeX2) { BMMS_LAUNCH(half, false, true); } else { BMMS_LAUNCH(half, false, false); } }
    }
#undef BMMS_LAUNCH
}
