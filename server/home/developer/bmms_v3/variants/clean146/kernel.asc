#include <algorithm>
#include <stdexcept>
#include <string>
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling_api.h"
using namespace AscendC;
using namespace matmul;
constexpr MatmulConfig BMMS_MM_CFG = GetMDLConfig(false, false, 0, false, false, false, true);

__aicore__ inline void bmms_sum(const LocalTensor<float>& dst,
    const LocalTensor<float>& src, const LocalTensor<float>& tmp, int32_t count)
{
    if (count <= 64) { WholeReduceSum(dst, src, count, 1, 1, 1, 8); return; }
    int32_t groups = count / 64;
    WholeReduceSum(tmp, src, 64, groups, 1, 1, 8);
    if (count % 64) WholeReduceSum(tmp[groups], src[groups * 64], count % 64, 1, 1, 1, 8);
    int32_t partials = (count + 63) / 64;
    PipeBarrier<PIPE_V>();
    if (partials > 64) {
        Add(tmp, tmp, tmp[64], partials - 64);
        PipeBarrier<PIPE_V>();
        partials = 64;
    }
    WholeReduceSum(dst, tmp, partials, 1, 1, 1, 8);
}

// Pair the two row halves before the final sum when their UB offsets are aligned.
// This lowers cancellation error without changing the row maxima.
__aicore__ inline void bmms_paired_sum(const LocalTensor<float>& dst,
    const LocalTensor<float>& src, const LocalTensor<float>& tmp, int32_t count)
{
    int32_t h = count / 2;
    if (h > 0 && h % 8 == 0) {
        Add(src, src, src[h], h);
        PipeBarrier<PIPE_V>();
        if (count % 2) {
            Add(src, src, src[h * 2], 1);
            PipeBarrier<PIPE_V>();
        }
        ReduceSum(dst, src, tmp, h);
    } else ReduceSum(dst, src, tmp, count);
}

// Reuse the retired tile buffer for several complete N-partition maximum planes.
// Every plane is read from the current invocation; padding is initialized to -inf.
__aicore__ inline LocalTensor<float> bmms_load_max_planes(
    const LocalTensor<float>& stage, const GlobalTensor<float>& maxima,
    int32_t batch,int32_t m,int32_t ns,int32_t rowStride,int32_t stageElements)
{
    int32_t capacity=stageElements/rowStride;
    const bool allFit=ns<=capacity;
    if(allFit)capacity=ns;else --capacity; // retain one plane for the group accumulator
    auto acc=stage[allFit?0:capacity*rowStride];
    for(int32_t first=0;first<ns;first+=capacity) {
        const int32_t count=ns-first<capacity?ns-first:capacity;
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        DataCopyExtParams cp{(uint16_t)count,(uint32_t)m*4,0,0,0};
        DataCopyPadExtParams<float> pad{true,0,(uint8_t)(rowStride-m),-3.402823466e+38f};
        DataCopyPad(stage,maxima[((int64_t)batch*ns+first)*m],cp,pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        int32_t power=1;while(power*2<=count)power*=2;
        if(count>power) {
            Max(stage,stage,stage[power*rowStride],(count-power)*rowStride);
            PipeBarrier<PIPE_V>();
        }
        for(int32_t half=power/2;half;half/=2) {
            Max(stage,stage,stage[half*rowStride],half*rowStride);
            PipeBarrier<PIPE_V>();
        }
        if(!allFit) {
            if(first==0)Adds(acc,stage,0.0f,m);
            else Max(acc,acc,stage,m);
            PipeBarrier<PIPE_V>();
        }
    }
    return acc;
}


template<class T, bool TA, bool TB, int TM = 0, int TN = 0, int TK = 0>
__global__ __aicore__ __mix__(1, 1) void bmms_manual(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns,
    int32_t dynamicM, int32_t dynamicN)
{
    constexpr bool useManual = true;
    const int32_t tileM = TM ? TM : dynamicM;
    const int32_t tileN = TN ? TN : dynamicN;
    if (TK) k = TK;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;

    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        // Hand-rolled cube path (no Matmul-library scheduler) for small problems, where the
        // library's per-task scalar/icache cost dominates the actual MAC time.
        const int32_t mp = tileM, np = tileN;
        int32_t bk = (32768 / (mp > np ? mp : np)) / 16 * 16;
        if (bk > k) bk = k;
        // When the whole K range fits in this L0 operand slab, all N panels
        // in one (batch,M,partition) task use the same A values. Retain them
        // in L1/L0A only for this invocation; the first N panel of every task
        // always reloads A. Multi-K-stage tasks keep the complete old path.
        const bool keepA=(k<=bk);
        LocalTensor<T> l1a(TPosition::A1, 0, mp * bk);
        LocalTensor<T> l1b(TPosition::B1, mp * bk * 2, np * bk);
        LocalTensor<T> l0a(TPosition::A2, 0, mp * bk);
        LocalTensor<T> l0b(TPosition::B2, 0, np * bk);
        LocalTensor<float> l0c(TPosition::CO1, 0, mp * np);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                if (t - begin >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                if (useManual) {
                    const int32_t cm16 = (cm + 15) / 16 * 16;
                    const int32_t cn16 = (cn + 15) / 16 * 16;
                    const int64_t aBase = (int64_t)batch * m * k + (TA ? (int64_t)mi : (int64_t)mi * k);
                    const int64_t bBase = (int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni);
                    for (int32_t k0 = 0; k0 < k; k0 += bk) {
                        int32_t kk = (k0 + bk <= k) ? bk : (k - k0);
                        int32_t kk16 = (kk + 15) / 16 * 16;
                        // Close the pipe hazards left by the previous chunk/tile before rewriting L1/L0.
                        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                        if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                        // ---- GM(ND) -> L1(NZ) ----
                        Nd2NzParams pa;
                        pa.ndNum = 1;
                        pa.dstNzNStride = 1;
                        pa.dstNzMatrixStride = 0;
                        pa.srcNdMatrixStride = 1;
                        int64_t aOff = aBase;
                        if (!TA) {
                            pa.nValue = (uint16_t)cm; pa.dValue = (uint16_t)kk;
                            pa.srcDValue = (uint16_t)k; pa.dstNzC0Stride = (uint16_t)cm16;
                            aOff += k0;
                        } else {
                            pa.nValue = (uint16_t)kk; pa.dValue = (uint16_t)cm;
                            pa.srcDValue = (uint16_t)m; pa.dstNzC0Stride = (uint16_t)kk16;
                            aOff += (int64_t)k0 * m;
                        }
                        Nd2NzParams pb;
                        pb.ndNum = 1;
                        pb.dstNzNStride = 1;
                        pb.dstNzMatrixStride = 0;
                        pb.srcNdMatrixStride = 1;
                        pb.dstNzC0Stride = (uint16_t)(TB ? cn16 : kk16);
                        int64_t bOff = bBase;
                        if (!TB) {
                            pb.nValue = (uint16_t)kk; pb.dValue = (uint16_t)cn;
                            pb.srcDValue = (uint16_t)n;
                            bOff += (int64_t)k0 * n;
                        } else {
                            pb.nValue = (uint16_t)cn; pb.dValue = (uint16_t)kk;
                            pb.srcDValue = (uint16_t)k;
                            bOff += k0;
                        }
                        if(!keepA || t==begin)DataCopy(l1a, ag[aOff], pa);
                        DataCopy(l1b, bg[bOff], pb);
                        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        // ---- L1 -> L0A / L0B ----
                        const int32_t bm = cm16 / 16;
                        const int32_t bn = cn16 / 16;
                        const int32_t bkk = kk16 / 16;
                        LoadData2dParams lp;
                        lp.startIndex = 0;
                        lp.sid = 0;
                        lp.dstGap = 0;
                        if(!keepA || t==begin){
                        if (!TA) {
                            lp.ifTranspose = false;
                            if (bkk == 1) {
                                lp.repeatTimes = (uint8_t)bm;
                                lp.srcStride = 1;
                                LoadData(l0a, l1a, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = (uint8_t)bm;
                                for (int32_t i = 0; i < bm; ++i) {
                                    LoadData(l0a[i * bkk * 256], l1a[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = true;
                            lp.repeatTimes = (uint8_t)(bm * bkk);
                            lp.srcStride = 1;
                            LoadData(l0a, l1a, lp);
                        }
                        }
                        if (!TB) {
                            lp.ifTranspose = true;
                            if (bn == 1) {
                                lp.repeatTimes = (uint8_t)bkk;
                                lp.srcStride = 1;
                                LoadData(l0b, l1b, lp);
                            } else {
                                lp.repeatTimes = (uint8_t)bn;
                                lp.srcStride = (uint8_t)bkk;
                                for (int32_t i = 0; i < bkk; ++i) {
                                    LoadData(l0b[i * bn * 256], l1b[i * 256], lp);
                                }
                            }
                        } else {
                            lp.ifTranspose = false;
                            lp.repeatTimes = (uint8_t)(bn * bkk);
                            lp.srcStride = 1;
                            LoadData(l0b, l1b, lp);
                        }
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);   // L1 reusable
                        l1Busy = true;
                        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                        // ---- Mmad ----
                        MmadParams mmp;
                        mmp.m = (uint16_t)cm16;
                        mmp.n = (uint16_t)cn16;
                        mmp.k = (uint16_t)kk16;
                        mmp.isBias = false;
                        mmp.cmatrixSource = false;
                        mmp.cmatrixInitVal = (k0 == 0);
                        mmp.unitFlag = 0;
                        Mmad(l0c, l0a, l0b, mmp);
                        SetFlag<HardEvent::M_MTE1>(EVENT_ID3);      // L0 reusable
                        l0Busy = true;
                    }
                    SetFlag<HardEvent::M_FIX>(EVENT_ID0);           // L0C ready
                    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                    FixpipeParamsV220 fp;
                    fp.nSize = (uint16_t)cn16;
                    fp.mSize = (uint16_t)cm16;
                    fp.srcStride = (uint16_t)cm16;
                    fp.dstStride = (uint32_t)tileN;
                    fp.reluEn = false;
                    fp.ndNum = 1;
                    fp.srcNdStride = 0;
                    fp.dstNdStride = 0;
                    Fixpipe(sg[coreOffset + (int64_t)slot * tileM * tileN], l0c, fp);
                    SetFlag<HardEvent::FIX_M>(EVENT_ID0);
                    fixBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
            }
            CrossCoreWaitFlag(10);
            if (end - begin > 1) CrossCoreWaitFlag(15);
        }
        if (useManual) {
            if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
            if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        }

    }
    if ASCEND_IS_AIV {
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t vrows = (tileM + 7) / 8 * 8;
        const int32_t sumRows = (m + 7) / 8 * 8;
        const int32_t stageBytes = tileM * cN * 4;
        LocalTensor<float> x(TPosition::VECIN, 0, tileM * cN);
        LocalTensor<float> running(TPosition::VECCALC, stageBytes, vrows);
        LocalTensor<float> rbuf(TPosition::VECCALC, stageBytes + vrows * 4, vrows);
        LocalTensor<float> sumTemp(TPosition::VECCALC, stageBytes + vrows * 8, 8192);
        LocalTensor<float> sx(TPosition::VECIN, stageBytes + vrows * 8 + 32768, sumRows);
        LocalTensor<float> acc(TPosition::VECCALC, stageBytes + vrows * 8 + 32768 + sumRows * 4, sumRows);
        bool vectorBusy = false;
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);

        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;

            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = (t - begin) & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    if (vectorBusy) {
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                    if (cN == 128) {
                        Max(x, x, x[64], 64, cm, {1, 1, 1, 16, 16, 16});
                        PipeBarrier<PIPE_V>();
                    }
                    for (int32_t r = 0; r < cm; r += 248) {
                        int32_t rows = cm - r < 248 ? cm - r : 248;
                        WholeReduceMax(rbuf[r], x[r * cN], cN < 64 ? cN : 64,
                            rows, 1, 1, cN / 8, ReduceOrder::ORDER_ONLY_VALUE);
                    }
                    PipeBarrier<PIPE_V>();
                    Max(running, running, rbuf, cm);
                    vectorBusy = true;
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
            }
            if (mt == 1 && ns == 1) {
                if (cm <= 64) WholeReduceSum(rbuf, running, cm, 1, 1, 1, 8);
                else bmms_sum(rbuf, running, sumTemp, cm);
                PipeBarrier<PIPE_V>();
                Adds(running, rbuf, 0.0f, 8);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        if (mt == 1 && ns == 1) { PipeBarrier<PIPE_ALL>(); return; }
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();


        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            if (ns > 1 && m % 8 == 0 && ns * m <= 8192) {
                DataCopyExtParams cp{1, (uint32_t)(ns * m) * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sumTemp, mg[(int64_t)batch * ns * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                // Max is exact under reassociation: fold whole plane groups in a
                // balanced tree instead of issuing one vector command per plane.
                int power=1;while(power*2<=ns)power*=2;
                if(ns>power) {
                    Max(sumTemp,sumTemp,sumTemp[power*m],(ns-power)*m);
                    PipeBarrier<PIPE_V>();
                }
                for(int half=power/2;half>=1;half/=2) {
                    Max(sumTemp,sumTemp,sumTemp[half*m],half*m);
                    PipeBarrier<PIPE_V>();
                }
                bmms_sum(running, sumTemp, sx, m);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], running, op);
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            } else {

            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(sx, mg[((int64_t)batch * ns + part) * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if (ns == 1) bmms_sum(rbuf, sx, sumTemp, m);
                else Max(acc, acc, sx, m);

            }
            auto out = running;
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else bmms_sum(out, acc, sumTemp, m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
}

template<int BM, int BN, int BK>
__aicore__ constexpr MatmulConfig bmms_static_mdl_config()
{
    MatmulConfig cfg = BMMS_MM_CFG;
    cfg.basicM = BM; cfg.basicN = BN; cfg.basicK = BK;
    return cfg;
}

template<class T, bool TA, bool TB, int BM, int BN, int BK>
__global__ __aicore__ __mix__(1, 1) void bmms_fused_static(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        constexpr static MatmulConfig shapeConfig = bmms_static_mdl_config<BM, BN, BK>();
        constexpr static auto staticTiling = GetMatmulApiTiling<AT, BT, CT, BiasT>(shapeConfig);
        MatmulImpl<AT, BT, CT, BiasT, staticTiling> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(m, n, k, k, tileN);
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                mm.SetSingleShape(cm, cn, k);
                mm.SetTensorA(ag[(int64_t)batch * m * k + (TA ? mi : (int64_t)mi * k)], TA);
                mm.SetTensorB(bg[(int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni)], TB);
                mm.IterateAll(sg[coreOffset + (int64_t)slot * tileM * tileN]);
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
        }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t finalRows=(m+7)/8*8;
        const int32_t stageElements=tileM*cN>2*finalRows?tileM*cN:2*finalRows;
        pipe.InitBuffer(input, 1, stageElements*4);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto finalStage=input.AllocTensor<float>();
            auto acc=bmms_load_max_planes(finalStage,mg,batch,m,ns,finalRows,stageElements);
            auto out = output.AllocTensor<float>();
            ReduceSum(out, acc, sumTemp, m);
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            input.FreeTensor(finalStage);
        }
    }
}

template<class T, bool TA, bool TB>
__global__ __aicore__ __mix__(1, 1) void bmms_fused(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        MatmulImpl<AT, BT, CT, BiasT, BMMS_MM_CFG> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(m, n, k, k, tileN);
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                mm.SetSingleShape(cm, cn, k);
                mm.SetTensorA(ag[(int64_t)batch * m * k + (TA ? mi : (int64_t)mi * k)], TA);
                mm.SetTensorB(bg[(int64_t)batch * n * k + (TB ? (int64_t)ni * k : ni)], TB);
                mm.IterateAll(sg[coreOffset + (int64_t)slot * tileM * tileN]);
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
        }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t finalRows=(m+7)/8*8;
        const int32_t stageElements=tileM*cN>2*finalRows?tileM*cN:2*finalRows;
        pipe.InitBuffer(input, 1, stageElements*4);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto finalStage=input.AllocTensor<float>();
            auto acc=bmms_load_max_planes(finalStage,mg,batch,m,ns,finalRows,stageElements);
            auto out = output.AllocTensor<float>();
            ReduceSum(out, acc, sumTemp, m);
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            input.FreeTensor(finalStage);
        }
    }
}

template<class T, bool TA, bool TB, bool PAIR=false, bool FULLA=false>
__global__ __aicore__ __mix__(1, 1) void bmms_resident(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIC {
        using AT = MatmulType<(FULLA ? TPosition::A1 : TPosition::GM), (FULLA ? CubeFormat::NZ : CubeFormat::ND), T, TA>;
        using BT = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        MatmulImpl<AT, BT, CT, BiasT, BMMS_MM_CFG> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        TBuf<TPosition::A1> fullA;
        LocalTensor<T> residentA;
        if constexpr(FULLA) {
            pipe.InitBuffer(fullA, tileM*k*2);
            residentA=fullA.template Get<T>();
        }
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(FULLA ? tileM : m, n, FULLA ? k/2 : k, k, tileN);
        decltype(pipe.FetchEventID(HardEvent::MTE2_MTE1)) aReady{},aReleased{};
        if constexpr(FULLA) {
            aReady=pipe.FetchEventID(HardEvent::MTE2_MTE1);
            aReleased=pipe.FetchEventID(HardEvent::MTE1_MTE2);
        }
        bool aBusy=false;
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            if constexpr(FULLA) {
                if(aBusy) WaitFlag<HardEvent::MTE1_MTE2>(aReleased);
                const int32_t halfK=k/2;
                Nd2NzParams pa{1, (uint16_t)(TA ? halfK : tileM), (uint16_t)(TA ? tileM : halfK), 0,
                    (uint16_t)(TA ? m : k), (uint16_t)(TA ? halfK : tileM), 1, 0};
                for(int32_t q=0;q<2;++q) {
                    const int64_t offset=(int64_t)batch*m*k+(TA ? (int64_t)q*halfK*m+mi : (int64_t)mi*k+q*halfK);
                    DataCopy(residentA[q*tileM*halfK],ag[offset],pa);
                }
                SetFlag<HardEvent::MTE2_MTE1>(aReady);
                WaitFlag<HardEvent::MTE2_MTE1>(aReady);
            }
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int halfK = PAIR ? k/2 : k;
                for(int q=0;q<(PAIR ? 2 : 1);++q) {
                    const int pos=q*halfK;
                    mm.SetSingleShape(cm,cn,halfK);
                    if constexpr(FULLA) mm.SetTensorA(residentA[pos*tileM],TA);
                    else mm.SetTensorA(ag[(int64_t)batch*m*k+(TA ? (int64_t)pos*m+mi : (int64_t)mi*k+pos)],TA);
                    mm.SetTensorB(bg[(int64_t)batch*n*k+(TB ? (int64_t)ni*k+pos : (int64_t)pos*n+ni)],TB);
                    mm.IterateAll(sg[coreOffset+(int64_t)slot*tileM*tileN],uint8_t(q));
                    if(PAIR && q==0) {
                        const auto event=pipe.FetchEventID(HardEvent::FIX_M);
                        SetFlag<HardEvent::FIX_M>(event);WaitFlag<HardEvent::FIX_M>(event);
                    }
                }
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
            if constexpr(FULLA) { SetFlag<HardEvent::MTE1_MTE2>(aReleased); aBusy=true; }
        }
        if constexpr(FULLA) { if(aBusy) WaitFlag<HardEvent::MTE1_MTE2>(aReleased); }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t finalRows=(m+7)/8*8;
        const int32_t stageElements=tileM*cN>2*finalRows?tileM*cN:2*finalRows;
        pipe.InitBuffer(input, 1, stageElements*4);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto finalStage=input.AllocTensor<float>();
            auto acc=bmms_load_max_planes(finalStage,mg,batch,m,ns,finalRows,stageElements);
            auto out = output.AllocTensor<float>();
            ReduceSum(out, acc, sumTemp, m);
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            input.FreeTensor(finalStage);
        }
    }
}

template<class T,bool TA,bool TB>
__aicore__ inline void bmms_pack_nz_whole_rows(GM_ADDR a,GM_ADDR b,GM_ADDR pa,GM_ADDR pb,
    int batches,int m,int n,int k,int kp,int mp,int np)
{
    static_assert(sizeof(T)==2,"NZ pack requires16bit operands");
    LocalTensor<T> x(TPosition::VECIN,0,32*1280),z(TPosition::VECOUT,81920,32*512);
    LocalTensor<int32_t> ix(TPosition::VECCALC,114688,8192);
    const int ar=TA?kp:mp,ac=TA?mp:kp,br=TB?np:kp,bc=TB?kp:np;
    const int at=batches*((ar+31)/32),bt=batches*((br+31)/32);
    GlobalTensor<T> src,dst;int lastRows=0,lastCols=0;
    for(int work=GetBlockIdx();work<at+bt;work+=GetBlockNum()) {
        const bool second=work>=at;const int task=second?work-at:work;
        const int sr=second?(TB?n:k):(TA?k:m),sc=second?(TB?k:n):(TA?m:k);
        const int dr=second?br:ar,dc=second?bc:ac,rt=(dr+31)/32;
        const int batch=task/rt,ri=task%rt*32,rows=dr-ri<32?dr-ri:32;
        const int vr=ri>=sr?0:(sr-ri<rows?sr-ri:rows);
        src.SetGlobalBuffer((__gm__ T*)(second?b:a));dst.SetGlobalBuffer((__gm__ T*)(second?pb:pa));
        Duplicate(x,(T)0,rows*dc);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        if(vr) {
            DataCopyExtParams cp{(uint16_t)vr,(uint32_t)sc*2,0,(uint32_t)(dc-(sc+15)/16*16)/16,0};
            DataCopyPadExtParams<T> pad{true,0,(uint8_t)((16-sc%16)%16),(T)0};
            DataCopyPad(x,src[(int64_t)batch*sr*sc+(int64_t)ri*sc],cp,pad);
        }
        if(lastRows!=rows||lastCols!=dc) {
            #pragma unroll
            for(int j=0;j<8;++j)ix.SetValue(j,j*4);
            SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
            for(int len=8;len<rows*8;len*=2) {
                Adds(ix[len],ix,int32_t(len/8*dc*2),len);PipeBarrier<PIPE_V>();
            }
            for(int len=rows*8;len<rows*256;len*=2) {
                Adds(ix[len],ix,int32_t(len/(rows*8)*32),len);PipeBarrier<PIPE_V>();
            }
            lastRows=rows;lastCols=dc;
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        for(int ci=0;ci<dc;ci+=512) {
            const int cols=dc-ci<512?dc-ci:512;
            Gather(z.template ReinterpretCast<int32_t>(),x.template ReinterpretCast<int32_t>(),
                ix.template ReinterpretCast<uint32_t>(),ci*2,rows*cols/2);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{(uint16_t)(cols/16),(uint32_t)rows*32,0,(uint32_t)(dr-rows)*32,0};
            DataCopyPad(dst[(int64_t)batch*dr*dc+(int64_t)ci*dr+ri*16],z,op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

template<class T, bool TA, bool TB>
__aicore__ inline void bmms_pack_nz(GM_ADDR a, GM_ADDR b,
    GM_ADDR pa, GM_ADDR pb, int batches, int m, int n, int k, int kp, int mp, int np)
{
    if((TA?mp:kp)<=1280 && (TB?kp:np)<=1280) {
        bmms_pack_nz_whole_rows<T,TA,TB>(a,b,pa,pb,batches,m,n,k,kp,mp,np);return;
    }

    LocalTensor<T> x(TPosition::VECIN,0,32768), z(TPosition::VECOUT,65536,32768);
    GlobalTensor<T> src,dst;
    const int ar=TA?kp:mp, ac=TA?mp:kp;
    const int br=TB?np:kp, bc=TB?kp:np;
    const int at=batches*((ar+127)/128)*((ac+255)/256);
    const int bt=batches*((br+127)/128)*((bc+255)/256);
    // Flatten the operand grids so each Vector peer receives the same number of tiles.
    for(int work=GetBlockIdx();work<at+bt;work+=GetBlockNum()) {
        const int operand=work>=at;
        const int task=operand?work-at:work;
        src.SetGlobalBuffer((__gm__ T*)(operand?b:a));dst.SetGlobalBuffer((__gm__ T*)(operand?pb:pa));
        const int sr=operand?(TB?n:k):(TA?k:m), sc=operand?(TB?k:n):(TA?m:k);
        const int dr=operand?br:ar, dc=operand?bc:ac;
        const int rt=(dr+127)/128,ct=(dc+255)/256;
            const int batch=task/(rt*ct),ri=(task/ct)%rt*128,ci=task%ct*256;
            const int rows=dr-ri<128?dr-ri:128,cols=dc-ci<256?dc-ci:256;
            const int vr=ri>=sr?0:(sr-ri<rows?sr-ri:rows),vc=ci>=sc?0:(sc-ci<cols?sc-ci:cols);
            Duplicate(x,(T)0,rows*256);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            if(vr&&vc) {
                DataCopyExtParams cp{(uint16_t)vr,(uint32_t)vc*2,(uint32_t)(sc-vc)*2,
                    (uint32_t)(256-(vc+15)/16*16)/16,0};
                DataCopyPadExtParams<T> pad{true,0,(uint8_t)((16-vc%16)%16),(T)0};
                DataCopyPad(x,src[(int64_t)batch*sr*sc+(int64_t)ri*sc+ci],cp,pad);
            }
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            for(int c=0;c<cols/16;++c)
                Copy(z[c*rows*16].template ReinterpretCast<uint32_t>(),
                    x[c*16].template ReinterpretCast<uint32_t>(),8,rows,{1,1,1,16});
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams op{(uint16_t)(cols/16),(uint32_t)rows*16*2,0,(uint32_t)(dr-rows)*16*2,0};
            DataCopyPad(dst[(int64_t)batch*dr*dc+(int64_t)ci*dr+ri*16],z,op);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

// For a physical input P[dr,dc], form NZ(P^T): [dr/16,dc,16].
// z[(c/16)*256+j*16+i] = P[ri+i,ci+c+j].
// Flipping the Matmul storage-transpose flags cancels this physical transpose.

// Two independent raw/output stages. All padding is fresh per invocation.
template<class T,bool TA,bool TB>
__aicore__ inline void bmms_pack_transposed_stage(GM_ADDR a,GM_ADDR b,
    LocalTensor<T> raw,int work,int m,int n,int k,int kp,int mp,int np,
    int &cols,bool &second,int64_t &dstOffset,int phase)
{
    constexpr int R=16;
    const int ar=TA?kp:mp,ac=TA?mp:kp,br=TB?np:kp,bc=TB?kp:np;
    // Caller supplies a global work index and chooses the input explicitly.
    const int dr=second?br:ar,dc=second?bc:ac;
    const int sr=second?(TB?n:k):(TA?k:m),sc=second?(TB?k:n):(TA?m:k);
    const int batch=work/(dr/R),ri=work%(dr/R)*R;
    cols=dc;
    const int vr=ri>=sr?0:(sr-ri<R?sr-ri:R),vc=sc;
    dstOffset=(int64_t)batch*dr*dc+(int64_t)ri*dc;
    Duplicate(raw,(T)0,R*cols);
    auto ev=phase?EVENT_ID1:EVENT_ID0;
    SetFlag<HardEvent::V_MTE2>(ev);WaitFlag<HardEvent::V_MTE2>(ev);
    if(vr&&vc){
        GlobalTensor<T> src;src.SetGlobalBuffer((__gm__ T*)(second?b:a));
        DataCopyExtParams cp{(uint16_t)vr,(uint32_t)vc*2,(uint32_t)(sc-vc)*2,
            (uint32_t)(cols-(vc+15)/16*16)/16,0};
        DataCopyPadExtParams<T> pad{true,0,(uint8_t)((16-vc%16)%16),(T)0};
        DataCopyPad(raw,src[(int64_t)batch*sr*sc+(int64_t)ri*sc],cp,pad);
    }
    SetFlag<HardEvent::MTE2_V>(ev);
}
template<class T,bool TA,bool TB,int PACK_VECTORS=1>
__aicore__ inline void bmms_pack_transposed_pingpong(GM_ADDR a,GM_ADDR b,GM_ADDR pa,GM_ADDR pb,
    int batches,int m,int n,int k,int kp,int mp,int np)
{
    constexpr int R=16,C=1280,STAGE_BYTES=R*C*2;
    static_assert(STAGE_BYTES*4<=180*1024,"two-stage transpose UB capacity");
    LocalTensor<T> raw0(TPosition::VECIN,0,R*C),raw1(TPosition::VECIN,STAGE_BYTES,R*C);
    LocalTensor<T> out0(TPosition::VECOUT,STAGE_BYTES*2,R*C),out1(TPosition::VECOUT,STAGE_BYTES*3,R*C);
    const int ar=TA?kp:mp,br=TB?np:kp;
    const int at=batches*(ar/R),total=at+batches*(br/R),core=GetBlockIdx(),stride=GetBlockNum()*PACK_VECTORS;
    const int count=core<total?(total-1-core)/stride+1:0;
    int cols[2]={0,0},lastCols[2]={0,0};bool second[2]={false,false},busy[2]={false,false};int64_t offsets[2];
    uint64_t src0[16],src1[16],dst0[16],dst1[16];
    for(int i=0;i<2&&i<count;++i){
        const int work=core+i*stride;second[i]=work>=at;
        bmms_pack_transposed_stage<T,TA,TB>(a,b,i?raw1:raw0,second[i]?work-at:work,m,n,k,kp,mp,np,cols[i],second[i],offsets[i],i);
    }
    for(int i=0;i<count;++i){
        int phase=i&1;auto ev=phase?EVENT_ID1:EVENT_ID0;
        auto raw=phase?raw1:raw0;auto out=phase?out1:out0;
        auto srcAddr=phase?src1:src0;auto dstAddr=phase?dst1:dst0;
        WaitFlag<HardEvent::MTE2_V>(ev);
        if(busy[phase])WaitFlag<HardEvent::MTE3_V>(ev);
        if(lastCols[phase]!=cols[phase]){
            for(int j=0;j<16;++j){srcAddr[j]=(uint64_t)raw[j*cols[phase]].GetPhyAddr();dstAddr[j]=(uint64_t)out[j*16].GetPhyAddr();}
            lastCols[phase]=cols[phase];
        }
        TransDataTo5HDParams tp;tp.dstHighHalf=false;tp.srcHighHalf=false;
        tp.repeatTimes=cols[phase]/16;tp.dstRepStride=tp.repeatTimes==1?0:16;tp.srcRepStride=tp.repeatTimes==1?0:1;
        TransDataTo5HD<uint16_t>(dstAddr,srcAddr,tp);
        SetFlag<HardEvent::V_MTE3>(ev);WaitFlag<HardEvent::V_MTE3>(ev);
        GlobalTensor<T> dst;dst.SetGlobalBuffer((__gm__ T*)(second[phase]?pb:pa));
        DataCopyExtParams cp{1,(uint32_t)cols[phase]*R*2,0,0,0};DataCopyPad(dst[offsets[phase]],out,cp);
        SetFlag<HardEvent::MTE3_V>(ev);busy[phase]=true;
        if(i+2<count){
            const int work=core+(i+2)*stride;second[phase]=work>=at;
            bmms_pack_transposed_stage<T,TA,TB>(a,b,raw,second[phase]?work-at:work,m,n,k,kp,mp,np,cols[phase],second[phase],offsets[phase],phase);
        }
    }
    if(busy[0])WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    if(busy[1])WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
    PipeBarrier<PIPE_ALL>();
}
template<class T,bool TA,bool TB,int PACK_VECTORS=1>
__aicore__ inline void bmms_pack_transposed_nz(GM_ADDR a,GM_ADDR b,GM_ADDR pa,GM_ADDR pb,
    int batches,int m,int n,int k,int kp,int mp,int np)
{
    if((TA?mp:kp)<=1280 && (TB?kp:np)<=1280){
        bmms_pack_transposed_pingpong<T,TA,TB,PACK_VECTORS>(a,b,pa,pb,batches,m,n,k,kp,mp,np);return;
    }
    constexpr int R=16,C=2048,RAW_BYTES=R*C*2;
    static_assert(sizeof(T)==2 && 2*RAW_BYTES<=180*1024,"NZ transpose UB budget");
    LocalTensor<T> raw(TPosition::VECIN,0,R*C),out(TPosition::VECOUT,RAW_BYTES,R*C);
    GlobalTensor<T> src,dst;uint64_t srcAddr[16],dstAddr[16];int lastCols=0;
    const int ar=TA?kp:mp,ac=TA?mp:kp,br=TB?np:kp,bc=TB?kp:np;
    const int astep=ac<=C?ac:1024,bstep=bc<=C?bc:1024;
    const int act=(ac+astep-1)/astep,bct=(bc+bstep-1)/bstep;
    const int at=batches*(ar/R)*act,bt=batches*(br/R)*bct;
    for(int work=GetBlockIdx();work<at+bt;work+=GetBlockNum()*PACK_VECTORS){
        const bool second=work>=at;const int task=second?work-at:work;
        const int sr=second?(TB?n:k):(TA?k:m),sc=second?(TB?k:n):(TA?m:k);
        const int dr=second?br:ar,dc=second?bc:ac,ct=second?bct:act;
        const int cstep=second?bstep:astep;
        const int batch=task/((dr/R)*ct),ri=(task/ct)%(dr/R)*R,ci=task%ct*cstep;
        const int cols=dc-ci<cstep?dc-ci:cstep;
        const int vr=ri>=sr?0:(sr-ri<R?sr-ri:R);
        const int vc=ci>=sc?0:(sc-ci<cols?sc-ci:cols);
        src.SetGlobalBuffer((__gm__ T*)(second?b:a));
        dst.SetGlobalBuffer((__gm__ T*)(second?pb:pa));
        Duplicate(raw,(T)0,R*cols);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        if(vr&&vc){
            DataCopyExtParams cp{(uint16_t)vr,(uint32_t)vc*2,(uint32_t)(sc-vc)*2,
                (uint32_t)(cols-(vc+15)/16*16)/16,0};
            DataCopyPadExtParams<T> pad{true,0,(uint8_t)((16-vc%16)%16),(T)0};
            DataCopyPad(raw,src[(int64_t)batch*sr*sc+(int64_t)ri*sc+ci],cp,pad);
        }
        if(lastCols!=cols){
            for(int j=0;j<16;++j){
                srcAddr[j]=(uint64_t)(raw[j*cols].GetPhyAddr());
                dstAddr[j]=(uint64_t)(out[j*16].GetPhyAddr());
            }
            lastCols=cols;
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        TransDataTo5HDParams tp;tp.dstHighHalf=false;tp.srcHighHalf=false;
        tp.repeatTimes=cols/16;tp.dstRepStride=tp.repeatTimes==1?0:16;tp.srcRepStride=tp.repeatTimes==1?0:1;
        TransDataTo5HD<uint16_t>(dstAddr,srcAddr,tp);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams cp{1,(uint32_t)cols*R*2,0,0,0};
        DataCopyPad(dst[(int64_t)batch*dr*dc+(int64_t)ri*dc+(int64_t)ci*R],out,cp);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

template<class T, bool TA, bool TB, bool NZ=false>
__global__ __aicore__ __mix__(1, 1) void bmms_fused_transposed_nz(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR maxima, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t ns, TCubeTiling tiling, int32_t storeM, int32_t storeN, GM_ADDR packedA, GM_ADDR packedB, int32_t originalK)
{
    const int32_t tileM = tiling.singleCoreM;
    const int32_t tileN = tiling.singleCoreN;
    const int32_t mt = (m + tileM - 1) / tileM;
    const int32_t nt = (n + tileN - 1) / tileN;
    const int32_t core = GetBlockIdx();
    const int64_t coreOffset = (int64_t)core * 2 * tileM * tileN;
    TPipe pipe;
    if ASCEND_IS_AIV {
        bmms_pack_transposed_nz<T, TA, TB>(a, b, packedA, packedB, batches, m, n, originalK, k, storeM, storeN);
        // Every operand tile must be visible before any Cube starts reading NZ inputs.
        SyncAll<true>();
        CrossCoreSetFlag<2, PIPE_MTE3>(7);
    }
    if ASCEND_IS_AIC {
        CrossCoreWaitFlag(7);
        using AT = MatmulType<TPosition::GM, NZ?CubeFormat::NZ:CubeFormat::ND, T, !TA>;
        using BT = MatmulType<TPosition::GM, NZ?CubeFormat::NZ:CubeFormat::ND, T, !TB>;
        using CT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        using BiasT = MatmulType<TPosition::GM, CubeFormat::ND, float>;
        MatmulImpl<AT, BT, CT, BiasT, BMMS_MM_CFG> mm;
        GlobalTensor<T> ag, bg;
        GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)packedA); bg.SetGlobalBuffer((__gm__ T*)packedB);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mm.SetSubBlockIdx(0); mm.Init(&tiling, &pipe);
        mm.SetOrgShape(storeM, storeN, k, k, tileN);
        // Alternate scratch slots across tasks; drain only at kernel exit.
        // A slot is reusable after its Vector peer has finished reading it.
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                if (step >= 2) CrossCoreWaitFlag(slot == 0 ? 10 : 15);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                mm.SetSingleShape(cm, cn, k);
                mm.SetTensorA(ag[(int64_t)batch * storeM * k + (!TA ? (int64_t)mi*k : (int64_t)mi*16)], !TA);
                mm.SetTensorB(bg[(int64_t)batch * storeN * k + (!TB ? (int64_t)ni*16 : (int64_t)ni*k)], !TB);
                mm.IterateAll(sg[coreOffset + (int64_t)slot * tileM * tileN]);
                CrossCoreSetFlag<2, PIPE_FIX>(slot == 0 ? 8 : 9);
                ++step;
            }
        }
        if (step > 0) CrossCoreWaitFlag(10);
        if (step > 1) CrossCoreWaitFlag(15);
        // mm.End() omitted: one Init per kernel, resources re-established lazily
    }
    if ASCEND_IS_AIV {
        TQue<TPosition::VECIN, 1> input;
        TQue<TPosition::VECOUT, 1> output;
        TBuf<TPosition::VECCALC> temp, reduced;
        // The similarity tile is staged in column chunks of at most 128 columns, so the UB
        // footprint no longer grows with tileN and much larger Cube tiles become usable.
        const int32_t cN = tileN < 128 ? tileN : 128;
        const int32_t finalRows=(m+7)/8*8;
        const int32_t stageElements=tileM*cN>2*finalRows?tileM*cN:2*finalRows;
        pipe.InitBuffer(input, 1, stageElements*4);
        pipe.InitBuffer(output, 1, tileM * 4);
        pipe.InitBuffer(temp, 32768);
        pipe.InitBuffer(reduced, tileM * 4);
        GlobalTensor<float> sg, mg, yg;
        yg.SetGlobalBuffer((__gm__ float*)y);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);
        auto tmp = temp.Get<uint8_t>();
        auto rbuf = reduced.Get<float>();
        int32_t step = 0;
        for (int32_t task = core; task < batches * mt * ns; task += GetBlockNum()) {
            int32_t batch = task / (mt * ns);
            int32_t part = task % ns;
            int32_t mi = (task / ns) % mt * tileM;
            int32_t begin = nt * part / ns;
            int32_t end = nt * (part + 1) / ns;
            int32_t cm = m - mi < tileM ? m - mi : tileM;
            auto running = output.AllocTensor<float>();
            Duplicate(running, -3.402823466e+38f, tileM);
            for (int32_t t = begin; t < end; ++t) {
                int32_t slot = step & 1;
                CrossCoreWaitFlag(slot == 0 ? 8 : 9);
                int32_t ni = t * tileN;
                int32_t cn = n - ni < tileN ? n - ni : tileN;
                const int64_t slotBase = coreOffset + (int64_t)slot * tileM * tileN;
                for (int32_t nc = 0; nc < cn; nc += cN) {
                    int32_t cols = cn - nc < cN ? cn - nc : cN;
                    auto x = input.AllocTensor<float>();
                    if (cols != cN) {
                        Duplicate(x, -3.402823466e+38f, tileM * cN);
                        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
                        WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                    }
                    DataCopyExtParams cp{(uint16_t)cm, (uint32_t)cols * 4,
                        (uint32_t)(tileN - cols) * 4, (uint32_t)(cN - (cols + 7) / 8 * 8) / 8, 0};
                    DataCopyPadExtParams<float> pad{true, 0, 0, -3.402823466e+38f};
                    DataCopyPad(x, sg[slotBase + nc], cp, pad);
                    input.EnQue(x); x = input.DeQue<float>();
                    uint32_t shape[] = {(uint32_t)cm, (uint32_t)cN};
                    ReduceMax<float, Pattern::Reduce::AR, true>(rbuf, x, tmp, shape, false);
                    Max(running, running, rbuf, cm);
                    input.FreeTensor(x);
                }
                CrossCoreSetFlag<2, PIPE_MTE2>(slot == 0 ? 10 : 15);
                ++step;
            }
            if (mt == 1 && ns == 1) {
                ReduceSum(rbuf, running, temp.Get<float>(), cm);
                Adds(running, rbuf, 0.0f, 8);
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, 4, 0, 0, 0};
                DataCopyPad(yg[batch], running, cp);
            } else {
                output.EnQue(running); running = output.DeQue<float>();
                DataCopyExtParams cp{1, (uint32_t)cm * 4, 0, 0, 0};
                DataCopyPad(mg[((int64_t)batch * ns + part) * m + mi], running, cp);
            }
            output.FreeTensor(running);
        }
        if (mt == 1 && ns == 1) return;
        // All row maxima must be visible before any batch's final reduction.
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();

        auto sumTemp = temp.Get<float>();
        for (int32_t batch = core; batch < batches; batch += GetBlockNum()) {
            auto finalStage=input.AllocTensor<float>();
            auto acc=finalStage[finalRows];
            if (ns > 1) Duplicate(acc, -3.402823466e+38f, m);
            for (int32_t part = 0; part < ns; ++part) {
                // Tile staging has expired; reuse its storage for final planes.
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                auto x=finalStage;
                DataCopyExtParams cp{1, (uint32_t)m * 4, 0, 0, 0};
                DataCopyPadExtParams<float> pad{false, 0, 0, 0};
                DataCopyPad(x, mg[((int64_t)batch * ns + part) * m], cp, pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                if (ns == 1) {
                    if (NZ) bmms_paired_sum(rbuf, x, sumTemp, m);
                    else ReduceSum(rbuf, x, sumTemp, m);
                }
                else Max(acc, acc, x, m);

            }
            auto out = output.AllocTensor<float>();
            if (ns == 1) Adds(out, rbuf, 0.0f, 8);
            else {
                if (NZ) bmms_paired_sum(out, acc, sumTemp, m);
                else ReduceSum(out, acc, sumTemp, m);
            }
            output.EnQue(out); out = output.DeQue<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0};
            DataCopyPad(yg[batch], out, op);
            output.FreeTensor(out);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
            input.FreeTensor(finalStage);
        }
    }
}

// C^T=B^T*A^T; the Vector peer reduces physical rows (original N).
// The input pack is the same fresh NZ(P^T) pack as the retained implementation.
template<class T>
__global__ __aicore__ __mix__(1, 2) void bmms_transposed_resident_gemm(
    GM_ADDR a,GM_ADDR b,GM_ADDR pa,GM_ADDR pb,GM_ADDR scratch,GM_ADDR maxima,GM_ADDR y,
    int batches,int m,int n,int originalK,int kp,int mp,int np,int ns)
{
    constexpr int TM=128,TN=128,BK=128;
    const int mt=(n+TM-1)/TM,nt=(m+TN-1)/TN,core=GetBlockIdx()/GetTaskRatio();
    const int64_t coreOffset=(int64_t)core*2*TM*TN;
    if ASCEND_IS_AIV {
        bmms_pack_transposed_nz<T,true,true,2>(a,b,pa,pb,batches,m,n,originalK,kp,mp,np);
        SyncAll<true>();
        CrossCoreSetFlag<2,PIPE_MTE3>(7);
    }
    if ASCEND_IS_AIC {
        CrossCoreWaitFlag(7);
        LocalTensor<T> la(TPosition::A1,0,TM*kp);
        LocalTensor<T> lb(TPosition::B1,TM*kp*2,2*TN*BK);
        LocalTensor<T> aa(TPosition::A2,0,32768),bb(TPosition::B2,0,32768);
        LocalTensor<float> cc(TPosition::CO1,0,2*TM*TN);
        GlobalTensor<T> ag,bg;GlobalTensor<float> sg;
        ag.SetGlobalBuffer((__gm__ T*)pb);bg.SetGlobalBuffer((__gm__ T*)pa);
        sg.SetGlobalBuffer((__gm__ float*)scratch);
        bool aBusy=false,bBusy[2]={false,false},l0Busy[2]={false,false},cBusy[2]={false,false};
        int step=0,madStep=0;
        DisableDmaAtomic();
        for(int task=core;task<batches*mt*ns;task+=GetBlockNum()) {
            const int batch=task/(mt*ns),part=task%ns,mi=(task/ns)%mt*TM;
            const int begin=nt*part/ns,end=nt*(part+1)/ns;
            const int cm=n-mi<TM?n-mi:TM,cm16=(cm+15)/16*16;
            if(aBusy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
            // Preblock resident A in K slabs so every L0 load is contiguous.
            for(int pos=0;pos<kp;pos+=BK) {
                const int kk=kp-pos<BK?kp-pos:BK;
                DataCopyParams cp{(uint16_t)(cm16/16),(uint16_t)kk,(uint16_t)(kp-kk),0};
                DataCopy(la[pos*cm16],ag[(int64_t)batch*np*kp+(int64_t)mi*kp+pos*16],cp);
            }
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID2);
            for(int t=begin;t<end;++t) {
                const int slot=step&1,ni=t*TN,cn=m-ni<TN?m-ni:TN,cn16=(cn+15)/16*16;
                auto cv=cc[slot*TM*TN];
                if(cBusy[slot]){if(slot)WaitFlag<HardEvent::FIX_M>(EVENT_ID1);else WaitFlag<HardEvent::FIX_M>(EVENT_ID0);}
                // Two independent L1 stages. A stage is released after its L0 copy.
                for(int pos=0;pos<kp && pos<2*BK;pos+=BK) {
                    const int phase=pos/BK,kk=kp-pos<BK?kp-pos:BK;
                    if(bBusy[phase]){if(phase)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);else WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);}
                    DataCopyParams cp{(uint16_t)(kk/16),(uint16_t)cn16,(uint16_t)(mp-cn16),0};
                    DataCopy(lb[phase*TN*BK],bg[(int64_t)batch*mp*kp+(int64_t)ni*16+(int64_t)pos*mp],cp);
                    if(phase)SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);else SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                }
                for(int pos=0;pos<kp;pos+=BK) {
                    const int phase=(pos/BK)&1,kk=kp-pos<BK?kp-pos:BK;
                    if(phase)WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);else WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                    // L0 ownership spans all tiles/tasks, including odd K chunk counts.
                    const int l0Phase=madStep&1;
                    if(l0Busy[l0Phase]){if(l0Phase)WaitFlag<HardEvent::M_MTE1>(EVENT_ID4);else WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);}
                    auto av=aa[l0Phase*16384],bv=bb[l0Phase*16384];
                    LoadData2dParams ap{0,(uint8_t)(cm16*kk/256),1,0,0,true,0};
                    LoadData2dParams bp{0,(uint8_t)(cn16*kk/256),1,0,0,false,0};
                    LoadData(av,la[pos*cm16],ap);LoadData(bv,lb[phase*TN*BK],bp);
                    if(phase)SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);else SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                    bBusy[phase]=true;
                    if(t+1==end && pos+kk==kp){SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);aBusy=true;}
                    if(l0Phase)SetFlag<HardEvent::MTE1_M>(EVENT_ID1);else SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    if(l0Phase)WaitFlag<HardEvent::MTE1_M>(EVENT_ID1);else WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    MmadParams mm{(uint16_t)cm16,(uint16_t)cn16,(uint16_t)kk,0,false,pos==0};
                    Mmad(cv,av,bv,mm);
                    // SDK MmadCompute requires a Cube barrier for fewer than 10 C fractals.
                    // Small tail accumulators otherwise collide across consecutive K steps.
                    if((cm16/16)*(cn16/16)<10)PipeBarrier<PIPE_M>();
                    if(l0Phase)SetFlag<HardEvent::M_MTE1>(EVENT_ID4);else SetFlag<HardEvent::M_MTE1>(EVENT_ID3);
                    l0Busy[l0Phase]=true;++madStep;
                    const int next=pos+2*BK;
                    if(next<kp) {
                        if(phase)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);else WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                        const int nextK=kp-next<BK?kp-next:BK;
                        DataCopyParams cp{(uint16_t)(nextK/16),(uint16_t)cn16,(uint16_t)(mp-cn16),0};
                        DataCopy(lb[phase*TN*BK],bg[(int64_t)batch*mp*kp+(int64_t)ni*16+(int64_t)next*mp],cp);
                        if(phase)SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID1);else SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                        bBusy[phase]=false;
                    }
                }
                if(slot)SetFlag<HardEvent::M_FIX>(EVENT_ID1);else SetFlag<HardEvent::M_FIX>(EVENT_ID0);
                if(slot)WaitFlag<HardEvent::M_FIX>(EVENT_ID1);else WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                if(step>=2)CrossCoreWaitFlag(slot?15:10);
                FixpipeParamsV220 fp;fp.mSize=cm16;fp.nSize=cn16;fp.srcStride=cm16;fp.dstStride=TN;
                Fixpipe(sg[coreOffset+(int64_t)slot*TM*TN],cv,fp);
                if(slot)SetFlag<HardEvent::FIX_M>(EVENT_ID1);else SetFlag<HardEvent::FIX_M>(EVENT_ID0);
                cBusy[slot]=true;CrossCoreSetFlag<2,PIPE_FIX>(slot?9:8);++step;
            }
        }
        if(aBusy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID2);
        if(bBusy[0])WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        if(bBusy[1])WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID1);
        if(l0Busy[0])WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
        if(l0Busy[1])WaitFlag<HardEvent::M_MTE1>(EVENT_ID4);
        if(cBusy[0])WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        if(cBusy[1])WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        if(step>0)CrossCoreWaitFlag(10);if(step>1)CrossCoreWaitFlag(15);
    }
    if ASCEND_IS_AIV {
        TPipe pipe;TBuf<TPosition::VECIN> stageBuffer;
        TBuf<TPosition::VECCALC> accBuffer,tempBuffer;TBuf<TPosition::VECOUT> outBuffer;
        pipe.InitBuffer(stageBuffer,TM*TN*4);pipe.InitBuffer(accBuffer,((m+7)/8*8)*4);
        pipe.InitBuffer(tempBuffer,32768);pipe.InitBuffer(outBuffer,TN*4);
        auto stage=stageBuffer.Get<float>(),acc=accBuffer.Get<float>(),tmp=tempBuffer.Get<float>(),out=outBuffer.Get<float>();
        GlobalTensor<float> sg,mg,yg;sg.SetGlobalBuffer((__gm__ float*)scratch);
        mg.SetGlobalBuffer((__gm__ float*)maxima);yg.SetGlobalBuffer((__gm__ float*)y);
        int step=0;
        for(int task=core;task<batches*mt*ns;task+=GetBlockNum()) {
            const int batch=task/(mt*ns),part=task%ns,mi=(task/ns)%mt*TM;
            const int begin=nt*part/ns,end=nt*(part+1)/ns,cm=n-mi<TM?n-mi:TM;
            for(int t=begin;t<end;++t) {
                const int slot=step&1,ni=t*TN,cn=m-ni<TN?m-ni:TN;
                CrossCoreWaitFlag(slot?9:8);
                if(GetSubBlockIdx()!=0) {
                    // Mode2 includes both Vector peers. The primary owns the C read;
                    // this packing peer contributes its matching protocol acknowledgement.
                    CrossCoreSetFlag<2,PIPE_MTE2>(slot?15:10);++step;continue;
                }
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopyExtParams cp{(uint16_t)cm,(uint32_t)cn*4,(uint32_t)(TN-cn)*4,(uint32_t)(TN-(cn+7)/8*8)/8,0};
                DataCopyPadExtParams<float> pad{true,0,0,-3.402823466e+38f};
                DataCopyPad(stage,sg[coreOffset+(int64_t)slot*TM*TN],cp,pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                CrossCoreSetFlag<2,PIPE_MTE2>(slot?15:10);
                // Only real original-N rows participate; Cube's zero row padding must not.
                for(int count=cm;count>1;) {
                    const int half=(count+1)/2;
                    Max(stage,stage,stage[half*TN],(count-half)*TN);PipeBarrier<PIPE_V>();count=half;
                }
                Adds(out,stage,0.0f,cn);
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                DataCopyExtParams op{1,(uint32_t)cn*4,0,0,0};
                DataCopyPad(mg[((int64_t)batch*mt+mi/TM)*m+ni],out,op);
                SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
                ++step;
            }
        }
        PipeBarrier<PIPE_ALL>();SyncAll<true>();
        if(GetSubBlockIdx()==0) for(int batch=core;batch<batches;batch+=GetBlockNum()) {
            // Each retired original-N tile owns a complete original-M
            // maximum plane. Group fresh planes in the retired C buffer:
            // one strided DMA and a balanced Max tree replace serial
            // per-plane DMA/Vector fences. MaxN is exact under this
            // reassociation; the original paired SumM is unchanged.
            auto finalMax=bmms_load_max_planes(stage,mg,batch,m,mt,(m+7)/8*8,TM*TN);
            bmms_paired_sum(out,finalMax,tmp,m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],out,cp);
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
}

template<class T>
__global__ __aicore__ __vector__ void bmms_vector_short_nt(
    GM_ADDR a,GM_ADDR b,GM_ADDR y,int32_t batches,int32_t m,int32_t n,int32_t k)
{
    constexpr int MP=8,NP=16,KP=64;
    constexpr int AR=0,BR=1024,AF=3072,BF=5120,PROD=9216,DOTS=13312,MAXIMA=13824,OUT=13856;
    constexpr int UB_BYTES=OUT+32;
    static_assert(UB_BYTES==13888 && UB_BYTES<=180*1024,"short NT UB budget");
    LocalTensor<T> ar(TPosition::VECIN,AR,MP*KP),br(TPosition::VECIN,BR,NP*KP);
    LocalTensor<float> af(TPosition::VECCALC,AF,MP*KP),bf(TPosition::VECCALC,BF,NP*KP);
    LocalTensor<float> prod(TPosition::VECCALC,PROD,NP*KP),dots(TPosition::VECCALC,DOTS,MP*NP);
    LocalTensor<float> maxima(TPosition::VECCALC,MAXIMA,8),out(TPosition::VECOUT,OUT,8);
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    for(int batch=GetBlockIdx();batch<batches;batch+=GetBlockNum()) {
        DataCopyExtParams ac{1,(uint32_t)(m*k*2),0,0,0},bc{1,(uint32_t)(n*k*2),0,0,0};
        DataCopyPadExtParams<T> ap{true,0,(uint8_t)((16-m*k%16)%16),(T)0};
        DataCopyPadExtParams<T> bp{true,0,(uint8_t)((16-n*k%16)%16),(T)0};
        DataCopyPad(ar,ag[(int64_t)batch*m*k],ac,ap);
        DataCopyPad(br,bg[(int64_t)batch*n*k],bc,bp);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af,ar,RoundMode::CAST_NONE,m*k);Cast(bf,br,RoundMode::CAST_NONE,n*k);
        PipeBarrier<PIPE_V>();
        // Every dot product uses the same K active lanes. Set that mask once;
        // isSetMask=false below only reuses state, and both operations still
        // compute all K values for every real row and column.
        SetVectorMask<float>(k);
        #pragma unroll
        for(int row=0;row<m;++row) {
            Mul<float,false>(prod,af[row*k],bf,k,n,{1,1,1,(uint8_t)(k/8),0,(uint8_t)(k/8)});
            PipeBarrier<PIPE_V>();
            WholeReduceSum<float,false>(dots[row*NP],prod,k,n,1,1,k/8);
            PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(maxima,dots,n,m,1,1,NP/8,ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(out,maxima,m,1,1,1,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);
        if(batch+GetBlockNum()<batches) {
            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

template<class T>
__global__ __aicore__ __vector__ void bmms_dot(GM_ADDR a, GM_ADDR b, GM_ADDR y, int32_t batches, int32_t k)
{
    int32_t ak = (k + 15) / 16 * 16;
    LocalTensor<T> al(TPosition::VECIN, 0, ak), bl(TPosition::VECIN, ak * 2, ak);
    LocalTensor<float> af(TPosition::VECCALC, ak * 4, ak), bf(TPosition::VECCALC, ak * 8, ak);
    LocalTensor<float> tmp(TPosition::VECCALC, ak * 12, 128);
    LocalTensor<float> out(TPosition::VECOUT, ak * 12 + 512, 8);
    GlobalTensor<T> ag, bg; GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b); yg.SetGlobalBuffer((__gm__ float*)y);
    int32_t batch = GetBlockIdx();
    do {
        DataCopyExtParams cp{1, (uint32_t)k * 2, 0, 0, 0};
        DataCopyPadExtParams<T> pad{false, 0, 0, (T)0};
        DataCopyPad(al, ag[(int64_t)batch * k], cp, pad);
        DataCopyPad(bl, bg[(int64_t)batch * k], cp, pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af, al, RoundMode::CAST_NONE, k); Cast(bf, bl, RoundMode::CAST_NONE, k);
        PipeBarrier<PIPE_V>();
        Mul(af, af, bf, k);
        PipeBarrier<PIPE_V>();
        bmms_sum(out, af, tmp, k);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], out, op);
        if (batch + GetBlockNum() < batches) {
            SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0); WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        }
        batch += GetBlockNum();
    } while (batch < batches);
    PipeBarrier<PIPE_ALL>();
}

template<class T, bool TA, bool TB>
__global__ __aicore__ __mix__(1, 1) void bmms_split_tile(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR partialSums, GM_ADDR y, int32_t batches, int32_t m, int32_t n, int32_t k, int32_t parts)
{
    constexpr int M = 64, N = 64, BK = 512, ROWS = 16;
    const int rowTiles = (m + ROWS - 1) / ROWS;
    const int core = GetBlockIdx();
    GlobalTensor<float> sg, yg;
    sg.SetGlobalBuffer((__gm__ float*)scratch);
    yg.SetGlobalBuffer((__gm__ float*)y);
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<T> la(TPosition::A1, 0, M * BK), lb(TPosition::B1, M * BK * 2, N * BK);
        LocalTensor<T> aa(TPosition::A2, 0, M * BK), bb(TPosition::B2, 0, N * BK);
        LocalTensor<float> cc(TPosition::CO1, 0, M * N);
        bool l1Busy = false, l0Busy = false, fixBusy = false;
        for (int task = core; task < batches * parts; task += GetBlockNum()) {
            const int batch = task / parts, part = task % parts;
            const int begin = (k / 16 * part / parts) * 16;
            const int end = (k / 16 * (part + 1) / parts) * 16;
            for (int pos = begin; pos < end; pos += BK) {
                const int kk = end - pos < BK ? end - pos : BK;
                if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                if (fixBusy) { WaitFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = false; }
                Nd2NzParams pa{1, (uint16_t)(TA ? kk : m), (uint16_t)(TA ? m : kk), 0,
                    (uint16_t)(TA ? m : k), (uint16_t)(TA ? kk : M), 1, 0};
                Nd2NzParams pb{1, (uint16_t)(TB ? n : kk), (uint16_t)(TB ? kk : n), 0,
                    (uint16_t)(TB ? k : n), (uint16_t)(TB ? N : kk), 1, 0};
                const int64_t ao = (int64_t)batch * m * k + (TA ? (int64_t)pos * m : pos);
                const int64_t bo = (int64_t)batch * n * k + (TB ? pos : (int64_t)pos * n);
                DataCopy(la, ag[ao], pa); DataCopy(lb, bg[bo], pb);
                SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0); WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                LoadData2dParams ap{0, (uint8_t)(kk / 16), TA ? 1 : M / 16, 0, 0, TA, 0};
                if (TA) { ap.repeatTimes = M * kk / 256; LoadData(aa, la, ap); }
                else {
                    #pragma unroll
                    for (int i = 0; i < M / 16; ++i) LoadData(aa[i * kk * 16], la[i * 256], ap);
                }
                LoadData2dParams bp{0, N / 16, (uint16_t)(TB ? 1 : kk / 16), 0, 0, !TB, 0};
                if (TB) { bp.repeatTimes = N * kk / 256; LoadData(bb, lb, bp); }
                else {
                    for (int i = 0; i < kk / 16; ++i) LoadData(bb[i * N * 16], lb[i * 256], bp);
                }
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0); l1Busy = true;
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0); WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                MmadParams mm{M, N, (uint16_t)kk, 0, false, pos == begin};
                Mmad(cc, aa, bb, mm);
                SetFlag<HardEvent::M_MTE1>(EVENT_ID3); l0Busy = true;
            }
            SetFlag<HardEvent::M_FIX>(EVENT_ID0); WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
            FixpipeParamsV220 fp;
            fp.mSize = M; fp.nSize = N; fp.srcStride = M; fp.dstStride = N;
            Fixpipe(sg[(int64_t)task * M * N], cc, fp);
            SetFlag<HardEvent::FIX_M>(EVENT_ID0); fixBusy = true;
        }
        if (l1Busy) WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        if (l0Busy) WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
        if (fixBusy) WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
    }
    if ASCEND_IS_AIV {
        // At most 16 parts: 64 KiB staging, 64 B row maxima, 32 B output.
        LocalTensor<float> vx(TPosition::VECIN, 0, 16 * ROWS * N);
        LocalTensor<float> rm(TPosition::VECCALC, 16 * ROWS * N * 4, 32);
        LocalTensor<float> out(TPosition::VECOUT, 16 * ROWS * N * 4 + 128, 32);
        // Fresh output for this invocation. The existing first all-core barrier
        // orders these zero stores before any row-group atomic contribution.
        // Initialization overlaps Cube's real split-K matrix products.
        DisableDmaAtomic();
        Duplicate(out, 0.0f, 8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        for (int batch = core; batch < batches; batch += GetBlockNum()) {
            DataCopyExtParams init{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], out, init);
        }
        PipeBarrier<PIPE_ALL>();
        CrossCoreWaitFlag(8);
        SyncAll<true>();
        for (int task = core; task < batches * rowTiles; task += GetBlockNum()) {
            const int batch = task / rowTiles, row = (task % rowTiles) * ROWS;
            const int rows = m-row < ROWS ? m-row : ROWS;
            DataCopyExtParams cp{(uint16_t)parts, ROWS * N * 4, (M - ROWS) * N * 4, 0, 0};
            DataCopyPadExtParams<float> pad{false, 0, 0, 0};
            DataCopyPad(vx, sg[(int64_t)batch * parts * M * N + row * N], cp, pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            for (int count = parts; count > 1; count = (count + 1) / 2) {
                const int half = (count + 1) / 2;
                Add(vx, vx, vx[half * ROWS * N], (count - half) * ROWS * N);
                PipeBarrier<PIPE_V>();
            }
            WholeReduceMax(rm, vx, n, rows, 1, 1, N / 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            WholeReduceSum(out, rm, rows, 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            // Max is taken only after every split-K contribution is summed.
            // Atomics combine actual row-group sums; no partial Max is added.
            SetAtomicAdd<float>();
            DataCopyExtParams op{1, 4, 0, 0, 0}; DataCopyPad(yg[batch], out, op);
            DisableDmaAtomic();
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0); WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
        // The kernel's final PIPE_ALL drains every contribution. No second
        // all-core barrier or GM readback is needed to form the scalar output.
    }
    PipeBarrier<PIPE_ALL>();
}

// Shared shape-only storage map for Host allocation and Device layout.
#define BMMS_SMALL_STORAGE_N(NP) ((NP)<=32?(NP):((NP)<=64?64:128))

template<class T, bool TA, bool TB, int MP, int NP>
__global__ __aicore__ __mix__(1, 1) void bmms_single_tile(GM_ADDR a, GM_ADDR b, GM_ADDR scratch,
    GM_ADDR y, int32_t m, int32_t n, int32_t k, int32_t storageN)
{
    static_assert(NP*256*2<=64*1024 && MP*256*2<=64*1024,"single-tile L0A/B capacity");
    static_assert(NP*MP*4<=128*1024 && (NP*MP+8)*4<=180*1024,"single-tile C/UB capacity");
    // C^T=B^T*A^T removes GM row-pitch holes when storageN>NP: the useful
    // MP*NP values become contiguous NP rows of width MP instead of MP rows
    // separated by storageN. Both layouts already meet 32B alignment; the
    // changed footprint/address pattern, not alignment alone, is the reason.
    // TA&&!TB with NP>MP also replaces the long RHS L0 gather with one
    // contiguous transposed LHS load, leaving the short RHS gathers.
    // The host slot stride remains MP*storageN; Max(true N) precedes Sum(true M).
    if constexpr (BMMS_SMALL_STORAGE_N(NP)>NP || (TA && !TB && NP>MP)) {
        const int kp=(k+15)/16*16,core=GetBlockIdx();
        constexpr bool AT=!TB,BT=!TA;
        GlobalTensor<float> sg,yg;sg.SetGlobalBuffer((__gm__ float*)scratch);
        yg.SetGlobalBuffer((__gm__ float*)y);
        const int64_t slot=(int64_t)core*MP*storageN;
        if ASCEND_IS_AIC {
            GlobalTensor<T> ag,bg;ag.SetGlobalBuffer((__gm__ T*)b);bg.SetGlobalBuffer((__gm__ T*)a);
            LocalTensor<T> la(TPosition::A1,0,NP*256),lb(TPosition::B1,NP*256*2,MP*256);
            LocalTensor<T> aa(TPosition::A2,0,NP*256),bb(TPosition::B2,0,MP*256);
            LocalTensor<float> cc(TPosition::CO1,0,NP*MP);
            Nd2NzParams pa{1,(uint16_t)(AT?k:n),(uint16_t)(AT?n:k),0,
                (uint16_t)(AT?n:k),(uint16_t)(AT?kp:NP),1,0};
            Nd2NzParams pb{1,(uint16_t)(BT?m:k),(uint16_t)(BT?k:m),0,
                (uint16_t)(BT?k:m),(uint16_t)(BT?MP:kp),1,0};
            DataCopy(la,ag[(int64_t)core*n*k],pa);DataCopy(lb,bg[(int64_t)core*m*k],pb);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
            LoadData2dParams ap{0,(uint8_t)(kp/16),AT?1:NP/16,0,0,AT,0};
            if constexpr(AT){ap.repeatTimes=NP*kp/256;LoadData(aa,la,ap);}
            else {
                #pragma unroll
                for(int row=0;row<NP/16;++row)LoadData(aa[row*kp*16],la[row*256],ap);
            }
            LoadData2dParams bp{0,MP/16,(uint16_t)(BT?1:kp/16),0,0,!BT,0};
            if constexpr(BT){bp.repeatTimes=MP*kp/256;LoadData(bb,lb,bp);}
            else if(MP/16<kp/16){
                bp.repeatTimes=kp/16;bp.srcStride=1;bp.dstGap=MP/16-1;
                #pragma unroll
                for(int col=0;col<MP/16;++col)LoadData(bb[col*256],lb[col*kp*16],bp);
            }else for(int pos=0;pos<kp/16;++pos)LoadData(bb[pos*MP*16],lb[pos*256],bp);
            SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
            MmadParams mm{NP,MP,(uint16_t)k,0,false,true};Mmad(cc,aa,bb,mm);
            SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
            FixpipeParamsV220 fp;fp.mSize=NP;fp.nSize=MP;fp.srcStride=NP;fp.dstStride=MP;
            Fixpipe(sg[slot],cc,fp);CrossCoreSetFlag<2,PIPE_FIX>(8);
        }
        if ASCEND_IS_AIV {
            LocalTensor<float> vx(TPosition::VECIN,0,NP*MP);
            LocalTensor<float> out(TPosition::VECOUT,NP*MP*4,8);
            CrossCoreWaitFlag(8);DataCopy(vx,sg[slot],NP*MP);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            // Only actual N rows enter Max; zero-padded Cube rows are excluded.
            for(int count=n;count>1;){
                const int half=(count+1)/2;
                Max(vx,vx,vx[half*MP],(count-half)*MP);PipeBarrier<PIPE_V>();count=half;
            }
            WholeReduceSum(out,vx,m,1,1,1,8);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[core],out,cp);
        }
        PipeBarrier<PIPE_ALL>();return;
    }
    const int kp=(k+15)/16*16;
    const int core = GetBlockIdx();
    // Retained orientations use the same shared physical row-pitch map.
    constexpr int32_t pitch=BMMS_SMALL_STORAGE_N(NP);
    GlobalTensor<float> sg; sg.SetGlobalBuffer((__gm__ float*)scratch);
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag, bg;
        ag.SetGlobalBuffer((__gm__ T*)a); bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<T> la(TPosition::A1, 0, MP * 256), lb(TPosition::B1, MP * 256 * 2, NP * 256);
        LocalTensor<T> aa(TPosition::A2, 0, MP * 256), bb(TPosition::B2, 0, NP * 256);
        LocalTensor<float> cc(TPosition::CO1, 0, MP * NP);
        Nd2NzParams pa{1, (uint16_t)(TA ? k : m), (uint16_t)(TA ? m : k), 0,
            (uint16_t)(TA ? m : k), (uint16_t)(TA ? kp : MP), 1, 0};
        Nd2NzParams pb{1, (uint16_t)(TB ? n : k), (uint16_t)(TB ? k : n), 0,
            (uint16_t)(TB ? k : n), (uint16_t)(TB ? NP : kp), 1, 0};
        DataCopy(la, ag[(int64_t)core * m * k], pa);
        DataCopy(lb, bg[(int64_t)core * n * k], pb);
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0); WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        LoadData2dParams ap{0, (uint8_t)(kp / 16), TA ? 1 : MP / 16, 0, 0, TA, 0};
        if (TA) { ap.repeatTimes = MP * kp / 256; LoadData(aa, la, ap); }
        else {
            #pragma unroll
            for (int i = 0; i < MP / 16; ++i) LoadData(aa[i * kp * 16], la[i * 256], ap);
        }
        LoadData2dParams bp{0, NP / 16, (uint16_t)(TB ? 1 : kp / 16), 0, 0, !TB, 0};
        if (TB) { bp.repeatTimes = NP * kp / 256; LoadData(bb, lb, bp); }
        else if (NP / 16 < kp / 16) {
            bp.repeatTimes = kp / 16; bp.srcStride = 1; bp.dstGap = NP / 16 - 1;
            #pragma unroll
            for (int j = 0; j < NP / 16; ++j) LoadData(bb[j * 256], lb[j * kp * 16], bp);
        } else {
            for (int i = 0; i < kp / 16; ++i) LoadData(bb[i * NP * 16], lb[i * 256], bp);
        }
        SetFlag<HardEvent::MTE1_M>(EVENT_ID0); WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
        MmadParams mm{MP, NP, (uint16_t)k, 0, false, true}; Mmad(cc, aa, bb, mm);
        SetFlag<HardEvent::M_FIX>(EVENT_ID0); WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
        FixpipeParamsV220 fp;
        fp.mSize = MP; fp.nSize = NP; fp.srcStride = MP; fp.dstStride = pitch;
        Fixpipe(sg[(int64_t)core * MP * pitch], cc, fp);
        CrossCoreSetFlag<2, PIPE_FIX>(8);
    }
    if ASCEND_IS_AIV {
        LocalTensor<float> vx(TPosition::VECIN, 0, MP * NP);
        LocalTensor<float> rm(TPosition::VECCALC, MP * NP * 4, MP);
        LocalTensor<float> out(TPosition::VECOUT, MP * NP * 4 + MP * 4, 8);
        GlobalTensor<float> yg; yg.SetGlobalBuffer((__gm__ float*)y);
        CrossCoreWaitFlag(8);
        // Read the already padded Cube result, then mask invalid N lanes in reductions.
        if constexpr((NP&(NP-1))==0) {
            DataCopy(vx,sg[(int64_t)core*MP*pitch],MP*NP);
        } else {
            // Keep the logical C rectangle while aligning every GM row independently.
            DataCopyExtParams cp{MP,NP*4,(uint32_t)(pitch-NP)*4,0,0};
            DataCopyPadExtParams<float> pad{false,0,0,0};
            DataCopyPad(vx,sg[(int64_t)core*MP*pitch],cp,pad);
        }
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0); WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if (NP > 64 && n > 64) {
            Max(vx, vx, vx[64], n - 64, m, {1, 1, 1, NP/8, NP/8, NP/8}); PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(rm, vx, n < 64 ? n : 64, m, 1, 1, NP / 8, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(out, rm, m, 1, 1, 1, 8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0); WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams cp{1, 4, 0, 0, 0}; DataCopyPad(yg[core], out, cp);
    }
    PipeBarrier<PIPE_ALL>();
}

constexpr int BMMS_PAIR_MAX_ROWS=416, BMMS_PAIR_CHUNK_ROWS=208;

// Split an existing narrow task only when it needs more than one 208-row
// stage. C0/C1 contain the two K halves of the SAME row chunk. Their GM
// FP32 merge finishes before Vector sees that chunk. This retains the
// precision protection and the original whole-task SumM reduction tree.
template<class T,bool TA,bool TB>
__aicore__ inline void bmms_narrow_chunks(
    GM_ADDR a,GM_ADDR b,GM_ADDR scratch,GM_ADDR y,
    int batches,int m,int n,int k,int tileM,int np)
{
    constexpr int CH=BMMS_PAIR_CHUNK_ROWS;
    static_assert(2*CH*64*4<=128*1024,"two K-half C buffers");
    static_assert(CH*64*2<=64*1024,"one K-half A buffer");
    static_assert(64*128*2<=64*1024,"resident full-K B buffer");
    static_assert((BMMS_PAIR_MAX_ROWS+64)*128*2<=512*1024,"whole task A/B L1");
    const int kh=k/2,mt=(m+tileM-1)/tileM,core=GetBlockIdx(),cores=GetBlockNum();
    const int64_t base=(int64_t)core*tileM*np;
    GlobalTensor<T> ag,bg;GlobalTensor<float> sg,yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);
    sg.SetGlobalBuffer((__gm__ float*)scratch);yg.SetGlobalBuffer((__gm__ float*)y);
    if ASCEND_IS_AIC {
        LocalTensor<T> la(TPosition::A1,0,tileM*k),lb(TPosition::B1,tileM*k*2,np*k);
        LocalTensor<T> aa(TPosition::A2,0,CH*kh),bb(TPosition::B2,0,np*k);
        LocalTensor<float> c0(TPosition::CO1,0,CH*np),c1(TPosition::CO1,CH*np*4,CH*np);
        bool l1Busy=false,l0Busy=false,fixBusy[2]={false,false},pending[2]={false,false};
        for(int task=core;task<batches*mt;task+=cores) {
            const int batch=task/mt,mi=task%mt*tileM,cm=m-mi<tileM?m-mi:tileM,cm16=(cm+15)/16*16;
            if(l1Busy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
            Nd2NzParams ap{1,(uint16_t)(TA?k:cm),(uint16_t)(TA?cm:k),0,
                (uint16_t)(TA?m:k),(uint16_t)(TA?k:cm16),1,0};
            Nd2NzParams bp{1,(uint16_t)(TB?n:k),(uint16_t)(TB?k:n),0,
                (uint16_t)(TB?k:n),(uint16_t)(TB?np:k),1,0};
            DataCopy(la,ag[(int64_t)batch*m*k+(TA?mi:(int64_t)mi*k)],ap);
            DataCopy(lb,bg[(int64_t)batch*n*k],bp);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
            // Full B is independent of the row chunk and stays in L0B.
            if(l0Busy){WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);l0Busy=false;}
            LoadData2dParams bbP{0,(uint8_t)(np/16),(uint16_t)(TB?1:k/16),0,0,!TB,0};
            if(TB){bbP.repeatTimes=np*k/256;LoadData(bb,lb,bbP);}
            else for(int posK=0;posK<k/16;++posK)LoadData(bb[posK*np*16],lb[posK*256],bbP);
            for(int first=0;first<cm;first+=CH) {
                const int chunk=first/CH,rows=cm-first<CH?cm-first:CH,rows16=(rows+15)/16*16;
                for(int part=0;part<2;++part) {
                    if(l0Busy){WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);l0Busy=false;}
                    const int ipos=part*kh;
                    LoadData2dParams aaP{0,(uint8_t)(rows16/16),(uint16_t)(TA?k/16:1),0,(uint16_t)(kh/16-1),TA,0};
                    for(int posK=0;posK<kh/16;++posK)
                        LoadData(aa[posK*256],la[TA?first*k+(ipos+posK*16)*16:(ipos+posK*16)*cm16+first*16],aaP);
                    if(first+rows==cm && part==1) {
                        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);l1Busy=true;
                    }
                    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                    if(fixBusy[part]) {
                        if(part==0)WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
                        else WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
                        fixBusy[part]=false;
                    }
                    auto cc=part==0?c0:c1;
                    MmadParams mm{(uint16_t)rows16,(uint16_t)np,(uint16_t)kh,0,false,true};
                    Mmad(cc,aa,bb[part*kh*np],mm);
                    SetFlag<HardEvent::M_MTE1>(EVENT_ID3);l0Busy=true;
                    // Match the SDK guard for very small C tiles before a second MAD.
                    if(rows16*np/256<10)PipeBarrier<PIPE_M>();
                    if(part==0){SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);}
                    else {SetFlag<HardEvent::M_FIX>(EVENT_ID1);WaitFlag<HardEvent::M_FIX>(EVENT_ID1);}
                    if(part==0 && pending[chunk]) {
                        CrossCoreWaitFlag(chunk==0?10:15);pending[chunk]=false;
                    }
                    FixpipeParamsV220 fp;fp.mSize=rows16;fp.nSize=np;fp.srcStride=rows16;fp.dstStride=np;
                    if(part==1)SetAtomicAdd<float>();else DisableDmaAtomic();
                    Fixpipe(sg[base+(int64_t)first*np],cc,fp);
                    DisableDmaAtomic();
                    if(part==0)SetFlag<HardEvent::FIX_M>(EVENT_ID0);
                    else {
                        SetFlag<HardEvent::FIX_M>(EVENT_ID1);
                        CrossCoreSetFlag<2,PIPE_FIX>(chunk==0?8:9);pending[chunk]=true;
                    }
                    fixBusy[part]=true;
                }
            }
        }
        if(l1Busy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        if(l0Busy)WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
        if(fixBusy[0])WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        if(fixBusy[1])WaitFlag<HardEvent::FIX_M>(EVENT_ID1);
        if(pending[0])CrossCoreWaitFlag(10);
        if(pending[1])CrossCoreWaitFlag(15);
    }
    if ASCEND_IS_AIV {
        const int stage=tileM*np*4,rmo=stage,tmpo=rmo+(tileM+7)/8*32,outo=tmpo+256,sxo=outo+32;
        LocalTensor<float> c(TPosition::VECIN,0,tileM*np);
        LocalTensor<float> rm(TPosition::VECCALC,rmo,(tileM+7)/8*8),tmp(TPosition::VECCALC,tmpo,64);
        LocalTensor<float> out(TPosition::VECOUT,outo,8);
        LocalTensor<float> blockMax(TPosition::VECCALC,sxo+512*4,tileM*8);
        DisableDmaAtomic();Duplicate(out,0.0f,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        for(int batch=core;batch<batches;batch+=cores) {
            DataCopyExtParams init{1,4,0,0,0};DataCopyPad(yg[batch],out,init);
        }
        PipeBarrier<PIPE_ALL>();SyncAll<true>();
        bool used=false;
        for(int task=core;task<batches*mt;task+=cores) {
            const int batch=task/mt,mi=task%mt*tileM,cm=m-mi<tileM?m-mi:tileM;
            for(int first=0;first<cm;first+=CH) {
                const int chunk=first/CH,rows=cm-first<CH?cm-first:CH;
                CrossCoreWaitFlag(chunk==0?8:9);
                if(used){SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
                DataCopyExtParams cp{1,(uint32_t)rows*np*4,0,0,0};
                DataCopyPadExtParams<float> pad{false,0,0,0};
                DataCopyPad(c,sg[base+(int64_t)first*np],cp,pad);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                CrossCoreSetFlag<2,PIPE_MTE2>(chunk==0?10:15);
                if(n==64) {
                    BlockReduceMax(blockMax,c,rows,64,1,1,8);PipeBarrier<PIPE_V>();
                    if(rows/8)BlockReduceMax(rm[first],blockMax,rows/8,64,1,1,8);
                    if(rows%8)BlockReduceMax(rm[first+(rows/8)*8],blockMax[(rows/8)*64],1,(rows%8)*8,1,1,8);
                } else WholeReduceMax(rm[first],c,n,rows,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();used=true;
            }
            bmms_sum(out,rm,tmp,cm);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            SetAtomicAdd<float>();
            DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);DisableDmaAtomic();
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

template<class T,bool TA,bool TB>
__global__ __aicore__ __mix__(1,1) void bmms_narrow_pair(
    GM_ADDR a,GM_ADDR b,GM_ADDR scratch,GM_ADDR partial,GM_ADDR y,
    int batches,int m,int n,int k,int tileM,int np)
{
    const int kh=k/2,kp=(kh+15)/16*16,mt=(m+tileM-1)/tileM;
    const bool whole=k%32==0;
    if(whole && tileM>BMMS_PAIR_CHUNK_ROWS) {
        bmms_narrow_chunks<T,TA,TB>(a,b,scratch,y,batches,m,n,k,tileM,np);
        return;
    }
    const int kl1=whole?k:kp,core=GetBlockIdx(),cores=GetBlockNum();
    const int64_t base=(int64_t)core*tileM*np;
    GlobalTensor<T> ag,bg;GlobalTensor<float> sg,pg,yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);
    sg.SetGlobalBuffer((__gm__ float*)scratch);pg.SetGlobalBuffer((__gm__ float*)partial);yg.SetGlobalBuffer((__gm__ float*)y);
    if ASCEND_IS_AIC {
        LocalTensor<T> la(TPosition::A1,0,tileM*kl1),lb(TPosition::B1,tileM*kl1*2,np*kl1);
        LocalTensor<T> aa(TPosition::A2,0,tileM*kp),bb(TPosition::B2,0,np*kp);
        LocalTensor<float> cc(TPosition::CO1,0,tileM*np);
        bool l1Busy=false,l0Busy=false,fixBusy=false,any=false;
        for(int task=core;task<batches*mt;task+=cores) {
            const int batch=task/mt,mi=task%mt*tileM,cm=m-mi<tileM?m-mi:tileM,cm16=(cm+15)/16*16;
            for(int part=0;part<2;++part) {
                if(l1Busy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
                if(l0Busy)WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
                const int pos=part*kh,ipos=whole?pos:0;
                if(!whole || part==0) {
                    if(!whole && kh!=kp) {
                        InitConstValue(la,InitConstValueParams<T>{1,(uint16_t)(cm16*kp/16),0,T(0)});
                        InitConstValue(lb,InitConstValueParams<T>{1,(uint16_t)(np*kp/16),0,T(0)});
                        PipeBarrier<PIPE_ALL>();
                    }
                    const int readK=whole?k:kh,readPos=whole?0:pos;
                    Nd2NzParams ap{1,(uint16_t)(TA?readK:cm),(uint16_t)(TA?cm:readK),0,
                        (uint16_t)(TA?m:k),(uint16_t)(TA?kl1:cm16),1,0};
                    Nd2NzParams bp{1,(uint16_t)(TB?n:readK),(uint16_t)(TB?readK:n),0,
                        (uint16_t)(TB?k:n),(uint16_t)(TB?np:kl1),1,0};
                    DataCopy(la,ag[(int64_t)batch*m*k+(TA?(int64_t)readPos*m+mi:(int64_t)mi*k+readPos)],ap);
                    DataCopy(lb,bg[(int64_t)batch*n*k+(TB?readPos:(int64_t)readPos*n)],bp);
                    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
                }
                if(cm16>kp) {
                    LoadData2dParams aaP{0,(uint8_t)(cm16/16),(uint16_t)(TA?kl1/16:1),0,(uint16_t)(kp/16-1),TA,0};
                    for(int posK=0;posK<kp/16;++posK)
                        LoadData(aa[posK*256],la[TA?(ipos+posK*16)*16:(ipos+posK*16)*cm16],aaP);
                } else {
                    LoadData2dParams aaP{0,(uint8_t)(kp/16),(uint16_t)(TA?1:cm16/16),0,0,TA,0};
                    for(int row=0;row<cm16/16;++row)
                        LoadData(aa[row*kp*16],la[TA?(row*kl1+ipos)*16:ipos*cm16+row*256],aaP);
                }
                LoadData2dParams bbP{0,(uint8_t)(np/16),(uint16_t)(TB?1:kl1/16),0,0,!TB,0};
                if(TB){bbP.repeatTimes=np*kp/256;LoadData(bb,lb[ipos*np],bbP);}
                else for(int posK=0;posK<kp/16;++posK)LoadData(bb[posK*np*16],lb[ipos*16+posK*256],bbP);
                SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);l1Busy=true;
                SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
                if(fixBusy){WaitFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=false;}
                MmadParams mm{(uint16_t)cm16,(uint16_t)np,(uint16_t)kp,0,false,true};Mmad(cc,aa,bb,mm);
                SetFlag<HardEvent::M_MTE1>(EVENT_ID3);l0Busy=true;
                SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
                if(part==0 && task!=core)CrossCoreWaitFlag(10);
                FixpipeParamsV220 fp;fp.mSize=cm16;fp.nSize=np;fp.srcStride=cm16;fp.dstStride=np;
                if(part==1)SetAtomicAdd<float>();else DisableDmaAtomic();
                Fixpipe(sg[base],cc,fp);
                DisableDmaAtomic();
                if(part==1)CrossCoreSetFlag<2,PIPE_FIX>(8);
                SetFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=true;
            }
            any=true;
        }
        if(l1Busy)WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        if(l0Busy)WaitFlag<HardEvent::M_MTE1>(EVENT_ID3);
        if(fixBusy)WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        if(any)CrossCoreWaitFlag(10);
    }
    if ASCEND_IS_AIV {
        static_assert(123808<180*1024,"paired narrow plus two-stage Max UB budget");
        const int stage=tileM*np*4,rmo=stage,tmpo=rmo+(tileM+7)/8*32,outo=tmpo+256,sxo=outo+32;
        LocalTensor<float> c(TPosition::VECIN,0,tileM*np);
        LocalTensor<float> rm(TPosition::VECCALC,rmo,(tileM+7)/8*8),tmp(TPosition::VECCALC,tmpo,64);
        LocalTensor<float> out(TPosition::VECOUT,outo,8),sx(TPosition::VECIN,sxo,512);
        LocalTensor<float> blockMax(TPosition::VECCALC,sxo+512*4,tileM*8);
        // Initialize every output in this invocation, while Cube starts its input DMA.
        DisableDmaAtomic();Duplicate(out,0.0f,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        for(int batch=core;batch<batches;batch+=cores) {
            DataCopyExtParams init{1,4,0,0,0};DataCopyPad(yg[batch],out,init);
        }
        PipeBarrier<PIPE_ALL>();SyncAll<true>();
        bool used=false;
        for(int task=core;task<batches*mt;task+=cores) {
            const int batch=task/mt,mi=task%mt*tileM,cm=m-mi<tileM?m-mi:tileM;
            CrossCoreWaitFlag(8);
            if(used){SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
            DataCopyExtParams cp{1,(uint32_t)cm*np*4,0,0,0};
            DataCopyPadExtParams<float> pad{false,0,0,0};DataCopyPad(c,sg[base],cp,pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            CrossCoreSetFlag<2,PIPE_MTE2>(10);
            if(n==64){
                // Each row has eight eight-float blocks. Stage 1 reduces blocks;
                // stage 2 reduces eight row-block maxima for eight rows at once.
                for(int first=0;first<cm;first+=248){
                    const int rows=cm-first<248?cm-first:248;
                    BlockReduceMax(blockMax[first*8],c[first*64],rows,64,1,1,8);
                }
                PipeBarrier<PIPE_V>();
                if(cm/8)BlockReduceMax(rm,blockMax,cm/8,64,1,1,8);
                if(cm%8)BlockReduceMax(rm[(cm/8)*8],blockMax[(cm/8)*64],1,(cm%8)*8,1,1,8);
            }else{
            for(int first=0;first<cm;first+=BMMS_PAIR_CHUNK_ROWS) {
                const int rows=cm-first<BMMS_PAIR_CHUNK_ROWS?cm-first:BMMS_PAIR_CHUNK_ROWS;
                WholeReduceMax(rm[first],c[first*np],n,rows,1,1,np/8,ReduceOrder::ORDER_ONLY_VALUE);
            }
            }
            PipeBarrier<PIPE_V>();used=true;
            bmms_sum(out,rm,tmp,cm);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            SetAtomicAdd<float>();
            DataCopyExtParams op{1,4,0,0,0};DataCopyPad(yg[batch],out,op);
            DisableDmaAtomic();
            SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        }

    }
    PipeBarrier<PIPE_ALL>();
}


// Capacity buckets describe UB resources, never a full logical testcase shape.
template<class T,bool TA,bool TB,int KP>
__global__ __aicore__ __vector__ void bmms_vector_rows(
    GM_ADDR a,GM_ADDR b,GM_ADDR y,int32_t batches,int32_t m,int32_t n,int32_t k)
{
    constexpr int MP=8,NP=16,RAW=16*KP;
    constexpr int AF=RAW*4,BF=AF+RAW*4,AT=BF+RAW*4,BT=AT+MP*KP*4;
    constexpr int PROD=BT+NP*KP*4,DOTS=PROD+MP*NP*KP*4;
    constexpr int MAXIMA=DOTS+MP*NP*4,OUT=MAXIMA+32,IX=OUT+32;
    static_assert(IX+KP*8<=180*1024,"generic vector rows UB");
    LocalTensor<T> ar(TPosition::VECIN,0,RAW),br(TPosition::VECIN,RAW*2,RAW);
    LocalTensor<float> af(TPosition::VECCALC,AF,RAW),bf(TPosition::VECCALC,BF,RAW);
    LocalTensor<float> at(TPosition::VECCALC,AT,MP*KP),bt(TPosition::VECCALC,BT,NP*KP);
    LocalTensor<float> prod(TPosition::VECCALC,PROD,MP*NP*KP),dots(TPosition::VECCALC,DOTS,MP*NP);
    LocalTensor<float> maxima(TPosition::VECCALC,MAXIMA,MP),out(TPosition::VECOUT,OUT,8);
    LocalTensor<int32_t> ai(TPosition::VECCALC,IX,KP),bi(TPosition::VECCALC,IX+KP*4,KP);
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    if(TA||!TB){
        for(int j=0;j<8;++j){if(TA)ai.SetValue(j,j*(TA?m:1)*4);if(!TB)bi.SetValue(j,j*(!TB?n:1)*4);}
        SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
        #pragma unroll
        for(int len=8;len<KP;len*=2){
            if(TA)Adds(ai[len],ai,len*m*4,len);
            if(!TB)Adds(bi[len],bi,len*n*4,len);
            PipeBarrier<PIPE_V>();
        }
    }
    for(int batch=GetBlockIdx();batch<batches;batch+=GetBlockNum()){
        DataCopyExtParams ac{1,(uint32_t)m*k*2,0,0,0},bc{1,(uint32_t)n*k*2,0,0,0};
        DataCopyPadExtParams<T> ap{true,0,(uint8_t)((16-m*k%16)%16),(T)0};
        DataCopyPadExtParams<T> bp{true,0,(uint8_t)((16-n*k%16)%16),(T)0};
        DataCopyPad(ar,ag[(int64_t)batch*m*k],ac,ap);DataCopyPad(br,bg[(int64_t)batch*n*k],bc,bp);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af,ar,RoundMode::CAST_NONE,m*k);Cast(bf,br,RoundMode::CAST_NONE,n*k);PipeBarrier<PIPE_V>();
        if(TA){for(int row=0;row<m;++row)Gather(at[row*k],af,ai.ReinterpretCast<uint32_t>(),row*4,k);}
        else at=af;
        if(!TB){for(int col=0;col<n;++col)Gather(bt[col*k],bf,bi.ReinterpretCast<uint32_t>(),col*4,k);}
        else bt=bf;
        PipeBarrier<PIPE_V>();
        for(int row=0;row<m;++row){
            #pragma unroll
            for(int chunk=0;chunk<KP;chunk+=64)
                Mul(prod[row*NP*KP+chunk],at[row*k+chunk],bt[chunk],k-chunk<64?k-chunk:64,n,
                    {1,1,1,(uint8_t)(k/8),0,(uint8_t)(k/8)});
        }
        PipeBarrier<PIPE_V>();
        if(KP>64){
            for(int row=0;row<m;++row)Add(prod[row*NP*KP],prod[row*NP*KP],prod[row*NP*KP+64],k-64,n,
                {1,1,1,(uint8_t)(k/8),(uint8_t)(k/8),(uint8_t)(k/8)});
            PipeBarrier<PIPE_V>();
        }
        for(int row=0;row<m;++row)WholeReduceSum(dots[row*NP],prod[row*NP*KP],k<64?k:64,n,1,1,k/8);
        PipeBarrier<PIPE_V>();
        WholeReduceMax(maxima,dots,n,m,1,1,NP/8,ReduceOrder::ORDER_ONLY_VALUE);PipeBarrier<PIPE_V>();
        WholeReduceSum(out,maxima,m,1,1,1,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],out,cp);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

// The mathematical scalar case reduces to one dot product for any supported K.
template<class T>
__global__ __aicore__ __cube__ void bmms_scalar_tile(GM_ADDR a,GM_ADDR b,GM_ADDR y,int32_t k)
{
    constexpr int P=16,KC=256;
    const int batch=GetBlockIdx();
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    LocalTensor<T> la(TPosition::A1,0,P*KC),lb(TPosition::B1,P*KC*2,P*KC);
    LocalTensor<T> aa(TPosition::A2,0,P*KC),bb(TPosition::B2,0,P*KC);
    LocalTensor<float> cc(TPosition::CO1,0,P*P);
    Nd2NzParams p{1,1,(uint16_t)k,0,(uint16_t)k,P,1,0};
    DataCopy(la,ag[(int64_t)batch*k],p);DataCopy(lb,bg[(int64_t)batch*k],p);
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    LoadData2dParams ap{0,(uint8_t)(k/16),1,0,0,false,0};LoadData(aa,la,ap);LoadData(bb,lb,ap);
    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
    MmadParams mm{P,P,(uint16_t)k,0,false,true};Mmad(cc,aa,bb,mm);
    SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
    FixpipeParamsV220 fp;fp.mSize=1;fp.nSize=1;fp.srcStride=P;fp.dstStride=1;Fixpipe(yg[batch],cc,fp);
    PipeBarrier<PIPE_ALL>();
}

// K-major inputs: broadcast each real A scalar to one eight-lane N block.
// All logical dimensions are runtime values; MP/NP/KP are only UB capacities.
template<class T>
__global__ __aicore__ __vector__ void bmms_kmajor_eight(
    GM_ADDR a,GM_ADDR b,GM_ADDR y,int32_t batches,int32_t m,int32_t n,int32_t k)
{
    constexpr int MP=8,NP=8,KP=64,RAW=MP*KP,E=MP*NP*KP;
    constexpr int AF=RAW*4,BF=AF+RAW*4,SORT=BF+RAW*4;
    constexpr int AP=SORT+KP*NP*4,BP=AP+E*4,IX=BP+E*4;
    constexpr int MAXIMA=IX+KP*NP*4,OUT=MAXIMA+32;
    static_assert(OUT+32<=180*1024,"K-major Vector capacity");
    LocalTensor<T> ar(TPosition::VECIN,0,RAW),br(TPosition::VECIN,RAW*2,RAW);
    LocalTensor<float> af(TPosition::VECCALC,AF,RAW),bf(TPosition::VECCALC,BF,RAW);
    LocalTensor<float> sorted(TPosition::VECCALC,SORT,KP*NP),ap(TPosition::VECCALC,AP,E),bp(TPosition::VECCALC,BP,E);
    LocalTensor<int32_t> ix(TPosition::VECCALC,IX,KP*NP);
    LocalTensor<float> maxima(TPosition::VECCALC,MAXIMA,8),out(TPosition::VECOUT,OUT,8);
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    DataCopyExtParams ac{1,(uint32_t)m*k*2,0,0,0},bc{1,(uint32_t)n*k*2,0,0,0};
    DataCopyPadExtParams<T> acp{true,0,(uint8_t)((16-m*k%16)%16),(T)0};
    DataCopyPadExtParams<T> bcp{true,0,(uint8_t)((16-n*k%16)%16),(T)0};
    // Host launches at most one core per batch. Input staging and the index
    // table occupy disjoint UB ranges, so start DMA before index generation.
    DataCopyPad(ar,ag[(int64_t)GetBlockIdx()*m*k],ac,acp);
    DataCopyPad(br,bg[(int64_t)GetBlockIdx()*n*k],bc,bcp);
    for(int j=0;j<8;++j)ix.SetValue(j,(j<n?j:0)*4);
    SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
    for(int len=8;len<k*8;len*=2){
        const int count=len<k*8-len?len:k*8-len;
        Adds(ix[len],ix,len/8*n*4,count);PipeBarrier<PIPE_V>();
    }
    for(int batch=GetBlockIdx();batch<batches;batch+=GetBlockNum()){
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Cast(af,ar,RoundMode::CAST_NONE,m*k);Cast(bf,br,RoundMode::CAST_NONE,n*k);PipeBarrier<PIPE_V>();
        Gather(sorted,bf,ix.ReinterpretCast<uint32_t>(),0,k*8);
        Brcb(ap,af,m*k/8,{1,8});PipeBarrier<PIPE_V>();
        for(int row=0;row<m;++row)Copy(bp[row*8],sorted,8,k,{1,1,(uint8_t)m,1});
        PipeBarrier<PIPE_V>();
        Mul(ap,ap,bp,m*k*8);PipeBarrier<PIPE_V>();
        for(int count=k;count>1;count=(count+1)/2){
            int half=(count+1)/2;
            Add(ap,ap,ap[half*m*8],(count-half)*m*8);PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(maxima,ap,n,m,1,1,1,ReduceOrder::ORDER_ONLY_VALUE);PipeBarrier<PIPE_V>();
        WholeReduceSum(out,maxima,m,1,1,1,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],out,cp);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        const int nextBatch=batch+GetBlockNum();
        if(nextBatch<batches) {
            DataCopyPad(ar,ag[(int64_t)nextBatch*m*k],ac,acp);
            DataCopyPad(br,bg[(int64_t)nextBatch*n*k],bc,bcp);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

// Contiguous16-bit staging: full32B paired-K source rows use a transpose
// and parity packing; M tails retain the general FP32 Gather layout.
template<class T>
__global__ __aicore__ __vector__ void bmms_kmajor_sixteen(
    GM_ADDR a,GM_ADDR b,GM_ADDR y,int32_t batches,int32_t m,int32_t n,int32_t k)
{
    constexpr int MP=8,NP=16,KP=128,RAW=MP*KP,BRAW=NP*KP;
    constexpr int BR=RAW*2,AF=BR+BRAW*2,AT=AF+RAW*4;
    constexpr int BF=AT+RAW*4,PROD=BF+BRAW*4,DOTS=PROD+MP*BRAW*4;
    constexpr int MAXIMA=DOTS+MP*NP*4,OUT=MAXIMA+32,IX=OUT+32;
    constexpr int AUX=IX+KP*4,KH=KP/2;
    static_assert(sizeof(T)==2,"paired-K transpose uses16-bit input words");
    static_assert(AUX+BRAW*2==93248 && AUX+BRAW*2<=180*1024,"paired-K Vector UB capacity");
    LocalTensor<T> ar(TPosition::VECIN,0,RAW),br(TPosition::VECIN,BR,BRAW);
    LocalTensor<float> af(TPosition::VECCALC,AF,RAW),at(TPosition::VECCALC,AT,RAW);
    LocalTensor<float> bf(TPosition::VECCALC,BF,BRAW),prod(TPosition::VECCALC,PROD,MP*BRAW);
    LocalTensor<float> dots(TPosition::VECCALC,DOTS,MP*NP),maxima(TPosition::VECCALC,MAXIMA,8);
    LocalTensor<float> value(TPosition::VECOUT,OUT,8);
    LocalTensor<int32_t> ix(TPosition::VECCALC,IX,KP);
    LocalTensor<uint16_t> bPair(TPosition::VECCALC,AUX,BRAW);
    uint64_t transposeSrc[16],transposeDst[16];
    // Two physical K rows must fill one32B DataBlock for the16x16 transpose.
    // This is a full-source-row layout condition, not a testcase tuple.
    const bool pairLayout=(2*m*(int)sizeof(T)==32);
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    for(int batch=GetBlockIdx();batch<batches;batch+=GetBlockNum()){
        if(k<KP || n<NP) {
            Duplicate(br,(T)0,BRAW);
            if(pairLayout && k<KP)Duplicate(ar,(T)0,RAW);
            SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
        }
        DataCopyExtParams ac{1,(uint32_t)m*k*2,0,0,0};
        DataCopyPadExtParams<T> ap{true,0,(uint8_t)((16-m*k%16)%16),(T)0};
        DataCopyExtParams bc{(uint16_t)n,(uint32_t)k*2,0,(uint32_t)(KP-(k+15)/16*16)/16,0};
        DataCopyPadExtParams<T> bp{true,0,(uint8_t)((16-k%16)%16),(T)0};
        DataCopyPad(ar,ag[(int64_t)batch*m*k],ac,ap);
        DataCopyPad(br,bg[(int64_t)batch*n*k],bc,bp);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if(batch==GetBlockIdx()) {
            if(pairLayout) {
                const uint64_t sb=(uint64_t)ar.GetPhyAddr(),db=(uint64_t)at.GetPhyAddr();
                #pragma unroll
                for(int j=0;j<16;++j) {
                    transposeSrc[j]=sb+j*32;transposeDst[j]=db+j*KH*2;
                }
            } else {
                for(int j=0;j<8;++j)ix.SetValue(j,j*m*4);
                SetFlag<HardEvent::S_V>(EVENT_ID0);WaitFlag<HardEvent::S_V>(EVENT_ID0);
                #pragma unroll
                for(int len=8;len<KP;len*=2) {
                    Adds(ix[len],ix,len*m*4,len);PipeBarrier<PIPE_V>();
                }
            }
        }
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        if(pairLayout) {
            // View compact A as [KP/2,2*M]. Transposing its16-bit words gives
            // [2,M,KP/2]: the first M rows are evenK, the next M are oddK.
            TransDataTo5HDParams tp;tp.dstHighHalf=false;tp.srcHighHalf=false;
            tp.repeatTimes=KP/32;tp.dstRepStride=1;tp.srcRepStride=16;
            TransDataTo5HD<uint16_t>(transposeDst,transposeSrc,tp);
            // Split all B rows by the same parity. Normal16-bit repeats read
            // exactly one128-element physical B row and emit64 elements.
            uint64_t retained=0;
            auto brBits=br.template ReinterpretCast<uint16_t>();
            GatherMask(bPair,brBits,(uint8_t)1,false,0,{1,NP,8,0},retained);
            GatherMask(bPair[BRAW/2],brBits,(uint8_t)2,false,0,{1,NP,8,0},retained);
            PipeBarrier<PIPE_V>();
            Cast(af,at.template ReinterpretCast<T>(),RoundMode::CAST_NONE,RAW);
            Cast(bf,bPair.template ReinterpretCast<T>(),RoundMode::CAST_NONE,BRAW);
            PipeBarrier<PIPE_V>();
            const int plane=m*NP*KH;
            for(int row=0;row<m;++row) {
                Mul(prod[row*NP*KH],af[row*KH],bf,KH,NP,{1,1,1,KH/8,0,KH/8});
                Mul(prod[plane+row*NP*KH],af[(m+row)*KH],bf[NP*KH],KH,NP,
                    {1,1,1,KH/8,0,KH/8});
            }
            PipeBarrier<PIPE_V>();
            Add(prod,prod,prod[plane],plane);PipeBarrier<PIPE_V>();
            WholeReduceSum(dots,prod,KH,m*NP,1,1,KH/8);PipeBarrier<PIPE_V>();
        } else {
            Cast(af,ar,RoundMode::CAST_NONE,m*k);
            Cast(bf,br,RoundMode::CAST_NONE,BRAW);
            if(k<KP)Duplicate(at,0.0f,m*KP);
            PipeBarrier<PIPE_V>();
            for(int row=0;row<m;++row)
                Gather(at[row*KP],af,ix.template ReinterpretCast<uint32_t>(),row*4,k);
            PipeBarrier<PIPE_V>();
            // Each M row has a disjoint product plane, so same-pipe instructions
            // for different rows can be issued before the common dependency fence.
            // No row's products are overwritten before its K reduction completes.
            for(int row=0;row<m;++row){
                Mul(prod[row*BRAW],at[row*KP],bf,64,NP,{1,1,1,KP/8,0,KP/8});
                Mul(prod[row*BRAW+64],at[row*KP+64],bf[64],64,NP,{1,1,1,KP/8,0,KP/8});
            }
            PipeBarrier<PIPE_V>();
            // All m*NP dot rows have the same 128-float physical pitch.
            // One repeat per dot folds K[64:128] into K[0:64]; a single batched
            // reduction then writes m*NP adjacent dot products. NP tail columns
            // were zero-filled in B and are excluded by the true-n Max below.
            Add(prod,prod,prod[64],64,m*NP,{1,1,1,KP/8,KP/8,KP/8});
            PipeBarrier<PIPE_V>();
            WholeReduceSum(dots,prod,64,m*NP,1,1,KP/8);
            PipeBarrier<PIPE_V>();
        }
        WholeReduceMax(maxima,dots,n,m,1,1,NP/8,ReduceOrder::ORDER_ONLY_VALUE);PipeBarrier<PIPE_V>();
        WholeReduceSum(value,maxima,m,1,1,1,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],value,cp);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

// Partition only independent M rows. Every owned row computes all real K
// terms and takes Max over all true N before its Sum contributes to y.
template<class T>
__global__ __aicore__ __mix__(1,2) void bmms_kmajor_rowpair(
    GM_ADDR a,GM_ADDR b,GM_ADDR y,int32_t m,int32_t n,int32_t k)
{
    // AIC coordinates only this batch's two Vector peers. The complete
    // arithmetic below remains inside this single mixed-kernel invocation.
    if ASCEND_IS_AIC {
        CrossCoreWaitFlag(8);
        CrossCoreSetFlag<2,PIPE_FIX>(9);
        PipeBarrier<PIPE_ALL>();
    }
    if ASCEND_IS_AIV {
    constexpr int PARTS=2;

    constexpr int MP=8,NP=16,KP=128,KH=64,ROWS=MP/PARTS;
    constexpr int RAW=MP*KP,BRAW=NP*KP;
    constexpr int BR=RAW*2,AF=BR+BRAW*2,AT=AF+RAW*4;
    constexpr int BF=AT+RAW*4,PROD=BF+BRAW*4;
    constexpr int DOTS=PROD+ROWS*NP*KP*4,MAXIMA=DOTS+ROWS*NP*4;
    constexpr int OUT=(MAXIMA+ROWS*4+31)/32*32,AUX=OUT+32;
    static_assert(PARTS==2||PARTS==4||PARTS==8,"row partition count");
    static_assert(sizeof(T)==2 && AUX+BRAW*2<=180*1024,"row-split UB capacity");
    LocalTensor<T> ar(TPosition::VECIN,0,RAW),br(TPosition::VECIN,BR,BRAW);
    LocalTensor<float> af(TPosition::VECCALC,AF,RAW),at(TPosition::VECCALC,AT,RAW);
    LocalTensor<float> bf(TPosition::VECCALC,BF,BRAW),prod(TPosition::VECCALC,PROD,ROWS*NP*KP);
    LocalTensor<float> dots(TPosition::VECCALC,DOTS,ROWS*NP),maxima(TPosition::VECCALC,MAXIMA,ROWS);
    LocalTensor<float> value(TPosition::VECOUT,OUT,8);
    LocalTensor<uint16_t> bPair(TPosition::VECCALC,AUX,BRAW);
    const int batch=GetBlockIdx(),part=GetSubBlockIdx(),first=part*ROWS;
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    // A new output is initialized in this invocation. The barrier below
    // orders every zero write before every true partial-sum atomic add.
    if(part==0) {
        Duplicate(value,0.0f,8);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID1);WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
        DataCopyExtParams zero{1,4,0,0,0};DataCopyPad(yg[batch],value,zero);
    }
    if(k<KP||n<NP) {
        Duplicate(br,(T)0,BRAW);
        if(k<KP)Duplicate(ar,(T)0,RAW);
        SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
    }
    DataCopyExtParams ac{1,(uint32_t)m*k*2,0,0,0};
    DataCopyPadExtParams<T> ap{true,0,(uint8_t)((16-m*k%16)%16),(T)0};
    DataCopyExtParams bc{(uint16_t)n,(uint32_t)k*2,0,(uint32_t)(KP-(k+15)/16*16)/16,0};
    DataCopyPadExtParams<T> bp{true,0,(uint8_t)((16-k%16)%16),(T)0};
    DataCopyPad(ar,ag[(int64_t)batch*m*k],ac,ap);
    DataCopyPad(br,bg[(int64_t)batch*n*k],bc,bp);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    uint64_t src[16],dst[16];
    const uint64_t sb=(uint64_t)ar.GetPhyAddr(),db=(uint64_t)at.GetPhyAddr();
    #pragma unroll
    for(int j=0;j<16;++j){src[j]=sb+j*32;dst[j]=db+j*KH*2;}
    // Both Vector peers signal this Cube domain. Peer0 signals only
    // after its fresh zero write completes on MTE3; peer1 also contributes
    // the required readiness signal. AIC relays readiness to both peers.
    // No global barrier or uninitialized GM readiness flag is used.
    CrossCoreSetFlag<2,PIPE_MTE3>(8);
    CrossCoreWaitFlag(9);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    TransDataTo5HDParams tp;tp.dstHighHalf=false;tp.srcHighHalf=false;
    tp.repeatTimes=KP/32;tp.dstRepStride=1;tp.srcRepStride=16;
    TransDataTo5HD<uint16_t>(dst,src,tp);
    uint64_t retained=0;
    auto brBits=br.template ReinterpretCast<uint16_t>();
    GatherMask(bPair,brBits,(uint8_t)1,false,0,{1,NP,8,0},retained);
    GatherMask(bPair[BRAW/2],brBits,(uint8_t)2,false,0,{1,NP,8,0},retained);
    PipeBarrier<PIPE_V>();
    Cast(af,at.template ReinterpretCast<T>(),RoundMode::CAST_NONE,RAW);
    Cast(bf,bPair.template ReinterpretCast<T>(),RoundMode::CAST_NONE,BRAW);
    PipeBarrier<PIPE_V>();
    constexpr int PLANE=ROWS*NP*KH;
    #pragma unroll
    for(int row=0;row<ROWS;++row){
        Mul(prod[row*NP*KH],af[(first+row)*KH],bf,KH,NP,{1,1,1,KH/8,0,KH/8});
        Mul(prod[PLANE+row*NP*KH],af[(MP+first+row)*KH],bf[NP*KH],KH,NP,{1,1,1,KH/8,0,KH/8});
    }
    PipeBarrier<PIPE_V>();
    Add(prod,prod,prod[PLANE],PLANE);PipeBarrier<PIPE_V>();
    WholeReduceSum(dots,prod,KH,ROWS*NP,1,1,KH/8);PipeBarrier<PIPE_V>();
    WholeReduceMax(maxima,dots,n,ROWS,1,1,NP/8,ReduceOrder::ORDER_ONLY_VALUE);PipeBarrier<PIPE_V>();
    WholeReduceSum(value,maxima,ROWS,1,1,1,8);
    SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    SetAtomicAdd<float>();
    DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg[batch],value,cp);
    DisableDmaAtomic();PipeBarrier<PIPE_ALL>();
    }
}

// Per-invocation allocation only. No persistent shape, input, output or workspace cache.
struct BmmsCallSpace {
    aclrtStream stream;void* ptr;
    explicit BmmsCallSpace(aclrtStream s):stream(s),ptr(nullptr){}
    // A failed invocation must report failure instead of returning a stale y.
    // No replacement output or empty kernel is produced on allocation failure.
    void allocate(size_t bytes){
        const aclError rc=aclrtMalloc(&ptr,bytes,ACL_MEM_MALLOC_HUGE_FIRST);
        if(rc!=ACL_SUCCESS) throw std::runtime_error(
            "BatchMatmulMaxSum: workspace allocation failed, aclError="+std::to_string(rc));
    }
    ~BmmsCallSpace(){if(ptr){aclrtSynchronizeStream(stream);aclrtFree(ptr);}}
};
extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    int32_t b = info_x1.tensors[0].shape[0];
    int32_t m = info_x1.tensors[0].shape[transposeX1 ? 2 : 1];
    int32_t k = info_x1.tensors[0].shape[transposeX1 ? 1 : 2];
    int32_t n = info_x2.tensors[0].shape[transposeX2 ? 1 : 2];

    if(m>=1024 && m<=8192 && n>32 && n<=64 && k>=32 && k<=128 && k%8==0) {
        const int tm=std::min<int>(BMMS_PAIR_MAX_ROWS,std::max<int>(16,((int64_t)b*m+availableCoreNum-1)/availableCoreNum+15)/16*16);
        const int np=(n+15)/16*16,mt=(m+tm-1)/tm,cores=std::min<int64_t>(availableCoreNum,(int64_t)b*mt);
        const size_t matrixBytes=(size_t)cores*tm*np*4,bytes=matrixBytes+((size_t)b*mt*4+511)/512*512;
        BmmsCallSpace localSpace(stream);localSpace.allocate(bytes);auto ws=&localSpace;
        GM_ADDR matrix=(GM_ADDR)ws->ptr;GM_ADDR partial=matrix+matrixBytes;
#define BMMS_PAIR(T,A,B) bmms_narrow_pair<T,A,B><<<cores,nullptr,stream>>>(x1,x2,matrix,partial,y,b,m,n,k,tm,np)
#define BMMS_PAIR_TYPE(T) if(transposeX1){if(transposeX2){BMMS_PAIR(T,true,true);}else{BMMS_PAIR(T,true,false);}} else{if(transposeX2){BMMS_PAIR(T,false,true);}else{BMMS_PAIR(T,false,false);}}
        if(info_x1.tensors[0].dtype==1){BMMS_PAIR_TYPE(half);}else{BMMS_PAIR_TYPE(bfloat16_t);}
#undef BMMS_PAIR_TYPE
#undef BMMS_PAIR
        return;
    }

    // Fewer output rows/columns than a 64x64 tile, high K arithmetic intensity.
    if(m<=64 && n<=64 && k>=2048 && k%16==0 && b<=availableCoreNum){
        int parts=std::min<int>(16,k/512),cores=std::min<int64_t>(availableCoreNum,(int64_t)b*parts);
        size_t matrixBytes=(size_t)b*parts*64*64*4;
        BmmsCallSpace localSpace(stream);localSpace.allocate(matrixBytes+((size_t)b*((m+15)/16)*4+511)/512*512);
#define BMMS_SPLIT(T,A,B) bmms_split_tile<T,A,B><<<cores,nullptr,stream>>>(x1,x2,(GM_ADDR)localSpace.ptr,(GM_ADDR)localSpace.ptr+matrixBytes,y,b,m,n,k,parts)
#define BMMS_SPLIT_TYPE(T) if(transposeX1){if(transposeX2){BMMS_SPLIT(T,true,true);}else{BMMS_SPLIT(T,true,false);}}else{if(transposeX2){BMMS_SPLIT(T,false,true);}else{BMMS_SPLIT(T,false,false);}}
        if(info_x1.tensors[0].dtype==2){BMMS_SPLIT_TYPE(bfloat16_t);}else{BMMS_SPLIT_TYPE(half);}
#undef BMMS_SPLIT_TYPE
#undef BMMS_SPLIT
        return;
    }
    if(m==1 && n==1){
        if(k%16==0 && k<=256 && b<=availableCoreNum){
            if(info_x1.tensors[0].dtype==2)bmms_scalar_tile<bfloat16_t><<<b,nullptr,stream>>>(x1,x2,y,k);
            else bmms_scalar_tile<half><<<b,nullptr,stream>>>(x1,x2,y,k);
        }else{
            int vc=std::min<int64_t>(b,availableCoreNum*2);
            if(info_x1.tensors[0].dtype==2)bmms_dot<bfloat16_t><<<vc,nullptr,stream>>>(x1,x2,y,b,k);
            else bmms_dot<half><<<vc,nullptr,stream>>>(x1,x2,y,b,k);
        }
        return;
    }
    // Contiguous dot rows fit one Vector repeat per product.
    if(!transposeX1 && transposeX2 && m<=8 && n<=16 && k<=64){
        int vc=std::min<int64_t>(b,availableCoreNum*2);
        if(info_x1.tensors[0].dtype==2)bmms_vector_short_nt<bfloat16_t><<<vc,nullptr,stream>>>(x1,x2,y,b,m,n,k);
        else bmms_vector_short_nt<half><<<vc,nullptr,stream>>>(x1,x2,y,b,m,n,k);
        return;
    }
    if(transposeX1 && !transposeX2 && m<=8 && n<=8 && k<=64){
        int vc=std::min<int64_t>(b,availableCoreNum*2);
        if(info_x1.tensors[0].dtype==2)bmms_kmajor_eight<bfloat16_t><<<vc,nullptr,stream>>>(x1,x2,y,b,m,n,k);
        else bmms_kmajor_eight<half><<<vc,nullptr,stream>>>(x1,x2,y,b,m,n,k);
        return;
    }
    if(transposeX1 && transposeX2 && m<=8 && n<=16 && k>64 && k<=128){
        int vc=std::min<int64_t>(b,availableCoreNum*2);
        // Paired source rows fill32B; one Cube domain can coordinate
        // two Vector row groups without a device-wide initialization barrier.
        const bool useRowPair=2*m*(int)sizeof(uint16_t)==32 &&
            (int64_t)m*n*k>=64*128 && b<=availableCoreNum;
#define BMMS_ROW_PAIR(T) do{ \
    if(useRowPair)bmms_kmajor_rowpair<T><<<b,nullptr,stream>>>(x1,x2,y,m,n,k); \
    else bmms_kmajor_sixteen<T><<<vc,nullptr,stream>>>(x1,x2,y,b,m,n,k); \
}while(0)
        if(info_x1.tensors[0].dtype==2){BMMS_ROW_PAIR(bfloat16_t);}else{BMMS_ROW_PAIR(half);}
#undef BMMS_ROW_PAIR
        return;
    }
    if(m<=8 && n<=16 && k<=128){
        int vc=std::min<int64_t>(b,availableCoreNum*2);
#define BMMS_ROWS(T,A,B) do{if(k<=64)bmms_vector_rows<T,A,B,64><<<vc,nullptr,stream>>>(x1,x2,y,b,m,n,k);else bmms_vector_rows<T,A,B,128><<<vc,nullptr,stream>>>(x1,x2,y,b,m,n,k);}while(0)
#define BMMS_ROWS_TYPE(T) if(transposeX1){if(transposeX2){BMMS_ROWS(T,true,true);}else{BMMS_ROWS(T,true,false);}}else{if(transposeX2){BMMS_ROWS(T,false,true);}else{BMMS_ROWS(T,false,false);}}
        if(info_x1.tensors[0].dtype==2){BMMS_ROWS_TYPE(bfloat16_t);}else{BMMS_ROWS_TYPE(half);}
#undef BMMS_ROWS_TYPE
#undef BMMS_ROWS
        return;
    }
    if (m <= 32 && n <= 128 && m * n > 32 && k <= 256 && k >= 16 && b <= availableCoreNum) {
        const int32_t mp = m <= 16 ? 16 : 32;
        const int32_t np = (n+15)/16*16;
        const int32_t storageN=BMMS_SMALL_STORAGE_N(np);
        BmmsCallSpace localSpace(stream);localSpace.allocate((size_t)b*mp*storageN*4);auto ws=&localSpace;
#define BMMS_DN(T, A, B, MP) do { \
    if (np == 16) bmms_single_tile<T, A, B, MP, 16><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k, storageN); \
    else if (np == 32) bmms_single_tile<T, A, B, MP, 32><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k, storageN); \
    else if (np == 48) bmms_single_tile<T, A, B, MP, 48><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k, storageN); \
    else if (np == 64) bmms_single_tile<T, A, B, MP, 64><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k, storageN); \
    else if (np == 80) bmms_single_tile<T, A, B, MP, 80><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k, storageN); \
    else if (np == 96) bmms_single_tile<T, A, B, MP, 96><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k, storageN); \
    else if (np == 112) bmms_single_tile<T, A, B, MP, 112><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k, storageN); \
    else bmms_single_tile<T, A, B, MP, 128><<<b, nullptr, stream>>>(x1, x2, (GM_ADDR)ws->ptr, y, m, n, k, storageN); \
} while (0)
#define BMMS_DIRECT(T,A,B) do { if(mp==16){BMMS_DN(T,A,B,16);}else{BMMS_DN(T,A,B,32);} }while(0)
        if (info_x1.tensors[0].dtype == 2) {
            if (transposeX1) { if (transposeX2) { BMMS_DIRECT(bfloat16_t, true, true); } else { BMMS_DIRECT(bfloat16_t, true, false); } }
            else { if (transposeX2) { BMMS_DIRECT(bfloat16_t, false, true); } else { BMMS_DIRECT(bfloat16_t, false, false); } }
        } else {
            if (transposeX1) { if (transposeX2) { BMMS_DIRECT(half, true, true); } else { BMMS_DIRECT(half, true, false); } }
            else { if (transposeX2) { BMMS_DIRECT(half, false, true); } else { BMMS_DIRECT(half, false, false); } }
        }
#undef BMMS_DIRECT
#undef BMMS_DN
        return;
    }

    BmmsCallSpace packedSpace(stream);
    int32_t storeM=m, storeN=n; bool packed=false;
    const int32_t originalK=k; GM_ADDR packedA=nullptr; GM_ADDR packedB=nullptr;
    // Packing and NZ compute share one kernel; reserve padded storage only for substantial tail work.
    if (m >= 512 && n >= 512 && m <= 4096 && n <= 4096 && k >= 512 && k <= 2048 &&
        k % 16 != 0 && (int64_t)m * n * k >= (1LL << 29) && (m % 128 != 0 || n % 256 != 0)) {
        int32_t kp = (k + 15) / 16 * 16;
        storeM=(m+15)/16*16; storeN=(n+15)/16*16;
        size_t abytes = ((size_t)b * storeM * kp * 2 + 511) / 512 * 512;
        size_t bytes = abytes + (size_t)b * storeN * kp * 2;
        packedSpace.allocate(bytes);auto ws=&packedSpace;
        packedA = (GM_ADDR)ws->ptr; packedB = packedA + abytes;
        k = kp; packed=true;
    }

    // TT packed operands already have the two contiguous orientations for C^T.
    // This bound is a per-core L1 capacity bound, independent of whole input tuples.
    if(packed && transposeX1 && transposeX2 && 2LL*128*k+2LL*2*128*128<=512*1024-256) {
        const int tm=128,tn=128,mt=(n+tm-1)/tm,nt=(m+tn-1)/tn;
        const int rowTasks=b*mt;int ns=1;
        if(rowTasks<2*availableCoreNum) {
            int best=(rowTasks+availableCoreNum-1)/availableCoreNum*nt;
            for(int parts=2;parts<=nt && parts<=availableCoreNum;++parts) {
                const int cost=(rowTasks*parts+availableCoreNum-1)/availableCoreNum*((nt+parts-1)/parts);
                if(cost<best){best=cost;ns=parts;}
            }
        }
        const int cores=std::max<int64_t>(1,std::min<int64_t>(availableCoreNum,rowTasks*ns));
        const size_t matrixBytes=(size_t)cores*2*tm*tn*4;
        const size_t bytes=matrixBytes+((size_t)b*mt*m*4+511)/512*512;
        BmmsCallSpace localSpace(stream);localSpace.allocate(bytes);
        if(info_x1.tensors[0].dtype==2)
            bmms_transposed_resident_gemm<bfloat16_t><<<cores,nullptr,stream>>>(x1,x2,packedA,packedB,
                (GM_ADDR)localSpace.ptr,(GM_ADDR)localSpace.ptr+matrixBytes,y,b,m,n,originalK,k,storeM,storeN,ns);
        else bmms_transposed_resident_gemm<half><<<cores,nullptr,stream>>>(x1,x2,packedA,packedB,
                (GM_ADDR)localSpace.ptr,(GM_ADDR)localSpace.ptr+matrixBytes,y,b,m,n,originalK,k,storeM,storeN,ns);
        return;
    }

    int32_t tileM = m <= 16 ? 16 : (m <= 32 ? 32 : ((n <= 64 && k <= 128 && m >= 256 && (int64_t)b * ((m + 255) / 256) >= availableCoreNum) ? 256 : 64));
    int32_t tileN = n <= 16 ? 16 : (n <= 32 ? 32 : (n <= 64 ? 64 : 128));
    // For narrow, short-K matrices, fewer waves can offset a partially filled wave.
    if (k <= 128 && n <= 32 && m >= 2048) {
        int64_t best = ((b * ((m + tileM - 1) / tileM) + availableCoreNum - 1) / availableCoreNum) * (tileM + 128);
        for (int32_t candidate = 128; candidate * tileN <= 16384; candidate *= 2) {
            int64_t cost = ((b * ((m + candidate - 1) / candidate) + availableCoreNum - 1) / availableCoreNum) * (candidate + 128);
            if (cost < best) { best = cost; tileM = candidate; }
        }
    }
    // Enlarge tiles only when enough independent tasks remain to occupy the device.
    int32_t initialRows = b * ((m + tileM - 1) / tileM);
    if (n > 128 && (k >= 256 || initialRows * 2 < availableCoreNum) && (initialRows * 2 >= availableCoreNum ||
        (int64_t)initialRows * ((n + 255) / 256) >= availableCoreNum)) tileN = 256;

    // Each tile reloads its own A/B slab from GM and pays one Fixpipe + one scheduler pass,
    // so a 128-row M tile is a win whenever enough tiles remain to keep the device busy.
    // ...but never override the tuned narrow-matrix M-tile chosen just above.
    if (m >= 128 && tileN >= 128) {
        int64_t tiles = (int64_t)((m + 127) / 128) * ((n + 127) / 128);
        if (tiles * 2 >= availableCoreNum) tileM = 128;
    }
    if (k <= 256 && (int64_t)b * m * n * k < (1LL << 28) &&
        n > 128 && n <= 1024 && m <= 512) tileN = 128;
    // Swap the aspect ratio at fixed L0C area when aligned TT shapes have few M tasks.
    // More N partitions expose additional independent tasks without increasing a tile's MACs.
    if(!packed && transposeX1 && transposeX2 && m%256==0 && n%128==0 && k>=512 && k%16==0 &&
       (int64_t)b*((m+255)/256)*((n+127)/128)>=availableCoreNum) {tileM=256;tileN=128;}
    // Keep the AIV UB footprint (tile staging + max/sum reduce buffers) inside the 192 KB
    // budget; an over-large tile overflows UB and faults or hangs the kernel at run time.
    {
        const int64_t finalElements=2LL*((m+7)/8)*8;
        while ((std::max<int64_t>((int64_t)tileM*std::min(tileN,128),finalElements)*4+
                32768+2LL*tileM*4)>180*1024 && (tileM>16||tileN>16)) {
            if(tileN>128 || (tileN>=tileM && tileN>16))tileN>>=1;
            else if(tileM>16)tileM>>=1;
            else break;
        }
    }

    // Resident-A capacity for this tile geometry (FP16/BF16, 2 bytes/element):
    //   A = 128*K*2; one double-buffered B group = 2*256*64*2.
    //   A + B <= 512 KiB gives K <= 1792. External A1 is supplied by this
    //   kernel; Matmul does not allocate another A1 input buffer for it.
    // K%32 makes both K/2 passes 16-aligned; M alignment makes resident A
    // loads full tiles. Each selected path computes all M/N/K contributions.
    // K>1024 and the extra M/N ranges/divisibility gates are inherited
    // performance heuristics, NOT additional L1 capacity requirements.
    // Unselected shapes use the complete generic/manual paths below.
    const bool useFullA = !packed && transposeX1 && !transposeX2 && m>=512 && m<=8192 && n>=1024 && n<=8192 &&
        m%128==0 && n%512==0 && k>1024 && k<=1792 && k%32==0 && tileM==128 && tileN==256;
    TCubeTiling tiling;
    {
        matmul_tiling::PlatformInfo platform;
        platform.socVersion = platform_ascendc::SocVersion::ASCEND910B;
        platform.l1Size = 512 * 1024;
        platform.l0ASize = platform.l0BSize = 64 * 1024;
        platform.l0CSize = 128 * 1024;
        platform.ubSize = 192 * 1024;
        matmul_tiling::MatmulApiTiling api(platform);
        auto dtype = info_x1.tensors[0].dtype == 2 ? matmul_tiling::DataType::DT_BF16 : matmul_tiling::DataType::DT_FLOAT16;
        api.SetAType(useFullA ? matmul_tiling::TPosition::A1 : matmul_tiling::TPosition::GM, ((packed||useFullA)?matmul_tiling::CubeFormat::NZ:matmul_tiling::CubeFormat::ND), dtype, packed?!transposeX1:transposeX1);
        api.SetBType(matmul_tiling::TPosition::GM, (packed?matmul_tiling::CubeFormat::NZ:matmul_tiling::CubeFormat::ND), dtype, packed?!transposeX2:transposeX2);
        api.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);
        api.SetShape(tileM, tileN, useFullA ? k/2 : k);
        api.SetOrgShape(useFullA ? tileM : storeM, storeN, useFullA ? k/2 : k, k);
        if (m >= 512 && n >= 512 && k >= 512 && n % 128 != 0 && k % 16 != 0 && transposeX2)
            api.SetFixSplit(std::min(tileM, 128), std::min(tileN, 128), -1);
        else api.SetFixSplit(std::min(tileM, 256), tileN, useFullA ? 64 : -1);
        api.SetBufferSpace(platform.l1Size, platform.l0CSize, 0);
        const int tilingStatus=api.GetTiling(tiling);
        // Propagate tiling failure; never treat an unlaunched computation as success.
        if(tilingStatus!=0) throw std::runtime_error(
            "BatchMatmulMaxSum: GetTiling failed, status="+std::to_string(tilingStatus));
        if (useFullA) {
            tiling.stepM=1; tiling.stepN=1; tiling.stepKa=1; tiling.depthA1=2;
            tiling.stepKb=(512*1024-tileM*k*2)/(2*tiling.baseN*tiling.baseK*2);
            tiling.depthB1=2*tiling.stepKb;
        }
        // Balanced K slabs reduce small-operand DMA scheduling without increasing
        // L1 capacity. Apply to the fresh per-invocation tiling.
        if (!packed && !useFullA && k >= 512 && (int64_t)b*m*n*k >= (1LL << 28) &&
            tiling.stepM == 1 && tiling.stepN == 1 && tiling.baseM > 0 &&
            tiling.baseN > 0 && tiling.baseK > 0 && k % tiling.baseK == 0 &&
            tiling.stepKa > 0 && tiling.stepKb > 0) {
            const int64_t slabBytes = 4LL * tiling.baseK * (tiling.baseM + tiling.baseN);
            const int blocks = k / tiling.baseK;
            const int limit = std::min<int64_t>(blocks, platform.l1Size / slabBytes);
            int q = 1;
            while (q * 2 <= limit && blocks % (q * 2) == 0) q *= 2;
            const int64_t l0a = 2LL*tiling.baseM*tiling.baseK*tiling.dbL0A;
            const int64_t l0b = 2LL*tiling.baseN*tiling.baseK*tiling.dbL0B;
            const int64_t l0c = 4LL*tiling.baseM*tiling.baseN*tiling.dbL0C;
            if (q > std::min(tiling.stepKa, tiling.stepKb) && slabBytes*q <= platform.l1Size &&
                tiling.dbL0A > 0 && tiling.dbL0B > 0 && tiling.dbL0C > 0 &&
                l0a <= platform.l0ASize && l0b <= platform.l0BSize && l0c <= platform.l0CSize) {
                tiling.stepKa = q; tiling.stepKb = q;
                tiling.depthA1 = 2*q; tiling.depthB1 = 2*q;
                tiling.shareL1Size = slabBytes*q;
            }
        }
        tiling.M = useFullA ? tileM : storeM; tiling.N = storeN; tiling.Ka = useFullA ? k/2 : k; tiling.Kb = k;
        tiling.singleCoreM = tileM; tiling.singleCoreN = tileN; tiling.singleCoreK = useFullA ? k/2 : k;
    }
    int32_t rowTasks = b * ((m + tileM - 1) / tileM);
    int32_t nt = (n + tileN - 1) / tileN;
    int32_t ns = 1;
    // Estimate the number of serial tile steps; avoid extra partitions on ties.
    // N-partitioning multiplies the task count and pays the per-task scheduler cost again;
    // only consider it while the B*M row tasks alone leave most of the device idle.
    if (rowTasks < 2 * availableCoreNum) {
        int32_t bestCost = ((rowTasks + availableCoreNum - 1) / availableCoreNum) * nt;
        for (int32_t parts = 2; parts <= nt && parts <= availableCoreNum; ++parts) {
            int32_t cost = ((rowTasks * parts + availableCoreNum - 1) / availableCoreNum) * ((nt + parts - 1) / parts);
            if (cost < bestCost) { bestCost = cost; ns = parts; }
        }
    }
    int32_t tasks = rowTasks * ns;
    int32_t cores = std::max<int32_t>(1, std::min<int64_t>(availableCoreNum, tasks));
    size_t matrixBytes=(size_t)cores*2*tileM*tileN*4;
    size_t bytes=matrixBytes+((size_t)b*ns*m*4+511)/512*512;
    BmmsCallSpace localSpace(stream);localSpace.allocate(bytes);auto ws=&localSpace;
    auto matrix = (GM_ADDR)ws->ptr;
    auto maxima = matrix + matrixBytes;
    const bool useManual = (!packed && (int64_t)b * m * n * k < (1LL << 28) && k % 16 == 0 &&
                            (int64_t)tileM * tileN <= 32768 && tileM <= 256 &&
                            !(m >= 512 && n >= 8 * m));
// Specialize a common physical tile, after tiling has already selected it.
    // Logical B/M/N/K remain runtime values and all tail/partition work is kept.
    // The guard also proves template geometry equals Host workspace geometry.
#define BMMS_MANUAL(T,A,B) do { \
    if(tileM==64 && tileN==256) bmms_manual<T,A,B,64,256><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN); \
    else bmms_manual<T,A,B><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tileM,tileN); \
} while(0)
    // Partial constants fix base geometry; runtime single-core M/N still handle tails.
    const bool staticFullTile = tiling.baseK > 0 && k % tiling.baseK == 0;
    const uint32_t staticTilingKey = staticFullTile && tiling.baseM == 128 &&
        tiling.baseN == 256 && tiling.baseK == 64 ? 1 :
        staticFullTile && tiling.baseM == 128 && tiling.baseN == 128 && tiling.baseK == 128 ? 2 : 0;
#define BMMS_LAUNCH(T, A, B) do { \
    if (useFullA) bmms_resident<T,A,B,true,true><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else if (useManual) BMMS_MANUAL(T, A, B); \
    else if(packed) bmms_fused_transposed_nz<T,A,B,true><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling,storeM,storeN,packedA,packedB,originalK); \
    else if (staticTilingKey == 1) bmms_fused_static<T,A,B,128,256,64><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else if (staticTilingKey == 2) bmms_fused_static<T,A,B,128,128,128><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
    else bmms_fused<T,A,B><<<cores,nullptr,stream>>>(x1,x2,matrix,maxima,y,b,m,n,k,ns,tiling); \
} while (0)
    if (info_x1.tensors[0].dtype == 2) {
        if (transposeX1) { if (transposeX2) { BMMS_LAUNCH(bfloat16_t, true, true); } else { BMMS_LAUNCH(bfloat16_t, true, false); } }
        else { if (transposeX2) { BMMS_LAUNCH(bfloat16_t, false, true); } else { BMMS_LAUNCH(bfloat16_t, false, false); } }
    } else {
        if (transposeX1) { if (transposeX2) { BMMS_LAUNCH(half, true, true); } else { BMMS_LAUNCH(half, true, false); } }
        else { if (transposeX2) { BMMS_LAUNCH(half, false, true); } else { BMMS_LAUNCH(half, false, false); } }
    }
#undef BMMS_LAUNCH
#undef BMMS_MANUAL
}
