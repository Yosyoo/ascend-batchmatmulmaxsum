#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <algorithm>
#include <vector>
#include <string>
#include <fstream>
#include <sstream>
#include "acl/acl.h"
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#include "kernel.asc"
struct Case { int b,m,n,k,d,ta,tb; std::string path; };
static bool read(const std::string& p, void* dst, size_t n) {
    FILE* f=fopen(p.c_str(),"rb"); if(!f)return false;
    bool ok=fread(dst,1,n,f)==n; fclose(f); return ok;
}
#define CHECK(x) do { auto err=(x); if(err!=ACL_SUCCESS) { fprintf(stderr,"ACL failure line %d code %d\n",__LINE__,(int)err); return 1; } } while(0)
int main(int argc,char** argv) {
    if(argc<2)return 1;
    std::ifstream mf(argv[1]); std::string line; std::vector<Case> cases;
    size_t maxA=0,maxB=0,maxY=0;
    while(std::getline(mf,line)) {
        std::istringstream ss(line); Case c;
        if(!(ss>>c.b>>c.m>>c.n>>c.k>>c.d>>c.ta>>c.tb>>c.path))continue;
        cases.push_back(c); maxA=std::max(maxA,(size_t)c.b*c.m*c.k*2);
        maxB=std::max(maxB,(size_t)c.b*c.n*c.k*2);maxY=std::max(maxY,(size_t)c.b*4);
    }
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(0));
    int64_t cores=0; CHECK(aclrtGetDeviceInfo(0,ACL_DEV_ATTR_CUBE_CORE_NUM,&cores));
    aclrtStream stream=nullptr; CHECK(aclrtCreateStream(&stream));
    void *ha=nullptr,*hb=nullptr,*hy=nullptr,*da=nullptr,*db=nullptr,*dy=nullptr;
    CHECK(aclrtMallocHost(&ha,maxA));CHECK(aclrtMallocHost(&hb,maxB));CHECK(aclrtMallocHost(&hy,maxY));
    CHECK(aclrtMalloc(&da,maxA,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&db,maxB,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&dy,maxY,ACL_MEM_MALLOC_HUGE_FIRST));
    for(size_t ci=0;ci<cases.size();++ci) {
        auto& c=cases[ci];size_t na=(size_t)c.b*c.m*c.k*2,nb=(size_t)c.b*c.n*c.k*2,ny=(size_t)c.b*4;
        std::vector<float> gold(c.b),first(c.b);
        if(!read(c.path+"/x1.bin",ha,na)||!read(c.path+"/x2.bin",hb,nb)||!read(c.path+"/gold.bin",gold.data(),ny))return 2;
        CHECK(aclrtMemcpy(da,maxA,ha,na,ACL_MEMCPY_HOST_TO_DEVICE)); CHECK(aclrtMemcpy(db,maxB,hb,nb,ACL_MEMCPY_HOST_TO_DEVICE));
        int64_t as[]={c.b,c.ta?c.k:c.m,c.ta?c.m:c.k},bs[]={c.b,c.tb?c.n:c.k,c.tb?c.k:c.n},ys[]={c.b};
        TensorInfo ai{as,3,c.d},bi{bs,3,c.d},yi{ys,1,0};TensorGroupInfo ag{&ai,1},bg{&bi,1},yg{&yi,1};
        double ab=0,rel=0;bool consistent=true,pass=true;
        for(int rep=0;rep<3;++rep) {
            run_kernel((GM_ADDR)da,ag,(GM_ADDR)db,bg,(GM_ADDR)dy,yg,cores,stream,c.ta,c.tb);
            CHECK(aclrtSynchronizeStreamWithTimeout(stream,10000)); CHECK(aclrtMemcpy(hy,maxY,dy,ny,ACL_MEMCPY_DEVICE_TO_HOST));
            float* got=(float*)hy;
            if(rep==0)memcpy(first.data(),got,ny);else if(memcmp(first.data(),got,ny))consistent=false;
            for(int i=0;i<c.b;++i) {
                double delta=std::abs((double)got[i]-gold[i]);ab=std::max(ab,delta);rel=std::max(rel,delta/std::max(std::abs((double)gold[i]),1e-5));
                if(!std::isfinite(got[i])||delta>1e-4+1e-4*std::abs((double)gold[i]))pass=false;
            }
        }
        printf("{\"case\":%zu,\"shape\":[%d,%d,%d,%d],\"dtype\":%d,\"ta\":%d,\"tb\":%d,\"absolute\":%.9g,\"relative\":%.9g,\"consistent\":%s,\"passed\":%s}\n",ci,c.b,c.m,c.n,c.k,c.d,c.ta,c.tb,ab,rel,consistent?"true":"false",pass?"true":"false");fflush(stdout);
        if(!pass||!consistent)return 3;
    }
    printf("PASS: %zu cases, 3 identical executions each\n",cases.size());
    CHECK(aclrtFree(da));CHECK(aclrtFree(db));CHECK(aclrtFree(dy));
    CHECK(aclrtFreeHost(ha));CHECK(aclrtFreeHost(hb));CHECK(aclrtFreeHost(hy));
    CHECK(aclrtDestroyStream(stream)); CHECK(aclrtResetDevice(0)); CHECK(aclFinalize());
    return 0;
}
