// Multi-shape benchmark: reads a shape list and runs run_kernel for each shape,
// so a single msprof session profiles many shapes.
// Usage: ./bench_multi shapes.txt iters [dtype ta tb]
// shapes.txt: one "B M N K" per line
// Prints one line per shape: SHAPE B M N K iters=<n>

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
#include <fstream>
#include <sstream>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "kernel.asc"

static void fill(void* buf, size_t bytes, int seed) {
    uint16_t* p = (uint16_t*)buf;
    size_t n = bytes / 2;
    uint32_t s = (uint32_t)seed * 2654435761u + 12345u;
    for (size_t i = 0; i < n; ++i) { s = s * 1103515245u + 12345u; p[i] = (uint16_t)(0x2000u + (s >> 18)); }
}

int main(int argc, char** argv)
{
    if (argc < 3) { fprintf(stderr, "usage: bench_multi shapes.txt iters [dtype ta tb]\n"); return 1; }
    const char* listPath = argv[1];
    int iters = atoi(argv[2]);
    int dtype = argc > 3 ? atoi(argv[3]) : 1;
    bool ta = argc > 4 ? atoi(argv[4]) != 0 : false;
    bool tb = argc > 5 ? atoi(argv[5]) != 0 : false;

    std::vector<std::vector<int64_t>> shapes;
    { std::ifstream f(listPath); std::string line;
      while (std::getline(f, line)) {
          std::istringstream is(line); int64_t B, M, N, K;
          if (!(is >> B >> M >> N >> K)) continue;
          if (B <= 0 || M <= 0 || N <= 0 || K <= 0) continue;
          shapes.push_back({B, M, N, K});
      } }

    aclrtStream stream = nullptr;
    int32_t deviceId = 1;
    { const char* dv = getenv("BMMS_DEVICE_ID"); if (dv && *dv) deviceId = atoi(dv); }
    int64_t availableCoreNum = 0;
    if (aclInit(nullptr) != ACL_SUCCESS) return 1;
    if (aclrtSetDevice(deviceId) != ACL_SUCCESS) return 1;
    if (aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum) != ACL_SUCCESS) return 1;
    if (availableCoreNum <= 0) return 1;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) return 1;

    // Biggest buffers, allocated once.
    size_t maxA = 0, maxB = 0, maxY = 0;
    for (auto& s : shapes) {
        maxA = std::max(maxA, (size_t)s[0] * s[1] * s[3] * 2);
        maxB = std::max(maxB, (size_t)s[0] * s[2] * s[3] * 2);
        maxY = std::max(maxY, (size_t)s[0] * 4);
    }
    void *hA = nullptr, *dA = nullptr, *hB = nullptr, *dB = nullptr, *hY = nullptr, *dY = nullptr;
    if (aclrtMallocHost(&hA, maxA) != ACL_SUCCESS) return 1;
    if (aclrtMalloc(&dA, maxA, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 1;
    if (aclrtMallocHost(&hB, maxB) != ACL_SUCCESS) return 1;
    if (aclrtMalloc(&dB, maxB, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 1;
    if (aclrtMallocHost(&hY, maxY) != ACL_SUCCESS) return 1;
    if (aclrtMalloc(&dY, maxY, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) return 1;
    fill(hA, maxA, 1); fill(hB, maxB, 2);
    if (aclrtMemcpy(dA, maxA, hA, maxA, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return 1;
    if (aclrtMemcpy(dB, maxB, hB, maxB, ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) return 1;

    for (auto& s : shapes) {
        int64_t B = s[0], M = s[1], N = s[2], K = s[3];
        int64_t x1_0_shape[] = {B, ta ? K : M, ta ? M : K};
        TensorInfo x1_tensors[] = {{x1_0_shape, 3, dtype}};
        TensorGroupInfo info_x1 = {x1_tensors, 1};
        int64_t x2_0_shape[] = {B, tb ? N : K, tb ? K : N};
        TensorInfo x2_tensors[] = {{x2_0_shape, 3, dtype}};
        TensorGroupInfo info_x2 = {x2_tensors, 1};
        int64_t y_0_shape[] = {B};
        TensorInfo y_tensors[] = {{y_0_shape, 1, 0}};
        TensorGroupInfo info_y = {y_tensors, 1};
        for (int i = 0; i < iters; ++i)
            run_kernel((GM_ADDR)dA, info_x1, (GM_ADDR)dB, info_x2, (GM_ADDR)dY, info_y,
                       availableCoreNum, stream, ta, tb);
        if (aclrtSynchronizeStreamWithTimeout(stream, 600000) != ACL_SUCCESS) { fprintf(stderr, "sync timeout\n"); return 1; }
        printf("SHAPE %ld %ld %ld %ld iters=%d\n", (long)B, (long)M, (long)N, (long)K, iters);
        fflush(stdout);
    }

    aclrtFree(dA); aclrtFreeHost(hA); aclrtFree(dB); aclrtFreeHost(hB); aclrtFree(dY); aclrtFreeHost(hY);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
