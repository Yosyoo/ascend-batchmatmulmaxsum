#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
using namespace AscendC;
template<class T>
__global__ __aicore__ __cube__ void load3d_gemm_component(GM_ADDR a,GM_ADDR b,GM_ADDR y,int m,int n,int k,int mode,int start,int count,int transA)
{
    GlobalTensor<T> ag,bg;GlobalTensor<float> yg;
    ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);yg.SetGlobalBuffer((__gm__ float*)y);
    LocalTensor<T> la(TPosition::A1,0,m*k),lb(TPosition::B1,65536,n*k);
    LocalTensor<T> aa(TPosition::A2,0,m*k),bb(TPosition::B2,0,n*k);
    LocalTensor<float> cc(TPosition::CO1,0,m*n);
    Nd2NzParams ap{1,(uint16_t)(transA?k:m),(uint16_t)(transA?m:k),0,(uint16_t)(transA?m:k),(uint16_t)(transA?k:m),1,0};
    Nd2NzParams bp{1,(uint16_t)k,(uint16_t)n,0,(uint16_t)n,(uint16_t)k,1,0};
    DataCopy(la,ag,ap);DataCopy(lb,bg,bp);
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    if(mode&1) {
        LoadData3DParamsV2<T> p;p.l1H=1;p.l1W=transA?k:m;p.channelSize=transA?m:k;
        p.kExtension=transA?m:count;p.mExtension=transA?count:m;
        p.kStartPt=transA?0:start;p.mStartPt=transA?start:0;p.enTranspose=transA;
        LoadData(aa,la,p);
    } else {
        if(transA){
            LoadData2dParams p{0,(uint8_t)(count/16),1,0,0,true,0};
            for(int r=0;r<m/16;++r)LoadData(aa[r*count*16],la[(r*k+start)*16],p);
        }else{
            LoadData2dParams p{0,(uint8_t)(m/16),1,0,(uint16_t)(count/16-1),false,0};
            for(int q=0;q<count/16;++q)LoadData(aa[q*256],la[(start+q*16)*m],p);
        }
    }
    PipeBarrier<PIPE_MTE1>();
    if(mode&2) {
        LoadData3DParamsV2<T> p;p.l1H=1;p.l1W=k;p.channelSize=n;
        p.kExtension=n;p.mExtension=count;p.kStartPt=0;p.mStartPt=start;p.enTranspose=true;
        LoadData(bb,lb,p);
    } else {
        LoadData2dParams p{0,(uint8_t)(n/16),(uint16_t)(k/16),0,0,true,0};
        for(int q=0;q<count/16;++q)LoadData(bb[q*n*16],lb[(start+q*16)*16],p);
    }
    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
    MmadParams mm{(uint16_t)m,(uint16_t)n,(uint16_t)count,0,false,true};Mmad(cc,aa,bb,mm);
    SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
    FixpipeParamsV220 fp;fp.mSize=m;fp.nSize=n;fp.srcStride=m;fp.dstStride=n;
    Fixpipe(yg,cc,fp);PipeBarrier<PIPE_ALL>();
}
#define CHECK(x) do{auto rc=(x);if(rc!=ACL_SUCCESS){fprintf(stderr,"ACL failure %d line%d\n",(int)rc,__LINE__);return 1;}}while(0)
static bool read(const char* f,void* dst,size_t n){FILE*p=fopen(f,"rb");if(!p)return false;bool ok=fread(dst,1,n,p)==n;fclose(p);return ok;}
int main(int argc,char** argv){
    if(argc!=5 && argc!=7)return 2;int m=atoi(argv[1]),n=atoi(argv[2]),k=atoi(argv[3]),dtype=atoi(argv[4]);
    if(m%16||n%16||k%16||m<=0||n<=0||k<=0||m>128||n>128||k>256)return 2;
    int start=argc==7?atoi(argv[5]):0,count=argc==7?atoi(argv[6]):k;
    if(start<0 || count<=0 || start%16 || count%16 || start+count>k)return 2;
    int transA=std::getenv("COMPONENT_TA")?std::atoi(std::getenv("COMPONENT_TA")):0;
    size_t as=m*k*2,bs=k*n*2,ys=m*n*4;
    std::vector<unsigned char> ah(as),bh(bs);std::vector<float> got(m*n),base(m*n);
    if(!read("a.bin",ah.data(),as)||!read("b.bin",bh.data(),bs))return 3;
    CHECK(aclInit(nullptr));CHECK(aclrtSetDevice(0));aclrtStream st;CHECK(aclrtCreateStream(&st));
    void*ad;void*bd;void*yd;CHECK(aclrtMalloc(&ad,as,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&bd,bs,ACL_MEM_MALLOC_HUGE_FIRST));CHECK(aclrtMalloc(&yd,ys,ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemcpy(ad,as,ah.data(),as,ACL_MEMCPY_HOST_TO_DEVICE));CHECK(aclrtMemcpy(bd,bs,bh.data(),bs,ACL_MEMCPY_HOST_TO_DEVICE));
    for(int mode=0;mode<4;++mode){
        CHECK(aclrtMemset(yd,ys,255,ys));
        if(dtype==1)load3d_gemm_component<half><<<1,nullptr,st>>>((GM_ADDR)ad,(GM_ADDR)bd,(GM_ADDR)yd,m,n,k,mode,start,count,transA);
        else load3d_gemm_component<bfloat16_t><<<1,nullptr,st>>>((GM_ADDR)ad,(GM_ADDR)bd,(GM_ADDR)yd,m,n,k,mode,start,count,transA);
        CHECK(aclrtSynchronizeStreamWithTimeout(st,10000));CHECK(aclrtMemcpy(got.data(),ys,yd,ys,ACL_MEMCPY_DEVICE_TO_HOST));
        if(!mode)base=got;
        int diff=0,nonfinite=0;double maxAbs=0;
        for(int i=0;i<m*n;++i){if(!std::isfinite(got[i]))++nonfinite;if(memcmp(&got[i],&base[i],4))++diff;maxAbs=std::max(maxAbs,std::abs((double)got[i]-base[i]));}
        char name[32];snprintf(name,sizeof(name),"out%d.bin",mode);FILE*f=fopen(name,"wb");fwrite(got.data(),1,ys,f);fclose(f);
        printf("{\"m\":%d,\"n\":%d,\"k\":%d,\"dtype\":%d,\"mode\":%d,\"different\":%d,\"nonfinite\":%d,\"maxAbs\":%.9g}\n",m,n,k,dtype,mode,diff,nonfinite,maxAbs);fflush(stdout);
    }
    CHECK(aclrtFree(ad));CHECK(aclrtFree(bd));CHECK(aclrtFree(yd));CHECK(aclrtDestroyStream(st));CHECK(aclrtResetDevice(0));CHECK(aclFinalize());return 0;
}
