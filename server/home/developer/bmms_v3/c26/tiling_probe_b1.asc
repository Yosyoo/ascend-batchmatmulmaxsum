#include <cstdio>
#include <initializer_list>
#include "tiling_api.h"
int main(){
 for(int k:{512,1024,1152,1280,1536,1792})for(int dtype:{1,2})for(bool ta:{false,true})for(bool tb:{false,true})for(bool reserve:{false,true}){
  matmul_tiling::PlatformInfo p;p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
  p.l1Size=512*1024;p.l0ASize=p.l0BSize=64*1024;p.l0CSize=128*1024;p.ubSize=192*1024;
  matmul_tiling::MatmulApiTiling api(p);
  auto dt=dtype==1?matmul_tiling::DataType::DT_FLOAT16:matmul_tiling::DataType::DT_BF16;
  api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,ta);
  api.SetBType(matmul_tiling::TPosition::B1,matmul_tiling::CubeFormat::NZ,dt,tb);
  api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
  api.SetBias(false);api.SetShape(256,128,k);api.SetOrgShape(4096,128,k,k);api.SetFixSplit(256,128,-1);
  const int resident=128*k*2,free=p.l1Size-resident;
  api.SetBufferSpace(reserve?free:p.l1Size,p.l0CSize,0);
  TCubeTiling t{};int rc=api.GetTiling(t);
  if(rc){printf("{\"k\":%d,\"dtype\":%d,\"ta\":%d,\"tb\":%d,\"reserve\":%d,\"rc\":%d}\n",k,dtype,ta,tb,reserve,rc);continue;}
  int q=free/(4*t.baseM*t.baseK);int blocks=k/t.baseK;
  if(q>blocks)q=blocks;while(q>1&&blocks%q)--q;
  printf("{\"k\":%d,\"dtype\":%d,\"ta\":%d,\"tb\":%d,\"reserve\":%d,\"rc\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"stepKa\":%d,\"stepKb\":%d,\"depthA1\":%d,\"depthB1\":%d,\"shareL1\":%d,\"newQa\":%d,\"totalL1\":%d,\"L0A\":%d,\"L0B\":%d,\"L0C\":%d}\n",k,dtype,ta,tb,reserve,rc,t.baseM,t.baseN,t.baseK,t.stepKa,t.stepKb,t.depthA1,t.depthB1,t.shareL1Size,q,resident+4*t.baseM*t.baseK*q,2*t.baseM*t.baseK*t.dbL0A,2*t.baseN*t.baseK*t.dbL0B,4*t.baseM*t.baseN*t.dbL0C);
 }
}
