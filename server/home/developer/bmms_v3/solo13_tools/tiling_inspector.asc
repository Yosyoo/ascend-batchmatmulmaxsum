#include <cstdio>
#include "tiling_api.h"
// Host-only resource metadata; no tensor input, output or operator calculation.
int main() {
    for(int requestedN: {256,128,512}) {
        matmul_tiling::PlatformInfo p;
        p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
        p.l1Size=512*1024;p.l0ASize=p.l0BSize=64*1024;p.l0CSize=128*1024;p.ubSize=192*1024;
        matmul_tiling::MatmulApiTiling api(p);
        api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_BF16,true);
        api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_BF16,false);
        api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);api.SetShape(128,requestedN==512?512:256,1536);api.SetOrgShape(1280,4096,1536);
        api.SetFixSplit(requestedN==512?64:128,requestedN,-1);api.SetBufferSpace(p.l1Size,p.l0CSize,0);
        TCubeTiling t;
        int rc=api.GetTiling(t);
        printf("{\"requestedN\":%d,\"rc\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"depthA1\":%d,\"depthB1\":%d,\"stepKa\":%d,\"stepKb\":%d,\"dbL0A\":%d,\"dbL0B\":%d,\"dbL0C\":%d,\"L1_bytes\":%d,\"L0A_bytes\":%d,\"L0B_bytes\":%d,\"L0C_bytes\":%d}\n",
            requestedN,rc,t.baseM,t.baseN,t.baseK,t.depthA1,t.depthB1,t.stepKa,t.stepKb,t.dbL0A,t.dbL0B,t.dbL0C,
            2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1),2*t.baseM*t.baseK*t.dbL0A,
            2*t.baseN*t.baseK*t.dbL0B,4*t.baseM*t.baseN*t.dbL0C);
    }
}
