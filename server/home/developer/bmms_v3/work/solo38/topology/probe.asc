#include <cstdio>
#include "acl/acl.h"
#include "kernel_operator.h"
using namespace AscendC;
// Standalone hardware diagnostic, never part of an operator submission.
__global__ __aicore__ __mix__(1,2) void topology_probe(GM_ADDR result) {
    if ASCEND_IS_AIC { CrossCoreSetFlag<2,PIPE_MTE2>(8); CrossCoreWaitFlag(10); }
    if ASCEND_IS_AIV {
        LocalTensor<int32_t> x(TPosition::VECCALC,0,8);
        GlobalTensor<int32_t> g; g.SetGlobalBuffer((__gm__ int32_t*)result);
        x.SetValue(0,GetBlockIdx()); x.SetValue(1,GetBlockNum());
        x.SetValue(2,GetSubBlockIdx()); x.SetValue(3,GetTaskRation());
        x.SetValue(4,GetSubBlockNum()); x.SetValue(5,123); x.SetValue(6,456); x.SetValue(7,789);
        CrossCoreWaitFlag(8);
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0); WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        DataCopy(g[GetBlockIdx()*8],x,8);
        CrossCoreSetFlag<2,PIPE_MTE3>(10);
        PipeBarrier<PIPE_ALL>(); SyncAll<true>();
    }
}
#define CHECK(x) do { auto e=(x); if(e){printf("ACL_ERROR %d line %d\n",int(e),__LINE__);return 1;} }while(0)
int main(){
    aclrtStream stream; void* dev; int32_t got[48]={};
    CHECK(aclInit(nullptr)); CHECK(aclrtSetDevice(0)); CHECK(aclrtCreateStream(&stream));
    CHECK(aclrtMalloc(&dev,sizeof(got),ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMemset(dev,sizeof(got),0,sizeof(got)));
    topology_probe<<<3,nullptr,stream>>>((GM_ADDR)dev);
    CHECK(aclrtSynchronizeStreamWithTimeout(stream,10000));
    CHECK(aclrtMemcpy(got,sizeof(got),dev,sizeof(got),ACL_MEMCPY_DEVICE_TO_HOST));
    for(int i=0;i<6;i++){ for(int j=0;j<8;j++)printf("%d ",got[i*8+j]);printf("\n"); }
    CHECK(aclrtFree(dev)); CHECK(aclrtDestroyStream(stream)); CHECK(aclFinalize());
}
