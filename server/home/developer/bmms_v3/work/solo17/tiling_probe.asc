#include <cstdio>
#include <initializer_list>
#include "tiling_api.h"
// Host resource metadata only. No input/output tensors or operator computation.
int main() {
    for(int k: {1152,1536,1792,8192}) for(int d: {1,2})
    for(bool ta: {false,true}) for(bool tb: {false,true}) for(int bn: {256,128}) {
        matmul_tiling::PlatformInfo p;
        p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
        p.l1Size=512*1024;p.l0ASize=p.l0BSize=64*1024;
        p.l0CSize=128*1024;p.ubSize=192*1024;
        matmul_tiling::MatmulApiTiling api(p);
        auto dtype=d==1?matmul_tiling::DataType::DT_FLOAT16:matmul_tiling::DataType::DT_BF16;
        api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dtype,ta);
        api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dtype,tb);
        api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);api.SetShape(128,256,k);api.SetOrgShape(1280,4096,k);
        api.SetFixSplit(128,bn,-1);api.SetBufferSpace(p.l1Size,p.l0CSize,0);
        TCubeTiling t;int rc=api.GetTiling(t);
        if(rc)return 1;
        int db=bn==128?2:t.dbL0C;
        printf("{\"k\":%d,\"dtype\":%d,\"ta\":%d,\"tb\":%d,\"requestedN\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"depthA1\":%d,\"depthB1\":%d,\"stepM\":%d,\"stepN\":%d,\"stepKa\":%d,\"stepKb\":%d,\"dbL0A\":%d,\"dbL0B\":%d,\"original_dbL0C\":%d,\"candidate_dbL0C\":%d,\"L1_bytes\":%d,\"L0A_bytes\":%d,\"L0B_bytes\":%d,\"L0C_bytes\":%d}\n",
            k,d,ta,tb,bn,t.baseM,t.baseN,t.baseK,t.depthA1,t.depthB1,t.stepM,t.stepN,t.stepKa,t.stepKb,t.dbL0A,t.dbL0B,t.dbL0C,db,
            2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1),2*t.baseM*t.baseK*t.dbL0A,
            2*t.baseN*t.baseK*t.dbL0B,4*t.baseM*t.baseN*db);
        if(2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1)>p.l1Size ||
            2*t.baseM*t.baseK*t.dbL0A>p.l0ASize || 2*t.baseN*t.baseK*t.dbL0B>p.l0BSize ||
            4*t.baseM*t.baseN*db>p.l0CSize)return 2;
    }
}
