#include <cstdint>
#include <cstdio>
#include <cstring>
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"

int main(int argc, char** argv) {
    const bool bySoc = argc > 1 && std::strcmp(argv[1], "soc") == 0;
    const auto init = aclInit(nullptr);
    const char* soc = aclrtGetSocName();
    std::printf("{\"mode\":\"%s\",\"aclInit\":%d,\"soc\":\"%s\",", bySoc ? "soc" : "default", int(init), soc ? soc : "null");
    auto* platform = bySoc ? (soc ? platform_ascendc::PlatformAscendCManager::GetInstance(soc) : nullptr)
                           : platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform) {
        std::printf("\"platform\":null}\n");
        if (init == ACL_SUCCESS) aclFinalize();
        return 2;
    }
    using MT = platform_ascendc::CoreMemType;
    const MT kinds[] = {MT::L0_A, MT::L0_B, MT::L0_C, MT::L1, MT::L2, MT::UB, MT::HBM};
    const char* names[] = {"L0A", "L0B", "L0C", "L1", "L2", "UB", "HBM"};
    std::printf("\"aic\":%u,\"aiv\":%u,\"core\":%u,\"socVersion\":%d,\"npuArch\":%d,\"memoryBytes\":{",
                platform->GetCoreNumAic(), platform->GetCoreNumAiv(), platform->GetCoreNum(),
                int(platform->GetSocVersion()), int(platform->GetCurNpuArch()));
    for (int i = 0; i < 7; ++i) {
        uint64_t size = 0;
        platform->GetCoreMemSize(kinds[i], size);
        std::printf("%s\"%s\":%llu", i ? "," : "", names[i], (unsigned long long)size);
    }
    std::printf("}}\n");
    if (init == ACL_SUCCESS) aclFinalize();
    return 0;
}
