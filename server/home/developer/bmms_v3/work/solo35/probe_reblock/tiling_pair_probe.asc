#include <cstdio>
#include <initializer_list>
#include "tiling_api.h"
int main(){
 for(int k=256;k<=8192;k+=128)for(int dt:{1,2})for(bool ta:{false,true})for(bool tb:{false,true}){
  matmul_tiling::PlatformInfo p;p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
  p.l1Size=524288;p.l0ASize=p.l0BSize=65536;p.l0CSize=131072;p.ubSize=196608;
  matmul_tiling::MatmulApiTiling api(p);auto dtype=dt==1?matmul_tiling::DataType::DT_FLOAT16:matmul_tiling::DataType::DT_BF16;
  api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dtype,ta);api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dtype,tb);api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
  api.SetBias(false);api.SetShape(128,256,k);api.SetOrgShape(1024,1024,k,k);api.SetFixSplit(128,256,128);api.SetBufferSpace(p.l1Size,p.l0CSize,0);
  TCubeTiling t;int ret=api.GetTiling(t);if(ret){printf("{\"k\":%d,\"dtype\":%d,\"ta\":%d,\"tb\":%d,\"ret\":%d}\n",k,dt,ta,tb,ret);continue;}

  if(k>=512 && k%256==0 && t.baseM==128 && t.baseN==256 && t.baseK==64 && t.stepM==1 && t.stepN==1) {
   int q=1,blocks=k/64,limit=524288/(4*64*(128+256));while(q*2<=limit && blocks%(q*2)==0)q*=2;
   if(q>t.stepKa || q>t.stepKb){t.stepKa=t.stepKb=q;t.depthA1=t.depthB1=2*q;}
   if(t.stepKa%2==0 && t.stepKb%2==0 && t.depthA1%2==0 && t.depthB1%2==0){
    t.baseK=128;t.stepKa/=2;t.stepKb/=2;t.depthA1/=2;t.depthB1/=2;t.dbL0A=t.dbL0B=1;
   }
  }
  int l1=2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1),a=2*t.baseM*t.baseK*t.dbL0A,b=2*t.baseN*t.baseK*t.dbL0B,c=4*t.baseM*t.baseN*t.dbL0C;
  printf("{\"k\":%d,\"dtype\":%d,\"ta\":%d,\"tb\":%d,\"ret\":0,\"base\":[%d,%d,%d],\"db\":[%d,%d,%d],\"L1\":%d,\"L0A\":%d,\"L0B\":%d,\"L0C\":%d}\n",k,dt,ta,tb,t.baseM,t.baseN,t.baseK,t.dbL0A,t.dbL0B,t.dbL0C,l1,a,b,c);
  if(l1>524288||a>65536||b>65536||c>131072)return 2;
 }
}
