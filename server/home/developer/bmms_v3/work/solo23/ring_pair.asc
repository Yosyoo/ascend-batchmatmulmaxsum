template<class T>
__aicore__ inline __attribute__((always_inline)) void bmms_ring_prefetch(
    GlobalTensor<T>& ag,GlobalTensor<T>& bg,int m,int n,int k,int mi,int ni,
    int cm,int start,int kk,int bank,bool& busy)
{
    constexpr int TM=112,TN=128,BK=128,BANKBYTES=(TM+TN)*BK*2;
    if(busy){WaitFlag<HardEvent::MTE1_MTE2>(bank);busy=false;}
    LocalTensor<T> la(TPosition::A1,bank*BANKBYTES,TM*BK);
    LocalTensor<T> lb(TPosition::B1,bank*BANKBYTES+TM*BK*2,TN*BK);
    Nd2NzParams pa{1,cm,kk,0,k,cm,1,0};
    Nd2NzParams pb{1,kk,TN,0,n,kk,1,0};
    DataCopy(la,ag[(int64_t)mi*k+start],pa);
    DataCopy(lb,bg[(int64_t)start*n+ni],pb);
    SetFlag<HardEvent::MTE2_MTE1>(bank);
}

template<class T>
__global__ __aicore__ __mix__(1,1) void bmms_ring_pair(
    GM_ADDR a,GM_ADDR b,GM_ADDR scratch,GM_ADDR maxima,GM_ADDR y,int m,int n,int k,int ns)
{
    constexpr int TM=112,TN=128,BK=128,BANKS=8,BANKBYTES=(TM+TN)*BK*2;
    const int core=GetBlockIdx(),mi=(core/ns)*TM,ni=(core%ns)*TN;
    const int cm=m-mi<TM?m-mi:TM;
    GlobalTensor<float> sg,mg,yg;
    sg.SetGlobalBuffer((__gm__ float*)scratch);mg.SetGlobalBuffer((__gm__ float*)maxima);
    yg.SetGlobalBuffer((__gm__ float*)y);
    if ASCEND_IS_AIC {
        GlobalTensor<T> ag,bg;ag.SetGlobalBuffer((__gm__ T*)a);bg.SetGlobalBuffer((__gm__ T*)b);
        LocalTensor<float> cc(TPosition::CO1,0,TM*TN);
        bool l1Busy[BANKS]={false,false,false,false,false,false,false,false};
        bool l0Busy[2]={false,false},fixBusy=false;
        const int half=k/2,chunks=(half+BK-1)/BK;
        for(int part=0;part<2;++part){
            for(int first=0;first<BANKS;++first){
                int kk=half-first*BK<BK?half-first*BK:BK;
                bmms_ring_prefetch(ag,bg,m,n,k,mi,ni,cm,part*half+first*BK,kk,first,l1Busy[first]);
            }
            for(int i=0;i<chunks;++i){
                const int bank=i&(BANKS-1),slot=i&1;
                const int kk=half-i*BK<BK?half-i*BK:BK;
                WaitFlag<HardEvent::MTE2_MTE1>(bank);
                if(l0Busy[slot]){WaitFlag<HardEvent::M_MTE1>(slot);l0Busy[slot]=false;}
                LocalTensor<T> la(TPosition::A1,bank*BANKBYTES,TM*BK);
                LocalTensor<T> lb(TPosition::B1,bank*BANKBYTES+TM*BK*2,TN*BK);
                LocalTensor<T> aa(TPosition::A2,slot*TM*BK*2,TM*BK);
                LocalTensor<T> bb(TPosition::B2,slot*TN*BK*2,TN*BK);
                LoadData2dParams ap{0,kk/16,cm/16,0,0,false,0};
                for(int row=0;row<cm/16;++row)LoadData(aa[row*kk*16],la[row*256],ap);
                LoadData2dParams bp{0,TN/16,kk/16,0,0,true,0};
                for(int row=0;row<kk/16;++row)LoadData(bb[row*TN*16],lb[row*256],bp);
                SetFlag<HardEvent::MTE1_MTE2>(bank);l1Busy[bank]=true;
                SetFlag<HardEvent::MTE1_M>(slot);WaitFlag<HardEvent::MTE1_M>(slot);
                if(fixBusy){WaitFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=false;}
                MmadParams mm{cm,TN,kk,0,false,i==0};Mmad(cc,aa,bb,mm);
                SetFlag<HardEvent::M_MTE1>(slot);l0Busy[slot]=true;
                if(i+BANKS<chunks){
                    const int next=i+BANKS,nextkk=half-next*BK<BK?half-next*BK:BK;
                    bmms_ring_prefetch(ag,bg,m,n,k,mi,ni,cm,part*half+next*BK,nextkk,bank,l1Busy[bank]);
                }
            }
            for(int slot=0;slot<2;++slot)if(l0Busy[slot]){WaitFlag<HardEvent::M_MTE1>(slot);l0Busy[slot]=false;}
            SetFlag<HardEvent::M_FIX>(EVENT_ID0);WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
            FixpipeParamsV220 fp;fp.mSize=cm;fp.nSize=TN;fp.srcStride=cm;fp.dstStride=TN;
            if(part==1)SetAtomicAdd<float>();else DisableDmaAtomic();
            Fixpipe(sg[(int64_t)core*TM*TN],cc,fp);DisableDmaAtomic();
            SetFlag<HardEvent::FIX_M>(EVENT_ID0);fixBusy=true;
            if(part==1)CrossCoreSetFlag<2,PIPE_FIX>(8);
        }
        for(int bank=0;bank<BANKS;++bank)if(l1Busy[bank])WaitFlag<HardEvent::MTE1_MTE2>(bank);
        if(fixBusy)WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
    }
    if ASCEND_IS_AIV {
        constexpr int C_BYTES=TM*TN*4,RM_BYTES=TM*4;
        LocalTensor<float> vx(TPosition::VECIN,0,TM*TN);
        LocalTensor<float> rm(TPosition::VECCALC,C_BYTES,TM);
        LocalTensor<float> sx(TPosition::VECIN,C_BYTES+RM_BYTES,m);
        LocalTensor<float> acc(TPosition::VECCALC,C_BYTES+RM_BYTES+m*4,m);
        LocalTensor<float> tmp(TPosition::VECCALC,C_BYTES+RM_BYTES+2*m*4,128);
        LocalTensor<float> out(TPosition::VECOUT,C_BYTES+RM_BYTES+2*m*4+512,8);
        CrossCoreWaitFlag(8);DataCopy(vx,sg[(int64_t)core*TM*TN],cm*TN);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        Max(vx,vx,vx[64],64,cm,{1,1,1,16,16,16});PipeBarrier<PIPE_V>();
        WholeReduceMax(rm,vx,64,cm,1,1,16,ReduceOrder::ORDER_ONLY_VALUE);
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
        DataCopyExtParams op{1,(uint32_t)cm*4,0,0,0};DataCopyPad(mg[(core%ns)*m+mi],rm,op);
        PipeBarrier<PIPE_ALL>();SyncAll<true>();
        if(core==0){
            Duplicate(acc,-3.402823466e+38f,m);
            for(int part=0;part<ns;++part){
                SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
                DataCopy(sx,mg[part*m],m);
                SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
                Max(acc,acc,sx,m);PipeBarrier<PIPE_V>();
            }
            bmms_paired_sum(out,acc,tmp,m);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
            DataCopyExtParams cp{1,4,0,0,0};DataCopyPad(yg,out,cp);
        }
    }
    PipeBarrier<PIPE_ALL>();
}
