#include <cstdio>
#include <initializer_list>
#include "tiling_api.h"
int main() {
    int rows=0;
    for(int m:{512,1024,2048,2432,4096,8192})
    for(int n:{1024,2048,4096,8192})
    for(int k:{1056,1088,1152,1536,1792})
    for(int dtype:{1,2}) for(bool ta:{false}) for(bool tb:{false}) {
        matmul_tiling::PlatformInfo p;
        p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
        p.l1Size=524288;p.l0ASize=p.l0BSize=65536;p.l0CSize=131072;p.ubSize=196608;
        matmul_tiling::MatmulApiTiling api(p);
        api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,(dtype==2?matmul_tiling::DataType::DT_BF16:matmul_tiling::DataType::DT_FLOAT16),ta);
        api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,(dtype==2?matmul_tiling::DataType::DT_BF16:matmul_tiling::DataType::DT_FLOAT16),tb);
        api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);api.SetShape(128,256,k);api.SetOrgShape(m,n,k,k);
        api.SetFixSplit(128,256,-1);api.SetBufferSpace(p.l1Size,p.l0CSize,0);
        TCubeTiling t;if(api.GetTiling(t))return 1;
        const int oldKb=t.stepKb;
        if(k>=2048 && m<=2432 && (m+127)/128<20 && t.stepM==1 && t.stepN==1 && t.stepKa>0 && t.stepKb>0) {
            const int maxKb=(p.l1Size-2*t.baseM*t.baseK*t.depthA1)/(4*t.baseN*t.baseK);
            for(int q=oldKb+1;q<=maxKb;++q)if(t.stepKa%q==0)t.stepKb=q;
            if(t.stepKb>oldKb){t.depthB1=2*t.stepKb;t.shareL1Size=2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1);}
        }
        const int l1=2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1);
        const int l0a=2*t.baseM*t.baseK*t.dbL0A,l0b=2*t.baseN*t.baseK*t.dbL0B,l0c=4*t.baseM*t.baseN*t.dbL0C;
        const int ub=2*128*(m<=2432?128:64)*4+32768+2*((m+7)/8)*32+2*128*4;
        printf("{\"shape\":[%d,%d,%d],\"dtype\":%d,\"ta\":%d,\"tb\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"L1_bytes\":%d,\"L0A_bytes\":%d,\"L0B_bytes\":%d,\"L0C_bytes\":%d,\"UB_bytes\":%d,\"stepKa\":%d,\"old_stepKb\":%d,\"stepKb\":%d}\n",m,n,k,dtype,ta,tb,t.baseM,t.baseN,t.baseK,l1,l0a,l0b,l0c,ub,t.stepKa,oldKb,t.stepKb);
        if(l1>p.l1Size||l0a>p.l0ASize||l0b>p.l0BSize||l0c>p.l0CSize||ub>184320)return 2;
        ++rows;
    }
    return rows==240?0:3;
}
