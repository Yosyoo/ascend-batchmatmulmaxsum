#include <cstdio>
#include <cstdint>
#include <algorithm>
#include <initializer_list>
#include "tiling_api.h"
struct Tile {int m,n;};
Tile choose(int b,int m,int n,int k,int availableCoreNum=20) {
    const bool packed=false,transposeX1=false,transposeX2=false;
    int32_t tileM = m <= 16 ? 16 : (m <= 32 ? 32 : ((n <= 64 && k <= 128 && m >= 256 && (int64_t)b * ((m + 255) / 256) >= availableCoreNum) ? 256 : 64));
    int32_t tileN = n <= 16 ? 16 : (n <= 32 ? 32 : (n <= 64 ? 64 : 128));
    // For narrow, short-K matrices, fewer waves can offset a partially filled wave.
    if (k <= 128 && n <= 32 && m >= 2048) {
        int64_t best = ((b * ((m + tileM - 1) / tileM) + availableCoreNum - 1) / availableCoreNum) * (tileM + 128);
        for (int32_t candidate = 128; candidate * tileN <= 16384; candidate *= 2) {
            int64_t cost = ((b * ((m + candidate - 1) / candidate) + availableCoreNum - 1) / availableCoreNum) * (candidate + 128);
            if (cost < best) { best = cost; tileM = candidate; }
        }
    }
    // Enlarge tiles only when enough independent tasks remain to occupy the device.
    int32_t initialRows = b * ((m + tileM - 1) / tileM);
    if (n > 128 && (k >= 256 || initialRows * 2 < availableCoreNum) && (initialRows * 2 >= availableCoreNum ||
        (int64_t)initialRows * ((n + 255) / 256) >= availableCoreNum)) tileN = 256;

    // Each tile reloads its own A/B slab from GM and pays one Fixpipe + one scheduler pass,
    // so a 128-row M tile is a win whenever enough tiles remain to keep the device busy.
    // ...but never override the tuned narrow-matrix M-tile chosen just above.
    if (m >= 128 && tileN >= 128) {
        int64_t tiles = (int64_t)((m + 127) / 128) * ((n + 127) / 128);
        if (tiles * 2 >= availableCoreNum) tileM = 128;
    }
    if (k <= 256 && (int64_t)b * m * n * k < (1LL << 28) &&
        n > 128 && n <= 1024 && m <= 512) tileN = 128;
    const bool useFullA = !packed && (transposeX1 || transposeX2) && m>=512 && m<=8192 && n>=1024 && n<=8192 &&
        m%128==0 && n%512==0 && k>1024 && k<=1792 && k%32==0 && tileM==128 && tileN==256;
    // Keep the AIV UB footprint (tile staging + max/sum reduce buffers) inside the 192 KB
    // budget; an over-large tile overflows UB and faults or hangs the kernel at run time.
    {
        int64_t aux = 32768 + 2 * (int64_t)((m + 7) / 8) * 32 + 2 * (int64_t)tileM * 4;
        int64_t maxStage = (180 * 1024 - aux) / 4;   // elements the chunked AIV staging may hold
        while ((int64_t)tileM * (tileN < 128 ? tileN : 128) > maxStage && (tileM > 16 || tileN > 16)) {
            if (tileN > 128 || (tileN >= tileM && tileN > 16)) tileN >>= 1;
            else if (tileM > 16) tileM >>= 1;
            else break;
        }
    }


    return {tileM,tileN};
}
int main() {
    int rows=0;
    for(int b:{1,2,4}) for(int m:{64,128,256,384,512,640,1024,1280,2048,2432,2560})
    for(int n:{128,256,512,768,1024,1280,2048,2560})
    for(int k:{1056,1152,1536,1792,2048,4096,6144,8192}) for(int d:{1,2}) {
        Tile tile=choose(b,m,n,k);int tm=tile.m,tn=tile.n;
        if(tm>128 || tn>256 || m%tm || n%tn)continue;
        const int orig=b*(m/tm)*(n/tn);if(orig>20)continue;
        matmul_tiling::PlatformInfo p;p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
        p.l1Size=524288;p.l0ASize=p.l0BSize=65536;p.l0CSize=131072;p.ubSize=196608;
        matmul_tiling::MatmulApiTiling api(p);
        auto dt=d==2?matmul_tiling::DataType::DT_BF16:matmul_tiling::DataType::DT_FLOAT16;
        api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,false);
        api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,false);
        api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);api.SetShape(tm,tn,k);api.SetOrgShape(m,n,k,k);
        api.SetFixSplit(std::min(tm,256),tn,-1);api.SetBufferSpace(p.l1Size,p.l0CSize,0);
        TCubeTiling t;if(api.GetTiling(t))return 1;
        if(k>=2048 && m>=512 && m<=2432 && n>=512 && m%128==0 && n%256==0 && tm==128 && tn==256 && b*((m+127)/128)<20 && t.stepM==1 && t.stepN==1 && t.stepKa>0 && t.stepKb>0) {
            int oldKb=t.stepKb,maxKb=(p.l1Size-2*t.baseM*t.baseK*t.depthA1)/(4*t.baseN*t.baseK);
            for(int q=oldKb+1;q<=maxKb;++q)if(t.stepKa%q==0)t.stepKb=q;
            if(t.stepKb>oldKb){t.depthB1=2*t.stepKb;t.shareL1Size=2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1);}
        }
        int cn=std::min(tn,m<=2432?128:64);
        int l1=2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1);
        int la=2*t.baseM*t.baseK*t.dbL0A,lb=2*t.baseN*t.baseK*t.dbL0B,lc=4*t.baseM*t.baseN*t.dbL0C;
        int ub=2*tm*cn*4+32768+2*((m+7)/8)*32+2*tm*4;
        int scratch=2*orig*tm*tn*4,maxima=(b*(n/tn)*m*4+511)/512*512;
        printf("{\"shape\":[%d,%d,%d,%d],\"dtype\":%d,\"tileM\":%d,\"tileN\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"L1_bytes\":%d,\"L0A_bytes\":%d,\"L0B_bytes\":%d,\"L0C_bytes\":%d,\"UB_bytes\":%d,\"original_tile_tasks\":%d,\"parallel_cores\":%d,\"GM_scratch_bytes\":%d,\"GM_maxima_bytes\":%d}\n",b,m,n,k,d,tm,tn,t.baseM,t.baseN,t.baseK,l1,la,lb,lc,ub,orig,std::min(20,2*orig),scratch,maxima);
        if(l1>524288 || la>65536 || lb>65536 || lc>131072 || ub>184320)return 2;
        ++rows;
    }
    return rows>0?0:3;
}
