#include <cstdio>
#include <algorithm>
#include "tiling_api.h"
int main(){
    const int shapes[][2]={{128,2048},{256,1024},{512,512},{1024,256},{2048,128}};
    for(auto& shape:shapes) for(int k=2048;k<=8192;k+=32) for(int d=1;d<=2;++d){
        const int m=shape[0],n=shape[1],tm=m>=n?112:128,tn=m>=n?128:112;
        matmul_tiling::PlatformInfo p;p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
        p.l1Size=524288;p.l0ASize=p.l0BSize=65536;p.l0CSize=131072;p.ubSize=196608;
        matmul_tiling::MatmulApiTiling api(p);
        auto dt=d==2?matmul_tiling::DataType::DT_BF16:matmul_tiling::DataType::DT_FLOAT16;
        api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,false);
        api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dt,false);
        api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);api.SetShape(tm,tn,k);api.SetOrgShape(m,n,k,k);
        api.SetFixSplit(tm,tn,-1);api.SetBufferSpace(p.l1Size,p.l0CSize,0);
        TCubeTiling t;const int ret=api.GetTiling(t);if(ret){printf("ERROR %d %d %d %d %d\n",m,n,k,d,ret);return 1;}
        int l1=2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1);
        int la=2*t.baseM*t.baseK*t.dbL0A,lb=2*t.baseN*t.baseK*t.dbL0B,lc=4*t.baseM*t.baseN*t.dbL0C;
        int ub=tm*std::min(tn,128)*4+32768+2*((m+7)/8)*32+2*tm*4;
        const int tasks=((m+tm-1)/tm)*((n+tn-1)/tn);
        printf("{\"shape\":[1,%d,%d,%d],\"dtype\":%d,\"tileM\":%d,\"tileN\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"stepKa\":%d,\"stepKb\":%d,\"depthA1\":%d,\"depthB1\":%d,\"L1_bytes\":%d,\"L0A_bytes\":%d,\"L0B_bytes\":%d,\"L0C_bytes\":%d,\"UB_bytes\":%d,\"tasks\":%d,\"GM_scratch_bytes\":%d}\n",m,n,k,d,tm,tn,t.baseM,t.baseN,t.baseK,t.stepKa,t.stepKb,t.depthA1,t.depthB1,l1,la,lb,lc,ub,tasks,2*tasks*tm*tn*4);
        if(l1>524288||la>65536||lb>65536||lc>131072||ub>184320||tasks>20)return 2;
    }
}
