#include <cstdio>
#include <initializer_list>
#include "tiling_api.h"
int main() {
    for(int m: {512,1280,8192}) for(int n: {1024,4096,8192})
    for(int k=1056;k<=1792;k+=32) for(int d: {1,2})
    for(bool ta: {false,true}) for(bool tb: {false,true}) {
        const int tm=64,tn=512,preload=tm*k*2;
        matmul_tiling::PlatformInfo p;
        p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
        p.l1Size=512*1024;p.l0ASize=p.l0BSize=64*1024;p.l0CSize=128*1024;p.ubSize=192*1024;
        matmul_tiling::MatmulApiTiling api(p);
        auto dtype=d==1?matmul_tiling::DataType::DT_FLOAT16:matmul_tiling::DataType::DT_BF16;
        api.SetAType(matmul_tiling::TPosition::A1,matmul_tiling::CubeFormat::NZ,dtype,ta);
        api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dtype,tb);
        api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);api.SetShape(tm,tn,k/2);api.SetOrgShape(tm,n,k/2,k);
        api.SetFixSplit(64,256,64);api.SetBufferSpace(p.l1Size,p.l0CSize,0);
        TCubeTiling t;int rc=api.GetTiling(t);if(rc){printf("tiling rc=%d k=%d\n",rc,k);return 1;}
        t.stepM=1;t.stepN=1;t.stepKa=1;t.depthA1=2;
        t.stepKb=(p.l1Size-preload)/(2*t.baseN*t.baseK*2);
        t.depthB1=2*t.stepKb;
        if(t.stepKb<1)return 3;
        // CANN GetCubeInBufferType selects NONE for L1 A input: A is externally reserved once.
        const int l1=preload+2*t.baseN*t.baseK*t.depthB1;
        const int l0a=2*t.baseM*t.baseK*t.dbL0A,l0b=2*t.baseN*t.baseK*t.dbL0B,l0c=4*t.baseM*t.baseN*t.dbL0C;
        printf("{\"shape\":[%d,%d,%d],\"dtype\":%d,\"ta\":%d,\"tb\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"depthA1\":%d,\"depthB1\":%d,\"singleCoreK\":%d,\"A1_preload_bytes\":%d,\"L1_bytes\":%d,\"L0A_bytes\":%d,\"L0B_bytes\":%d,\"L0C_bytes\":%d}\n",
            m,n,k,d,ta,tb,t.baseM,t.baseN,t.baseK,t.depthA1,t.depthB1,t.singleCoreK,preload,l1,l0a,l0b,l0c);
        if(l1>p.l1Size||l0a>p.l0ASize||l0b>p.l0BSize||l0c>p.l0CSize)return 2;
    }
}
