#include <cstdio>
#include <initializer_list>
#include <array>
#include "tiling_api.h"
int main() {
    for(auto shape: {std::array<int,5>{1280,4096,1152,128,512}, {1280,4096,1536,128,512}, {1280,4096,1792,128,512}})
    for(int d: {1,2}) for(bool ta: {false,true}) for(bool tb: {false,true}) {
        int m=shape[0],n=shape[1],k=shape[2],tm=shape[3],tn=shape[4];
        matmul_tiling::PlatformInfo p;
        p.socVersion=platform_ascendc::SocVersion::ASCEND910B;
        p.l1Size=512*1024;p.l0ASize=p.l0BSize=64*1024;p.l0CSize=128*1024;p.ubSize=192*1024;
        matmul_tiling::MatmulApiTiling api(p);
        auto dtype=d==1?matmul_tiling::DataType::DT_FLOAT16:matmul_tiling::DataType::DT_BF16;
        api.SetAType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dtype,ta);
        api.SetBType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,dtype,tb);
        api.SetCType(matmul_tiling::TPosition::GM,matmul_tiling::CubeFormat::ND,matmul_tiling::DataType::DT_FLOAT);
        api.SetBias(false);api.SetShape(tm,tn,k/2);api.SetOrgShape(m,n,k);
        api.SetFixSplit(128,256,-1);api.SetBufferSpace(p.l1Size,p.l0CSize,0);
        TCubeTiling t;int rc=api.GetTiling(t);if(rc)return 1;
        const int fullKa=(k/2+t.baseK-1)/t.baseK;
        const int bStep=(fullKa%2==0 && 2*t.baseK*(t.baseM*fullKa+4*t.baseN)<=p.l1Size)?2:1;
        t.stepM=1;t.stepN=1;t.stepKa=fullKa;t.depthA1=fullKa;t.stepKb=bStep;t.depthB1=2*bStep;
        const int l1=2*t.baseK*(t.baseM*t.depthA1+t.baseN*t.depthB1);
        const int l0a=2*t.baseM*t.baseK*t.dbL0A,l0b=2*t.baseN*t.baseK*t.dbL0B,l0c=4*t.baseM*t.baseN*t.dbL0C;
        printf("{\"shape\":[%d,%d,%d],\"dtype\":%d,\"ta\":%d,\"tb\":%d,\"baseM\":%d,\"baseN\":%d,\"baseK\":%d,\"singleCoreK\":%d,\"L1_bytes\":%d,\"L0A_bytes\":%d,\"L0B_bytes\":%d,\"L0C_bytes\":%d}\n",
            m,n,k,d,ta,tb,t.baseM,t.baseN,t.baseK,t.singleCoreK,l1,l0a,l0b,l0c);
        if(l1>p.l1Size||l0a>p.l0ASize||l0b>p.l0BSize||l0c>p.l0CSize)return 2;
    }
}
