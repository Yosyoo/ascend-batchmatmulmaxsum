// Cache/reentry test: reuse one stream and input allocation for B, 1, B batches.
// Usage: ./batch_matmul_max_sum_custom B M N K dtype ta tb [repetitions=6]

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <cstring>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Dtype enum for TensorInfo.dtype:
// 0=float32 1=float16 2=bfloat16 3=int8 4=int16 5=int32 6=int64
// 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include <vector>
#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); return 1; } } while(0)
#define FILE_CHECK(expr) do { if (!(expr)) { fprintf(stderr, "[ERROR] File I/O failed at %s:%d\n", __FILE__, __LINE__); return 1; } } while(0)

#include "kernel.asc"

int main(int argc, char** argv)
{
    int B = argc > 1 ? atoi(argv[1]) : 1;
    int M = argc > 2 ? atoi(argv[2]) : 1;
    int N = argc > 3 ? atoi(argv[3]) : 1;
    int K = argc > 4 ? atoi(argv[4]) : 32;
    int dtype = argc > 5 ? atoi(argv[5]) : 1;
    bool ta = argc > 6 ? atoi(argv[6]) != 0 : false;
    bool tb = argc > 7 ? atoi(argv[7]) != 0 : false;
    int32_t deviceId = 0;
    int64_t availableCoreNum = 0;
    aclrtStream stream = nullptr;

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCoreNum));
    if (availableCoreNum <= 0) {
        return 1;
    }
    ACL_CHECK(aclrtCreateStream(&stream));

    int64_t x1_0_shape[] = {B, ta ? K : M, ta ? M : K};
    TensorInfo x1_tensors[] = {{x1_0_shape, 3, dtype}};
    TensorGroupInfo info_x1 = {x1_tensors, 1};
    int64_t x2_0_shape[] = {B, tb ? N : K, tb ? K : N};
    TensorInfo x2_tensors[] = {{x2_0_shape, 3, dtype}};
    TensorGroupInfo info_x2 = {x2_tensors, 1};
    int64_t y_0_shape[] = {B};
    TensorInfo y_tensors[] = {{y_0_shape, 1, 0}};
    TensorGroupInfo info_y = {y_tensors, 1};

    bool transposeX1 = ta;
    bool transposeX2 = tb;

    uint8_t *inputHost_x1 = nullptr, *inputDevice_x1 = nullptr;
    uint8_t *inputHost_x2 = nullptr, *inputDevice_x2 = nullptr;

    uint8_t *outputHost_y = nullptr, *outputDevice_y = nullptr;

    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x1, (size_t)B*M*K*2));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x1, (size_t)B*M*K*2, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x1.bin", (size_t)B*M*K*2, inputHost_x1, (size_t)B*M*K*2));
    ACL_CHECK(aclrtMemcpy(inputDevice_x1, (size_t)B*M*K*2, inputHost_x1, (size_t)B*M*K*2, ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMallocHost((void **)&inputHost_x2, (size_t)B*N*K*2));
    ACL_CHECK(aclrtMalloc((void **)&inputDevice_x2, (size_t)B*N*K*2, ACL_MEM_MALLOC_HUGE_FIRST));
    FILE_CHECK(ReadFile("./input/x2.bin", (size_t)B*N*K*2, inputHost_x2, (size_t)B*N*K*2));
    ACL_CHECK(aclrtMemcpy(inputDevice_x2, (size_t)B*N*K*2, inputHost_x2, (size_t)B*N*K*2, ACL_MEMCPY_HOST_TO_DEVICE));

    ACL_CHECK(aclrtMallocHost((void **)&outputHost_y, (size_t)B*4));
    ACL_CHECK(aclrtMalloc((void **)&outputDevice_y, (size_t)B*4, ACL_MEM_MALLOC_HUGE_FIRST));

    int repetitions = argc > 8 ? atoi(argv[8]) : 6;
    std::vector<uint8_t> firstOutput((size_t)B * 4);
    for (int rep = 0; rep < repetitions; ++rep) {
        // Changing only the active prefix exercises tiling-plan cache reentry
        // without uploading new inputs or changing the allocated workspace.
        int activeB = rep % 3 == 1 ? 1 : B;
        x1_0_shape[0] = activeB;
        x2_0_shape[0] = activeB;
        y_0_shape[0] = activeB;
        run_kernel((GM_ADDR)inputDevice_x1, info_x1, (GM_ADDR)inputDevice_x2, info_x2, (GM_ADDR)outputDevice_y, info_y, availableCoreNum, stream, transposeX1, transposeX2);
        ACL_CHECK(aclrtSynchronizeStreamWithTimeout(stream, 3000));
        ACL_CHECK(aclrtMemcpy(outputHost_y, (size_t)B*4, outputDevice_y, (size_t)activeB*4, ACL_MEMCPY_DEVICE_TO_HOST));
        if (rep == 0) std::memcpy(firstOutput.data(), outputHost_y, (size_t)B*4);
        else if (std::memcmp(firstOutput.data(), outputHost_y, (size_t)activeB*4) != 0) {
            fprintf(stderr, "Cache/reentry output mismatch on repetition %d, active B=%d (original B=%d)\n", rep, activeB, B);
            return 1;
        }
    }
    auto sync_ret_ = aclrtSynchronizeStreamWithTimeout(stream, 3000);
    if (sync_ret_ != 0) { fprintf(stderr, "[ERROR] aclrtSynchronizeStreamWithTimeout failed, ret=%d\n", sync_ret_); return 1; }

    // The reference always contains all original batches, including when an
    // optional repetition count ends with an active prefix of one batch.
    FILE_CHECK(WriteFile("./output/y.bin", firstOutput.data(), (size_t)B*4));
    printf("Cache/reentry passed: %d repetitions with B=%d,1,%d cycle\n", repetitions, B, B);

    if (inputDevice_x1) aclrtFree(inputDevice_x1);
    if (inputHost_x1) aclrtFreeHost(inputHost_x1);
    if (inputDevice_x2) aclrtFree(inputDevice_x2);
    if (inputHost_x2) aclrtFreeHost(inputHost_x2);
    if (outputDevice_y) aclrtFree(outputDevice_y);
    if (outputHost_y) aclrtFreeHost(outputHost_y);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
